# ─── Required ──────────────────────────────────────────────
# Gmail credentials for sending booking/contact/newsletter emails
GMAIL_USER=
GMAIL_PASS=

# WhatsApp number (raw digits, no spaces or +)
# Shown in footer, navbar helpline, and WhatsApp CTA button
PUBLIC_WHATSAPP_NUMBER=212661172393

# ─── Optional ──────────────────────────────────────────────
# Separate recipient email (defaults to GMAIL_USER if not set)
MAIL_TO=

# ─── CAPTCHA (Cap - trycap.dev / reCAPTCHA) ─────────────
# Cap (privacy-first PoW CAPTCHA): https://trycap.dev
# Your self-hosted or managed Cap site endpoint
PUBLIC_CAP_API_ENDPOINT=
# Your Cap secret key for backend verification
CAP_SECRET_KEY=

# Fallback: Google reCAPTCHA v2 (optional)
RECAPTCHA_SECRET_KEY=
PUBLIC_RECAPTCHA_SITE_KEY=
