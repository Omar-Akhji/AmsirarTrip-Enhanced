# ─── Required ──────────────────────────────────────────────
# Gmail credentials for sending booking/contact/newsletter emails
GMAIL_USER=
GMAIL_PASS=

# WhatsApp number (raw digits, no spaces or +)
# Shown in footer, navbar helpline, and WhatsApp CTA button
PUBLIC_WHATSAPP_NUMBER=212661172393

# ─── Security & Cloudflare Edge ────────────────────────────
# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Dev defaults to Cloudflare's official always-pass test keys; production fails closed if unset
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shared 64-char hex secret (`openssl rand -hex 32`) injected by Cloudflare Request Header
# Transform Rule (`X-Origin-Verify`) to block direct-to-origin bypass and authenticate CF-Connecting-IP
ORIGIN_VERIFY_SECRET=

# ─── Optional ──────────────────────────────────────────────
# Separate recipient email (defaults to GMAIL_USER if not set)
MAIL_TO=
