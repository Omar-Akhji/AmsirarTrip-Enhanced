---
import aboutImg from "@/assets/images/about-img.webp";
import bgImage from "@/assets/images/Header/header-1.webp";
import aboutStats from "@/data/about-stats.json";
import { useTranslations } from "@/i18n/utils";
import PageHeader from "@/shared/layout/PageHeader.astro";
import Button from "@/shared/ui/Button.astro";
import { Image } from "astro:assets";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const factStats = aboutStats.map((stat) => ({
  id: stat.id,
  icon: stat.icon,
  value: stat.value,
  duration: stat.duration,
  label: t(
    stat.labelKey as
      | "about.facts.photos"
      | "about.facts.beaches"
      | "about.facts.mountains"
      | "about.facts.cruises",
  ),
}));

const DELAY_CLASSES = ["delay-0", "delay-150", "delay-300", "delay-[450ms]"] as const;
---

<PageHeader
  bgImage={bgImage}
  breadcrumbs={[{ label: t("nav.home"), href: "/" }, { label: t("nav.about") }]}
  headingId="about-page-title"
  subtitle={t("about.headerSubtitle")}
  title={t("about.title")}
>
  <Button
    variant="secondary"
    href="#about"
  >
    {t("about.ourStory")}
  </Button>
  <Button
    variant="ghost"
    href="#facts"
  >
    {t("about.facts.smTitle")}
  </Button>
</PageHeader>

<div class="bg-white">
  <!-- 01 // HERITAGE & MISSION -->
  <section
    aria-labelledby="our-story-heading"
    class="relative isolate overflow-hidden py-12 sm:py-16 lg:py-24 text-stone-900"
    id="about"
  >
    <div class="mx-auto px-4 max-inline-7xl">
      <div
        class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8"
        data-animate="fade-up"
      >
        <hgroup class="max-w-2xl space-y-2">
          <h2
            class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance"
            id="our-story-heading"
          >
            {t("about.ourStory")}
          </h2>
          <p class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 leading-relaxed max-w-[62ch] text-pretty">
            {t("about.experienceTitle")}
          </p>
        </hgroup>
      </div>

      <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-16">
        <!-- Editorial Text Column -->
        <div class="order-2 lg:order-1 lg:col-span-7">
          <div
            class="inline-full"
            data-animate="fade-up"
          >
            <article class="space-y-8">
              <div class="space-y-5 text-stone-700">
                <p class="text-base sm:text-lg leading-relaxed text-stone-800 font-normal">
                  {t("about.experienceText1")}
                </p>
                <p class="text-sm sm:text-base leading-relaxed text-stone-600">
                  {t("about.experienceText2")}
                </p>
                <p class="text-sm sm:text-base leading-relaxed text-stone-600">
                  {t("about.experienceText3")}
                </p>
              </div>

              <!-- Editorial Blockquote -->
              <figure class="my-8 border-s-2 border-orange-600 ps-6 py-1">
                <blockquote class="text-base sm:text-lg leading-relaxed text-stone-800 italic text-pretty">
                  "{t("about.conclusionText")}"
                </blockquote>
                <figcaption class="mbs-2 text-xs font-semibold tracking-wider text-stone-500 uppercase">
                  — Amsirar Expedition Atelier
                </figcaption>
              </figure>

              <!-- Core Pillars of Trust -->
              <div class="border-t border-stone-200/90 pbs-8">
                <hgroup class="mbe-6">
                  <h3 class="text-lg sm:text-xl font-bold tracking-tight text-stone-900">
                    {t("about.whyTrustTitle")}
                  </h3>
                </hgroup>
                <ul
                  role="list"
                  class="m-0 p-0 list-none grid grid-cols-1 gap-3 sm:grid-cols-2"
                >
                  {[1, 2, 3, 4].map((number_) => (
                    <li class="flex items-start gap-3 rounded-2xl border border-stone-200/80 bg-stone-50/70 p-4 shadow-2xs transition-colors hover:border-stone-300">
                      <span class="text-xs font-bold text-orange-600 shrink-0 mbs-0.5">
                        0{number_}
                      </span>
                      <p class="text-xs sm:text-sm leading-relaxed text-stone-700 text-pretty">
                        {t(`about.whyTrust.point${number_}`)}
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          </div>
        </div>

        <!-- Archival Image Column with Concentric Frame -->
        <div class="order-1 lg:order-2 lg:col-span-5">
          <div
            class="delay-200"
            data-animate="zoom-in"
          >
            <figure>
              <div class="overflow-hidden rounded-2xl border border-stone-200/90 bg-stone-100/80 p-2 sm:p-3 shadow-2xs">
                <div class="relative aspect-4/5 sm:aspect-4/3 lg:aspect-4/5 overflow-hidden rounded-2xl bg-stone-200">
                  <Image
                    alt="Amsirar landscape showcasing traditional Moroccan architecture and culture"
                    class="size-full object-cover transition-transform duration-700 [transition-timing-function:cubic-bezier(0.16,1,0.3,1)] pointer-fine:hover:scale-103 motion-reduce:transform-none"
                    height={852}
                    src={aboutImg}
                    width={720}
                  />
                </div>
              </div>
              <figcaption class="mbs-3 flex items-center justify-between px-2 font-mono text-xs text-stone-500">
                <span class="flex items-center gap-2">
                  <span class="size-1.5 rounded-full bg-orange-600"></span>
                  {t("about.imageCaption") || "High Atlas & Desert Valleys"}
                </span>
                <span class="tabular-nums">EST. 2006 · MOROCCO</span>
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 // EXPEDITION METRICS -->
  <section
    aria-labelledby="facts-heading"
    class="relative isolate overflow-hidden border-t border-stone-200/90 bg-stone-50/60 py-12 sm:py-16 lg:py-24 text-stone-900"
    id="facts"
  >
    <div class="mx-auto px-4 max-inline-7xl">
      <div
        class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8"
        data-animate="fade-up"
      >
        <hgroup class="max-w-2xl space-y-2">
          <h2
            class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance"
            id="facts-heading"
          >
            {t("about.facts.lgTitle")}
          </h2>
          <p class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 leading-relaxed max-w-[62ch] text-pretty">
            {t("about.facts.smTitle")}
          </p>
        </hgroup>
      </div>

      <div class="mbs-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {factStats.map((fact, index) => (
          <div
            class:list={["flex size-full", DELAY_CLASSES[index] || "delay-0"]}
            data-animate="fade-up"
          >
            <article
              aria-labelledby={`fact-${fact.id}-label`}
              class="group relative flex size-full flex-col justify-between overflow-hidden rounded-2xl border border-slate-900 bg-slate-950 px-8 py-10 text-center text-orange-200 shadow-xl transition-[transform,box-shadow] duration-200 ease-out pointer-fine:hover:-translate-y-1 pointer-fine:hover:shadow-2xl motion-reduce:transform-none"
            >
              <div class="relative flex flex-col items-center gap-y-6">
                <figure class="relative inline-flex size-24 shrink-0 items-center justify-center overflow-hidden rounded-full border-2 border-white bg-white/5 p-3 text-white">
                  <Image
                    alt=""
                    aria-hidden="true"
                    class="block size-full object-contain brightness-0 invert"
                    height={96}
                    src={fact.icon}
                    width={96}
                  />
                </figure>
                <div
                  aria-hidden="true"
                  class="font-mono text-4xl font-bold text-orange-200 tabular-nums text-shadow-md"
                >
                  <span
                    class="inline-block"
                    data-count-duration={fact.duration}
                    data-count-to={fact.value}
                  >
                    {fact.value.toLocaleString()}
                  </span>
                </div>
                <h3
                  class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-white/80 uppercase"
                  id={`fact-${fact.id}-label`}
                >
                  {fact.label}
                </h3>
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>
</div>
