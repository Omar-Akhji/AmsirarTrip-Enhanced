---
import aboutImg from "@/assets/images/about-img.webp";
import agafayImg from "@/assets/images/Excursions/Agafay.webp";
import ourikaImg from "@/assets/images/Excursions/Ourika_Valley.webp";
import bgImage from "@/assets/images/Header/header-1.webp";
import aboutStats from "@/data/about-stats.json";
import { useTranslations } from "@/i18n/utils";
import PageHeader from "@/layouts/PageHeader.astro";
import { splitTitleAccent } from "@/lib/utils";
import { Image } from "astro:assets";
import QuoteIcon from "@/shared/ui/icons/QuoteIcon.astro";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const storyTitle = splitTitleAccent(t("about.ourStory"));
const factsTitle = splitTitleAccent(t("about.facts.lgTitle"));

const factStats = aboutStats.map((stat) => ({
  id: stat.id,
  icon: stat.icon,
  value: stat.value,
  duration: stat.duration,
  label: t(
    stat.labelKey as
      | "about.facts.photos"
      | "about.facts.beaches"
      | "about.facts.mountains"
      | "about.facts.cruises",
  ),
}));

import { DELAY_CLASSES } from "@/shared/ui/primitives/animation-constants";
---

<PageHeader
  bgImage={bgImage}
  breadcrumbs={[{ label: t("nav.home"), href: "/" }, { label: t("nav.about") }]}
  hasUnderline={true}
  headingId="about-page-title"
  subtitle={t("about.headerSubtitle")}
  title={t("about.title")}
/>

<div class="bg-white dark:bg-surface-base">
  <!-- HERITAGE & MISSION -->
  <section
    aria-labelledby="our-story-heading"
    class="relative isolate overflow-clip py-12 sm:py-16 lg:py-24 text-stone-900 dark:text-mist-100"
    id="about"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <div
        class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200/80 pb-6 sm:pb-8 dark:border-white/10"
        data-animate="fade-up"
      >
        <hgroup class="max-w-2xl space-y-2">
          <h2
            class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance dark:text-mist-100"
            id="our-story-heading"
          >
            {storyTitle.main}{" "}
            {storyTitle.accent && <span class="text-orange">{storyTitle.accent}</span>}
          </h2>
          <p class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 dark:text-mist-300 leading-relaxed max-w-[62ch] text-pretty">
            {t("about.experienceTitle")}
          </p>
        </hgroup>
      </div>

      <div class="grid grid-cols-1 items-start gap-10 sm:gap-12 lg:grid-cols-golden lg:gap-6 xl:gap-8">
        <!-- Left Column: 3 Images Collage (order-1 on Mobile & Tablet, Left on Desktop) -->
        <div class="order-1 lg:order-1">
          <div
            class="animate-delay-200 flex flex-col gap-gap-tight"
            data-animate="zoom-in"
          >
            <!-- Top Landscape Image -->
            <div class="group relative aspect-golden overflow-hidden rounded-2xl border border-stone-200/80 bg-stone-100 shadow-xs dark:border-white/10 dark:bg-surface-card">
              <Image
                alt={t("about.imageCaption")}
                class="size-full object-cover transition-transform duration-700 ease-out-expo pointer-fine:group-hover:scale-103 motion-reduce:transform-none"
                height={675}
                loading="eager"
                src={agafayImg}
                width={1200}
              />
            </div>

            <!-- Bottom Row: 2 Images Side-by-Side -->
            <div class="grid grid-cols-2 gap-gap-tight">
              <div class="group relative aspect-golden-portrait overflow-hidden rounded-2xl border border-stone-200/80 bg-stone-100 shadow-xs dark:border-white/10 dark:bg-surface-card">
                <Image
                  alt="Ourika Valley green terraces and mountain villages"
                  class="size-full object-cover transition-transform duration-700 ease-out-expo pointer-fine:group-hover:scale-104 motion-reduce:transform-none"
                  height={750}
                  loading="lazy"
                  src={ourikaImg}
                  width={600}
                />
              </div>

              <div class="group relative aspect-golden-portrait overflow-hidden rounded-2xl border border-stone-200/80 bg-stone-100 shadow-xs dark:border-white/10 dark:bg-surface-card">
                <Image
                  alt="Traditional Moroccan architecture and Atlas travel"
                  class="size-full object-cover transition-transform duration-700 ease-out-expo pointer-fine:group-hover:scale-104 motion-reduce:transform-none"
                  height={852}
                  loading="lazy"
                  src={aboutImg}
                  width={720}
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Editorial Narrative & Quote (order-2 on Mobile & Tablet, Right on Desktop) -->
        <div class="order-2 lg:order-2">
          <div
            class="inline-full"
            data-animate="fade-up"
          >
            <article class="flex flex-col gap-gap">
              <!-- Lead & Narrative Story with Fluid Typography -->
              <div class="flex flex-col gap-gap-tight">
                <p class="font-normal text-stone-800 dark:text-mist-100 text-lead text-pretty">
                  {t("about.experienceText1")}
                </p>
                <p class="text-stone-600 dark:text-mist-300 text-fluid-base leading-relaxed text-pretty">
                  {t("about.experienceText2")}
                </p>
                <p class="text-stone-600 dark:text-mist-300 text-fluid-base leading-relaxed text-pretty">
                  {t("about.experienceText3")}
                </p>
              </div>

              <!-- Archival Editorial Quote Card -->
              <figure class="relative overflow-hidden rounded-2xl border border-stone-200/90 bg-stone-50/70 p-gutter dark:border-white/10 dark:bg-surface-card/80">
                <QuoteIcon
                  aria-hidden="true"
                  class="pointer-events-none absolute top-4 right-4 sm:top-5 sm:right-5 size-5 sm:size-6 text-orange-600/35"
                />
                <blockquote class="relative font-serif italic text-stone-800 dark:text-mist-100 text-lead text-pretty pe-8">
                  "{t("about.conclusionText")}"
                </blockquote>
                <figcaption class="mbs-3 flex items-center gap-2 font-mono text-fluid-sm font-semibold tracking-wider text-stone-600 dark:text-mist-200 uppercase">
                  <span class="size-1.5 rounded-full bg-orange-600"></span>
                  <span>Amsirar Trip Marrakech</span>
                </figcaption>
              </figure>
            </article>
          </div>
        </div>
      </div>

      <!-- Core Pillars of Trust Expanded Across Full Width Below Image & Story -->
      <div
        class="mbs-[clamp(2.5rem,2rem+2vw,4rem)] border-t border-stone-200/80 pt-[clamp(2rem,1.5rem+1.5vw,3rem)] dark:border-white/10"
        data-animate="fade-up"
      >
        <hgroup class="mbe-[clamp(1.25rem,1rem+0.75vw,1.75rem)] max-w-2xl">
          <h3 class="font-bold tracking-tight text-stone-900 dark:text-mist-100 text-[clamp(1.25rem,1.1rem+0.6vw,1.6rem)]">
            {t("about.whyTrustTitle")}
          </h3>
        </hgroup>
        <ul
          role="list"
          class="m-0 p-0 list-none grid grid-cols-1 xs:grid-cols-2 lg:grid-cols-4 gap-[clamp(1rem,0.8rem+0.5vw,1.5rem)] 2xl:gap-6"
        >
          {[1, 2, 3, 4].map((number_) => (
            <li class="flex flex-col items-start gap-3 rounded-2xl border border-stone-200/80 bg-stone-50/60 p-[clamp(1.125rem,0.95rem+0.6vw,1.5rem)] shadow-2xs dark:border-white/10 dark:bg-surface-card/60">
              <span class="inline-flex size-7 items-center justify-center rounded-lg bg-orange-100/80 dark:bg-orange-950/80 font-mono text-xs font-bold text-orange-700 dark:text-orange-400 tabular-nums shrink-0">
                0{number_}
              </span>
              <p class="text-stone-700 dark:text-mist-200 text-[clamp(0.875rem,0.825rem+0.2vw,0.95rem)] leading-relaxed text-pretty">
                {t(`about.whyTrust.point${number_}`)}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- EXPEDITION METRICS -->
  <section
    aria-labelledby="facts-heading"
    class="relative isolate overflow-clip border-t border-stone-200/90 bg-stone-50/60 py-12 sm:py-16 lg:py-24 text-stone-900 dark:border-white/10 dark:bg-surface-base dark:text-mist-100"
    id="facts"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <div
        class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8 dark:border-white/10"
        data-animate="fade-up"
      >
        <hgroup class="max-w-2xl space-y-2">
          <h2
            class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance dark:text-mist-100"
            id="facts-heading"
          >
            {factsTitle.main}{" "}
            {factsTitle.accent && <span class="text-orange">{factsTitle.accent}</span>}
          </h2>
          <p class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 dark:text-mist-300 leading-relaxed max-w-[62ch] text-pretty">
            {t("about.facts.smTitle")}
          </p>
        </hgroup>
      </div>

      <div class="mbs-16 grid gap-6 xs:grid-cols-2 sm:gap-8 lg:grid-cols-4 2xl:gap-10">
        {factStats.map((fact, index) => (
          <div
            class:list={["flex size-full", DELAY_CLASSES[index] || "animate-delay-0"]}
            data-animate="fade-up"
          >
            <article
              aria-labelledby={`fact-${fact.id}-label`}
              class="group relative flex size-full flex-col justify-between overflow-hidden rounded-2xl border border-slate-900 bg-slate-950 px-8 py-10 text-center text-orange-200 shadow-xl transition-[transform,box-shadow] duration-200 ease-out pointer-fine:hover:-translate-y-1 pointer-fine:hover:shadow-2xl motion-reduce:transform-none"
            >
              <div class="relative flex flex-col items-center gap-y-6">
                <figure class="relative inline-flex size-24 shrink-0 items-center justify-center overflow-hidden rounded-full border-2 border-white bg-white/5 p-3 text-white">
                  <Image
                    alt=""
                    aria-hidden="true"
                    class="block size-full object-contain brightness-0 invert"
                    height={96}
                    src={fact.icon}
                    width={96}
                  />
                </figure>
                <div
                  aria-hidden="true"
                  class="font-mono text-4xl font-bold text-orange-200 tabular-nums text-shadow-md"
                >
                  <span
                    class="inline-block"
                    data-count-duration={fact.duration}
                    data-count-to={fact.value}
                  >
                    {fact.value.toLocaleString(locale)}
                  </span>
                </div>
                <h3
                  class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-white/80 uppercase"
                  id={`fact-${fact.id}-label`}
                >
                  {fact.label}
                </h3>
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>
</div>
