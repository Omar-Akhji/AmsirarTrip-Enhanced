---
import type { CollectionEntry } from "astro:content";
import bgImage from "@/assets/images/Header/header-1.webp";
import { getExcursionsData } from "@/features/excursions/data/excursions-data";
import { useTranslations } from "@/i18n/utils";
import PageHeader from "@/layouts/PageHeader.astro";
import { splitTitleAccent } from "@/lib/utils";
import FaqAccordion from "@/shared/ui/widgets/FaqAccordion.astro";
import StatHighlights from "@/shared/ui/widgets/StatHighlights.astro";
import TripCard from "@/shared/ui/widgets/TripCard.astro";

interface Props {
  readonly entries?: readonly CollectionEntry<"excursions">[] | undefined;
}

const { entries } = Astro.props;
const locale = Astro.locals.locale;
const t = useTranslations(locale);
const excursions = await getExcursionsData(entries);

const excursionsGridTitle = splitTitleAccent(t("excursion.blog.lgTitle"));
const excursionsFaqTitle = splitTitleAccent(t("excursion.faq.title"));

const highlightStats = [
  {
    id: "routes",
    value: "6+",
    label: t("excursion.stats.routes"),
    description: t("excursion.stats.routesDesc"),
  },
  {
    id: "local",
    value: "100%",
    label: t("excursion.stats.local"),
    description: t("excursion.stats.localDesc"),
  },
  {
    id: "support",
    value: "24/7",
    label: t("excursion.stats.support"),
    description: t("excursion.stats.supportDesc"),
  },
];

const EXCURSIONS_FAQS = [
  { q: "excursion.faq.q1", a: "excursion.faq.a1" },
  { q: "excursion.faq.q2", a: "excursion.faq.a2" },
  { q: "excursion.faq.q3", a: "excursion.faq.a3" },
  { q: "excursion.faq.q4", a: "excursion.faq.a4" },
] as const;

import { DELAY_CLASSES } from "@/shared/ui/primitives/animation-constants";
---

<PageHeader
  bgImage={bgImage}
  breadcrumbs={[{ label: t("nav.home"), href: "/" }, { label: t("nav.excursions") }]}
  hasUnderline={true}
  subtitle={t("excursion.headerSubtitle")}
  title={t("excursion.title")}
/>

<div class="text-zinc-900 dark:text-mist-100">
  <section
    aria-labelledby="excursion-highlights"
    class="bg-white py-12 sm:py-16 lg:py-24 dark:bg-surface-base"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <h2
        class="sr-only"
        id="excursion-highlights"
      >
        {t("excursion.detailsTitle")}
      </h2>

      <div>
        <StatHighlights
          cardBg="bg-stone-50/80 dark:bg-surface-card/75 dark:border-white/10 dark:hover:border-white/20 dark:hover:bg-surface-hover/90"
          stats={highlightStats}
        />
      </div>
    </div>
  </section>

  <section
    aria-labelledby="excursion-grid-heading"
    class="border-t border-zinc-200 bg-linear-to-b from-zinc-50 to-white py-12 sm:py-16 lg:py-24 dark:border-white/10 dark:bg-surface-base dark:bg-none"
    id="excursions-grid"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <div
        class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8 dark:border-white/10"
        data-animate="creative-slide-right"
      >
        <hgroup class="max-w-2xl space-y-2">
          <h2
            class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance dark:text-mist-100"
            id="excursion-grid-heading"
          >
            {excursionsGridTitle.main}{" "}
            {excursionsGridTitle.accent && (
              <span class="text-orange">{excursionsGridTitle.accent}</span>
            )}
          </h2>
          <p class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm/relaxed sm:text-base text-stone-600 max-w-[62ch] text-pretty dark:text-mist-300">
            {t("excursion.sectionSubtitle")}
          </p>
        </hgroup>
      </div>

      <div class="grid grid-cols-1 gap-6 xs:gap-7 md:grid-cols-2 lg:grid-cols-3 lg:gap-8 2xl:gap-10">
        {excursions.map((excursion, index) => (
          <div
            class:list={["flex size-full", DELAY_CLASSES[index] || "animate-delay-0"]}
            data-animate="card-fan-rise"
          >
            <TripCard
              badge={t("excursion.card.category")}
              description={t(excursion.description)}
              exploreLink={t("excursion.exploreLink")}
              item={{ image: excursion.image, imageAlt: t(excursion.alt), route: excursion.route }}
              tagline={
                excursion.price === undefined ?
                  t(excursion.tagline)
                : t("excursion.card.priceFrom", { price: excursion.price })
              }
              title={t(excursion.title)}
              tourTypeBadge={t("tours.bothAvailable")}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section
    aria-labelledby="excursions-faq-heading"
    class="border-t border-zinc-200 bg-white py-12 sm:py-16 lg:py-20 dark:border-white/10 dark:bg-surface-base"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <hgroup
        class="mb-8 max-w-2xl"
        data-animate="curtain-up"
      >
        <h2
          class="text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl dark:text-mist-100"
          id="excursions-faq-heading"
        >
          {excursionsFaqTitle.main}{" "}
          {excursionsFaqTitle.accent && (
            <span class="text-orange">{excursionsFaqTitle.accent}</span>
          )}
        </h2>
        <p class="mt-2 border-s-2 border-orange-600 ps-4 py-0.5 text-sm/relaxed sm:text-base text-stone-600 max-w-[62ch] text-pretty dark:text-mist-300">
          {t("excursion.faq.subtitle")}
        </p>
      </hgroup>

      <FaqAccordion
        bare
        class="max-w-3xl dark:shadow-[0_4px_20px_-2px_rgba(0,0,0,0.4)]"
        faqs={EXCURSIONS_FAQS.map((faq) => ({ question: t(faq.q), answer: t(faq.a) }))}
        idPrefix="excursions"
      />
    </div>
  </section>
</div>
