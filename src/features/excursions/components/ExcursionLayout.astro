---
import { getExcursionRouteMap } from "@/features/maps/data/routes";
import { parseStringArray, useTranslations } from "@/i18n/utils";
import TripLayout from "@/layouts/TripLayout.astro";
import FaqAccordion from "@/shared/ui/widgets/FaqAccordion.astro";
import PricingCard from "@/shared/ui/widgets/PricingCard.astro";
import TripInfoSections from "@/shared/ui/widgets/TripInfoSections.astro";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import ExcursionProgram from "./ExcursionProgram.astro";
import ExcursionSeoSections from "./ExcursionSeoSections.astro";

interface Props {
  readonly excursion?: CollectionEntry<"excursions">["data"] | undefined;
  readonly excursionKey: string;
  readonly imageSrc: ImageMetadata;
  readonly locale: string;
  readonly slug?: string | undefined;
}

const { excursion, excursionKey, imageSrc, locale, slug = "" } = Astro.props;
const t = useTranslations(locale);
const isEnglish = locale === "en";

const excursionSlug = slug.length > 0 ? slug : excursionKey;
const transitionName = `trip-image-excursions-${excursionSlug}`;

const fallbackHighlights: readonly string[] = [
  t(`${excursionKey}.highlights.0`),
  t(`${excursionKey}.highlights.1`),
  t(`${excursionKey}.highlights.2`),
  t(`${excursionKey}.highlights.3`),
].filter((item): item is string => typeof item === "string" && item.length > 0);

const highlights =
  isEnglish && excursion?.seo?.highlights && excursion.seo.highlights.length > 0 ?
    excursion.seo.highlights
  : fallbackHighlights.length > 0 ? fallbackHighlights
  : (excursion?.seo?.highlights ?? []);

const sidebarItems = parseStringArray(t.raw("excursion.sidebar.items"));

const title = isEnglish && excursion?.seo?.title ? excursion.seo.title : t(`${excursionKey}.title`);
const lead =
  isEnglish && excursion?.seo?.lead ? excursion.seo.lead : t("excursion.detailsSubtitle");

const heroSubtitle = t(
  excursion?.i18nKeyPrefix && t.has(`excursion.list.${excursion.i18nKeyPrefix}.tagline`) ?
    `excursion.list.${excursion.i18nKeyPrefix}.tagline`
  : "excursion.headerSubtitle",
);

const distanceLabel = t(`${excursionKey}.distanceValue`);
const durationLabel = t(`${excursionKey}.durationLabel`);
const altText = excursion?.seo?.imageAlt ?? t(`${excursionKey}.alt`);

const metrics = excursion?.metrics ?? {
  distance: distanceLabel,
  duration: durationLabel,
  pickup: "08:00 AM hotel pickup in Marrakech",
  elevation: "Atlas foothills",
};

const price = excursion?.seo?.price ?? {
  label: "From €25 / person",
  note: "Small-group or private transfer with licensed English-speaking driver.",
};

const overviewParagraphs: readonly string[] =
  isEnglish && excursion?.overview && excursion.overview.length > 0 ?
    excursion.overview
  : [t(`${excursionKey}.overview`)].filter(
      (p): p is string => typeof p === "string" && p.length > 0,
    );

const program = excursion?.program ?? [];
const faqs = excursion?.seo?.faqs ?? [];
const includes = excursion?.includes ?? [];
const excludes = excursion?.excludes ?? [];
const goodToKnow = excursion?.goodToKnow ?? [];

const routeMap = getExcursionRouteMap(excursionKey, excursion?.location ?? "Morocco", title);
---

<TripLayout
  breadcrumbs={[
    { label: t("nav.home"), href: "/" },
    { label: t("nav.excursions"), href: "/excursions" },
    { label: t("excursion.breadcrumb") },
  ]}
  hasUnderline={true}
  headingId="excursion-title"
  imageAlt={`${altText} : Morocco excursion destination`}
  imageSrc={imageSrc}
  lead={lead}
  pageSubtitle={heroSubtitle}
  pageTitle={t("excursion.detailsTitle")}
  routeMap={routeMap}
  sectionId="excursion-single"
  sidebar={{
    sidebarTitle: t("excursion.sidebar.title"),
    mainBrand: t("excursion.sidebar.mainBrand"),
    intro: t("excursion.sidebar.intro"),
    details: t("excursion.sidebar.details"),
    sidebarItems,
    conclusion: t("excursion.sidebar.conclusion"),
    ctaTitle: t("excursion.sidebar.ctaTitle"),
    ctaDescription: t("excursion.sidebar.ctaDescription"),
    ctaPoint01: t("excursion.sidebar.ctaPoint01"),
    ctaPoint02: t("excursion.sidebar.ctaPoint02"),
    ctaPoint03: t("excursion.sidebar.ctaPoint03"),
  }}
  smTitle={t("excursion.detailsTitle")}
  title={title}
  transitionName={transitionName}
>
  <Fragment slot="content">
    <ExcursionSeoSections
      highlights={highlights}
      highlightsTitle={t("excursion.common.highlights")}
      metrics={metrics}
    />

    <section
      aria-labelledby="excursion-overview-heading"
      class="delay-300"
      data-animate="fade-up"
    >
      <hgroup>
        <p class="font-sans text-xs font-bold tracking-wider text-orange-700 uppercase dark:text-orange-400">
          {t("excursion.common.kickerAbout")}
        </p>
        <h3
          id="excursion-overview-heading"
          class="mbs-1 mbe-4 text-xl font-bold tracking-tight text-stone-900 sm:text-2xl md:text-3xl dark:text-mist-100"
        >
          {t("excursion.common.overview")}
        </h3>
      </hgroup>
      <div class="space-y-4">
        {overviewParagraphs.map((paragraph) => (
          <p class="font-sans text-sm sm:text-base leading-relaxed text-stone-700 dark:text-mist-200">{paragraph}</p>
        ))}
      </div>
    </section>

    {program.length > 0 && (
      <ExcursionProgram
        kicker={t("excursion.common.kickerSchedule")}
        program={program}
        programTitle={t("excursion.common.programTitle")}
      />
    )}

    <TripInfoSections
      idPrefix="excursion"
      excludedTitle={t("excursion.common.excluded")}
      excludes={excludes}
      goodToKnow={goodToKnow}
      goodToKnowTitle={t("excursion.common.goodToKnow")}
      includedTitle={t("excursion.common.included")}
      includes={includes}
    />

    <PricingCard
      idPrefix="excursion"
      pricingTitle={t("excursion.common.pricingTitle")}
      priceLabel={t("excursion.common.priceLabel")}
      price={price}
      reserveNow={t("booking.checkAvailability")}
    />

    {faqs.length > 0 && (
      <FaqAccordion
        idPrefix="excursion"
        faqTitle={t("excursion.common.faqTitle")}
        faqs={faqs}
      />
    )}
  </Fragment>
  <slot />
</TripLayout>
