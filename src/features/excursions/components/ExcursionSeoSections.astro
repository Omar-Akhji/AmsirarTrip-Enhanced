---
import ClockCircleIcon from "@/shared/ui/icons/ClockCircleIcon.astro";
import MapPointWaveIcon from "@/shared/ui/icons/MapPointWaveIcon.astro";
import MountainIcon from "@/shared/ui/icons/MountainIcon.astro";
import RouteIcon from "@/shared/ui/icons/RouteIcon.astro";
import HighlightsList from "@/shared/ui/widgets/HighlightsList.astro";

interface Props {
  readonly metrics: {
    readonly distance: string;
    readonly duration: string;
    readonly pickup: string;
    readonly elevation: string;
  };
  readonly highlights: readonly string[];
  readonly highlightsTitle: string;
}

const { metrics, highlights, highlightsTitle } = Astro.props;
---

<div
  class="delay-150"
  data-animate="fade-up"
>
  <dl class="m-0 p-0 grid grid-cols-1 gap-3 sm:gap-4 sm:grid-cols-2">
    <div
      class="flex items-center gap-3.5 rounded-2xl border border-stone-200/90 bg-white px-4 py-3 sm:px-5 sm:py-3.5 shadow-2xs transition-colors hover:border-stone-300 min-block-20"
      data-ascii="surface"
    >
      <RouteIcon
        aria-hidden="true"
        class="size-5 shrink-0 text-orange-600"
      />
      <div class="text-start min-w-0">
        <dt class="font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase">
          Distance
        </dt>
        <dd class="m-0 font-mono text-xs sm:text-sm font-bold text-stone-900 leading-snug">
          {metrics.distance}
        </dd>
      </div>
    </div>

    <div
      class="flex items-center gap-3.5 rounded-2xl border border-stone-200/90 bg-white px-4 py-3 sm:px-5 sm:py-3.5 shadow-2xs transition-colors hover:border-stone-300 min-block-20"
      data-ascii="surface"
    >
      <ClockCircleIcon
        aria-hidden="true"
        class="size-5 shrink-0 text-orange-600"
      />
      <div class="text-start min-w-0">
        <dt class="font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase">
          Duration
        </dt>
        <dd class="m-0 font-mono text-xs sm:text-sm font-bold text-stone-900 leading-snug">
          {metrics.duration}
        </dd>
      </div>
    </div>

    <div
      class="flex items-center gap-3.5 rounded-2xl border border-stone-200/90 bg-white px-4 py-3 sm:px-5 sm:py-3.5 shadow-2xs transition-colors hover:border-stone-300 min-block-20"
      data-ascii="surface"
    >
      <MapPointWaveIcon
        aria-hidden="true"
        class="size-5 shrink-0 text-orange-600"
      />
      <div class="text-start min-w-0">
        <dt class="font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase">
          Pickup Window
        </dt>
        <dd class="m-0 font-mono text-xs sm:text-sm font-bold text-stone-900 leading-snug">
          {metrics.pickup}
        </dd>
      </div>
    </div>

    <div
      class="flex items-center gap-3.5 rounded-2xl border border-stone-200/90 bg-white px-4 py-3 sm:px-5 sm:py-3.5 shadow-2xs transition-colors hover:border-stone-300 min-block-20"
      data-ascii="surface"
    >
      <MountainIcon
        aria-hidden="true"
        class="size-5 shrink-0 text-orange-600"
      />
      <div class="text-start min-w-0">
        <dt class="font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase">
          Elevation / Setting
        </dt>
        <dd class="m-0 font-mono text-xs sm:text-sm font-bold text-stone-900 leading-snug">
          {metrics.elevation}
        </dd>
      </div>
    </div>
  </dl>
</div>

<HighlightsList
  idPrefix="excursion"
  highlightsTitle={highlightsTitle}
  highlights={highlights}
/>
