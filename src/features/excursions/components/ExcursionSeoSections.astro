---
import ClockCircleIcon from "@/shared/ui/icons/ClockCircleIcon.astro";
import MapPointWaveIcon from "@/shared/ui/icons/MapPointWaveIcon.astro";
import MountainIcon from "@/shared/ui/icons/MountainIcon.astro";
import RouteIcon from "@/shared/ui/icons/RouteIcon.astro";
import HighlightsList from "@/shared/ui/widgets/HighlightsList.astro";

interface Props {
  readonly metrics: {
    readonly distance: string;
    readonly duration: string;
    readonly pickup: string;
    readonly elevation: string;
  };
  readonly highlights: readonly string[];
  readonly highlightsTitle: string;
}

const { metrics, highlights, highlightsTitle } = Astro.props;
---

<div
  class="delay-150"
  data-animate="fade-up"
>
  <dl class="m-0 p-0 grid grid-cols-1 gap-3 sm:gap-4 sm:grid-cols-2">
    <div class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-3.5 rounded-2xl border border-stone-200/90 bg-white px-4 py-3 sm:px-5 sm:py-3.5 shadow-2xs transition-colors hover:border-stone-300 min-block-20 dark:border-white/10 dark:bg-surface-card/85 dark:hover:border-white/20">
      <dt class="contents">
        <RouteIcon
          aria-hidden="true"
          class="col-start-1 row-start-1 row-span-2 size-5 shrink-0 self-center text-orange-600"
        />
        <span class="col-start-2 row-start-1 font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase dark:text-mist-400">
          Distance
        </span>
      </dt>
      <dd class="m-0 col-start-2 row-start-2 font-mono text-xs sm:text-sm font-bold text-stone-900 leading-snug dark:text-mist-100">
        {metrics.distance}
      </dd>
    </div>

    <div class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-3.5 rounded-2xl border border-stone-200/90 bg-white px-4 py-3 sm:px-5 sm:py-3.5 shadow-2xs transition-colors hover:border-stone-300 min-block-20 dark:border-white/10 dark:bg-surface-card/85 dark:hover:border-white/20">
      <dt class="contents">
        <ClockCircleIcon
          aria-hidden="true"
          class="col-start-1 row-start-1 row-span-2 size-5 shrink-0 self-center text-orange-600"
        />
        <span class="col-start-2 row-start-1 font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase dark:text-mist-400">
          Duration
        </span>
      </dt>
      <dd class="m-0 col-start-2 row-start-2 font-mono text-xs sm:text-sm font-bold text-stone-900 leading-snug dark:text-mist-100">
        {metrics.duration}
      </dd>
    </div>

    <div class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-3.5 rounded-2xl border border-stone-200/90 bg-white px-4 py-3 sm:px-5 sm:py-3.5 shadow-2xs transition-colors hover:border-stone-300 min-block-20 dark:border-white/10 dark:bg-surface-card/85 dark:hover:border-white/20">
      <dt class="contents">
        <MapPointWaveIcon
          aria-hidden="true"
          class="col-start-1 row-start-1 row-span-2 size-5 shrink-0 self-center text-orange-600"
        />
        <span class="col-start-2 row-start-1 font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase dark:text-mist-400">
          Pickup Window
        </span>
      </dt>
      <dd class="m-0 col-start-2 row-start-2 font-mono text-xs sm:text-sm font-bold text-stone-900 leading-snug dark:text-mist-100">
        {metrics.pickup}
      </dd>
    </div>

    <div class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-3.5 rounded-2xl border border-stone-200/90 bg-white px-4 py-3 sm:px-5 sm:py-3.5 shadow-2xs transition-colors hover:border-stone-300 min-block-20 dark:border-white/10 dark:bg-surface-card/85 dark:hover:border-white/20">
      <dt class="contents">
        <MountainIcon
          aria-hidden="true"
          class="col-start-1 row-start-1 row-span-2 size-5 shrink-0 self-center text-orange-600"
        />
        <span class="col-start-2 row-start-1 font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase dark:text-mist-400">
          Elevation / Setting
        </span>
      </dt>
      <dd class="m-0 col-start-2 row-start-2 font-mono text-xs sm:text-sm font-bold text-stone-900 leading-snug dark:text-mist-100">
        {metrics.elevation}
      </dd>
    </div>
  </dl>
</div>

<HighlightsList
  idPrefix="excursion"
  highlightsTitle={highlightsTitle}
  highlights={highlights}
/>
