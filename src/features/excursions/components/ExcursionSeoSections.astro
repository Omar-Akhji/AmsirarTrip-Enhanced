---
import ClockCircleIcon from "@/shared/ui/icons/ClockCircleIcon.astro";
import MapPointWaveIcon from "@/shared/ui/icons/MapPointWaveIcon.astro";
import MountainIcon from "@/shared/ui/icons/MountainIcon.astro";
import RouteIcon from "@/shared/ui/icons/RouteIcon.astro";
import HighlightsList from "@/shared/ui/widgets/HighlightsList.astro";
import TripMetricTile from "@/shared/ui/widgets/TripMetricTile.astro";

interface Props {
  readonly distanceLabel: string;
  readonly durationLabel: string;
  readonly elevationLabel: string;
  readonly highlights: readonly string[];
  readonly highlightsKicker?: string | undefined;
  readonly highlightsTitle: string;
  readonly metrics: {
    readonly distance: string;
    readonly duration: string;
    readonly elevation: string;
    readonly pickup: string;
  };
  readonly pickupLabel: string;
}

const {
  metrics,
  highlights,
  highlightsTitle,
  highlightsKicker,
  distanceLabel,
  durationLabel,
  pickupLabel,
  elevationLabel,
} = Astro.props;
---

<div
  class="animate-delay-150"
  data-animate="focus-unblur"
>
  <dl class="m-0 p-0 grid grid-cols-1 gap-3 sm:gap-4 sm:grid-cols-2">
    <TripMetricTile
      compact={true}
      label={distanceLabel}
      value={metrics.distance}
    >
      <RouteIcon
        aria-hidden="true"
        class="col-start-1 row-start-1 row-span-2 size-5 shrink-0 self-center text-orange-600"
      />
    </TripMetricTile>

    <TripMetricTile
      compact={true}
      label={durationLabel}
      value={metrics.duration}
    >
      <ClockCircleIcon
        aria-hidden="true"
        class="col-start-1 row-start-1 row-span-2 size-5 shrink-0 self-center text-orange-600"
      />
    </TripMetricTile>

    <TripMetricTile
      compact={true}
      label={pickupLabel}
      value={metrics.pickup}
    >
      <MapPointWaveIcon
        aria-hidden="true"
        class="col-start-1 row-start-1 row-span-2 size-5 shrink-0 self-center text-orange-600"
      />
    </TripMetricTile>

    <TripMetricTile
      compact={true}
      label={elevationLabel}
      value={metrics.elevation}
    >
      <MountainIcon
        aria-hidden="true"
        class="col-start-1 row-start-1 row-span-2 size-5 shrink-0 self-center text-orange-600"
      />
    </TripMetricTile>
  </dl>
</div>

<HighlightsList
  highlights={highlights}
  highlightsTitle={highlightsTitle}
  idPrefix="excursion"
  kicker={highlightsKicker}
/>
