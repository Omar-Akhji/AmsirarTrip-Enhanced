---
import PointOnMapIcon from "@/shared/ui/icons/PointOnMapIcon.astro";

interface Stage {
  readonly time: string;
  readonly title: string;
  readonly location: string;
  readonly description: string;
}

interface Props {
  readonly program: readonly Stage[];
  readonly programTitle?: string | undefined;
  readonly kicker?: string | undefined;
}

const { program, programTitle = "Day Trip Schedule", kicker = "Schedule & Stops" } = Astro.props;
const STAGE_DELAYS = [
  "animate-delay-0",
  "animate-delay-80",
  "animate-delay-160",
  "animate-delay-240",
  "animate-delay-320",
  "animate-delay-400",
  "animate-delay-480",
  "animate-delay-560",
  "animate-delay-640",
  "animate-delay-720",
] as const;
---

<section
  aria-labelledby="excursion-itinerary-heading"
  class="animate-delay-450"
  data-animate="curtain-up"
>
  <hgroup class="mbe-8">
    <p class="font-sans text-xs font-bold tracking-wider text-orange-700 uppercase dark:text-orange-400">
      {kicker}
    </p>
    <h3
      id="excursion-itinerary-heading"
      class="mbs-1 text-xl font-bold tracking-tight text-stone-900 sm:text-2xl md:text-3xl dark:text-mist-100"
    >
      {programTitle}
    </h3>
  </hgroup>

  <ol
    role="list"
    class="itinerary-stages-list m-0 list-none p-0 space-y-8"
  >
    {program.map((stage, index) => (
      <li
        class:list={[STAGE_DELAYS[index] || "animate-delay-0"]}
        data-animate="step-unfold"
      >
        <div class="group relative">
          <div class="mbe-4 flex flex-wrap items-center gap-3">
            <span class="inline-flex items-center gap-2 rounded-full border-[1.5px] border-orange-500 bg-stone-100 px-4 py-1.5 font-mono text-xs font-bold tracking-[0.14em] text-stone-900 uppercase shadow-2xs dark:border-orange-400 dark:bg-white/10 dark:text-mist-100">
              <span class="size-1.5 rounded-full bg-orange-500"></span>
              {stage.time}
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-stone-200/90 bg-white px-3.5 py-1 font-mono text-xs font-semibold text-stone-800 shadow-2xs dark:border-white/10 dark:bg-surface-card dark:text-mist-100">
              <PointOnMapIcon
                aria-hidden="true"
                class="size-3.5 text-orange-600 shrink-0"
              />
              {stage.location}
            </span>
          </div>

          <div class="relative space-y-3 border-s-0 ps-0 sm:ms-5.5 sm:border-s sm:border-stone-200 sm:ps-8 dark:sm:border-white/10">
            <h4 class="text-base sm:text-lg font-bold text-stone-900 tracking-tight dark:text-mist-100">
              {stage.title}
            </h4>
            <p class="text-sm sm:text-base leading-relaxed text-stone-700 font-normal dark:text-mist-200">
              {stage.description}
            </p>
          </div>
        </div>
      </li>
    ))}
  </ol>
</section>
