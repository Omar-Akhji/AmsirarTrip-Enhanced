---
import { getEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import headerImg from "@/assets/images/Header/header-2.webp";
import { useTranslations } from "@/i18n/utils";
import {
  FAX_DISPLAY,
  FAX_LINK,
  PHONE_DISPLAY,
  PHONE_LINK,
  WHATSAPP_LINK,
} from "@/lib/constants/contact";
import PageHeader from "@/layouts/PageHeader.astro";
import Button from "@/shared/ui/primitives/Button.astro";
import CalendarIcon from "@/shared/ui/icons/CalendarIcon.astro";
import CompassIcon from "@/shared/ui/icons/CompassIcon.astro";
import CookieIcon from "@/shared/ui/icons/CookieIcon.astro";
import DocumentTextIcon from "@/shared/ui/icons/DocumentTextIcon.astro";
import LetterIcon from "@/shared/ui/icons/LetterIcon.astro";
import LibraIcon from "@/shared/ui/icons/LibraIcon.astro";
import MessageCircleIcon from "@/shared/ui/icons/MessageCircleIcon.astro";
import PhoneCallIcon from "@/shared/ui/icons/PhoneCallIcon.astro";
import PointOnMapIcon from "@/shared/ui/icons/PointOnMapIcon.astro";
import PrinterIcon from "@/shared/ui/icons/PrinterIcon.astro";
import ShieldCheckIcon from "@/shared/ui/icons/ShieldCheckIcon.astro";
import SparklesIcon from "@/shared/ui/icons/SparklesIcon.astro";
import VerifiedCheckIcon from "@/shared/ui/icons/VerifiedCheckIcon.astro";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

interface CookieRow {
  name: string;
  provider: string;
  category: string;
  categoryClass: string;
  purpose: string;
  lifespan: string;
}

interface PrivacyCopy {
  title: string;
  subtitle: string;
  lastUpdated: string;
  badgeDoc: string;
  badgeStatus: string;
  badgeJurisdiction: string;
  summaryTitle: string;
  summarySubtitle: string;
  summaryCards: { title: string; description: string }[];
  tocTitle: string;
  printLabel: string;
  agencyCard: { title: string; badge: string; hours: string; chatCta: string };
  cookieCta: { title: string; desc: string; buttonLabel: string };
  cookieTable: {
    title: string;
    subtitle: string;
    colName: string;
    colProvider: string;
    colCategory: string;
    colPurpose: string;
    colLifespan: string;
    rows: CookieRow[];
  };
  sections: {
    id: string;
    num: string;
    title: string;
    paragraphs: string[];
    callout?: { title: string; desc: string };
  }[];
}

const entry =
  (await getEntry("legal", `${locale}/privacy-policy`))
  ?? (await getEntry("legal", "en/privacy-policy"));
if (!entry) {
  throw new Error("Missing privacy-policy legal content");
}
const current = entry.data as unknown as PrivacyCopy;
---

<!-- 1. Hero Header with Authentic Moroccan Photography & Meta Badges -->
<PageHeader
  bgImage={headerImg}
  breadcrumbs={[{ label: t("nav.home"), href: "/" }, { label: current.title }]}
  gradientPosition="top-right"
  hasUnderline={true}
  headingId="privacy-policy-heading"
  subtitle={current.subtitle}
  title={current.title}
>
  <!-- Authority & Meta Badges Row -->
  <div class="flex flex-wrap items-center justify-center gap-2 pbs-2">
    <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1 text-xs font-mono font-medium text-white backdrop-blur-md">
      <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>{current.badgeStatus}</span>
    </div>
    <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1 text-xs font-mono font-medium text-white/90 backdrop-blur-md">
      <CalendarIcon
        aria-hidden="true"
        class="size-3.5 text-orange-300"
      />
      <time datetime="2026-01">{current.lastUpdated}</time>
    </div>
    <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1 text-xs font-mono font-medium text-white/90 backdrop-blur-md">
      <LibraIcon
        aria-hidden="true"
        class="size-3.5 text-orange-300"
      />
      <span>{current.badgeJurisdiction}</span>
    </div>
  </div>
</PageHeader>

<div class="relative bg-stone-50/70 text-slate-900 transition-colors print:bg-white print:text-black dark:bg-surface-base dark:text-mist-100">
  <!-- Subtle background texture -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(241,93,48,0.04),transparent_50%)]"
  ></div>

  <!-- 2. Executive Summary Bento (Anti-Slop Transparency Cards) -->
  <section
    aria-labelledby="privacy-summary-heading"
    class="relative z-10 border-be border-stone-200/80 bg-white py-12 lg:py-16 dark:border-white/10 dark:bg-surface-base"
  >
    <div class="mx-auto max-w-7xl 2xl:max-w-360 3xl:max-w-420 px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <div class="flex items-center gap-2">
          <SparklesIcon
            aria-hidden="true"
            class="size-4 text-orange-600"
          />
          <span class="font-mono text-xs font-semibold tracking-wider text-orange-600 uppercase">
            // {current.badgeDoc}
          </span>
        </div>
        <h2
          class="mbs-2 text-2xl font-bold tracking-tight text-slate-900 dark:text-mist-100 sm:text-3xl"
          id="privacy-summary-heading"
        >
          {current.summaryTitle}
        </h2>
        <p class="mbs-2 text-sm text-slate-600 dark:text-mist-300 sm:text-base leading-relaxed">
          {current.summarySubtitle}
        </p>
      </div>

      <div class="mbs-8 grid grid-cols-1 gap-4 xs:grid-cols-2 lg:grid-cols-4 2xl:gap-6">
        {current.summaryCards.map((card, idx) => (
          <div class="group relative flex flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/60 p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-orange-500/30 hover:bg-white hover:shadow-lg hover:shadow-orange-500/5 dark:border-white/10 dark:bg-surface-card/75 dark:shadow-[0_4px_20px_-2px_rgba(0,0,0,0.4)] dark:hover:border-white/20 dark:hover:bg-surface-hover/90">
            <div>
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs font-bold text-orange-600">0{idx + 1}</span>
              </div>
              <h3 class="mbs-3 text-base font-bold text-slate-900 dark:text-mist-100 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">
                {card.title}
              </h3>
              <p class="mbs-2 text-xs leading-relaxed text-slate-600 dark:text-mist-300 sm:text-sm">
                {card.description}
              </p>
            </div>
            <div class="mbs-4 pbs-3 border-bs border-stone-200/60 dark:border-white/10 flex items-center gap-2 text-xs font-medium text-slate-500 dark:text-mist-400">
              <VerifiedCheckIcon class="size-4 text-emerald-600" />
              <span>Verified Policy</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Two-Column Swiss Editorial Layout -->
  <div class="relative z-10 mx-auto max-w-7xl 2xl:max-w-360 3xl:max-w-420 px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-golden-rev lg:gap-8 xl:gap-8">
      <!-- STICKY SIDEBAR (TOC + AGENCY CARD + ACTIONS) -->
      <aside class="print:hidden">
        <div class="sticky top-24 space-y-4">
          <!-- Table of Contents Card -->
          <nav
            aria-label={current.tocTitle}
            class="rounded-2xl border border-stone-200/90 bg-white p-4 sm:p-5 shadow-sm dark:border-white/10 dark:bg-surface-card/85 dark:shadow-[0_4px_20px_-2px_rgba(0,0,0,0.4)]"
          >
            <div class="flex items-center justify-between border-be border-stone-200/80 dark:border-white/10 pbe-3">
              <div class="flex items-center gap-2">
                <DocumentTextIcon
                  aria-hidden="true"
                  class="size-4 text-orange-600"
                />
                <h3 class="font-mono text-xs font-bold tracking-wider text-slate-900 dark:text-mist-100 uppercase">
                  {current.tocTitle}
                </h3>
              </div>
              <span class="rounded-full bg-stone-100 dark:bg-white/10 px-2 py-1 font-mono text-[11px] font-semibold text-slate-600 dark:text-mist-300">
                0{current.sections.length}
              </span>
            </div>

            <ul
              class="mbs-3 flex flex-col gap-0.5 text-xs sm:text-sm font-medium"
              id="privacy-toc-list"
            >
              {current.sections.map((sec, idx) => (
                <li>
                  <a
                    class="group flex items-center rounded-full px-3 py-2 text-slate-600 dark:text-mist-300 transition-all duration-150 hover:bg-orange-500/5 hover:text-orange-600 dark:hover:bg-white/10 dark:hover:text-yellow data-[active=true]:bg-orange-500/10 data-[active=true]:font-semibold data-[active=true]:text-orange-600 dark:data-[active=true]:bg-white/10 dark:data-[active=true]:text-yellow"
                    data-section-id={sec.id}
                    href={`#${sec.id}`}
                  >
                    <span class="flex items-center gap-2 truncate min-w-0">
                      <span class="shrink-0 whitespace-nowrap font-mono text-xs font-bold text-slate-400 group-hover:text-orange-600 group-data-[active=true]:text-orange-600 dark:text-mist-400 dark:group-hover:text-yellow dark:group-data-[active=true]:text-yellow">
                        {String(idx + 1).padStart(2, "0")}
                      </span>
                      <span class="truncate">{sec.title}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>

            <div class="mbs-3 pbs-3 border-bs border-stone-200/80 dark:border-white/10">
              <Button
                variant="outline"
                size="sm"
                class="w-full bg-stone-50 text-slate-700 hover:bg-stone-100 dark:bg-white/5 dark:text-mist-200 dark:hover:bg-white/10 dark:border-white/10"
                id="privacy-print-btn"
                type="button"
              >
                <PrinterIcon
                  aria-hidden="true"
                  class="size-3.5 text-slate-500 dark:text-mist-400"
                />
                <span>{current.printLabel}</span>
              </Button>
            </div>
          </nav>

          <!-- Direct Agency Credentials & Support Card -->
          <div class="overflow-hidden rounded-2xl border border-white/10 bg-slate-950 p-5 text-white shadow-xl ring-1 ring-white/10">
            <div class="flex items-center gap-2">
              <ShieldCheckIcon
                aria-hidden="true"
                class="size-4 text-orange-400"
              />
              <span class="font-mono text-xs font-semibold tracking-wider text-orange-400 uppercase">
                {current.agencyCard.badge}
              </span>
            </div>

            <h4 class="mbs-2 text-base font-bold text-white sm:text-lg">
              {current.agencyCard.title}
            </h4>
            <p class="mbs-1 text-xs text-zinc-400">{current.agencyCard.hours}</p>

            <div class="mbs-4 flex flex-col gap-3 border-bs border-white/10 pbs-3 text-xs text-zinc-300">
              <div class="flex items-start gap-3">
                <PointOnMapIcon class="size-4 shrink-0 text-orange-400 mbs-0.5" />
                <span class="leading-relaxed">
                  APT 5 RDC IMM J RES PERLE DE L'ATLAS QI MARRAKECH
                </span>
              </div>
              <div class="flex items-start gap-3 font-mono text-[11px] text-zinc-400">
                <DocumentTextIcon class="size-4 shrink-0 text-orange-400 mbs-0.5" />
                <div class="flex flex-col gap-0.5">
                  <span>ICE: 001627534000007</span>
                  <span>IF: 6520387 &bull; RC: 25397 (Marrakech)</span>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <LetterIcon
                  aria-hidden="true"
                  class="size-4 shrink-0 text-orange-400"
                />
                <a
                  class="hover:text-white transition-colors"
                  href="mailto:amsirare@gmail.com"
                >
                  amsirare@gmail.com
                </a>
              </div>
              <div class="flex items-start gap-3">
                <PhoneCallIcon
                  aria-hidden="true"
                  class="size-4 shrink-0 text-orange-400 mbs-0.5"
                />
                <div class="flex flex-col gap-0.5">
                  <a
                    class="hover:text-white transition-colors"
                    href={PHONE_LINK}
                  >
                    {PHONE_DISPLAY} (Mobile)
                  </a>
                  <a
                    class="text-zinc-400 hover:text-white transition-colors"
                    href={FAX_LINK}
                  >
                    {FAX_DISPLAY} (Fax)
                  </a>
                </div>
              </div>
            </div>

            <div class="mbs-4 pbs-2">
              <a
                class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-full bg-linear-to-br from-amber-orange to-orange px-4 py-3 font-mono text-xs font-semibold text-white shadow-md shadow-orange/20 transition-all duration-150 hover:brightness-105 active:scale-[0.98]"
                href={WHATSAPP_LINK}
                rel="noopener noreferrer"
                target="_blank"
              >
                <MessageCircleIcon
                  aria-hidden="true"
                  class="size-4"
                />
                <span>{current.agencyCard.chatCta}</span>
              </a>
            </div>
          </div>
        </div>
      </aside>

      <!-- MAIN CONTENT COLUMN -->
      <article class="space-y-6 print:w-full">
        {current.sections.map((sec, idx) => (
          <section
            aria-labelledby={`heading-${sec.id}`}
            class="relative rounded-2xl border border-stone-200/90 bg-white p-6 sm:p-8 shadow-sm transition-all duration-200 hover:border-stone-300 print:border-none print:shadow-none print:break-inside-avoid"
            id={sec.id}
          >
            <!-- Section Header -->
            <div class="border-be border-stone-200/80 pbe-4">
              <div class="flex items-center gap-3">
                <span class="flex shrink-0 whitespace-nowrap items-center justify-center rounded-full bg-orange-500/10 px-2 py-1 font-mono text-xs font-bold text-orange-600">
                  {String(idx + 1).padStart(2, "0")}
                </span>
                <h2
                  class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl"
                  id={`heading-${sec.id}`}
                >
                  {sec.title}
                </h2>
              </div>
            </div>

            <!-- Paragraphs -->
            <div class="mbs-6 flex flex-col gap-4 text-sm leading-relaxed text-slate-700 sm:text-base">
              {sec.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </div>

            <!-- Callout if defined -->
            {sec.callout && (
              <div class="mbs-6 rounded-2xl border border-orange-500/20 bg-orange-500/5 p-4 sm:p-5 dark:border-orange-500/30 dark:bg-orange-950/20">
                <div class="flex items-start gap-4">
                  <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-orange-500/10 text-orange-600 dark:bg-orange-500/20 dark:text-orange-400">
                    <ShieldCheckIcon
                      aria-hidden="true"
                      class="size-4.5"
                    />
                  </div>
                  <div>
                    <h4 class="text-sm font-bold text-slate-900 dark:text-mist-100">
                      {sec.callout.title}
                    </h4>
                    <p class="mbs-1 text-xs sm:text-sm text-slate-700 dark:text-mist-300 leading-relaxed">
                      {sec.callout.desc}
                    </p>
                  </div>
                </div>
              </div>
            )}

            <!-- Interactive Cookie Preference CTA Box (Section 03) -->
            {sec.id === "cookies" && (
              <div class="mbs-6 rounded-2xl border border-stone-200 bg-stone-50/80 p-5 sm:p-6 transition-colors hover:border-orange-500/30">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                  <div class="flex items-start gap-4">
                    <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-orange-500/10 text-orange-600">
                      <CookieIcon
                        aria-hidden="true"
                        class="size-4.5"
                      />
                    </div>
                    <div>
                      <h4 class="text-sm font-bold text-slate-900">{current.cookieCta.title}</h4>
                      <p class="mbs-1 text-xs sm:text-sm text-slate-600 leading-relaxed max-w-md">
                        {current.cookieCta.desc}
                      </p>
                    </div>
                  </div>
                  <Button
                    variant="primary"
                    size="md"
                    class="text-xs uppercase tracking-wider"
                    data-open-cookie-settings
                    type="button"
                  >
                    <span>{current.cookieCta.buttonLabel}</span>
                  </Button>
                </div>
              </div>
            )}

            <!-- Dedicated Cookie Inventory Table (Section 04) -->
            {sec.id === "inventory" && (
              <div class="mbs-6 flex flex-col gap-4 pbs-4 border-bs border-stone-200/80">
                <div>
                  <h3 class="text-base font-bold text-slate-900 sm:text-lg">
                    {current.cookieTable.title}
                  </h3>
                  <p class="mbs-1 text-xs text-slate-600 sm:text-sm">
                    {current.cookieTable.subtitle}
                  </p>
                </div>

                <!-- Responsive Mobile Cards (< sm) -->
                <div class="sm:hidden flex flex-col gap-3">
                  {current.cookieTable.rows.map((row) => (
                    <div class="rounded-xl border border-stone-200 bg-stone-50/60 p-4 transition-colors hover:border-orange-500/30 hover:bg-white">
                      <div class="flex items-start justify-between gap-2 border-be border-stone-200/60 pbe-3">
                        <span class="font-mono text-xs font-bold text-slate-900 break-all">
                          {row.name}
                        </span>
                        <span
                          class:list={[
                            "inline-block shrink-0 rounded-full border px-2 py-1 font-mono text-[10px] font-bold",
                            row.categoryClass,
                          ]}
                        >
                          {row.category}
                        </span>
                      </div>
                      <p class="mbs-3 text-xs leading-relaxed text-slate-600">{row.purpose}</p>
                      <div class="mbs-3 flex items-center justify-between border-bs border-stone-200/60 pbs-2 text-[11px] text-slate-500">
                        <span class="font-medium text-slate-700">{row.provider}</span>
                        <span class="font-mono text-slate-500">{row.lifespan}</span>
                      </div>
                    </div>
                  ))}
                </div>

                <!-- Balanced Desktop / Tablet Table (>= sm) -->
                <div class="hidden sm:block overflow-x-auto rounded-xl border border-stone-200 bg-white shadow-xs">
                  <table class="w-full text-left text-xs sm:text-sm">
                    <caption class="sr-only">
                      {locale === "fr" ?
                        "Inventaire des cookies et traceurs utilisés"
                      : locale === "es" ?
                        "Inventario de cookies y rastreadores"
                      : locale === "de" ?
                        "Übersicht der verwendeten Cookies"
                      : "Cookie and tracking technologies inventory"}
                    </caption>
                    <thead class="border-be border-stone-200 bg-stone-50 font-mono text-xs font-semibold text-slate-700">
                      <tr>
                        <th
                          class="w-[20%] min-w-35 px-4 py-3"
                          scope="col"
                        >
                          {current.cookieTable.colName}
                        </th>
                        <th
                          class="w-[17%] min-w-31.25 px-4 py-3"
                          scope="col"
                        >
                          {current.cookieTable.colProvider}
                        </th>
                        <th
                          class="w-[16%] min-w-30 px-4 py-3"
                          scope="col"
                        >
                          {current.cookieTable.colCategory}
                        </th>
                        <th
                          class="w-[36%] min-w-60 px-4 py-3"
                          scope="col"
                        >
                          {current.cookieTable.colPurpose}
                        </th>
                        <th
                          class="w-[11%] min-w-20 px-4 py-3"
                          scope="col"
                        >
                          {current.cookieTable.colLifespan}
                        </th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-stone-100 text-slate-700">
                      {current.cookieTable.rows.map((row) => (
                        <tr class="transition-colors hover:bg-stone-50/60">
                          <td class="px-4 py-3 font-mono text-xs font-bold text-slate-900 break-all sm:break-normal">
                            {row.name}
                          </td>
                          <td class="px-4 py-3 text-xs text-slate-600">{row.provider}</td>
                          <td class="px-4 py-3">
                            <span
                              class:list={[
                                "inline-block rounded-full border px-2 py-1 font-mono text-[11px] font-bold whitespace-nowrap",
                                row.categoryClass,
                              ]}
                            >
                              {row.category}
                            </span>
                          </td>
                          <td class="px-4 py-3 text-xs leading-relaxed text-slate-600">
                            {row.purpose}
                          </td>
                          <td class="px-4 py-3 font-mono text-xs text-slate-500 whitespace-nowrap">
                            {row.lifespan}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            <!-- Section 08: Direct Contact Action Grid -->
            {sec.id === "contact" && (
              <div class="mbs-8 pbs-6 border-bs border-stone-200/80">
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                  <a
                    class="group/contact flex items-center justify-center gap-3 rounded-full border border-stone-200 bg-stone-50 px-4 py-3 text-center transition-all duration-150 hover:border-orange-500 hover:bg-orange-500/5 active:scale-[0.98]"
                    href={PHONE_LINK}
                  >
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-orange-500/10 text-orange-600 group-hover/contact:bg-orange-500 group-hover/contact:text-white transition-colors">
                      <PhoneCallIcon
                        aria-hidden="true"
                        class="size-4"
                      />
                    </div>
                    <div class="text-left">
                      <span class="block text-xs font-bold text-slate-900 group-hover/contact:text-orange-600 transition-colors">
                        Telephone
                      </span>
                      <span class="block font-mono text-[11px] text-slate-600">
                        {PHONE_DISPLAY}
                      </span>
                    </div>
                  </a>

                  <a
                    class="group/contact flex items-center justify-center gap-3 rounded-full border border-stone-200 bg-stone-50 px-4 py-3 text-center transition-all duration-150 hover:border-orange-500 hover:bg-orange-500/5 active:scale-[0.98]"
                    href="mailto:amsirare@gmail.com"
                  >
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-orange-500/10 text-orange-600 group-hover/contact:bg-orange-500 group-hover/contact:text-white transition-colors">
                      <LetterIcon
                        aria-hidden="true"
                        class="size-4"
                      />
                    </div>
                    <div class="text-left">
                      <span class="block text-xs font-bold text-slate-900 group-hover/contact:text-orange-600 transition-colors">
                        Email Us
                      </span>
                      <span class="block font-mono text-[11px] text-slate-600">
                        amsirare@gmail.com
                      </span>
                    </div>
                  </a>

                  <a
                    class="group/contact flex items-center justify-center gap-3 rounded-full border border-stone-200 bg-stone-50 px-4 py-3 text-center transition-all duration-150 hover:border-emerald-500 hover:bg-emerald-500/5 active:scale-[0.98]"
                    href={WHATSAPP_LINK}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 group-hover/contact:bg-emerald-600 group-hover/contact:text-white transition-colors">
                      <MessageCircleIcon
                        aria-hidden="true"
                        class="size-4"
                      />
                    </div>
                    <div class="text-left">
                      <span class="block text-xs font-bold text-slate-900 group-hover/contact:text-emerald-700 transition-colors">
                        WhatsApp
                      </span>
                      <span class="block font-mono text-[11px] text-emerald-700">Chat Now</span>
