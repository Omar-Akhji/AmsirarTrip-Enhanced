---
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import headerImg from "@/assets/images/Header/header-2.webp";
import agencyProfile from "@/data/agency-profile.json";
import { useTranslations } from "@/i18n/utils";
import PageHeader from "@/layouts/PageHeader.astro";
import {
  FAX_DISPLAY,
  FAX_LINK,
  PHONE_DISPLAY,
  PHONE_LINK,
  WHATSAPP_LINK,
} from "@/lib/constants/contact";
import CalendarIcon from "@/shared/ui/icons/CalendarIcon.astro";
import CompassIcon from "@/shared/ui/icons/CompassIcon.astro";
import CookieIcon from "@/shared/ui/icons/CookieIcon.astro";
import DangerCircleIcon from "@/shared/ui/icons/DangerCircleIcon.astro";
import DocumentTextIcon from "@/shared/ui/icons/DocumentTextIcon.astro";
import LetterIcon from "@/shared/ui/icons/LetterIcon.astro";
import LibraIcon from "@/shared/ui/icons/LibraIcon.astro";
import MessageCircleIcon from "@/shared/ui/icons/MessageCircleIcon.astro";
import PhoneCallIcon from "@/shared/ui/icons/PhoneCallIcon.astro";
import PointOnMapIcon from "@/shared/ui/icons/PointOnMapIcon.astro";
import PrinterIcon from "@/shared/ui/icons/PrinterIcon.astro";
import ShieldCheckIcon from "@/shared/ui/icons/ShieldCheckIcon.astro";
import SparklesIcon from "@/shared/ui/icons/SparklesIcon.astro";
import VerifiedCheckIcon from "@/shared/ui/icons/VerifiedCheckIcon.astro";
import Button from "@/shared/ui/primitives/Button.astro";

interface Props {
  readonly doc: "privacy-policy" | "terms-of-service";
}

const { doc } = Astro.props;
const locale = Astro.locals.locale;
const t = useTranslations(locale);

const entry =
  (await getEntry("legal", `${locale}/${doc}`)) ?? (await getEntry("legal", `en/${doc}`));
if (!entry) {
  throw new Error(`Missing ${doc} legal content`);
}

const current: CollectionEntry<"legal">["data"] = entry.data;
const isPrivacy = doc === "privacy-policy";
const primaryEmail = agencyProfile.contact.emails[0] ?? "amsirare@gmail.com";
const sectionCount = String(current.sections.length).padStart(2, "0");
---

<PageHeader
  bgImage={headerImg}
  breadcrumbs={[{ label: t("nav.home"), href: "/" }, { label: current.title }]}
  gradientPosition="top-right"
  hasUnderline={true}
  headingId={`${doc}-heading`}
  subtitle={current.subtitle}
  title={current.title}
>
  <div class="flex flex-wrap items-center justify-center gap-2 pbs-2">
    <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1 font-mono text-xs font-medium text-white backdrop-blur-md">
      <span class="size-2 animate-pulse rounded-full bg-emerald-400"></span>
      <span>{current.badgeStatus}</span>
    </div>
    <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1 font-mono text-xs font-medium text-white/90 backdrop-blur-md">
      <CalendarIcon
        aria-hidden="true"
        class="size-3.5 text-orange-300"
      />
      <time datetime="2026-01">{current.lastUpdated}</time>
    </div>
    <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1 font-mono text-xs font-medium text-white/90 backdrop-blur-md">
      <LibraIcon
        aria-hidden="true"
        class="size-3.5 text-orange-300"
      />
      <span>{current.badgeJurisdiction}</span>
    </div>
  </div>
</PageHeader>

<div class="relative bg-stone-50/70 text-slate-900 transition-colors print:bg-white print:text-black dark:bg-surface-base dark:text-mist-100">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(241,93,48,0.04),transparent_50%)]"
  ></div>

  <section
    aria-labelledby={`${doc}-summary-heading`}
    class="relative z-10 border-be border-stone-200/80 bg-white py-12 lg:py-16 dark:border-white/10 dark:bg-surface-base"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 2xl:max-w-360 3xl:max-w-420">
      <div class="max-w-2xl">
        <div class="flex items-center gap-2">
          <SparklesIcon
            aria-hidden="true"
            class="size-4 text-orange-700 dark:text-orange-400"
          />
          <span class="font-mono text-xs font-semibold tracking-wider text-orange-700 uppercase dark:text-orange-400">
            // {current.badgeDoc}
          </span>
        </div>
        <h2
          class="mbs-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-mist-100"
          id={`${doc}-summary-heading`}
        >
          {current.summaryTitle}
        </h2>
        <p class="mbs-2 text-sm/relaxed text-slate-600 sm:text-base dark:text-mist-300">
          {current.summarySubtitle}
        </p>
      </div>

      <div class="mbs-8 grid grid-cols-1 gap-4 xs:grid-cols-2 lg:grid-cols-4 2xl:gap-6">
        {current.summaryCards.map((card, idx) => (
          <div class="group relative flex flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/60 p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-orange-500/30 hover:bg-white hover:shadow-lg hover:shadow-orange-500/5 dark:border-white/10 dark:bg-surface-card/75 dark:shadow-[0_4px_20px_-2px_rgba(0,0,0,0.4)] dark:hover:border-white/20 dark:hover:bg-surface-hover/90">
            <div>
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs font-bold text-orange-700 dark:text-orange-400">
                  0{idx + 1}
                </span>
              </div>
              <h3 class="mbs-3 text-base font-bold text-slate-900 transition-colors group-hover:text-orange-600 dark:text-mist-100 dark:group-hover:text-orange-400">
                {card.title}
              </h3>
              <p class="mbs-2 text-xs/relaxed text-slate-600 sm:text-sm dark:text-mist-300">
                {card.description}
              </p>
            </div>
            <div class="mbs-4 flex items-center gap-2 border-bs border-stone-200/60 pbs-3 text-xs font-medium text-slate-600 dark:border-white/10 dark:text-mist-300">
              <VerifiedCheckIcon class="size-4 text-emerald-600" />
              <span>{t("legal.ui.verifiedPolicy")}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="relative z-10 mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16 2xl:max-w-360 3xl:max-w-420">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-golden-rev lg:gap-8 xl:gap-8">
      <aside class="print:hidden">
        <div class="sticky top-24 space-y-4">
          <nav
            aria-label={current.tocTitle}
            class="rounded-2xl border border-stone-200/90 bg-white p-4 shadow-sm sm:p-5 dark:border-white/10 dark:bg-surface-card/85 dark:shadow-[0_4px_20px_-2px_rgba(0,0,0,0.4)]"
          >
            <div class="flex items-center justify-between border-be border-stone-200/80 pbe-3 dark:border-white/10">
              <div class="flex items-center gap-2">
                <DocumentTextIcon
                  aria-hidden="true"
                  class="size-4 text-orange"
                />
                <h3 class="font-mono text-xs font-bold tracking-wider text-slate-900 uppercase dark:text-mist-100">
                  {current.tocTitle}
                </h3>
              </div>
              <span class="rounded-full bg-stone-100 px-2 py-1 font-mono text-[0.6875rem] font-semibold text-slate-600 dark:bg-white/10 dark:text-mist-300">
                {sectionCount}
              </span>
            </div>

            <ul
              class="mbs-3 flex flex-col gap-0.5 text-xs font-medium sm:text-sm"
              id="legal-toc-list"
            >
              {current.sections.map((sec, idx) => (
                <li>
                  <a
                    class="group flex items-center rounded-full px-3 py-2 text-slate-600 transition-all duration-150 hover:bg-orange/5 hover:text-orange data-[active=true]:bg-orange/10 data-[active=true]:font-semibold data-[active=true]:text-orange dark:text-mist-300 dark:hover:bg-white/10 dark:hover:text-yellow dark:data-[active=true]:bg-white/10 dark:data-[active=true]:text-yellow"
                    data-section-id={sec.id}
                    href={`#${sec.id}`}
                  >
                    <span class="flex min-w-0 items-center gap-2 truncate">
                      <span class="shrink-0 font-mono text-xs font-bold whitespace-nowrap text-slate-600 group-hover:text-orange group-data-[active=true]:text-orange dark:text-mist-300 dark:group-hover:text-yellow dark:group-data-[active=true]:text-yellow">
                        {String(idx + 1).padStart(2, "0")}
                      </span>
                      <span class="truncate">{sec.title}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>

            <div class="mbs-3 border-bs border-stone-200/80 pbs-3 dark:border-white/10">
              <Button
                class="w-full bg-stone-50 text-slate-700 hover:bg-stone-100 dark:border-white/10 dark:bg-white/5 dark:text-mist-200 dark:hover:bg-white/10"
                id="legal-print-btn"
                size="sm"
                type="button"
                variant="outline"
              >
                <PrinterIcon
                  aria-hidden="true"
                  class="size-3.5 text-slate-500 dark:text-mist-400"
                />
                <span>{current.printLabel}</span>
              </Button>
            </div>
          </nav>

          <div class="overflow-hidden rounded-2xl border border-white/10 bg-slate-950 p-5 text-white shadow-xl ring-1 ring-white/10">
            <div class="flex items-center gap-2">
              <ShieldCheckIcon
                aria-hidden="true"
                class="size-4 text-orange-400"
              />
              <span class="font-mono text-xs font-semibold tracking-wider text-orange-400 uppercase">
                {current.agencyCard.badge}
              </span>
            </div>

            <h4 class="mbs-2 text-base font-bold text-white sm:text-lg">
              {current.agencyCard.title}
            </h4>
            <p class="mbs-1 text-xs text-zinc-400">{current.agencyCard.hours}</p>

            <div class="mbs-4 flex flex-col gap-3 border-bs border-white/10 pbs-3 text-xs text-zinc-300">
              <div class="flex items-start gap-3">
                <PointOnMapIcon class="mbs-0.5 size-4 shrink-0 text-orange-400" />
                <span class="leading-relaxed">{agencyProfile.address.fullAddress}</span>
              </div>
              <div class="flex items-start gap-3 font-mono text-[0.6875rem] text-zinc-400">
                <DocumentTextIcon class="mbs-0.5 size-4 shrink-0 text-orange-400" />
                <div class="flex flex-col gap-0.5">
                  <span>ICE: {agencyProfile.ice}</span>
                  <span>
                    IF: {agencyProfile.if} &bull; RC: {agencyProfile.rcNumber} (
                    {agencyProfile.address.addressLocality})
                  </span>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <LetterIcon
                  aria-hidden="true"
                  class="size-4 shrink-0 text-orange-400"
                />
                <a
                  class="transition-colors hover:text-white"
                  href={`mailto:${primaryEmail}`}
                >
                  {primaryEmail}
                </a>
              </div>
              <div class="flex items-start gap-3">
                <PhoneCallIcon
                  aria-hidden="true"
                  class="mbs-0.5 size-4 shrink-0 text-orange-400"
                />
                <div class="flex flex-col gap-0.5">
                  <a
                    class="transition-colors hover:text-white"
                    href={PHONE_LINK}
                  >
                    {PHONE_DISPLAY} ({t("legal.ui.mobile")})
                  </a>
                  <a
                    class="text-zinc-400 transition-colors hover:text-white"
                    href={FAX_LINK}
                  >
                    {FAX_DISPLAY} ({t("legal.ui.fax")})
                  </a>
                </div>
              </div>
            </div>

            <div class="mbs-4 pbs-2">
              <a
                class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-full bg-linear-to-br from-amber-orange to-orange px-4 py-3 font-mono text-xs font-semibold text-white shadow-md shadow-orange/20 transition-all duration-150 hover:brightness-105 active:scale-[0.98]"
                href={WHATSAPP_LINK}
                rel="noopener noreferrer"
                target="_blank"
              >
                <MessageCircleIcon
                  aria-hidden="true"
                  class="size-4"
                />
                <span>{current.agencyCard.chatCta}</span>
              </a>
            </div>
          </div>
        </div>
      </aside>

      <article class="space-y-6 print:w-full">
        {current.sections.map((sec, idx) => (
          <section
            aria-labelledby={`heading-${sec.id}`}
            class="relative rounded-2xl border border-stone-200/90 bg-white p-6 shadow-sm transition-all duration-200 hover:border-stone-300 sm:p-8 print:break-inside-avoid print:border-none print:shadow-none dark:border-white/10 dark:bg-surface-card/85 dark:shadow-[0_4px_20px_-2px_rgba(0,0,0,0.4)]"
            data-animate={idx % 2 === 0 ? "glide-tilt" : "step-unfold"}
            id={sec.id}
          >
            <div class="border-be border-stone-200/80 pbe-4 dark:border-white/10">
              <div class="flex items-center gap-3">
                <span class="flex shrink-0 items-center justify-center rounded-full bg-orange/10 px-2 py-1 font-mono text-xs font-bold whitespace-nowrap text-orange-800 dark:text-orange-300">
                  {String(idx + 1).padStart(2, "0")}
                </span>
                <h2
                  class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl dark:text-mist-100"
                  id={`heading-${sec.id}`}
                >
                  {sec.title}
                </h2>
              </div>
            </div>

            <div class="mbs-6 flex flex-col gap-4 text-sm/relaxed text-slate-700 sm:text-base dark:text-mist-300">
              {sec.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </div>

            {isPrivacy && sec.id === "cookies" && current.cookieCta && (
              <div class="mbs-6 rounded-2xl border border-stone-200 bg-stone-50/80 p-5 transition-colors hover:border-orange-500/30 sm:p-6 dark:border-white/10 dark:bg-white/5 dark:hover:border-orange-500/40">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                  <div class="flex items-start gap-4">
                    <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-orange-500/10 text-orange-600 dark:bg-orange-500/20 dark:text-orange-400">
                      <CookieIcon
                        aria-hidden="true"
                        class="size-4.5"
                      />
                    </div>
                    <div>
                      <h4 class="text-sm font-bold text-slate-900 dark:text-mist-100">
                        {current.cookieCta.title}
                      </h4>
                      <p class="mbs-1 max-w-md text-xs/relaxed text-slate-600 sm:text-sm dark:text-mist-300">
                        {current.cookieCta.desc}
                      </p>
                    </div>
                  </div>
                  <Button
                    class="text-xs tracking-wider uppercase"
                    command="show-modal"
                    commandfor="cookie-preferences-modal"
                    data-open-cookie-settings
                    size="md"
                    type="button"
                    variant="primary"
                  >
                    <span>{current.cookieCta.buttonLabel}</span>
                  </Button>
                </div>
              </div>
            )}

            {isPrivacy && sec.id === "inventory" && current.cookieTable && (
              <div class="mbs-6 flex flex-col gap-4 border-bs border-stone-200/80 pbs-4 dark:border-white/10">
                <div>
                  <h3 class="text-base font-bold text-slate-900 sm:text-lg dark:text-mist-100">
                    {current.cookieTable.title}
                  </h3>
                  <p class="mbs-1 text-xs text-slate-600 sm:text-sm dark:text-mist-300">
                    {current.cookieTable.subtitle}
                  </p>
                </div>

                <div class="flex flex-col gap-3 sm:hidden">
                  {current.cookieTable.rows.map((row) => (
                    <div class="rounded-xl border border-stone-200 bg-stone-50/60 p-4 transition-colors hover:border-orange-500/30 hover:bg-white dark:border-white/10 dark:bg-white/5 dark:hover:border-orange-500/40 dark:hover:bg-white/10">
                      <div class="flex items-start justify-between gap-2 border-be border-stone-200/60 pbe-3 dark:border-white/10">
                        <span class="font-mono text-xs font-bold break-all text-slate-900 dark:text-mist-100">
                          {row.name}
                        </span>
                        <span
                          class:list={[
                            "inline-block shrink-0 rounded-full border px-2 py-1 font-mono text-[0.625rem] font-bold",
                            row.categoryClass,
                          ]}
                        >
                          {row.category}
                        </span>
                      </div>
                      <p class="mbs-3 text-xs/relaxed text-slate-600 dark:text-mist-300">
                        {row.purpose}
                      </p>
                      <div class="mbs-3 flex items-center justify-between border-bs border-stone-200/60 pbs-2 text-[0.6875rem] text-slate-600 dark:border-white/10 dark:text-mist-300">
                        <span class="font-medium text-slate-700 dark:text-mist-200">
                          {row.provider}
                        </span>
                        <span class="font-mono text-slate-600 dark:text-mist-300">
                          {row.lifespan}
                        </span>
                      </div>
                    </div>
                  ))}
                </div>

                <div class="hidden overflow-hidden rounded-xl border border-stone-200 bg-white shadow-xs sm:block dark:border-white/10 dark:bg-surface-card/85">
                  <table class="w-full text-left text-xs sm:text-sm">
                    <caption class="sr-only">{t("legal.ui.cookieTableCaption")}</caption>
                    <thead class="border-be border-stone-200 bg-stone-50 font-mono text-xs font-semibold text-slate-700 dark:border-white/10 dark:bg-white/5 dark:text-mist-200">
                      <tr>
                        <th
                          class="w-[20%] px-4 py-3"
                          scope="col"
                        >
                          {current.cookieTable.colName}
                        </th>
                        <th
                          class="w-[17%] px-4 py-3"
                          scope="col"
                        >
                          {current.cookieTable.colProvider}
                        </th>
                        <th
                          class="w-[16%] px-4 py-3"
                          scope="col"
                        >
                          {current.cookieTable.colCategory}
                        </th>
                        <th
                          class="w-[36%] px-4 py-3"
                          scope="col"
                        >
                          {current.cookieTable.colPurpose}
                        </th>
                        <th
                          class="w-[11%] px-4 py-3"
                          scope="col"
                        >
                          {current.cookieTable.colLifespan}
                        </th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-stone-100 text-slate-700 dark:divide-white/10 dark:text-mist-200">
                      {current.cookieTable.rows.map((row) => (
                        <tr class="transition-colors hover:bg-stone-50/60 dark:hover:bg-white/5">
                          <td class="px-4 py-3 font-mono text-xs font-bold break-all text-slate-900 sm:break-normal dark:text-mist-100">
                            {row.name}
                          </td>
                          <td class="px-4 py-3 text-xs text-slate-600 dark:text-mist-300">
                            {row.provider}
                          </td>
                          <td class="px-4 py-3">
                            <span
                              class:list={[
                                "inline-block rounded-full border px-2 py-1 font-mono text-[0.6875rem] font-bold whitespace-nowrap",
                                row.categoryClass,
                              ]}
                            >
                              {row.category}
                            </span>
                          </td>
                          <td class="px-4 py-3 text-xs/relaxed text-slate-600 dark:text-mist-300">
                            {row.purpose}
                          </td>
                          <td class="px-4 py-3 font-mono text-xs whitespace-nowrap text-slate-600 dark:text-mist-300">
                            {row.lifespan}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            {!isPrivacy && sec.id === "cancellation" && current.cancellationMatrix && (
              <div class="mbs-8 flex flex-col gap-6 border-bs border-stone-200/80 pbs-6 dark:border-white/10">
                <div>
                  <h3 class="text-base font-bold text-slate-900 sm:text-lg dark:text-mist-100">
                    {current.cancellationMatrix.title}
                  </h3>
                  <p class="mbs-1 text-xs text-slate-600 sm:text-sm dark:text-mist-300">
                    {current.cancellationMatrix.subtitle}
                  </p>
                </div>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                  {current.cancellationMatrix.tiers.map((tier) => (
                    <div class="flex flex-col justify-between rounded-xl border border-stone-200 bg-stone-50/70 p-4 transition-colors hover:border-orange/30 hover:bg-white dark:border-white/10 dark:bg-white/5 dark:hover:border-orange/50 dark:hover:bg-white/10">
                      <div>
                        <div class="flex items-center justify-between">
                          <span class="font-mono text-xs font-bold text-slate-800 dark:text-mist-100">
                            {tier.days}
                          </span>
                        </div>
                        <div class="mbs-3">
                          <span
                            class:list={[
                              "inline-block rounded-full border px-2 py-1 font-mono text-xs font-bold",
                              tier.badgeClass,
                            ]}
                          >
                            {tier.badge}
                          </span>
                        </div>
                        <p class="mbs-3 text-xs/relaxed text-slate-600 dark:text-mist-300">
                          {tier.desc}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>

                <div class="rounded-2xl border border-amber-500/20 bg-amber-500/5 p-4 sm:p-5 dark:border-amber-400/30 dark:bg-amber-950/25">
                  <div class="flex items-start gap-4">
                    <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-orange/10 text-orange dark:bg-orange-500/20 dark:text-orange-400">
                      <DangerCircleIcon
                        aria-hidden="true"
                        class="size-4.5"
                      />
                    </div>
                    <div>
                      <h4 class="text-sm font-bold text-slate-900 dark:text-mist-100">
                        {current.cancellationMatrix.insuranceTitle}
                      </h4>
                      <p class="mbs-1 text-xs/relaxed text-slate-700 sm:text-sm dark:text-mist-300">
                        {current.cancellationMatrix.insuranceDesc}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {sec.callout && (
              <div class="mbs-6 rounded-2xl border border-orange/20 bg-orange/5 p-4 sm:p-5 dark:border-orange-500/30 dark:bg-orange-950/20">
                <div class="flex items-start gap-4">
                  <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-orange/10 text-orange dark:bg-orange-500/20 dark:text-orange-400">
                    <ShieldCheckIcon
                      aria-hidden="true"
                      class="size-4.5"
                    />
                  </div>
                  <div>
                    <h4 class="text-sm font-bold text-slate-900 dark:text-mist-100">
                      {sec.callout.title}
                    </h4>
                    <p class="mbs-1 text-xs/relaxed text-slate-700 sm:text-sm dark:text-mist-300">
                      {sec.callout.desc}
                    </p>
                  </div>
                </div>
              </div>
            )}

            {sec.id === "contact" && (
              <div class="mbs-8 border-bs border-stone-200/80 pbs-6 dark:border-white/10">
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                  <a
                    class="group/contact flex items-center justify-center gap-3 rounded-full border border-stone-200 bg-stone-50 px-4 py-3 text-center transition-all duration-150 hover:border-orange hover:bg-orange/5 active:scale-[0.98] dark:border-white/10 dark:bg-white/5"
                    href={PHONE_LINK}
