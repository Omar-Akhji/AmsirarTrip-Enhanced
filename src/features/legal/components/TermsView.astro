        num: "01",
        title: "Geltungsbereich & Annahme der Bedingungen",
        paragraphs: [
          "Mit dem Zugriff auf amsirartrip.com oder der verbindlichen Buchung unserer Marokko-Reisen schließen Sie einen rechtsverbindlichen Reisevertrag ab.",
          "Sollten Sie diesen Bestimmungen nicht zustimmen, bitten wir Sie, von einer Buchung abzusehen. Fortgesetzte Nutzung gilt als Einverständnis mit den jeweils aktuellen Bestimmungen.",
        ],
      },
      {
        id: "services",
        num: "02",
        title: "Unsere Reiseleistungen & Angebote",
        paragraphs: [
          "Amsirar Trip bietet maßgeschneiderte Rundreisen, Wüstenausflüge in die Sahara, Bergtouren im Atlas und Kulturtouren in Marokko an.",
          "Alle Buchungen erfolgen vorbehaltlich Verfügbarkeit. Reiserouten können wetterbedingt oder aus Sicherheitsgründen angepasst werden.",
        ],
      },
      {
        id: "bookings",
        num: "03",
        title: "Buchung, Anzahlung & Zahlungsbedingungen",
        paragraphs: [
          "Für verbindliche Reservierungen ist eine Anzahlung zur Sicherung von Allradfahrzeugen und Wüstencamps erforderlich.",
          "Der Restbetrag ist vor Reisebeginn fällig. Die angegebenen Preise umfassen alle schriftlich bestätigten Leistungen Ihres Reiseplans.",
        ],
        callout: {
          title: "Preistransparenz",
          desc: "Verbindliche Festpreise ohne versteckte Zuschläge oder nachträgliche Sonderabgaben.",
        },
      },
      {
        id: "cancellation",
        num: "04",
        title: "Stornierungs- & Rückerstattungsrichtlinien",
        paragraphs: [
          "Die Durchführung privater Expeditionen erfordert verbindliche Vereinbarungen mit lokalen Partnern in abgelegenen Wüstenregionen.",
          "Stornierungen bedürfen der Schriftform per E-Mail (amsirare@gmail.com) oder WhatsApp gemäß der nachfolgenden Staffel.",
        ],
      },
      {
        id: "liability",
        num: "05",
        title: "Haftungsbeschränkung & Höhere Gewalt",
        paragraphs: [
          "Für Verzögerungen oder Ausfälle infolge höherer Gewalt (Sandstürme, Unwetter, Straßensperren) übernimmt Amsirar Trip keine Haftung.",
          "Unsere Haftung beschränkt sich in jedem Fall auf die Höhe des insgesamt für die Buchung bezahlten Reisepreises.",
        ],
      },
      {
        id: "intellectual-property",
        num: "06",
        title: "Urheberrecht & Geistiges Eigentum",
        paragraphs: [
          "Sämtliche Texte, Fotografien und Routenverläufe dieser Webseite unterliegen dem Urheberrecht von Amsirar Trip SARL.",
        ],
      },
      {
        id: "governing-law",
        num: "07",
        title: "Anwendbares Recht & Gerichtsstand",
        paragraphs: [
          "Es gilt ausschließlich das Recht des Königreichs Marokko.",
          "Für Streitigkeiten, die nicht gütlich beigelegt werden können, ist der ausschließliche Gerichtsstand Marrakesch.",
        ],
        callout: {
          title: "Lizenzierter Tourismusbetrieb",
          desc: "Amsirar Trip SARL ist in Marrakesch registriert und erfüllt alle Vorgaben des marokkanischen Tourismusministeriums.",
        },
      },
      {
        id: "contact",
        num: "08",
        title: "Offizielle Kontaktaufnahme & Rechtshinweise",
        paragraphs: [
          "Für vertragsrechtliche Rückfragen steht Ihnen unsere Leitung in Marrakesch gerne zur Verfügung:",
        ],
      },
    ],
  },
};

const defaultCopy: LegalCopy = contentByLocale["en"] as LegalCopy;
const current: LegalCopy = (contentByLocale[locale] ?? defaultCopy) as LegalCopy;
---

<!-- 1. Hero Header with Authentic Moroccan Photography & Meta Badges -->
<PageHeader
  bgImage={headerImg}
  breadcrumbs={[{ label: t("nav.home"), href: "/" }, { label: current.title }]}
  gradientPosition="top-right"
  headingId="terms-of-service-heading"
  subtitle={current.subtitle}
  title={current.title}
>
  <!-- Authority & Meta Badges Row -->
  <div class="flex flex-wrap items-center justify-center gap-2 pbs-2">
    <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1 text-xs font-mono font-medium text-white backdrop-blur-md">
      <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>{current.badgeStatus}</span>
    </div>
    <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1 text-xs font-mono font-medium text-white/90 backdrop-blur-md">
      <Calendar class="size-3.5 text-orange-300" />
      <time datetime="2026-01">{current.lastUpdated}</time>
    </div>
    <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1 text-xs font-mono font-medium text-white/90 backdrop-blur-md">
      <Scale class="size-3.5 text-orange-300" />
      <span>{current.badgeJurisdiction}</span>
    </div>
  </div>
</PageHeader>

<div class="relative bg-stone-50/70 text-slate-900 transition-colors print:bg-white print:text-black">
  <!-- Subtle background texture -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,oklch(56%_0.19_33deg/4%),transparent_50%)]"
  ></div>

  <!-- 2. Executive Summary Bento (Anti-Slop Transparency Cards) -->
  <section
    aria-labelledby="terms-summary-heading"
    class="relative z-10 border-be border-stone-200/80 bg-white py-12 lg:py-16"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <div class="flex items-center gap-2">
          <Sparkles class="size-4 text-orange" />
          <span class="font-mono text-xs font-semibold tracking-wider text-orange uppercase">
            // {current.badgeDoc}
          </span>
        </div>
        <h2
          class="mbs-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
          id="terms-summary-heading"
        >
          {current.summaryTitle}
        </h2>
        <p class="mbs-2 text-sm text-slate-600 sm:text-base leading-relaxed">
          {current.summarySubtitle}
        </p>
      </div>

      <div class="mbs-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {current.summaryCards.map((card, idx) => (
          <div class="group relative flex flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/60 p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-orange/30 hover:bg-white hover:shadow-lg hover:shadow-orange/5">
            <div>
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs font-bold text-orange">0{idx + 1}</span>
              </div>
              <h3 class="mbs-3 text-base font-bold text-slate-900 group-hover:text-orange transition-colors">
                {card.title}
              </h3>
              <p class="mbs-2 text-xs leading-relaxed text-slate-600 sm:text-sm">
                {card.description}
              </p>
            </div>
            <div class="mbs-4 pbs-3 border-bs border-stone-200/60 flex items-center gap-2 text-xs font-medium text-slate-500">
              <CircleCheck class="size-4 text-emerald-600" />
              <span>Verified Policy</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Two-Column Swiss Editorial Layout -->
  <div class="relative z-10 mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:gap-8 xl:gap-8">
      <!-- STICKY SIDEBAR (TOC + AGENCY CARD + ACTIONS) -->
      <aside class="lg:col-span-4 print:hidden">
        <div class="sticky top-24 space-y-4">
          <!-- Table of Contents Card -->
          <nav
            aria-label={current.tocTitle}
            class="rounded-2xl border border-stone-200/90 bg-white p-4 sm:p-5 shadow-sm"
          >
            <div class="flex items-center justify-between border-be border-stone-200/80 pbe-3">
              <div class="flex items-center gap-2">
                <FileText class="size-4 text-orange" />
                <h3 class="font-mono text-xs font-bold tracking-wider text-slate-900 uppercase">
                  {current.tocTitle}
                </h3>
              </div>
              <span class="rounded-full bg-stone-100 px-2 py-1 font-mono text-[11px] font-semibold text-slate-600">
                0{current.sections.length}
              </span>
            </div>

            <ul
              class="mbs-3 flex flex-col gap-0.5 text-xs sm:text-sm font-medium"
              id="terms-toc-list"
            >
              {current.sections.map((sec, idx) => (
                <li>
                  <a
                    class="group flex items-center rounded-full px-3 py-2 text-slate-600 transition-all duration-150 hover:bg-orange/5 hover:text-orange data-[active=true]:bg-orange/10 data-[active=true]:font-semibold data-[active=true]:text-orange"
                    data-section-id={sec.id}
                    href={`#${sec.id}`}
                  >
                    <span class="flex items-center gap-2 truncate min-w-0">
                      <span class="shrink-0 whitespace-nowrap font-mono text-xs font-bold text-slate-400 group-hover:text-orange group-data-[active=true]:text-orange">
                        {idx + 1}&nbsp;//
                      </span>
                      <span class="truncate">{sec.title}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>

            <div class="mbs-3 pbs-3 border-bs border-stone-200/80">
              <button
                class="flex w-full min-h-10 cursor-pointer items-center justify-center gap-2 rounded-full border border-stone-200 bg-stone-50 px-4 py-2 text-xs font-semibold text-slate-700 transition-colors hover:bg-stone-100 active:scale-[0.98]"
                id="terms-print-btn"
                type="button"
              >
                <Printer class="size-3.5 text-slate-500" />
                <span>{current.printLabel}</span>
              </button>
            </div>
          </nav>

          <!-- Direct Agency Credentials & Support Card -->
          <div class="overflow-hidden rounded-2xl border border-white/10 bg-slate-950 p-5 text-white shadow-xl ring-1 ring-white/10">
            <div class="flex items-center gap-2">
              <ShieldCheck class="size-4 text-orange-400" />
              <span class="font-mono text-xs font-semibold tracking-wider text-orange-400 uppercase">
                {current.agencyCard.badge}
              </span>
            </div>

            <h4 class="mbs-2 text-base font-bold text-white sm:text-lg">
              {current.agencyCard.title}
            </h4>
            <p class="mbs-1 text-xs text-zinc-400">{current.agencyCard.hours}</p>

            <div class="mbs-4 flex flex-col gap-3 border-bs border-white/10 pbs-3 text-xs text-zinc-300">
              <div class="flex items-start gap-3">
                <MapPinned
                  class="size-4 shrink-0 text-orange-400 mbs-0.5"
                  stroke-width={2}
                />
                <span class="leading-relaxed">
                  Imm. J appt N° 5, Résidence La Perle de l'Atlas, Marrakech, Morocco
                </span>
              </div>
              <div class="flex items-center gap-3">
                <Mail class="size-4 shrink-0 text-orange-400" />
                <a
                  class="hover:text-white transition-colors"
                  href="mailto:amsirare@gmail.com"
                >
                  amsirare@gmail.com
                </a>
              </div>
              <div class="flex items-center gap-3">
                <Phone class="size-4 shrink-0 text-orange-400" />
                <a
                  class="hover:text-white transition-colors"
                  href={PHONE_LINK}
                >
                  {PHONE_DISPLAY}
                </a>
              </div>
            </div>

            <div class="mbs-4 pbs-2">
              <a
                class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-full bg-linear-to-br from-amber-orange to-orange px-4 py-3 font-mono text-xs font-semibold text-white shadow-md shadow-orange/20 transition-all duration-150 hover:brightness-105 active:scale-[0.98]"
                href={WHATSAPP_LINK}
                rel="noopener noreferrer"
                target="_blank"
              >
                <MessageCircle class="size-4" />
                <span>{current.agencyCard.chatCta}</span>
              </a>
            </div>
          </div>
        </div>
      </aside>

      <!-- MAIN CONTENT COLUMN -->
      <article class="lg:col-span-8 space-y-6 print:w-full">
        {current.sections.map((sec, idx) => (
          <section
            aria-labelledby={`heading-${sec.id}`}
            class="relative rounded-2xl border border-stone-200/90 bg-white p-6 sm:p-8 shadow-sm transition-all duration-200 hover:border-stone-300 print:border-none print:shadow-none print:break-inside-avoid"
            id={sec.id}
          >
            <!-- Section Header -->
            <div class="border-be border-stone-200/80 pbe-4">
              <div class="flex items-center gap-3">
                <span class="flex shrink-0 whitespace-nowrap items-center justify-center rounded-full bg-orange/10 px-2 py-1 font-mono text-xs font-bold text-orange">
                  {idx + 1}&nbsp;//
                </span>
                <h2
                  class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl"
                  id={`heading-${sec.id}`}
                >
                  {sec.title}
                </h2>
              </div>
            </div>

            <!-- Paragraphs -->
            <div class="mbs-6 flex flex-col gap-4 text-sm leading-relaxed text-slate-700 sm:text-base">
              {sec.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </div>

            <!-- Dedicated Visual Matrix for Cancellation (Section 04) -->
            {sec.id === "cancellation" && (
              <div class="mbs-8 flex flex-col gap-6 pbs-6 border-bs border-stone-200/80">
                <div>
                  <h3 class="text-base font-bold text-slate-900 sm:text-lg">
                    {current.cancellationMatrix.title}
                  </h3>
                  <p class="mbs-1 text-xs text-slate-600 sm:text-sm">
                    {current.cancellationMatrix.subtitle}
                  </p>
                </div>

                <!-- 3-Tier Grid -->
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                  {current.cancellationMatrix.tiers.map((tier) => (
                    <div class="flex flex-col justify-between rounded-xl border border-stone-200 bg-stone-50/70 p-4 transition-colors hover:bg-white hover:border-orange/30">
                      <div>
                        <div class="flex items-center justify-between">
                          <span class="font-mono text-xs font-bold text-slate-800">
                            {tier.days}
                          </span>
                        </div>
                        <div class="mbs-3">
                          <span
                            class:list={[
                              "inline-block rounded-full border px-2 py-1 font-mono text-xs font-bold",
                              tier.badgeClass,
                            ]}
                          >
                            {tier.badge}
                          </span>
                        </div>
                        <p class="mbs-3 text-xs leading-relaxed text-slate-600">{tier.desc}</p>
                      </div>
                    </div>
                  ))}
                </div>

                <!-- Travel Insurance Advisory Box -->
                <div class="rounded-2xl border border-amber-500/20 bg-amber-500/5 p-4 sm:p-5">
                  <div class="flex items-start gap-4">
                    <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-orange/10 text-orange">
                      <CircleAlert class="size-4.5" />
                    </div>
                    <div>
                      <h4 class="text-sm font-bold text-slate-900">
                        {current.cancellationMatrix.insuranceTitle}
                      </h4>
                      <p class="mbs-1 text-xs sm:text-sm text-slate-700 leading-relaxed">
                        {current.cancellationMatrix.insuranceDesc}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            )}

            <!-- Callout if defined -->
            {sec.callout && (
              <div class="mbs-6 rounded-2xl border border-orange/20 bg-orange/5 p-4 sm:p-5">
                <div class="flex items-start gap-4">
                  <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-orange/10 text-orange">
                    <ShieldCheck class="size-4.5" />
                  </div>
                  <div>
                    <h4 class="text-sm font-bold text-slate-900">{sec.callout.title}</h4>
                    <p class="mbs-1 text-xs sm:text-sm text-slate-700 leading-relaxed">
                      {sec.callout.desc}
                    </p>
                  </div>
                </div>
              </div>
            )}

            <!-- Section 08: Direct Contact Action Grid -->
            {sec.id === "contact" && (
              <div class="mbs-8 pbs-6 border-bs border-stone-200/80">
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                  <a
                    class="group/contact flex items-center justify-center gap-3 rounded-full border border-stone-200 bg-stone-50 px-4 py-3 text-center transition-all duration-150 hover:border-orange hover:bg-orange/5 active:scale-[0.98]"
                    href={PHONE_LINK}
                  >
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-orange/10 text-orange group-hover/contact:bg-orange group-hover/contact:text-white transition-colors">
                      <Phone class="size-4" />
                    </div>
                    <div class="text-left">
                      <span class="block text-xs font-bold text-slate-900 group-hover/contact:text-orange transition-colors">
                        Telephone
                      </span>
                      <span class="block font-mono text-[11px] text-slate-600">
                        {PHONE_DISPLAY}
                      </span>
                    </div>
                  </a>

                  <a
                    class="group/contact flex items-center justify-center gap-3 rounded-full border border-stone-200 bg-stone-50 px-4 py-3 text-center transition-all duration-150 hover:border-orange hover:bg-orange/5 active:scale-[0.98]"
                    href="mailto:amsirare@gmail.com"
                  >
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-orange/10 text-orange group-hover/contact:bg-orange group-hover/contact:text-white transition-colors">
                      <Mail class="size-4" />
                    </div>
                    <div class="text-left">
                      <span class="block text-xs font-bold text-slate-900 group-hover/contact:text-orange transition-colors">
                        Email Us
                      </span>
                      <span class="block font-mono text-[11px] text-slate-600">
                        amsirare@gmail.com
                      </span>
                    </div>
                  </a>

                  <a
                    class="group/contact flex items-center justify-center gap-3 rounded-full border border-stone-200 bg-stone-50 px-4 py-3 text-center transition-all duration-150 hover:border-emerald-500 hover:bg-emerald-500/5 active:scale-[0.98]"
                    href={WHATSAPP_LINK}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 group-hover/contact:bg-emerald-600 group-hover/contact:text-white transition-colors">
                      <MessageCircle class="size-4" />
                    </div>
                    <div class="text-left">
                      <span class="block text-xs font-bold text-slate-900 group-hover/contact:text-emerald-700 transition-colors">
                        WhatsApp
                      </span>
                      <span class="block font-mono text-[11px] text-emerald-700">Chat Now</span>
                    </div>
                  </a>
                </div>
              </div>
            )}
          </section>
        ))}

        <!-- Bottom Return & Reassurance Banner -->
        <div class="rounded-2xl border border-stone-200 bg-linear-to-r from-stone-50 via-white to-stone-50 p-6 sm:p-8 text-center shadow-xs">
          <Compass class="mx-auto size-8 text-orange" />
          <h3 class="mt-3 text-lg font-bold text-slate-900">
            Ready to Explore the Wonders of Morocco?
          </h3>
          <p class="mx-auto mt-2 max-w-xl text-sm text-slate-600 leading-relaxed">
            From the dunes of Erg Chebbi to the imperial alleys of Fes and Marrakech, our expert
            team is ready to design your journey with complete peace of mind.
          </p>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            <a
              class="inline-flex min-h-11 items-center justify-center whitespace-nowrap rounded-full bg-linear-to-br from-amber-orange to-orange px-6 py-3 text-sm font-semibold text-white shadow-md shadow-orange/20 transition-all hover:brightness-105 active:scale-[0.98]"
              href={getRelativeLocaleUrl(locale, "tours")}
            >
              <span>Explore Morocco Tours</span>
            </a>
            <a
              class="inline-flex min-h-11 items-center justify-center whitespace-nowrap rounded-full border border-stone-300 bg-white px-6 py-3 text-sm font-medium text-slate-700 transition-colors hover:bg-stone-50 active:scale-[0.98]"
              href={getRelativeLocaleUrl(locale, "contact")}
            >
              <span>Contact Our Team</span>
            </a>
          </div>
        </div>
      </article>
    </div>
  </div>
</div>

<!-- Interactive Table of Contents & Print Script -->
<script src="../scripts/terms-interactive.ts"></script>
