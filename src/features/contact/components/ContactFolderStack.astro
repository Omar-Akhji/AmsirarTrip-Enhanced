---
import { useTranslations } from "@/i18n/utils";
import { WHATSAPP_LINK } from "@/lib/constants/contact";
import AltArrowRightIcon from "@/shared/ui/icons/AltArrowRightIcon.astro";
import Button from "@/shared/ui/primitives/Button.astro";
import FolderStack from "@/shared/ui/widgets/FolderStack.astro";

interface ContactMethod {
  description: string;
  id: string;
  title: string;
}

interface Props {
  methods: ContactMethod[];
}

const { methods } = Astro.props;
const locale = Astro.locals.locale;
const t = useTranslations(locale);
const actionLabels: Readonly<Record<string, string>> = {
  phone: t("contact.actions.chatWhatsapp"),
  email: t("contact.actions.sendMessage"),
};
---

<FolderStack idPrefix="contact">
  {methods.map((method, index) => (
    <article
      aria-label={typeof method.title === "string" ? method.title : undefined}
      class="contact-info-card group relative flex h-55 w-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/95 p-5 shadow-xl shadow-stone-900/10 backdrop-blur-xs transition-shadow duration-300 dark:border-white/10 dark:bg-surface-card/90 dark:shadow-[0_12px_28px_rgba(0,0,0,0.6)]"
      slot={`card-${index}`}
    >
      <div>
        <h3 class="mbe-2.5 border-b border-stone-200/80 pb-2.5 text-base/snug sm:text-lg font-bold tracking-tight text-stone-950 dark:text-mist-100 transition-colors duration-200 group-hover:text-orange-600 dark:border-white/10">
          {method.title}
        </h3>
        <p class="text-sm/relaxed text-stone-600 dark:text-mist-200">{method.description}</p>
      </div>

      <div class="mbs-2 border-t border-stone-200/60 dark:border-white/10 pbs-2.5">
        <Button
          class="flex w-full min-h-11 items-center justify-between border-stone-200 bg-white px-6 py-3 text-xs font-bold text-stone-800 transition hover:border-transparent pointer-fine:hover:border-transparent hover:bg-linear-to-br hover:from-amber-orange hover:to-orange hover:text-white hover:shadow-md hover:shadow-orange/20 active:border-transparent active:bg-linear-to-br active:from-amber-orange active:to-orange active:text-white active:shadow-md active:shadow-orange/20 dark:border-white/10 dark:bg-white/5 dark:text-mist-100 dark:hover:border-transparent dark:hover:bg-linear-to-br dark:hover:from-amber-orange dark:hover:to-orange dark:hover:text-white dark:hover:shadow-md dark:hover:shadow-orange/30 dark:active:border-transparent dark:active:bg-linear-to-br dark:active:from-amber-orange dark:active:to-orange dark:active:text-white dark:active:shadow-md dark:active:shadow-orange/30"
          href={
            method.id === "phone" ? WHATSAPP_LINK
            : method.id === "email" ?
              "#contact-form-section"
            : "#location"
          }
          rel={method.id === "phone" ? "noopener noreferrer" : undefined}
          target={method.id === "phone" ? "_blank" : undefined}
          variant="outline"
        >
          <span class="uppercase tracking-wider">
            {actionLabels[method.id] ?? t("contact.actions.viewOffice")}
          </span>
          <AltArrowRightIcon
            aria-hidden="true"
            class="size-4"
          />
        </Button>
      </div>
    </article>
  ))}
</FolderStack>
