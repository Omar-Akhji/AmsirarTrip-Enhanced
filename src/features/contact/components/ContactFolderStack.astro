---
import { ChevronRight } from "@lucide/astro";
import { WHATSAPP_LINK } from "@/lib/constants/contact";

interface ContactMethod {
  id: string;
  title: string;
  description: string;
}

interface Props {
  methods: ContactMethod[];
}

const { methods } = Astro.props;
---

<contact-folder-stack class="block relative w-full overflow-visible">
  <div class="contact-folder-track relative w-full h-[220vh]">
    <div class="contact-folder-stage sticky top-18 h-[460px] w-full mx-auto overflow-visible select-none">
      <!-- Layer 1: Folder Back Plate (z-index: 2, behind cards) -->
      <div
        class="folder-back-plate absolute inset-x-0 bottom-4 h-[300px] overflow-visible pointer-events-none will-change-transform"
        style="z-index: 2; opacity: 0; transform: translateY(340px);"
      >
        <!-- 1. Top Tab: Left edge at left-0 -->
        <div class="absolute top-0 left-0 h-7.75 w-28 rounded-tl-2xl bg-slate-950 border-t border-l border-white/10"></div>

        <!-- 2. Diagonal Slanted Shoulder: Starts at left-28 (112px), width 24px -->
        <div class="absolute top-0 left-28 h-7.75 w-6">
          <svg
            class="size-full text-slate-950"
            viewBox="0 0 24 31"
            fill="currentColor"
          >
            <polygon points="0,0 24,31 0,31"></polygon>
            <line
              x1="0"
              y1="0"
              x2="24"
              y2="31"
              stroke="rgba(255,255,255,0.12)"
              stroke-width="1.2"
            ></line>
          </svg>
        </div>

        <!-- 3. Top-Right Shoulder Border -->
        <div class="absolute top-7.5 left-34 right-0 h-px bg-white/10"></div>

        <!-- 4. Main Back Body -->
        <div class="absolute top-7.5 inset-x-0 bottom-0 rounded-b-2xl rounded-tr-2xl bg-slate-950 border-x border-b border-white/10 shadow-2xl">
          <div class="absolute inset-0 rounded-b-2xl rounded-tr-2xl bg-linear-to-b from-slate-900/60 to-slate-950 pointer-events-none"></div>
        </div>
      </div>

      <!-- Layer 2: The Cards Stack (z-index: 10, between folder back and front pocket) -->
      <div
        class="cards-stack-layer absolute inset-x-0 top-2 h-[340px] will-change-transform"
        style="z-index: 10; perspective: 1200px;"
      >
        {methods.map((method, index) => (
          <div
            data-stack-card={index}
            class="contact-card-slot absolute inset-x-0 top-0 w-full origin-top will-change-transform"
            style={`z-index: ${10 + index * 2};`}
          >
            <article
              aria-label={typeof method.title === "string" ? method.title : undefined}
              class="contact-info-card group flex h-[270px] w-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/95 p-6 shadow-xl shadow-stone-900/10 backdrop-blur-xs transition-shadow duration-300"
            >
              <div>
                <h3 class="mbe-3 text-xl font-bold tracking-tight text-stone-950 transition-colors duration-200 group-hover:text-orange-600">
                  {method.title}
                </h3>
                <p class="text-sm leading-relaxed text-stone-600">{method.description}</p>
              </div>

              <!-- Tactile Action Link -->
              <div class="mbs-6 border-t border-stone-200/60 pbs-4">
                <a
                  class="flex min-h-11 items-center justify-between rounded-full border border-stone-200 bg-white px-6 py-3 font-mono text-xs font-bold text-stone-800 transition hover:border-orange/60 hover:bg-linear-to-br hover:from-amber-orange hover:to-orange hover:text-white hover:shadow-md hover:shadow-orange/20"
                  href={
                    method.id === "phone" ? WHATSAPP_LINK
                    : method.id === "email" ?
                      "#contact-form-section"
                    : "#location"
                  }
                  target={method.id === "phone" ? "_blank" : undefined}
                  rel={method.id === "phone" ? "noopener noreferrer" : undefined}
                >
                  <span class="uppercase tracking-wider">
                    {method.id === "phone" ?
                      "WhatsApp Dispatch"
                    : method.id === "email" ?
                      "Send Written Brief"
                    : "Office Coordinates"}
                  </span>
                  <ChevronRight
                    aria-hidden="true"
                    class="size-4"
                  />
                </a>
              </div>
            </article>
          </div>
        ))}
      </div>

      <!-- Layer 3: Folder Front Pocket (z-index: 25, in front of the cards) -->
      <div
        class="folder-front-pocket absolute inset-x-0 bottom-4 h-[250px] rounded-2xl bg-slate-900/98 border border-white/10 shadow-[0_-14px_35px_rgba(0,0,0,0.7)] ring-1 ring-white/5 will-change-transform overflow-hidden pointer-events-none"
        style="z-index: 25; opacity: 0; transform-origin: bottom center; transform: translateY(340px);"
      >
        <div class="size-full bg-linear-to-b from-slate-900/40 to-slate-950/80"></div>
      </div>
    </div>
  </div>
</contact-folder-stack>

<style>
  @media (prefers-reduced-motion: reduce) {
    .contact-folder-track {
      height: auto !important;
    }

    .contact-folder-stage {
      position: static !important;
      height: auto !important;
      top: auto !important;
      user-select: auto !important;
    }

    .folder-back-plate,
    .folder-front-pocket {
      display: none !important;
    }

    .cards-stack-layer {
      position: static !important;
      height: auto !important;
      perspective: none !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 1.25rem !important;
    }

    .contact-card-slot {
      position: static !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script src="../scripts/contact-folder-stack.ts"></script>
