---
import bgImage from "@/assets/images/Header/header-1.webp";
import { useTranslations } from "@/i18n/utils";
import { WHATSAPP_LINK } from "@/lib/constants/contact";
import { splitTitleAccent } from "@/lib/utils";
import PageHeader from "@/layouts/PageHeader.astro";
import Button from "@/shared/ui/primitives/Button.astro";
import ContactFolderStack from "./ContactFolderStack.astro";
import PointOnMapIcon from "@/shared/ui/icons/PointOnMapIcon.astro";
import AltArrowRightIcon from "@/shared/ui/icons/AltArrowRightIcon.astro";

const locale = Astro.locals.locale ?? Astro.currentLocale ?? "en";
const t = useTranslations(locale);

const contactTitle = splitTitleAccent(t("contact.lgTitle"));
const locationTitle = splitTitleAccent(t("contact.location.lgTitle"));

const contactMethods = [
  { id: "phone", title: t("contact.card.phoneTitle"), description: t("contact.card.phoneSeo") },
  { id: "email", title: t("contact.card.emailTitle"), description: t("contact.card.emailSeo") },
  { id: "location", title: t("contact.card.visitTitle"), description: t("contact.card.visitSeo") },
];

import { DELAY_CLASSES } from "@/shared/ui/primitives/animation-constants";
---

<PageHeader
  bgImage={bgImage}
  breadcrumbs={[{ label: t("nav.home"), href: "/" }, { label: t("nav.contact") }]}
  gradientPosition="top-right"
  hasUnderline={true}
  smTitle={t("contact.smTitle")}
  subtitle={t("contact.headerSubtitle")}
  title={t("contact.title")}
/>

<div class="text-zinc-900 dark:text-mist-100">
  <!-- DIRECT CHANNELS -->
  <section
    aria-labelledby="contact-methods-heading"
    class="relative isolate bg-white py-12 sm:py-16 lg:py-24 dark:bg-surface-base"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <h2
        class="sr-only"
        id="contact-methods-heading"
      >
        {t("contact.methods.title")}
      </h2>

      <!-- Mobile Mode: Folder Stack (matches Home page experience) -->
      <div class="block md:hidden w-full">
        <ContactFolderStack methods={contactMethods} />
      </div>

      <!-- Desktop & Tablet Mode: Responsive Multi-Column Grid -->
      <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 2xl:gap-8 items-stretch">
        {contactMethods.map((method, index) => (
          <div
            class:list={[
              "flex size-full",
              { "md:col-span-2 lg:col-span-1": index === 2 },
              DELAY_CLASSES[index] || "animate-delay-0",
            ]}
            data-animate="fade-up"
          >
            <article
              aria-label={typeof method.title === "string" ? method.title : undefined}
              class="contact-info-card group relative flex size-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/80 p-6 sm:p-8 shadow-xs shadow-stone-900/5 transition-all duration-300 hover:-translate-y-1 hover:border-stone-300 hover:shadow-md motion-reduce:transform-none dark:border-white/10 dark:bg-surface-card/80 dark:shadow-[0_4px_20px_-2px_rgba(0,0,0,0.4)] dark:hover:border-white/20 dark:hover:bg-surface-hover/90"
            >
              <div>
                <h3 class="mbe-3 border-b border-stone-200/80 pb-3 text-lg lg:text-xl font-bold leading-snug tracking-tight text-stone-950 dark:text-mist-100 transition-colors duration-200 group-hover:text-orange-600 dark:border-white/10">
                  {method.title}
                </h3>
                <p class="text-sm leading-relaxed text-stone-600 dark:text-mist-300">
                  {method.description}
                </p>
              </div>

              <!-- Tactile Action Link -->
              <div class="mbs-6 border-t border-stone-200/60 dark:border-white/10 pbs-4">
                <Button
                  class="flex w-full min-h-11 items-center justify-between border-stone-200 bg-white px-6 py-3 text-xs font-bold text-stone-800 transition-[border-color,background,color,box-shadow] duration-160 ease-out hover:border-transparent pointer-fine:hover:border-transparent pointer-fine:hover:bg-linear-to-br pointer-fine:hover:from-amber-orange pointer-fine:hover:to-orange pointer-fine:hover:text-white pointer-fine:hover:shadow-md pointer-fine:hover:shadow-orange/20 dark:border-white/10 dark:bg-white/5 dark:text-mist-100 dark:hover:border-transparent"
                  variant="outline"
                  href={
                    method.id === "phone" ? WHATSAPP_LINK
                    : method.id === "email" ?
                      "#contact-form-section"
                    : "#location"
                  }
                  target={method.id === "phone" ? "_blank" : undefined}
                  rel={method.id === "phone" ? "noopener noreferrer" : undefined}
                >
                  <span class="uppercase tracking-wider">
                    {method.id === "phone" ?
                      "Chat on WhatsApp"
                    : method.id === "email" ?
                      "Send Us a Message"
                    : "View Office Location"}
                  </span>
                  <AltArrowRightIcon
                    aria-hidden="true"
                    class="size-4"
                  />
                </Button>
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EXPEDITION INQUIRY -->
  <section
    aria-labelledby="contact-form-heading"
    class="relative isolate border-t border-stone-200 bg-stone-50 py-12 sm:py-16 lg:py-24 dark:border-white/10 dark:bg-surface-base"
    id="contact-form-section"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <div
        class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8 dark:border-white/10"
        data-animate="fade-up"
      >
        <hgroup class="max-w-2xl space-y-2">
          <h2
            class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance dark:text-mist-100"
            id="contact-form-heading"
          >
            {contactTitle.main}{" "}
            {contactTitle.accent && <span class="text-orange">{contactTitle.accent}</span>}
          </h2>
          <p class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 dark:text-mist-300 leading-relaxed max-w-[62ch] text-pretty">
            {t("contact.form.subtitle")}
          </p>
        </hgroup>
      </div>

      <div data-animate="fade-up">
        <slot />
      </div>
    </div>
  </section>

  <!-- OFFICE & LOCATION -->
  <section
    aria-labelledby="location-heading"
    class="relative isolate border-t border-stone-200/90 bg-white py-12 sm:py-16 lg:py-24 dark:border-white/10 dark:bg-surface-base"
    id="location"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <div
        class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8 dark:border-white/10"
        data-animate="fade-up"
      >
        <hgroup class="max-w-2xl space-y-2">
          <h2
            class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance dark:text-mist-100"
            id="location-heading"
          >
            {locationTitle.main}{" "}
            {locationTitle.accent && <span class="text-orange">{locationTitle.accent}</span>}
          </h2>
          <p class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 dark:text-mist-300 leading-relaxed max-w-[62ch] text-pretty">
            {t("contact.location.smTitle")}
          </p>
        </hgroup>
      </div>

      <details class="group overflow-hidden rounded-2xl border border-slate-900 bg-slate-950 text-white shadow-xl details-content:block-0 details-content:overflow-clip details-content:opacity-0 details-content:transition-[block-size,content-visibility,opacity] details-content:duration-300 details-content:ease-out-expo details-content:transition-discrete motion-reduce:details-content:transition-none open:details-content:block-auto open:details-content:opacity-100">
        <summary class="group/summary relative flex flex-col items-center justify-center bg-slate-950 text-white cursor-pointer list-none select-none transition duration-300 block-75 md:block-100 lg:block-125 marker:hidden group-open:hidden">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(241,93,48,0.12),transparent_70%)]"></div>
          <div class="relative z-10 text-center space-y-4 px-6 max-w-lg mx-auto">
            <div class="mx-auto flex size-14 items-center justify-center rounded-full border border-white/10 bg-white/5 text-orange-400 font-mono text-xs shadow-xs group-hover/summary:scale-105 transition duration-300">
              <PointOnMapIcon
                aria-hidden="true"
                class="size-6"
              />
            </div>
            <h3 class="text-xl font-bold tracking-tight text-white uppercase sm:text-2xl">
              {t("contact.map.placeholderTitle")}
            </h3>
            <p class="font-mono text-xs sm:text-sm text-stone-300 leading-relaxed">
              {t("contact.map.placeholderDesc")}
            </p>
            <div class="pt-2">
              <span class="group/btn inline-flex min-h-12 cursor-pointer items-center rounded-full border border-stone-200/80 bg-white py-1.5 ps-5 pe-1.5 font-mono text-xs font-semibold tracking-wider text-dark-surface uppercase shadow-lg shadow-black/25 transition-all duration-200 group-hover/summary:border-stone-300 group-hover/summary:bg-white group-hover/summary:shadow-xl group-hover/btn:border-stone-300 group-hover/btn:bg-white group-hover/btn:shadow-xl active:scale-[0.98]">
                <span class="flex-1 text-center truncate px-3">{t("contact.map.loadBtn")}</span>
                <span class="relative flex size-8 shrink-0 items-center justify-center overflow-hidden rounded-full bg-linear-to-br from-amber-orange to-orange text-white shadow-xs shadow-orange/40 transition-transform duration-300 ease-out group-hover/summary:scale-105 group-hover/btn:scale-105 group-active/summary:scale-95 group-active/btn:scale-95">
                  <div class="relative flex size-full items-center justify-center">
                    <!-- Default state: Solar Arrow Right-Up Broken -->
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="absolute size-4.5 transition-all duration-300 ease-out group-hover/summary:translate-x-3 group-hover/summary:-translate-y-3 group-hover/summary:opacity-0 group-hover/btn:translate-x-3 group-hover/btn:-translate-y-3 group-hover/btn:opacity-0 rtl:-scale-x-100 rtl:group-hover/summary:-translate-x-3 rtl:group-hover/btn:-translate-x-3"
                      aria-hidden="true"
                    >
                      <path d="M18 15V6H9M18 6L11.5 12.5M6 18L8.5 15.5" />
                    </svg>

                    <!-- Hover state: Solar Arrow Right Broken -->
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="absolute size-4.5 -translate-x-3 translate-y-2 opacity-0 transition-all duration-300 ease-out group-hover/summary:translate-x-0 group-hover/summary:translate-y-0 group-hover/summary:opacity-100 group-hover/btn:translate-x-0 group-hover/btn:translate-y-0 group-hover/btn:opacity-100 rtl:translate-x-3 rtl:-scale-x-100 rtl:group-hover/summary:translate-x-0 rtl:group-hover/btn:translate-x-0"
                      aria-hidden="true"
                    >
                      <path d="M14 18L20 12L14 6M20 12H9.5M4 12H6.5" />
                    </svg>
                  </div>
                </span>
              </span>
            </div>
          </div>
        </summary>
        <iframe
          allowfullscreen
          aria-label="Interactive map showing Amsirar Trip agency location in Marrakech"
          class="border-0 block-75 md:block-100 lg:block-125 inline-full"
          data-src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3399.999!2d-8.0257651!3d31.6259758!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xdafef007a3f58d3%3A0xa6485d9ed7022b4c!2sAmsirar+Travel!5e0!3m2!1sen!2sma!4v1699999999999!5m2!1sen!2sma"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Amsirar Trip Agency Location - Marrakech, Morocco"
        ></iframe>
      </details>
    </div>
  </section>
</div>

<script src="../../../scripts/contact-map-facade.ts"></script>
