---
import bgImage from "@/assets/images/Header/header-1.webp";
import { useTranslations } from "@/i18n/utils";
import { WHATSAPP_LINK } from "@/lib/constants/contact";
import PageHeader from "@/shared/layout/PageHeader.astro";
import { ArrowRight, Mail, MapPin, MessageCircle, Phone } from "@lucide/astro";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const contactMethods = [
  {
    id: "phone",
    icon: Phone,
    title: t("contact.card.phoneTitle", "Feel free to contact us - we're here to help"),
    description: t(
      "contact.card.phoneSeo",
      "Have a quick question or want to book now? Our local team answers calls and messages promptly - reach out and we'll help plan the perfect Morocco trip.",
    ),
  },
  {
    id: "email",
    icon: Mail,
    title: t("contact.card.emailTitle", "Send a message - we'll reply with a tailored plan"),
    description: t(
      "contact.card.emailSeo",
      "Prefer to write? Send us your plans, dates and priorities - we'll prepare a personalised itinerary and respond quickly with options and clear next steps.",
    ),
  },
  {
    id: "location",
    icon: MapPin,
    title: t("contact.card.visitTitle", "Visit our Marrakech office - friendly, local support"),
    description: t(
      "contact.card.visitSeo",
      "Drop by for an in-person chat, help with bookings, or to learn more about our desert excursions and private tours - our team is ready to welcome you.",
    ),
  },
];
---

<PageHeader
  bgImage={bgImage}
  breadcrumbs={[{ label: t("nav.home"), href: "/" }, { label: t("nav.contact") }]}
  gradientPosition="top-right"
  smTitle={t("contact.smTitle", "get in touch with us")}
  subtitle={t("contact.headerSubtitle")}
  title={t("contact.title")}
>
  <a
    class="inline-flex items-center gap-2 rounded-full border border-white/60 px-6 py-3 text-sm font-semibold text-white/90 transition text-shadow-xs pointer-fine:hover:bg-white/10"
    href="#contact-form-section"
  >
    <span>{t("contact.form.cta", "Send message")}</span>
    <ArrowRight class="size-4" />
  </a>
  <a
    class="inline-flex items-center gap-2 rounded-full bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition text-shadow-xs pointer-fine:hover:-translate-y-0.5 pointer-fine:hover:bg-white/20"
    href={WHATSAPP_LINK}
    rel="noopener noreferrer"
    target="_blank"
  >
    <MessageCircle
      aria-hidden="true"
      class="size-4"
    />
    <span>WhatsApp</span>
  </a>
</PageHeader>
<div class="text-zinc-900">
  <section
    aria-labelledby="contact-methods-heading"
    class="relative isolate py-16"
  >
    <h2
      class="sr-only"
      id="contact-methods-heading"
    >
      {t("contact.methods.title", "Contact Methods")}
    </h2>
    <div class="mx-auto px-4 max-inline-7xl">
      <div class="grid gap-6 md:grid-cols-3">
        {contactMethods.map((method, index) => (
          <div
            class="flex size-full"
            data-animate="fade-up"
            style={`transition-delay: ${index * 150}ms`}
          >
            <article
              aria-label={typeof method.title === "string" ? method.title : undefined}
              class="contact-info-card group rounded-3xl border border-orange-100 bg-white px-6 py-8 shadow-lg shadow-orange-100/70 transition inline-full pointer-fine:hover:-translate-y-1 pointer-fine:hover:shadow-xl"
            >
              <div class="mbe-4 inline-flex size-14 items-center justify-center rounded-full bg-orange-50 text-orange-600 transition group-hover:bg-orange-600 group-hover:text-white">
                <method.icon class="size-6" />
              </div>
              <h3 class="text-xl font-semibold text-zinc-900">{method.title}</h3>
              <p class="mbs-3 text-base leading-relaxed text-zinc-700">{method.description}</p>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section
    aria-labelledby="contact-form-heading"
    class="bg-neutral-50"
    id="contact-form-section"
  >
    <div class="mx-auto px-4 pbs-16 max-inline-7xl">
      <div
        class="section-header text-center"
        data-animate="fade-up"
      >
        <p class="inline-flex items-center justify-center rounded-full border-2 border-orange-400 px-6 py-3 text-sm font-semibold tracking-[0.45em] text-orange-700 uppercase">
          {t("contact.form.badge", "Plan with locals")}
        </p>
        <h2
          class="mbs-6 text-2xl leading-tight font-semibold tracking-widest text-neutral-900 uppercase sm:text-3xl sm:tracking-[0.15em] md:text-4xl md:tracking-[0.2em]"
          id="contact-form-heading"
        >
          {t("contact.lgTitle", "contact us")}
        </h2>
        <div
          aria-hidden="true"
          class="mx-auto mbs-4 rounded-full bg-orange-500 block-1 inline-20"
        ></div>
      </div>
    </div>
  </section>

  <slot />

  <section
    aria-labelledby="location-heading"
    class="relative bg-zinc-50 pbe-16"
    id="location"
  >
    <div class="mx-auto px-4 max-inline-7xl">
      <div
        class="mbe-12 p-7 text-center tracking-wide uppercase"
        data-animate="fade-up"
      >
        <p class="inline-flex items-center justify-center rounded-full border-2 border-orange-400 px-6 py-3 text-sm font-semibold tracking-[0.45em] text-orange-700 uppercase">
          {t("contact.location.smTitle")}
        </p>
        <h2
          class="mbs-6 text-2xl leading-tight font-semibold tracking-widest text-neutral-900 uppercase sm:text-3xl sm:tracking-[0.15em] md:text-4xl md:tracking-[0.2em]"
          id="location-heading"
        >
          {t("contact.location.lgTitle")}
        </h2>
        <div
          aria-hidden="true"
          class="mx-auto mbs-4 rounded-full bg-orange-500 block-1 inline-20"
        ></div>
      </div>
      <div class="overflow-hidden rounded-3xl shadow-2xl ring-1 ring-zinc-200">
        <div
          class="group relative flex flex-col items-center justify-center bg-zinc-900/95 text-white cursor-pointer transition duration-300 block-75 md:block-100 lg:block-125"
          id="map-placeholder"
        >
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(249,115,22,0.15),transparent_70%)]"></div>
          <div class="relative z-10 text-center space-y-4 px-6">
            <div class="mx-auto flex size-16 items-center justify-center rounded-full bg-orange-600/10 text-orange-500 ring-2 ring-orange-500/20 group-hover:scale-110 transition duration-300">
              <MapPin
                class="size-8"
                stroke-width={2}
              />
            </div>
            <h3 class="text-xl font-semibold tracking-wide uppercase">
              {t("contact.map.placeholderTitle", "Show Interactive Map")}
            </h3>
            <p class="text-sm text-zinc-400 max-w-md mx-auto">
              {t(
                "contact.map.placeholderDesc",
                "Clicking will load the Google Maps widget which may set cookies and load third-party scripts.",
              )}
            </p>
            <button
              class="inline-flex items-center gap-2 rounded-full bg-orange-700 px-6 py-2.5 text-sm font-semibold text-white shadow-md hover:bg-orange-600 transition duration-150"
              type="button"
            >
              {t("contact.map.loadBtn", "Load Map")}
            </button>
          </div>
        </div>
        <div
          class="hidden"
          id="map-container"
        >
          <iframe
            allowfullscreen
            aria-label="Interactive map showing Amsirar Trip agency location in Marrakech"
            class="border-0 block-75 md:block-100 lg:block-125"
            data-src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3399.999!2d-8.0257651!3d31.6259758!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xdafef007a3f58d3%3A0xa6485d9ed7022b4c!2sAmsirar+Travel!5e0!3m2!1sen!2sma!4v1699999999999!5m2!1sen!2sma"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            sandbox="allow-scripts allow-same-origin allow-popups"
            title="Amsirar Trip Agency Location - Marrakech, Morocco"
            width="100%"
          ></iframe>
        </div>
      </div>

      <script src="../scripts/map-placeholder.ts"></script>
    </div>
  </section>
</div>
