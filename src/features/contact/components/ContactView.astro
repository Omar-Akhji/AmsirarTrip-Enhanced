---
import bgImage from "@/assets/images/Header/header-1.webp";
import { useTranslations } from "@/i18n/utils";
import { WHATSAPP_LINK } from "@/lib/constants/contact";
import PageHeader from "@/shared/layout/PageHeader.astro";
import Button from "@/shared/ui/Button.astro";
import ContactFolderStack from "./ContactFolderStack.astro";
import { ChevronRight, Mail, MapPinned, MessageCircle, Phone } from "@lucide/astro";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const contactMethods = [
  {
    id: "phone",
    icon: Phone,
    title: t("contact.card.phoneTitle", "Call or WhatsApp our Marrakech desk"),
    description: t(
      "contact.card.phoneSeo",
      "Our team answers booking questions, availability requests, and route changes from 09:00 to 21:00 GMT+1 daily.",
    ),
  },
  {
    id: "email",
    icon: Mail,
    title: t("contact.card.emailTitle", "Send a message - we'll reply with a tailored plan"),
    description: t(
      "contact.card.emailSeo",
      "Prefer to write? Send us your plans, dates and priorities - we'll prepare a personalised itinerary and respond quickly with options and clear next steps.",
    ),
  },
  {
    id: "location",
    icon: MapPinned,
    title: t("contact.card.visitTitle", "Visit our Marrakech office - friendly, local support"),
    description: t(
      "contact.card.visitSeo",
      "Drop by for an in-person chat, help with bookings, or to learn more about our desert excursions and private tours - our team is ready to welcome you.",
    ),
  },
];

import { DELAY_CLASSES } from "@/shared/ui/animation-constants";
---

<PageHeader
  bgImage={bgImage}
  breadcrumbs={[{ label: t("nav.home"), href: "/" }, { label: t("nav.contact") }]}
  gradientPosition="top-right"
  smTitle={t("contact.smTitle", "Get in Touch with Us")}
  subtitle={t("contact.headerSubtitle")}
  title={t("contact.title")}
>
  <Button
    variant="secondary"
    href="#contact-form-section"
  >
    <span>{t("contact.form.cta", "Send message")}</span>
    <ChevronRight
      aria-hidden="true"
      class="size-4"
    />
  </Button>
  <Button
    variant="ghost"
    href={WHATSAPP_LINK}
    rel="noopener noreferrer"
    target="_blank"
  >
    <MessageCircle
      aria-hidden="true"
      class="size-4"
    />
    <span>WhatsApp</span>
  </Button>
</PageHeader>

<div class="text-zinc-900">
  <!-- DIRECT CHANNELS -->
  <section
    aria-labelledby="contact-methods-heading"
    class="relative isolate bg-white py-12 sm:py-16 lg:py-24"
  >
    <div class="mx-auto px-4 max-inline-7xl">
      <h2
        class="sr-only"
        id="contact-methods-heading"
      >
        {t("contact.methods.title", "Direct Communication Channels")}
      </h2>

      <!-- Mobile Mode: Folder Stack (matches Home page experience) -->
      <div class="block md:hidden w-full">
        <ContactFolderStack methods={contactMethods} />
      </div>

      <!-- Desktop & Tablet Mode: Responsive Multi-Column Grid -->
      <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
        {contactMethods.map((method, index) => (
          <div
            class:list={[
              "flex size-full",
              { "md:col-span-2 lg:col-span-1": index === 2 },
              DELAY_CLASSES[index] || "delay-0",
            ]}
            data-animate="fade-up"
          >
            <article
              aria-label={typeof method.title === "string" ? method.title : undefined}
              class="contact-info-card group relative flex size-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/80 p-6 sm:p-8 shadow-xs shadow-stone-900/5 transition-all duration-300 hover:-translate-y-1 hover:border-stone-300 hover:shadow-md motion-reduce:transform-none"
            >
              <div>
                <h3 class="mbe-3 text-xl font-bold tracking-tight text-stone-950 transition-colors duration-200 group-hover:text-orange-600">
                  {method.title}
                </h3>
                <p class="text-sm leading-relaxed text-stone-600">{method.description}</p>
              </div>

              <!-- Tactile Action Link -->
              <div class="mbs-6 border-t border-stone-200/60 pbs-4">
                <a
                  class="flex min-h-11 items-center justify-between rounded-full border border-stone-200 bg-white px-6 py-3 font-mono text-xs font-bold text-stone-800 transition-[border-color,background,color,box-shadow] duration-160 ease-out pointer-fine:hover:border-orange/60 pointer-fine:hover:bg-linear-to-br pointer-fine:hover:from-amber-orange pointer-fine:hover:to-orange pointer-fine:hover:text-white pointer-fine:hover:shadow-md pointer-fine:hover:shadow-orange/20 active:scale-[0.98] motion-reduce:transform-none"
                  href={
                    method.id === "phone" ? WHATSAPP_LINK
                    : method.id === "email" ?
                      "#contact-form-section"
                    : "#location"
                  }
                  target={method.id === "phone" ? "_blank" : undefined}
                  rel={method.id === "phone" ? "noopener noreferrer" : undefined}
                >
                  <span class="uppercase tracking-wider">
                    {method.id === "phone" ?
                      "Chat on WhatsApp"
                    : method.id === "email" ?
                      "Send Us a Message"
                    : "View Office Location"}
                  </span>
                  <ChevronRight
                    aria-hidden="true"
                    class="size-4"
                  />
                </a>
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EXPEDITION INQUIRY -->
  <section
    aria-labelledby="contact-form-heading"
    class="relative isolate border-t border-stone-200 bg-stone-50 py-12 sm:py-16 lg:py-24"
    id="contact-form-section"
  >
    <div class="mx-auto px-4 max-inline-7xl">
      <div
        class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8"
        data-animate="fade-up"
      >
        <hgroup class="max-w-2xl space-y-2">
          <h2
            class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance"
            id="contact-form-heading"
          >
            {t("contact.lgTitle", "Contact Us")}
          </h2>
          <p class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 leading-relaxed max-w-[62ch] text-pretty">
            {t(
              "contact.form.subtitle",
              "Share your dates, party size, and travel priorities. Our local Marrakech office prepares a tailored proposal within 24 hours.",
            )}
          </p>
        </hgroup>
      </div>

      <slot />
    </div>
  </section>

  <!-- OFFICE & LOCATION -->
  <section
    aria-labelledby="location-heading"
    class="relative isolate border-t border-stone-200/90 bg-white py-12 sm:py-16 lg:py-24"
    id="location"
  >
    <div class="mx-auto px-4 max-inline-7xl">
      <div
        class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8"
        data-animate="fade-up"
      >
        <hgroup class="max-w-2xl space-y-2">
          <h2
            class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance"
            id="location-heading"
          >
            {t("contact.location.lgTitle")}
          </h2>
          <p class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 leading-relaxed max-w-[62ch] text-pretty">
            {t("contact.location.smTitle")}
          </p>
        </hgroup>
      </div>

      <details class="group overflow-hidden rounded-2xl border border-slate-900 bg-slate-950 text-white shadow-xl">
        <summary class="group/summary relative flex flex-col items-center justify-center bg-slate-950 text-white cursor-pointer list-none select-none transition duration-300 block-75 md:block-100 lg:block-125 marker:hidden group-open:hidden">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(234,88,12,0.12),transparent_70%)]"></div>
          <div class="relative z-10 text-center space-y-4 px-6 max-w-lg mx-auto">
            <div class="mx-auto flex size-14 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-orange-400 font-mono text-xs shadow-xs group-hover/summary:scale-105 transition duration-300">
              <MapPinned
                aria-hidden="true"
                class="size-6"
                stroke-width={2}
              />
            </div>
            <h3 class="text-xl font-bold tracking-tight text-white uppercase sm:text-2xl">
              {t("contact.map.placeholderTitle", "Show Interactive Map")}
            </h3>
            <p class="font-mono text-xs sm:text-sm text-stone-300 leading-relaxed">
              {t(
                "contact.map.placeholderDesc",
                "Clicking will load the Google Maps widget which may set cookies and load third-party scripts.",
              )}
            </p>
            <div class="pt-2">
              <span class="inline-flex min-h-11 items-center gap-2 rounded-full border border-orange-500/50 bg-linear-to-br from-amber-orange to-orange px-8 py-3 font-mono text-xs font-bold uppercase tracking-wider text-white shadow-md shadow-orange/20 transition-[filter,box-shadow,transform] duration-160 ease-out pointer-fine:hover:brightness-105 pointer-fine:hover:shadow-lg pointer-fine:hover:shadow-orange/30 active:scale-[0.98] motion-reduce:transform-none">
                <span>{t("contact.map.loadBtn", "Load Map")}</span>
                <ChevronRight
                  aria-hidden="true"
                  class="size-4"
                />
              </span>
            </div>
          </div>
        </summary>
        <iframe
          allowfullscreen
          aria-label="Interactive map showing Amsirar Trip agency location in Marrakech"
          class="border-0 block-75 md:block-100 lg:block-125 inline-full"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3399.999!2d-8.0257651!3d31.6259758!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xdafef007a3f58d3%3A0xa6485d9ed7022b4c!2sAmsirar+Travel!5e0!3m2!1sen!2sma!4v1699999999999!5m2!1sen!2sma"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          sandbox="allow-scripts allow-same-origin allow-popups"
          title="Amsirar Trip Agency Location - Marrakech, Morocco"
        ></iframe>
      </details>
    </div>
  </section>
</div>
