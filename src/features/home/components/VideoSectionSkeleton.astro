---
import AsciiSkeleton from "@/shared/ui/feedback/AsciiSkeleton.astro";

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<section
  aria-busy="true"
  aria-label="Loading travel video"
  class:list={["relative overflow-hidden py-8 text-white inline-full sm:py-12 lg:py-16", className]}
>
  <div class="mx-auto px-4 max-inline-330">
    <div class="relative overflow-hidden rounded-2xl border border-slate-900 bg-slate-950 p-2 shadow-2xl block-[55vh] inline-full sm:p-3 sm:block-[65vh] lg:block-[75vh] xl:block-[85vh]">
      <!-- Top Telemetry Badge Skeleton -->
      <div class="pointer-events-none absolute inset-s-6 top-6 z-20 flex items-center gap-2 font-mono text-xs">
        <AsciiSkeleton
          class="h-7 w-52 rounded-md overflow-hidden text-stone-300"
          rows={1}
          variant="dither"
        />
      </div>

      <!-- Edge-to-Edge ASCII Background Mesh -->
      <div class="absolute inset-0 size-full overflow-hidden bg-slate-950">
        <AsciiSkeleton
          class="ars-image ars-hero-bg size-full text-stone-700/35"
          rows={50}
          variant="dither"
        />
      </div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/80 via-black/40 to-black/60"
      ></div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.06),transparent_70%)]"
      ></div>

      <!-- Centered Play Button Skeleton — entire button rendered as pure ASCII dither circle -->
      <div
        aria-hidden="true"
        class="absolute inset-0 z-10 flex items-center justify-center rounded-xl"
      >
        <AsciiSkeleton
          class="size-18 sm:size-20 rounded-full overflow-hidden text-white/50"
          rows={6}
          variant="dither"
        />
      </div>
    </div>
  </div>
</section>
