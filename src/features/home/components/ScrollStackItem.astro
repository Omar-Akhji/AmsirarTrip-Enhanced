---
interface Props {
  itemClassName?: string;
  class?: string;
  style?: string | Record<string, string | number>;
}

const { itemClassName = "", class: className = "", style = "" } = Astro.props;
const resolvedClass = [itemClassName, className].filter(Boolean).join(" ");
---

<div
  data-stack-slot
  class="scroll-stack-slot sticky w-full origin-top will-change-transform"
>
  <div
    class:list={[
      "scroll-stack-card relative box-border h-80 w-full origin-top rounded-2xl overflow-hidden will-change-transform shadow-[0_0_0_1px_rgba(255,255,255,0.08),0_-12px_40px_-16px_rgba(0,0,0,0.5),0_24px_48px_-24px_rgba(0,0,0,0.6)]",
      resolvedClass,
    ]}
    style={typeof style === "string" ? style : undefined}
  >
    <slot />
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 z-20 rounded-[inherit] bg-black opacity-(--scroll-stack-dim,0) transition-opacity duration-150"
    />
  </div>
</div>
