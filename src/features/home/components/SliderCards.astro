---
import { Image } from "astro:assets";

export interface SlideCardItem {
  id: string;
  image: ImageMetadata | string;
  title: string;
  type: string;
  alt?: string;
  thumbTitle?: string;
  thumbType?: string;
}

interface Props {
  items: SlideCardItem[];
}

const { items } = Astro.props;
---

<div
  class="thumbnail absolute z-100 flex w-max gap-(--thumb-gap) bottom-(--thumb-bottom) left-(--thumb-left)"
  aria-label="Slider destination previews"
>
  {items.map((item, index) => (
    <button
      type="button"
      class="item group relative shrink-0 cursor-pointer overflow-hidden text-start shadow-[0_8px_25px_rgb(0_0_0/45%)] w-(--thumb-width) h-(--thumb-height) rounded-(--thumb-radius)"
      data-index={index}
      aria-label={`Go to slide ${index + 1}: ${item.thumbTitle || item.title}`}
    >
      {typeof item.image === "string" ?
        <Image
          src={item.image}
          alt={item.alt || `${item.thumbTitle || item.title} - ${item.thumbType || item.type}`}
          loading="eager"
          decoding="async"
          fetchpriority={index <= 1 ? "high" : "low"}
          width={400}
          height={580}
          class="size-full object-cover rounded-(--thumb-radius)"
        />
      : <Image
          src={item.image}
          alt={item.alt || `${item.thumbTitle || item.title} - ${item.thumbType || item.type}`}
          loading="eager"
          decoding="async"
          fetchpriority={index <= 1 ? "high" : "low"}
          width={400}
          height={580}
          class="size-full object-cover rounded-(--thumb-radius)"
        />
      }
      <div class="thumbnail-overlay pointer-events-none absolute inset-x-0 bottom-0 flex flex-col px-2 py-1.5 sm:px-2.5 sm:py-2 text-white text-shadow-sm text-shadow-black/80 bg-linear-to-t from-black/85 to-transparent">
        <span class="thumbnail-type truncate text-[0.65rem] sm:text-[0.7rem] font-bold uppercase tracking-wider text-orange-400">
          {item.thumbType || item.type}
        </span>
        <span class="thumbnail-title truncate text-[0.65rem] sm:text-[0.7rem] text-slate-200">
          {item.thumbTitle || item.title}
        </span>
      </div>
    </button>
  ))}
</div>
