---
import { useTranslations } from "@/i18n/utils";
import StatsFolderStack from "./StatsFolderStack.astro";

const locale = Astro.locals.locale;
const t = useTranslations(locale);

interface CopyType {
  readonly care: string;
  readonly experience: string;
  readonly routes: string;
}

const defaultCopy: CopyType = {
  experience:
    "Founded in Marrakech in 2006. Our licensed local drivers and guides run private trips across all 12 Moroccan regions.",
  routes:
    "Private 4x4 and minivan routes paced around your dates—no fixed group departures, no forced commission-shop stops.",
  care: "One Marrakech coordinator and licensed driver-guide stay on your trip from airport pickup to drop-off, with direct WhatsApp support.",
};

const descriptions: Record<"fr" | "es" | "de", CopyType> = {
  fr: {
    experience:
      "Fondée à Marrakech en 2006. Nos chauffeurs-guides agréés mènent des circuits privés dans les 12 régions du Maroc.",
    routes:
      "Circuits privés en 4x4 ou minibus adaptés à vos dates : aucun départ en groupe imposé, aucun arrêt forcé en boutique.",
    care: "Un coordinateur à Marrakech et un chauffeur-guide agréé vous suivent de l'aéroport au retour, avec assistance directe sur WhatsApp.",
  },
  es: {
    experience:
      "Fundada en Marrakech en 2006. Nuestros conductores-guías titulados operan rutas privadas por las 12 regiones de Marruecos.",
    routes:
      "Rutas privadas en 4x4 o miniván según tus fechas: sin salidas grupales fijas ni paradas forzadas en tiendas de comisiones.",
    care: "Un coordinador en Marrakech y un conductor-guía titulado te acompañan del aeropuerto al regreso, con soporte directo por WhatsApp.",
  },
  de: {
    experience:
      "2006 in Marrakesch gegründet. Unsere lizenzierten Fahrer und Guides führen Privattouren durch alle 12 Regionen Marokkos.",
    routes:
      "Private 4x4- und Minivan-Routen nach Ihren Reisedaten – keine festen Gruppenabfahrten, keine erzwungenen Verkaufsstopps.",
    care: "Ein Koordinator in Marrakesch und ein lizenzierter Fahrer-Guide begleiten Sie vom Flughafen bis zur Abreise – mit direktem WhatsApp-Support.",
  },
};

function getCopy(lang: string): CopyType {
  switch (lang) {
    case "fr": {
      return descriptions.fr;
    }
    case "es": {
      return descriptions.es;
    }
    case "de": {
      return descriptions.de;
    }
    default: {
      return defaultCopy;
    }
  }
}

const copy = getCopy(locale);

const statHighlights = [
  {
    id: "experience",
    code: "HERITAGE",
    value: "20+",
    label: t("home.stats.experience"),
    description: copy.experience,
    footerLeft: "Est. 2006",
    footerRight: "Marrakech HQ",
  },
  {
    id: "routes",
    code: "EXPEDITIONS",
    value: "35+",
    label: t("excursion.stats.routes"),
    description: copy.routes,
    footerLeft: "All 12 Regions",
    footerRight: "Bespoke Routes",
  },
  {
    id: "care",
    code: "CONCIERGE",
    value: "24/7",
    label: t("excursion.stats.support"),
    description: copy.care,
    footerLeft: "Real-Time",
    footerRight: "Direct WhatsApp",
  },
];

import { DELAY_CLASSES } from "@/shared/ui/primitives/animation-constants";
---

<section
  aria-labelledby="home-highlights"
  class="bg-white py-12 sm:py-16 lg:py-24 dark:bg-surface-base"
>
  <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
    <h2
      class="sr-only"
      id="home-highlights"
    >
      {t("about.experienceTitle")}
    </h2>

    {/* Mobile Mode: Scroll-Stack into Folder (https://reactbits.dev/components/folder) */}
    <div class="block md:hidden w-full">
      <StatsFolderStack stats={statHighlights} />
    </div>

    {/* Desktop & Tablet Mode: 3-column Grid */}
    <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 2xl:gap-8 items-stretch">
      {statHighlights.map((stat, index) => (
        <div
          class:list={[
            "flex size-full",
            { "md:col-span-2 lg:col-span-1": index === 2 },
            DELAY_CLASSES[index] || "animate-delay-0",
          ]}
          data-animate="focus-unblur"
        >
          <article class="group relative flex size-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/80 p-6 sm:p-7 shadow-xs shadow-stone-900/5 transition-all duration-300 hover:-translate-y-1 hover:border-stone-300 hover:shadow-md dark:border-white/10 dark:bg-surface-card/75 dark:shadow-[0_4px_20px_-2px_rgba(0,0,0,0.4)] dark:hover:border-white/20 dark:hover:bg-surface-hover/90">
            <div>
              <div class="mbe-5 flex items-center justify-between border-b border-stone-200/60 pb-3 text-[0.6875rem] font-mono uppercase tracking-wider text-stone-400 dark:border-white/10 dark:text-mist-400">
                <span class="font-semibold text-stone-600 dark:text-mist-200">{stat.code}</span>
              </div>

              <div class="mbe-3">
                <data
                  class="text-4xl font-bold tracking-tight text-orange-700 dark:text-orange-400 tabular-nums block"
                  data-scroll-counter
                  value={stat.value}
                >
                  {stat.value}
                </data>
              </div>

              <h3 class="text-base sm:text-lg font-semibold tracking-tight text-stone-900 dark:text-mist-100">
                {stat.label}
              </h3>

              <p class="mbs-2 text-sm/relaxed text-stone-600 dark:text-mist-300">
                {stat.description}
              </p>
            </div>

            <div class="mbs-6 flex items-center justify-between border-t border-stone-200/60 pt-3 text-[0.6875rem] font-mono text-stone-400 uppercase tracking-wider dark:border-white/10 dark:text-mist-400">
              <span class="text-stone-600 dark:text-mist-200">{stat.footerLeft}</span>
              <span class="inline-flex items-center gap-1 text-stone-600 dark:text-mist-200">
                {stat.footerRight}
              </span>
            </div>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>
