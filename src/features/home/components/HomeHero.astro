---
import { Image } from "astro:assets";
import { useTranslations } from "@/i18n/utils";
import bg1 from "../../../assets/images/Header/header-1.webp";
import bg2 from "../../../assets/images/Header/header-2.webp";
import bg3 from "../../../assets/images/Header/header-3.webp";
import SliderCards, { type SlideCardItem } from "./SliderCards.astro";
import SliderDetails from "./SliderDetails.astro";

interface Props {
  images?: (ImageMetadata | string)[];
}

const { images = [] } = Astro.props;

const locale = Astro.locals.locale;
const t = useTranslations(locale);

const defaultImages = [images[0] || bg1, images[1] || bg2, images[2] || bg3];
const slideKeys = ["sahara", "atlas", "imperial"] as const;

const currentSlides = slideKeys.map((id, index) => ({
  id,
  title: t(`hero.slides.${id}.title`),
  type: t(`hero.slides.${id}.type`),
  description: t(`hero.slides.${id}.description`),
  thumbType: t(`hero.slides.${id}.thumbType`),
  thumbTitle: t(`hero.slides.${id}.thumbTitle`),
  image: defaultImages[index] || defaultImages[0] || "",
}));

const thumbnailCards: SlideCardItem[] = currentSlides.map((slide) => ({
  id: slide.id,
  image: slide.image,
  title: slide.title,
  type: slide.type,
  thumbTitle: slide.thumbTitle,
  thumbType: slide.thumbType,
}));
---

<section
  aria-label={t("hero.carouselAria")}
  aria-roledescription="carousel"
  class="relative isolate w-full h-dvh max-h-dvh overflow-hidden bg-black text-white"
  id="home-hero-slider-section"
>
  <h1 class="sr-only">{t("home.heroTitle")}</h1>
  <div
    class="slider relative size-full overflow-hidden bg-[#050505] font-sans"
    id="home-hero-slider"
  >
    <!-- List of Full-Screen Slides -->
    <div class="list">
      {currentSlides.map((slide, index) => (
        <div
          aria-hidden={index === 0 ? "false" : "true"}
          class="item absolute inset-0 size-full"
          data-index={index}
        >
          {typeof slide.image === "string" ?
            <Image
              alt={`${slide.title} - ${slide.type}`}
              class="size-full object-cover"
              decoding="async"
              fetchpriority={index === 0 ? "high" : "low"}
              height={1080}
              loading="eager"
              src={slide.image}
              width={1920}
            />
          : <Image
              alt={`${slide.title} - ${slide.type}`}
              class="size-full object-cover"
              decoding="async"
              fetchpriority={index === 0 ? "high" : "low"}
              format="webp"
              loading="eager"
              quality={80}
              sizes="100vw"
              src={slide.image}
              widths={[640, 1024, 1536, 1920]}
            />
          }
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 z-1 bg-[linear-gradient(to_bottom,rgb(0_0_0/55%)_0%,rgb(0_0_0/15%)_18%,transparent_32%),linear-gradient(to_top,rgb(0_0_0/40%)_0%,transparent_32%)]"
          />
          <SliderDetails
            description={slide.description}
            isH1={false}
            title={slide.title}
            type={slide.type}
          />
        </div>
      ))}
    </div>

    <!-- WCAG 2.2.2 Pause / Play Autoplay Control -->
    <button
      aria-label={t("hero.pauseAutoplay")}
      aria-pressed="false"
      class="absolute inset-s-4 bottom-20 sm:inset-s-8 sm:bottom-8 z-110 inline-flex size-11 cursor-pointer items-center justify-center rounded-full border border-white/25 bg-black/55 text-white shadow-lg backdrop-blur-md transition-colors hover:border-white/50 hover:bg-black/75 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2 focus-visible:ring-offset-black"
      data-label-pause={t("hero.pauseAutoplay")}
      data-label-play={t("hero.playAutoplay")}
      data-slider-toggle
      type="button"
    >
      <svg
        aria-hidden="true"
        class="size-5"
        data-icon-pause
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <rect
          height="14"
          rx="1.5"
          width="4"
          x="6"
          y="5"
        />
        <rect
          height="14"
          rx="1.5"
          width="4"
          x="14"
          y="5"
        />
      </svg>
      <svg
        aria-hidden="true"
        class="hidden size-5"
        data-icon-play
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11-6.86a1 1 0 0 0 0-1.7l-11-6.86A1 1 0 0 0 8 5.14Z" />
      </svg>
    </button>

    <!-- Thumbnail Carousel Cards -->
    <SliderCards items={thumbnailCards} />
  </div>
</section>

<script src="../../../scripts/slider.ts"></script>
