---
import { Image } from "astro:assets";
import bg1 from "../../../assets/images/Header/header-1.webp";
import bg2 from "../../../assets/images/Header/header-2.webp";
import bg3 from "../../../assets/images/Header/header-3.webp";
import SliderCards, { type SlideCardItem } from "./SliderCards.astro";
import SliderDetails from "./SliderDetails.astro";

interface Props {
  images?: (ImageMetadata | string)[];
}

const { images = [] } = Astro.props;

const locale = Astro.currentLocale || "en";

// Default high-resolution Moroccan travel images
const defaultImages = [images[0] || bg1, images[1] || bg2, images[2] || bg3];

// Localized slide content
const slidesData = {
  en: [
    {
      id: "sahara",
      title: "Erg Chebbi Dunes",
      type: "& Desert Camp Nights",
      description:
        "Camel treks across golden dunes at sunset, traditional Berber tagine dinners, and private desert camps beneath Saharan skies.",
    },
    {
      id: "atlas",
      title: "Mountain Passes",
      type: "& Ancient Kasbahs",
      description:
        "Cross dramatic Atlas summits, explore UNESCO World Heritage earthen ksour, and discover lush palm oases with local guides.",
    },
    {
      id: "imperial",
      title: "Imperial Medinas",
      type: "& Atlantic Coast",
      description:
        "Private chauffeur-guided journeys connecting Marrakech, Fes medina, Chefchaouen, and breezy Atlantic coastal ramparts.",
    },
  ],
  fr: [
    {
      id: "sahara",
      title: "Dunes de l'Erg Chebbi",
      type: "et nuits au bivouac",
      description:
        "Randonnées chamelières au coucher du soleil, dîners traditionnels berbères et nuits étoilées en camp privé au cœur des dunes.",
    },
    {
      id: "atlas",
      title: "Cols de montagne",
      type: "et kasbahs anciennes",
      description:
        "Franchissez les cols panoramiques de l'Atlas, explorez les ksour en pisé classés à l'UNESCO et découvrez des oasis préservées.",
    },
    {
      id: "imperial",
      title: "Médinas impériales",
      type: "et côte atlantique",
      description:
        "Voyages privés avec chauffeur reliant Marrakech, Fès, Chefchaouen et les remparts maritimes d'Essaouira.",
    },
  ],
  es: [
    {
      id: "sahara",
      title: "Dunas de Erg Chebbi",
      type: "y noches en campamento",
      description:
        "Paseos en camello al atardecer, cenas tradicionales bereberes y campamentos privados bajo el cielo estrellado del desierto.",
    },
    {
      id: "atlas",
      title: "Rutas por el Alto Atlas",
      type: "Pasos de montaña",
      description:
        "Cruce los puertos panorámicos del Atlas, explore kasbahs de adobe declaradas Patrimonio Mundial y oasis fértiles.",
    },
    {
      id: "imperial",
      title: "Medinas imperiales",
      type: "y costa atlántica",
      description:
        "Viajes privados con chófer conectando Marrakech, Fez, Chefchaouen y la costa atlántica de Essaouira.",
    },
  ],
  de: [
    {
      id: "sahara",
      title: "Erg Chebbi Dünen",
      type: "& Nächte im Wüstencamp",
      description:
        "Kamelritte bei Sonnenuntergang, traditionelle Berber-Abendessen und private Wüstencamps unter dem Sternenhimmel der Sahara.",
    },
    {
      id: "atlas",
      title: "Gebirgspässe",
      type: "& historische Kasbahs",
      description:
        "Überqueren Sie spektakuläre Atlas-Pässe, erkunden Sie UNESCO-Weltkulturerbe-Lehmburgen und fruchtbare Oasentäler.",
    },
    {
      id: "imperial",
      title: "Königsstädte",
      type: "& Atlantikküste",
      description:
        "Private Rundreisen mit Chauffeur zwischen Marrakesch, Fès, Chefchaouen und der atlantischen Küste von Essaouira.",
    },
  ],
};

const currentSlides = (slidesData[locale as keyof typeof slidesData] || slidesData.en).map(
  (slide, index) => ({ ...slide, image: defaultImages[index] || defaultImages[0] || "" }),
);

const thumbnailCards: SlideCardItem[] = currentSlides.map((slide) => ({
  id: slide.id,
  image: slide.image,
  title: slide.title,
  type: slide.type,
}));
---

<section
  id="home-hero-slider-section"
  class="relative isolate w-full h-[300vh] overflow-x-clip bg-black text-white"
  aria-roledescription="carousel"
  aria-label="Amsirar Trip Hero Carousel"
>
  <div
    class="slider sticky top-0 h-screen w-full overflow-hidden bg-[#050505] font-sans"
    id="home-hero-slider"
  >
    <!-- List of Full-Screen Slides -->
    <div class="list">
      {currentSlides.map((slide, index) => (
        <div
          class="item absolute inset-0 size-full"
          data-index={index}
        >
          {typeof slide.image === "string" ?
            <Image
              src={slide.image}
              alt={`${slide.title} - ${slide.type}`}
              decoding="async"
              fetchpriority={index === 0 ? "high" : "low"}
              loading="eager"
              width={1920}
              height={1080}
              class="size-full object-cover"
            />
          : <Image
              src={slide.image}
              alt={`${slide.title} - ${slide.type}`}
              decoding="async"
              fetchpriority={index === 0 ? "high" : "low"}
              loading="eager"
              class="size-full object-cover"
            />
          }
          <div
            class="slide-overlay pointer-events-none absolute inset-0 z-1 bg-[linear-gradient(to_bottom,rgb(0_0_0/55%)_0%,rgb(0_0_0/15%)_18%,transparent_32%),linear-gradient(to_top,rgb(0_0_0/40%)_0%,transparent_32%)]"
            aria-hidden="true"
          />
          <SliderDetails
            description={slide.description}
            isH1={index === 0}
            title={slide.title}
            type={slide.type}
          />
        </div>
      ))}
    </div>

    <!-- Thumbnail Carousel Cards -->
    <SliderCards items={thumbnailCards} />

    <!-- Vertical Dots Navigation directly below the orange line and along the same vertical axis -->
    <nav
      class="hero-dots-nav pagination absolute z-100 flex flex-col items-center -translate-x-1/2 left-4 sm:left-8 md:left-[5%] lg:left-[max(7%,calc(50%-570px))] 2xl:left-[max(7%,calc(50%-640px))] 3xl:left-[max(8%,calc(50%-720px))] top-[clamp(19.5rem,50vh,23rem)] md:top-[clamp(20rem,38vh,26rem)] lg:top-[clamp(22rem,42vh,28rem)]"
      id="pagination"
      aria-label="Slider vertical dots navigation"
    >
      <div class="relative flex flex-col items-center">
        {currentSlides.map((slide, index) => (
          <div
            class="relative flex flex-col items-center"
            data-dot-wrapper={index}
          >
            <button
              type="button"
              class:list={[
                "hero-dot-btn group relative flex size-7 sm:size-8 items-center justify-center cursor-pointer rounded-full transition-transform duration-200 active:scale-90 focus-visible:outline-2 focus-visible:outline-[#ecad29] focus-visible:outline-offset-2 motion-reduce:transform-none",
                { active: index === 0 },
              ]}
              data-index={index}
              aria-label={`Go to slide ${index + 1}: ${slide.title}`}
              aria-current={index === 0 ? "true" : undefined}
            >
              <span class="hero-dot-indicator relative grid size-3.5 sm:size-4 place-items-center rounded-full border border-white/35 bg-black/40 backdrop-blur-xs transition-all duration-300 group-[.active]:border-[#ecad29]/90 group-[.active]:bg-[#ecad29]/25 group-[.active]:shadow-[0_0_10px_rgb(236_173_41/50%)] group-[.active]:scale-115 group-[&:not(.active):hover]:border-white/80 group-[&:not(.active):hover]:bg-white/20 group-[&:not(.active):hover]:scale-110 motion-reduce:transition-none">
                <span class="hero-dot-core size-1.5 sm:size-2 rounded-full transition-all duration-300 bg-white/55 scale-75 group-[.active]:bg-[#ecad29] group-[.active]:shadow-[0_0_8px_rgb(236_173_41/90%)] group-[.active]:scale-100 group-[&:not(.active):hover]:bg-white/95 group-[&:not(.active):hover]:scale-90 motion-reduce:transition-none" />
              </span>
            </button>

            {index < currentSlides.length - 1 && (
              <div
                class="hero-dot-line relative h-6 sm:h-7 w-0.5 bg-white/20 overflow-hidden my-0.5 rounded-full transition-colors duration-300"
                aria-hidden="true"
                data-line-index={index}
              >
                <div
                  class="hero-dot-line-fill absolute inset-x-0 top-0 h-0 w-full bg-linear-to-b from-[#ecad29] to-orange-500 shadow-[0_0_6px_rgb(236_173_41/60%)] transition-[height] duration-500 ease-out motion-reduce:transition-none"
                />
              </div>
            )}
          </div>
        ))}
      </div>
    </nav>
  </div>
</section>

<script src="../../../scripts/slider.ts"></script>
