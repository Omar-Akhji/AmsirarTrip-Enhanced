---
import { Image } from "astro:assets";
import bg1 from "../../../assets/images/Header/header-1.webp";
import bg2 from "../../../assets/images/Header/header-2.webp";
import bg3 from "../../../assets/images/Header/header-3.webp";
import SliderCards, { type SlideCardItem } from "./SliderCards.astro";
import SliderDetails from "./SliderDetails.astro";

interface Props {
  images?: (ImageMetadata | string)[];
}

const { images = [] } = Astro.props;

const locale = Astro.currentLocale || "en";

// Default high-resolution Moroccan travel images
const defaultImages = [images[0] || bg1, images[1] || bg2, images[2] || bg3];

// Localized slide content
const slidesData = {
  en: [
    {
      id: "sahara",
      tagline: "Sahara Desert Expeditions",
      title: "Erg Chebbi Dunes",
      type: "& Desert Camp Nights",
      description:
        "Camel treks across golden dunes at sunset, traditional Berber tagine dinners, and private desert camps beneath Saharan skies.",
    },
    {
      id: "atlas",
      tagline: "High Atlas Mountain Treks",
      title: "Mountain Passes",
      type: "& Ancient Kasbahs",
      description:
        "Cross dramatic Atlas summits, explore UNESCO World Heritage earthen ksour, and discover lush palm oases with local guides.",
    },
    {
      id: "imperial",
      tagline: "Tailored Morocco Circuits",
      title: "Imperial Medinas",
      type: "& Atlantic Coast",
      description:
        "Private chauffeur-guided journeys connecting Marrakech, Fes medina, Chefchaouen, and breezy Atlantic coastal ramparts.",
    },
  ],
  fr: [
    {
      id: "sahara",
      tagline: "Expéditions dans le Sahara",
      title: "Dunes de l'Erg Chebbi",
      type: "et nuits au bivouac",
      description:
        "Randonnées chamelières au coucher du soleil, dîners traditionnels berbères et nuits étoilées en camp privé au cœur des dunes.",
    },
    {
      id: "atlas",
      tagline: "Randonnées dans le Haut Atlas",
      title: "Cols de montagne",
      type: "et kasbahs anciennes",
      description:
        "Franchissez les cols panoramiques de l'Atlas, explorez les ksour en pisé classés à l'UNESCO et découvrez des oasis préservées.",
    },
    {
      id: "imperial",
      tagline: "Circuits sur mesure au Maroc",
      title: "Médinas impériales",
      type: "et côte atlantique",
      description:
        "Voyages privés avec chauffeur reliant Marrakech, Fès, Chefchaouen et les remparts maritimes d'Essaouira.",
    },
  ],
  es: [
    {
      id: "sahara",
      tagline: "Expediciones al Sahara",
      title: "Dunas de Erg Chebbi",
      type: "y noches en campamento",
      description:
        "Paseos en camello al atardecer, cenas tradicionales bereberes y campamentos privados bajo el cielo estrellado del desierto.",
    },
    {
      id: "atlas",
      tagline: "Rutas por el Alto Atlas",
      title: "Pasos de montaña",
      type: "y antiguas kasbahs",
      description:
        "Cruce los puertos panorámicos del Atlas, explore kasbahs de adobe declaradas Patrimonio Mundial y oasis fértiles.",
    },
    {
      id: "imperial",
      tagline: "Circuitos a medida por Marruecos",
      title: "Medinas imperiales",
      type: "y costa atlántica",
      description:
        "Viajes privados con chófer conectando Marrakech, Fez, Chefchaouen y la costa atlántica de Essaouira.",
    },
  ],
  de: [
    {
      id: "sahara",
      tagline: "Sahara-Wüstenreisen",
      title: "Erg Chebbi Dünen",
      type: "& Nächte im Wüstencamp",
      description:
        "Kamelritte bei Sonnenuntergang, traditionelle Berber-Abendessen und private Wüstencamps unter dem Sternenhimmel der Sahara.",
    },
    {
      id: "atlas",
      tagline: "Touren im Hohen Atlas",
      title: "Gebirgspässe",
      type: "& historische Kasbahs",
      description:
        "Überqueren Sie spektakuläre Atlas-Pässe, erkunden Sie UNESCO-Weltkulturerbe-Lehmburgen und fruchtbare Oasentäler.",
    },
    {
      id: "imperial",
      tagline: "Maßgeschneiderte Marokko-Routen",
      title: "Königsstädte",
      type: "& Atlantikküste",
      description:
        "Private Rundreisen mit Chauffeur zwischen Marrakesch, Fès, Chefchaouen und der atlantischen Küste von Essaouira.",
    },
  ],
};

const currentSlides = (slidesData[locale as keyof typeof slidesData] || slidesData.en).map(
  (slide, index) => ({ ...slide, image: defaultImages[index] || defaultImages[0] || "" }),
);

const thumbnailCards: SlideCardItem[] = currentSlides.map((slide) => ({
  id: slide.id,
  image: slide.image,
  title: slide.title,
  type: slide.type,
}));
---

<section
  id="home-hero-slider-section"
  class="relative isolate w-full min-h-screen h-dvh overflow-hidden bg-black text-white"
  aria-roledescription="carousel"
  aria-label="Amsirar Trip Hero Carousel"
>
  <div
    class="slider relative h-screen w-screen overflow-hidden bg-[#050505] font-sans"
    id="home-hero-slider"
  >
    <!-- List of Full-Screen Slides -->
    <div class="list">
      {currentSlides.map((slide, index) => (
        <div
          class="item absolute inset-0 size-full"
          data-index={index}
        >
          {typeof slide.image === "string" ?
            <Image
              src={slide.image}
              alt={`${slide.title} - ${slide.type}`}
              decoding="async"
              fetchpriority={index === 0 ? "high" : "low"}
              loading="eager"
              width={1920}
              height={1080}
              class="size-full object-cover"
            />
          : <Image
              src={slide.image}
              alt={`${slide.title} - ${slide.type}`}
              decoding="async"
              fetchpriority={index === 0 ? "high" : "low"}
              loading="eager"
              class="size-full object-cover"
            />
          }
          <div
            class="slide-overlay pointer-events-none absolute inset-0 z-1 bg-[linear-gradient(to_bottom,rgb(0_0_0/55%)_0%,rgb(0_0_0/15%)_18%,transparent_32%),linear-gradient(to_top,rgb(0_0_0/40%)_0%,transparent_32%)]"
            aria-hidden="true"
          />
          <SliderDetails
            description={slide.description}
            isH1={index === 0}
            tagline={slide.tagline}
            title={slide.title}
            type={slide.type}
          />
        </div>
      ))}
    </div>

    <!-- Thumbnail Carousel Cards -->
    <SliderCards items={thumbnailCards} />

    <!-- Prev / Next Navigation Arrows & Marrakech-Tours Pagination Progress -->
    <div
      class="nextPrevArrows pagination absolute z-100 hidden w-auto items-center gap-3 md:flex left-[max(7%,calc(50%-570px))] max-lg:left-[5%] bottom-[calc(var(--thumb-bottom)+12px)] max-lg:bottom-[calc(var(--thumb-bottom)+10px)]"
      id="pagination"
      role="region"
      aria-label="Slider navigation and progress"
    >
      <button
        class="prev arrow arrow-left group grid size-12.5 cursor-pointer place-items-center rounded-full border-2 border-white/33 bg-white/5 backdrop-blur-md transition-[transform,background-color,border-color] duration-160 ease-out pointer-fine:hover:border-white/80 pointer-fine:hover:bg-white/10 active:scale-[0.96] motion-reduce:transform-none"
        type="button"
        aria-label="Previous slide"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          class="size-6 text-white/60 transition-colors duration-160 pointer-fine:group-hover:text-white"
          aria-hidden="true"
        >
          <path
            d="M15.75 19.5L8.25 12l7.5-7.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          />
        </svg>
      </button>
      <button
        class="next arrow arrow-right group grid size-12.5 cursor-pointer place-items-center rounded-full border-2 border-white/33 bg-white/5 backdrop-blur-md transition-[transform,background-color,border-color] duration-160 ease-out pointer-fine:hover:border-white/80 pointer-fine:hover:bg-white/10 active:scale-[0.96] motion-reduce:transform-none"
        type="button"
        aria-label="Next slide"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          class="size-6 text-white/60 transition-colors duration-160 pointer-fine:group-hover:text-white"
          aria-hidden="true"
        >
          <path
            d="M8.25 4.5l7.5 7.5-7.5 7.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          />
        </svg>
      </button>

      <!-- Yellow Progress Band from Marrakech-Tours -->
      <div
        class="progress-sub-container z-60 flex h-12.5 w-[clamp(80px,14vw,220px)] items-center max-lg:w-[clamp(60px,10vw,130px)]"
        aria-hidden="true"
      >
        <div class="progress-sub-background h-0.75 w-full overflow-hidden bg-white/20">
          <div
            class="progress-sub-foreground h-full w-1/3 bg-[#ecad29] shadow-[0_0_10px_rgb(236_173_41/50%)] transition-[width] duration-750 ease-out-expo"
            id="slider-progress-bar"
          ></div>
        </div>
      </div>

      <!-- Slide Numbers Counter from Marrakech-Tours -->
      <div
        class="slide-numbers relative z-60 h-12.5 w-11 overflow-hidden"
        id="slide-numbers"
        aria-live="polite"
      >
        {currentSlides.map((_, index) => (
          <div
            class:list={[
              "number-item pointer-events-none absolute inset-0 grid place-items-center text-[clamp(1.25rem,1.8vw,1.85rem)] font-bold text-white select-none transition-[transform,opacity] duration-750 ease-out-expo translate-y-full opacity-0 [&.active]:translate-y-0 [&.active]:opacity-100",
              { active: index === 0 },
            ]}
            id={`slide-item-${index}`}
            data-number-index={index}
          >
            {index + 1}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script src="../../../scripts/slider.ts"></script>
