---
import { Image } from "astro:assets";
import bg1 from "../../../assets/images/Header/header-1.webp";
import bg2 from "../../../assets/images/Header/header-2.webp";
import bg3 from "../../../assets/images/Header/header-3.webp";
import SliderCards, { type SlideCardItem } from "./SliderCards.astro";
import SliderDetails from "./SliderDetails.astro";

interface Props {
  images?: (ImageMetadata | string)[];
}

const { images = [] } = Astro.props;

const locale = Astro.currentLocale || "en";

// Default high-resolution Moroccan travel images
const defaultImages = [images[0] || bg1, images[1] || bg2, images[2] || bg3];

// Localized slide content
const slidesData = {
  en: [
    {
      id: "sahara",
      tagline: "Welcome to Amsirar Trip",
      title: "TOUR TRAVEL",
      type: "& ADVENTURE CAMPING",
      description:
        "Specialist in Morocco travel and tours, Sahara desert trips, and excursions to the imperial cities of Morocco.",
    },
    {
      id: "atlas",
      tagline: "Welcome to Amsirar Trip",
      title: "ADVENTURE AWAITS",
      type: "BEYOND THE DUNES",
      description:
        "Specialist in Morocco travel and tours, Sahara desert trips, and excursions to the imperial cities of Morocco.",
    },
    {
      id: "imperial",
      tagline: "Welcome to Amsirar Trip",
      title: "PACK YOUR BAGS",
      type: "MOROCCO CALLS",
      description:
        "Specialist in Morocco travel and tours, Sahara desert trips, and excursions to the imperial cities of Morocco.",
    },
  ],
  fr: [
    {
      id: "sahara",
      tagline: "Bienvenue chez Amsirar Trip",
      title: "VOYAGE, AVENTURE",
      type: "ET CAMPING",
      description:
        "Spécialiste des voyages au Maroc, des circuits dans le désert du Sahara et des excursions vers les villes impériales.",
    },
    {
      id: "atlas",
      tagline: "Bienvenue chez Amsirar Trip",
      title: "L'AVENTURE VOUS ATTEND",
      type: "AU-DELÀ DES DUNES",
      description:
        "Spécialiste des voyages au Maroc, des circuits dans le désert du Sahara et des excursions vers les villes impériales.",
    },
    {
      id: "imperial",
      tagline: "Bienvenue chez Amsirar Trip",
      title: "PRÉPAREZ VOS VALISES",
      type: "LE MAROC VOUS APPELLE",
      description:
        "Spécialiste des voyages au Maroc, des circuits dans le désert du Sahara et des excursions vers les villes impériales.",
    },
  ],
  es: [
    {
      id: "sahara",
      tagline: "Bienvenidos a Amsirar Trip",
      title: "VIAJES, AVENTURA",
      type: "Y CAMPING",
      description:
        "Especialista en viajes y tours a Marruecos, viajes al desierto del Sahara y excursiones a las ciudades imperiales de Marruecos.",
    },
    {
      id: "atlas",
      tagline: "Bienvenidos a Amsirar Trip",
      title: "LA AVENTURA TE ESPERA",
      type: "MÁS ALLÁ DE LAS DUNAS",
      description:
        "Especialista en viajes y tours a Marruecos, viajes al desierto del Sahara y excursiones a las ciudades imperiales de Marruecos.",
    },
    {
      id: "imperial",
      tagline: "Bienvenidos a Amsirar Trip",
      title: "PREPARA TUS MALETAS",
      type: "MARRUECOS TE LLAMA",
      description:
        "Especialista en viajes y tours a Marruecos, viajes al desierto del Sahara y excursiones a las ciudades imperiales de Marruecos.",
    },
  ],
  de: [
    {
      id: "sahara",
      tagline: "Willkommen bei Amsirar Trip",
      title: "REISEN, ABENTEUER",
      type: "& CAMPING",
      description:
        "Spezialist für Reisen und Touren in Marokko, Wüstenreisen in die Sahara und Ausflüge zu den Königsstädten Marokkos.",
    },
    {
      id: "atlas",
      tagline: "Willkommen bei Amsirar Trip",
      title: "DAS ABENTEUER WARTET",
      type: "JENSEITS DER DÜNEN",
      description:
        "Spezialist für Reisen und Touren in Marokko, Wüstenreisen in die Sahara und Ausflüge zu den Königsstädten Marokkos.",
    },
    {
      id: "imperial",
      tagline: "Willkommen bei Amsirar Trip",
      title: "PACKEN SIE IHRE KOFFER",
      type: "MAROKKO RUFT",
      description:
        "Spezialist für Reisen und Touren in Marokko, Wüstenreisen in die Sahara und Ausflüge zu den Königsstädten Marokkos.",
    },
  ],
};

const currentSlides = (slidesData[locale as keyof typeof slidesData] || slidesData.en).map(
  (slide, index) => ({ ...slide, image: defaultImages[index] || defaultImages[0] || "" }),
);

const thumbnailCards: SlideCardItem[] = currentSlides.map((slide) => ({
  id: slide.id,
  image: slide.image,
  title: slide.title,
  type: slide.type,
}));
---

<section
  id="home-hero-slider-section"
  class="relative isolate w-full min-h-screen h-dvh overflow-hidden bg-black text-white"
  aria-roledescription="carousel"
  aria-label="Amsirar Trip Hero Carousel"
>
  <div
    class="slider relative h-screen w-screen overflow-hidden bg-[#050505] font-sans"
    id="home-hero-slider"
  >
    <!-- List of Full-Screen Slides -->
    <div class="list">
      {currentSlides.map((slide, index) => (
        <div
          class="item absolute inset-0 size-full"
          data-index={index}
        >
          {typeof slide.image === "string" ?
            <Image
              src={slide.image}
              alt={`${slide.title} - ${slide.type}`}
              decoding="async"
              fetchpriority={index === 0 ? "high" : "low"}
              loading="eager"
              width={1920}
              height={1080}
              class="size-full object-cover"
            />
          : <Image
              src={slide.image}
              alt={`${slide.title} - ${slide.type}`}
              decoding="async"
              fetchpriority={index === 0 ? "high" : "low"}
              loading="eager"
              class="size-full object-cover"
            />
          }
          <div
            class="slide-overlay pointer-events-none absolute inset-0 z-1 bg-[linear-gradient(to_bottom,rgb(0_0_0/55%)_0%,rgb(0_0_0/15%)_18%,transparent_32%),linear-gradient(to_top,rgb(0_0_0/40%)_0%,transparent_32%)]"
            aria-hidden="true"
          />
          <SliderDetails
            description={slide.description}
            isH1={index === 0}
            tagline={slide.tagline}
            title={slide.title}
            type={slide.type}
          />
        </div>
      ))}
    </div>

    <!-- Thumbnail Carousel Cards -->
    <SliderCards items={thumbnailCards} />

    <!-- Prev / Next Navigation Arrows & Marrakech-Tours Pagination Progress -->
    <div
      class="nextPrevArrows pagination absolute z-100 hidden w-auto items-center gap-3 md:flex left-[max(7%,calc(50%-570px))] max-lg:left-[5%] bottom-[calc(var(--thumb-bottom)+12px)] max-lg:bottom-[calc(var(--thumb-bottom)+10px)]"
      id="pagination"
      role="region"
      aria-label="Slider navigation and progress"
    >
      <button
        class="prev arrow arrow-left group grid size-12.5 cursor-pointer place-items-center rounded-full border-2 border-white/33 bg-white/5 backdrop-blur-md transition-[transform,background-color,border-color] duration-160 ease-out pointer-fine:hover:border-white/80 pointer-fine:hover:bg-white/10 active:scale-[0.96] motion-reduce:transform-none"
        type="button"
        aria-label="Previous slide"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          class="size-6 text-white/60 transition-colors duration-160 pointer-fine:group-hover:text-white"
          aria-hidden="true"
        >
          <path
            d="M15.75 19.5L8.25 12l7.5-7.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          />
        </svg>
      </button>
      <button
        class="next arrow arrow-right group grid size-12.5 cursor-pointer place-items-center rounded-full border-2 border-white/33 bg-white/5 backdrop-blur-md transition-[transform,background-color,border-color] duration-160 ease-out pointer-fine:hover:border-white/80 pointer-fine:hover:bg-white/10 active:scale-[0.96] motion-reduce:transform-none"
        type="button"
        aria-label="Next slide"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          class="size-6 text-white/60 transition-colors duration-160 pointer-fine:group-hover:text-white"
          aria-hidden="true"
        >
          <path
            d="M8.25 4.5l7.5 7.5-7.5 7.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          />
        </svg>
      </button>

      <!-- Yellow Progress Band from Marrakech-Tours -->
      <div
        class="progress-sub-container z-60 flex h-12.5 w-[clamp(80px,14vw,220px)] items-center max-lg:w-[clamp(60px,10vw,130px)]"
        aria-hidden="true"
      >
        <div class="progress-sub-background h-0.75 w-full overflow-hidden rounded-full bg-white/20">
          <div
            class="progress-sub-foreground h-full w-1/3 rounded-full bg-[#ecad29] shadow-[0_0_10px_rgb(236_173_41/50%)] transition-[width] duration-750 ease-[cubic-bezier(0.16,1,0.3,1)]"
            id="slider-progress-bar"
          ></div>
        </div>
      </div>

      <!-- Slide Numbers Counter from Marrakech-Tours -->
      <div
        class="slide-numbers relative z-60 h-12.5 w-11 overflow-hidden"
        id="slide-numbers"
        aria-live="polite"
      >
        {currentSlides.map((_, index) => (
          <div
            class:list={[
              "number-item pointer-events-none absolute inset-0 grid place-items-center text-[clamp(1.25rem,1.8vw,1.85rem)] font-bold text-white select-none transition-[transform,opacity] duration-750 ease-[cubic-bezier(0.16,1,0.3,1)] translate-y-full opacity-0 [&.active]:translate-y-0 [&.active]:opacity-100",
              { active: index === 0 },
            ]}
            id={`slide-item-${index}`}
            data-number-index={index}
          >
            {index + 1}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script src="../../../scripts/slider.ts"></script>
