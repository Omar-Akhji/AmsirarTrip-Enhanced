---
import { useTranslations } from "@/i18n/utils";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import ScrollStack from "./ScrollStack.astro";
import ScrollStackItem from "./ScrollStackItem.astro";

const locale = Astro.locals.locale;
const t = useTranslations(locale);

const destinationEntries = await getCollection("destinations");
const preferredOrder = ["marrakech", "fez", "chefchaouen", "dadesValley", "casablanca", "rabat"];
const cities = destinationEntries
  .toSorted((a, b) => {
    const aIndex = preferredOrder.indexOf(a.id);
    const bIndex = preferredOrder.indexOf(b.id);
    return (aIndex === -1 ? 99 : aIndex) - (bIndex === -1 ? 99 : bIndex);
  })
  .map((entry) => entry.data);

const DELAY_CLASSES = [
  "animate-delay-0",
  "animate-delay-120",
  "animate-delay-240",
  "animate-delay-360",
  "animate-delay-480",
  "animate-delay-600",
] as const;
---

<section
  aria-labelledby="featured-heading"
  class="relative isolate overflow-visible bg-neutral-50 py-12 sm:py-16 lg:py-24 text-neutral-900 dark:bg-surface-base dark:text-mist-100"
  id="featured"
>
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(248,250,252,0.3),transparent_70%)] dark:bg-[radial-gradient(circle_at_center,rgba(13,18,23,0.6),transparent_70%)]"
  ></div>
  <div class="relative z-10 mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
    <div
      class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8 dark:border-white/10"
      data-animate="creative-slide-right"
    >
      <hgroup class="max-w-2xl space-y-2">
        <h2
          class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance dark:text-mist-100"
          id="featured-heading"
        >
          {locale === "fr" ?
            <>
              Destinations emblématiques <span class="text-orange">du Maroc</span>
            </>
          : locale === "es" ?
            <>
              Destinos emblemáticos <span class="text-orange">de Marruecos</span>
            </>
          : locale === "de" ?
            <>
              Höhepunkte und <span class="text-orange">Regionen Marokkos</span>
            </>
          : <>
              Signature Destinations <span class="text-orange">Across Morocco</span>
            </>
          }
        </h2>
        <p class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 dark:text-mist-300 leading-relaxed max-w-[62ch]">
          {locale === "fr" ?
            "Des ruelles ocres de Marrakech aux crêtes dorées de l'Erg Chebbi et gorges spectaculaires de l'Atlas."
          : locale === "es" ?
            "De los callejones de Marrakech a las dunas doradas de Erg Chebbi y las gargantas del Atlas."
          : locale === "de" ?
            "Von den Lehmpalästen in Marrakesch bis zu den goldenen Erg-Chebbi-Dünen und Tälern des Hohen Atlas."
          : "From the terracotta ramparts of Marrakech to the Erg Chebbi dunes and High Atlas mountain passes."
          }
        </p>
      </hgroup>
    </div>
    <svg
      class="sr-only"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <linearGradient
          id="royal-yellow-gradient"
          x1="0%"
          y1="0%"
          x2="100%"
          y2="100%"
        >
          <stop
            offset="0%"
            stop-color="var(--color-yellow, #B58A45)"
          ></stop>
          <stop
            offset="50%"
            stop-color="var(--color-amber-orange, #f27a24)"
          ></stop>
          <stop
            offset="100%"
            stop-color="var(--color-yellow, #B58A45)"
          ></stop>
        </linearGradient>
      </defs>
    </svg>

    {/* Mobile Mode: Animated GSAP & Lenis ScrollStack (https://reactbits.dev/components/scroll-stack) */}
    <div class="block md:hidden w-full">
      <ScrollStack
        useWindowScroll={true}
        itemDistance={100}
        itemStackDistance={24}
        stackPosition="88px"
        itemScale={0.045}
        baseScale={0.8}
        dimAmount={0.2}
        blurAmount={0.8}
        tiltAmount={2}
        rotationAmount={1.5}
        holdDistance={180}
      >
        {cities.map((city) => {
          const regionKey = city.titleKey.replace(".title", ".region");
          const regionText = t(regionKey);
          const cityTitle = t(city.titleKey);
          const cityDesc = t(city.descriptionKey);
          const cityAlt = t.has(city.altKey) ? t(city.altKey) : cityTitle;

          return (
            <ScrollStackItem itemClassName="group">
              <article class="relative size-full overflow-hidden rounded-2xl bg-slate-950 border-2 border-stone-800/80 shadow-2xl select-none">
                <div class="absolute inset-0 size-full">
                  <Image
                    alt={cityAlt}
                    class="size-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105 motion-reduce:transform-none"
                    decoding="async"
                    height={450}
                    loading="lazy"
                    src={city.image}
                    width={600}
                  />
                </div>

                <div
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-0 bg-linear-to-t from-slate-950 via-slate-950/65 via-50% to-slate-950/20"
                />

                <div class="relative z-10 flex size-full flex-col justify-end p-3.5 sm:p-4 text-white">
                  <div class="rounded-2xl border border-white/10 bg-white/10 p-4 shadow-xs ring-1 ring-black/5 backdrop-blur-[20px]">
                    <hgroup class="mbe-1.5">
                      <p class="font-mono text-[11px] font-semibold tracking-[0.16em] text-yellow uppercase mbe-1">
                        {regionText === regionKey ? "MOROCCO" : regionText}
                      </p>
                      <h3 class="text-xl font-bold tracking-tight text-white drop-shadow-xs">
                        {cityTitle}
                      </h3>
                    </hgroup>
                    <p class="text-xs text-stone-200/95 leading-relaxed line-clamp-3 drop-shadow-xs">
                      {cityDesc}
                    </p>
                  </div>
                </div>

                <div
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-0 rounded-2xl border-2 border-yellow/20"
                />
              </article>
            </ScrollStackItem>
          );
        })}
      </ScrollStack>
    </div>

    {/* Desktop & Tablet Mode: 3-column Grid */}
    <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 2xl:gap-10">
      {cities.map((city, index) => {
        const regionKey = city.titleKey.replace(".title", ".region");
        const regionText = t(regionKey);
        const cityTitle = t(city.titleKey);
        const cityDesc = t(city.descriptionKey);
        const cityAlt = t.has(city.altKey) ? t(city.altKey) : cityTitle;

        return (
          <div
            class:list={[DELAY_CLASSES[index] || "animate-delay-0"]}
            data-animate="card-fan-rise"
          >
            <article class="group relative block aspect-4/3 w-full select-none">
              <!-- Inner Image Card (Rounded image surface with dark luxury background) -->
              <div
                data-scroll-parallax
                class="relative size-full overflow-clip rounded-2xl border-2 border-stone-200/80 bg-slate-950 shadow-xs transition-shadow duration-700 ease-out-expo pointer-fine:group-hover:shadow-[0_20px_40px_rgba(0,0,0,0.3)]"
              >
                <div class="parallax-media pointer-events-none absolute -inset-y-5 inset-x-0 size-[calc(100%+40px)]">
                  <Image
                    alt={cityAlt}
                    class="size-full object-cover will-change-transform transition-transform duration-700 ease-out-expo pointer-fine:motion-safe:group-hover:scale-105 motion-reduce:transform-none motion-reduce:transition-none"
                    decoding="async"
                    height={450}
                    loading="lazy"
                    src={city.image}
                    width={600}
                  />
                </div>

                <!-- Ambient Scrim: Deepens smoothly on hover to frame the full text -->
                <div
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-0 bg-linear-to-t from-slate-950/95 via-slate-950/50 via-45% to-slate-950/15 opacity-85 transition-opacity duration-600 ease-out-expo pointer-fine:group-hover:opacity-100"
                />

                <!-- Editorial Typography Layer -->
                <div class="relative z-10 flex size-full flex-col justify-end p-3 sm:p-3.5 text-white pointer-events-none">
                  <div class="rounded-2xl border border-white/10 bg-white/10 p-4 sm:p-5 shadow-xs ring-1 ring-black/5 backdrop-blur-[20px] transition-all duration-300 pointer-fine:group-hover:border-white/20 pointer-fine:group-hover:bg-white/15">
                    <hgroup class="mbe-2">
                      <p class="font-mono text-[11px] font-semibold tracking-[0.16em] text-yellow uppercase mbe-1">
                        {regionText === regionKey ? "MOROCCO" : regionText}
                      </p>
                      <h3 class="text-xl font-bold tracking-tight text-white sm:text-2xl drop-shadow-xs">
                        {cityTitle}
                      </h3>
                    </hgroup>

                    <!-- Full Text Animated Drawer (Opens smoothly on hover) -->
                    <div class="grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity,margin-block-start] duration-500 ease-out-expo motion-reduce:transition-none pointer-fine:group-hover:grid-rows-[1fr] pointer-fine:group-hover:opacity-100 pointer-fine:group-hover:mbs-2 pointer-coarse:grid-rows-[1fr] pointer-coarse:opacity-100 pointer-coarse:mbs-2">
                      <div class="overflow-hidden">
                        <p class="text-xs sm:text-sm text-stone-200/95 leading-relaxed drop-shadow-xs transition-transform duration-500 ease-out-expo motion-reduce:transition-none translate-y-2 pointer-fine:group-hover:translate-y-0 pointer-coarse:translate-y-0">
                          {cityDesc}
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Animated Royal Yellow Aura Border (Wrapped around the image with an intentional 7px floating space) -->
              <svg
                aria-hidden="true"
                class="pointer-events-none absolute -inset-2 z-20 size-[calc(100%+16px)] overflow-visible"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <rect
                  class="opacity-0 [stroke-dasharray:100] [stroke-dashoffset:100] drop-shadow-[0_0_6px_oklch(84%_0.18_90deg/35%)] transition-[stroke-dashoffset,opacity] duration-500 ease-out-expo pointer-fine:group-hover:opacity-100 pointer-fine:group-hover:[stroke-dashoffset:0] pointer-fine:group-hover:duration-700 motion-reduce:opacity-100 motion-reduce:[stroke-dashoffset:0] motion-reduce:transition-opacity motion-reduce:duration-200"
                  height="calc(100% - 2px)"
                  pathLength="100"
                  rx="23"
                  stroke="url(#royal-yellow-gradient)"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  vector-effect="non-scaling-stroke"
                  width="calc(100% - 2px)"
                  x="1"
                  y="1"
                />
              </svg>
            </article>
          </div>
        );
      })}
    </div>
  </div>
</section>
