---
import { Skeleton } from "@/components/ui/skeleton";
import ButtonSkeleton from "@/shared/ui/feedback/ButtonSkeleton.astro";

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<section
  aria-busy="true"
  aria-label="Loading traveler reviews"
  class:list={["bg-zinc-50 py-12 sm:py-16 lg:py-24", className]}
>
  <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
    <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8">
      <hgroup class="max-w-2xl space-y-2">
        <div class="text-3xl sm:text-4xl font-bold leading-tight">
          <Skeleton class="h-[1.15em] w-72 sm:w-96 max-w-full" />
        </div>
        <div class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm/relaxed sm:text-base space-y-2 max-w-[62ch]">
          <Skeleton class="h-4 sm:h-5 w-full" />
          <Skeleton class="h-4 sm:h-5 w-3/4 sm:hidden" />
        </div>
      </hgroup>
      <div class="flex items-center">
        <ButtonSkeleton
          class="w-32"
          size="sm"
          variant="outline"
        />
      </div>
    </div>

    {/* Match TestimonialsSideScroll 280vh runway */}
    <div class="relative w-full h-auto motion-safe:h-[280vh]">
      <div class="py-4">
        <div class="flex items-stretch gap-6 overflow-hidden pb-4">
          {Array.from({ length: 4 }, () => (
            <div class="w-full sm:w-88 md:w-88 lg:w-92 2xl:w-96 3xl:w-105 shrink-0 flex flex-col">
              <article class="relative flex size-full flex-col justify-between overflow-hidden rounded-2xl border border-stone-200/90 bg-white p-5 shadow-xs sm:p-6">
                <figure class="m-0 flex size-full flex-col justify-between p-0">
                  <div>
                    {/* Review Meta Header */}
                    <div class="relative z-1 mbe-3 flex items-center justify-between border-b border-stone-100 pbe-2.5">
                      <Skeleton class="h-4 w-36" />
                      <Skeleton class="h-4 w-16" />
                    </div>

                    {/* Editorial Quote */}
                    <div class="mbe-4 space-y-2">
                      <Skeleton class="h-4 w-full" />
                      <Skeleton class="h-4 w-11/12" />
                      <Skeleton class="h-4 w-11/12" />
                      <Skeleton class="h-4 w-3/4" />
                    </div>
                  </div>

                  {/* Guest Signature */}
                  <figcaption class="mbs-auto border-t border-stone-100 pbs-3 space-y-1.5">
                    <Skeleton class="h-4 w-32" />
                    <div class="flex items-center gap-2">
                      <Skeleton class="h-3 w-20" />
                      <span class="text-stone-300">·</span>
                      <Skeleton class="h-3 w-16" />
                    </div>
                  </figcaption>
                </figure>
              </article>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
