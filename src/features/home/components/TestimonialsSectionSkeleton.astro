---
import AsciiSkeleton from "@/shared/ui/feedback/AsciiSkeleton.astro";
import ButtonSkeleton from "@/shared/ui/feedback/ButtonSkeleton.astro";

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<section
  aria-busy="true"
  aria-label="Loading traveler reviews"
  class:list={["bg-zinc-50 py-12 sm:py-16 lg:py-24", className]}
>
  <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
    <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8">
      <hgroup class="max-w-2xl space-y-2">
        <h2 class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance">
          <AsciiSkeleton
            class="text-stone-900 font-bold"
            lines={1}
            variant="dither"
            widths={["18rem"]}
          />
        </h2>
        <div class="border-s-2 border-orange-600 ps-4 py-0.5 max-w-[62ch]">
          <AsciiSkeleton
            class="text-stone-600 text-sm sm:text-base leading-relaxed"
            lines={2}
            variant="dither"
            widths={["100%", "78%"]}
          />
        </div>
      </hgroup>
      <div class="flex items-center">
        <ButtonSkeleton
          size="sm"
          variant="outline"
          class="w-32"
        />
      </div>
    </div>

    <div class="relative w-full">
      {/* Mobile View: Stacked Card matching TestimonialsScrollStack */}
      <div class="block md:hidden w-full">
        <div class="flex flex-col gap-5 w-full">
          {Array.from({ length: 3 }, () => (
            <article class="relative flex w-full flex-col justify-between overflow-hidden rounded-2xl border border-stone-200/90 bg-white p-5 sm:p-6 shadow-xl">
              <div>
                <div class="mbe-3 flex items-center justify-between border-b border-stone-100 pb-2.5 font-mono text-[11px]">
                  <AsciiSkeleton
                    class="text-orange-600 font-bold tracking-[0.14em] uppercase"
                    lines={1}
                    variant="dither"
                    widths={["8.5rem"]}
                  />
                  <div class="flex items-center gap-1 text-stone-300">
                    <AsciiSkeleton
                      class="text-amber-500"
                      lines={1}
                      variant="dither"
                      widths={["4rem"]}
                    />
                  </div>
                </div>
                <div class="mbe-4 space-y-1.5">
                  <AsciiSkeleton
                    class="text-sm leading-relaxed text-stone-600"
                    lines={3}
                    variant="dither"
                    widths={["100%", "94%", "72%"]}
                  />
                </div>
              </div>
              <div class="border-t border-stone-100 pt-3">
                <AsciiSkeleton
                  class="text-sm font-bold text-stone-800"
                  lines={1}
                  variant="dither"
                  widths={["7rem"]}
                />
                <div class="mbs-1">
                  <AsciiSkeleton
                    class="text-xs text-stone-400"
                    lines={1}
                    variant="dither"
                    widths={["10rem"]}
                  />
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>

      {/* Desktop & Tablet View: Horizontal Slider matching TestimonialsSideScroll */}
      <div class="hidden md:flex items-stretch gap-6 overflow-hidden pb-4">
        {Array.from({ length: 4 }, () => (
          <div class="w-80 md:w-88 lg:w-92 2xl:w-96 3xl:w-105 shrink-0 flex flex-col">
            <article class="relative flex size-full flex-col justify-between overflow-hidden rounded-2xl border border-stone-200/90 bg-white p-5 shadow-xs sm:p-6">
              <figure class="m-0 flex size-full flex-col justify-between p-0">
                <div>
                  {/* Review Meta Header */}
                  <div class="relative z-1 mbe-3 flex items-center justify-between border-b border-stone-100 pbe-2.5 font-mono text-[11px]">
                    <AsciiSkeleton
                      class="font-bold tracking-[0.14em] text-orange-600 uppercase"
                      lines={1}
                      variant="dither"
                      widths={["9rem"]}
                    />
                    <AsciiSkeleton
                      class="text-amber-500"
                      lines={1}
                      variant="dither"
                      widths={["4.5rem"]}
                    />
                  </div>

                  {/* Editorial Quote */}
                  <div class="mbe-4 space-y-1.5">
                    <AsciiSkeleton
                      class="text-sm leading-relaxed text-stone-600"
                      lines={3}
                      variant="dither"
                      widths={["100%", "92%", "75%"]}
                    />
                  </div>
                </div>

                {/* Guest Signature */}
                <figcaption class="mbs-auto border-t border-stone-100 pbs-3 space-y-1.5">
                  <AsciiSkeleton
                    class="text-sm font-bold text-stone-800"
                    lines={1}
                    variant="dither"
                    widths={["8rem"]}
                  />
                  <div class="flex items-center gap-2 font-mono text-xs text-stone-400">
                    <AsciiSkeleton
                      class="text-stone-400"
                      lines={1}
                      variant="dither"
                      widths={["5.5rem"]}
                    />
                    <span class="text-stone-300">·</span>
                    <AsciiSkeleton
                      class="text-stone-400"
                      lines={1}
                      variant="dither"
                      widths={["4.5rem"]}
                    />
                  </div>
                </figcaption>
              </figure>
            </article>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
