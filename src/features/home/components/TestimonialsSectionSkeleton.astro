---
import AsciiSkeleton from "@/shared/ui/AsciiSkeleton.astro";
import { CircleCheck, Star } from "@lucide/astro";

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<section
  aria-busy="true"
  aria-label="Loading traveler reviews"
  class:list={["bg-zinc-50 py-12 sm:py-16 lg:py-24", className]}
>
  <div class="mx-auto px-4 max-inline-330">
    <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8">
      <hgroup class="max-w-2xl space-y-2">
        <AsciiSkeleton
          class="text-3xl font-bold tracking-tight text-stone-800 sm:text-4xl"
          lines={1}
          variant="dither"
          widths={["18rem"]}
        />
        <div class="border-s-2 border-stone-300 ps-4 py-0.5 max-w-[62ch]">
          <AsciiSkeleton
            class="text-stone-500 text-sm sm:text-base"
            lines={2}
            variant="dither"
            widths={["100%", "80%"]}
          />
        </div>
      </hgroup>
    </div>

    <div class="relative">
      <div class="grid grid-cols-1 justify-items-stretch gap-6 md:grid-cols-2 lg:grid-cols-3">
        {Array.from({ length: 3 }, (_, index) => (
          <div class:list={[`flex size-full`, { "md:col-span-2 lg:col-span-1": index === 2 }]}>
            <article class="group relative flex size-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-white p-6 shadow-xs sm:p-8">
              <figure class="m-0 flex size-full flex-col justify-between p-0">
                <div>
                  <!-- Dispatch Meta Header -->
                  <div class="mbe-4 flex items-center justify-between border-b border-stone-100 pbe-3 font-mono text-xs">
                    <AsciiSkeleton
                      class="text-stone-400 font-bold tracking-[0.14em] uppercase"
                      lines={1}
                      variant="scan"
                      widths={["13ch"]}
                    />
                    <div class="flex items-center gap-0.5 text-stone-300">
                      {Array.from({ length: 5 }, () => (
                        <Star
                          aria-hidden="true"
                          class="size-3.5 fill-current"
                          stroke-width={1.5}
                        />
                      ))}
                    </div>
                  </div>

                  <!-- Editorial Quote -->
                  <div class="mbe-6 space-y-2">
                    <AsciiSkeleton
                      class="text-sm leading-relaxed text-stone-600 sm:text-base"
                      lines={3}
                      variant="dither"
                      widths={["100%", "92%", "75%"]}
                    />
                  </div>
                </div>

                <!-- Guest Signature -->
                <figcaption class="mbs-auto border-t border-stone-100 pbs-4 space-y-2">
                  <AsciiSkeleton
                    class="text-sm font-bold text-stone-800"
                    lines={1}
                    variant="scan"
                    widths={["9rem"]}
                  />
                  <div class="mbs-1 flex items-center gap-2 font-mono text-xs text-stone-400">
                    <AsciiSkeleton
                      class="text-stone-400"
                      lines={1}
                      variant="terminal"
                      widths={["6rem"]}
                    />
                    <span class="text-stone-300">·</span>
                    <span class="inline-flex items-center gap-1 font-sans text-xs font-medium text-stone-400">
                      <CircleCheck
                        aria-hidden="true"
                        class="size-3 text-stone-400"
                      />
                      Verified
                    </span>
                  </div>
                </figcaption>
              </figure>
            </article>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
