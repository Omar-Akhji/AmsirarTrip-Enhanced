---
import { Skeleton } from "@/components/ui/skeleton";

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;

const serviceCardSkeletons = [
  { key: "handcrafted", titleWidth: "w-48" },
  { key: "guide", titleWidth: "w-40" },
  { key: "price", titleWidth: "w-44" },
];
---

<section
  aria-busy="true"
  aria-label="Loading services"
  class:list={[
    "relative overflow-visible py-12 sm:py-16 lg:py-24 text-orange-200 bg-stone-950",
    className,
  ]}
>
  {/* Dark background */}
  <div class="absolute inset-0 size-full overflow-hidden bg-stone-950">
    <Skeleton class="size-full rounded-none bg-stone-900/60" />
  </div>
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-black/45"
  ></div>

  <div class="relative mx-auto px-4 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420 sm:px-6 lg:px-8">
    <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-white/10 pb-6 sm:pb-8">
      <hgroup class="max-w-2xl space-y-3">
        <div class="flex flex-wrap items-baseline gap-3">
          <Skeleton class="h-9 w-44 bg-white/20" />
          <Skeleton class="h-9 w-52 bg-white/15" />
        </div>
        <div class="border-s-2 border-yellow ps-4 py-0.5 space-y-2 max-w-[62ch]">
          <Skeleton class="h-4 w-full bg-white/15" />
          <Skeleton class="h-4 w-4/5 bg-white/15" />
        </div>
      </hgroup>
    </div>

    {/* Mobile Mode: Stacked Cards matching ServicesScrollStack */}
    <div class="block md:hidden w-full">
      <div class="flex flex-col gap-5 w-full">
        {serviceCardSkeletons.map((card) => (
          <article
            class="flex flex-col items-center rounded-2xl border border-white/10 bg-white/10 p-8 text-center shadow-xs ring-1 ring-black/5 backdrop-blur-xl size-full"
          >
            <div class="mbe-6 inline-flex size-25 items-center justify-center rounded-full bg-white/5 ring-1 ring-white/10">
              <Skeleton class="size-15 rounded-full bg-white/15" />
            </div>
            <div class="w-full flex justify-center">
              <Skeleton class:list={["h-6 bg-white/20", card.titleWidth]} />
            </div>
            <div class="mbs-3 w-full space-y-2 flex flex-col items-center">
              <Skeleton class="h-3.5 w-full bg-white/15" />
              <Skeleton class="h-3.5 w-11/12 bg-white/15" />
              <Skeleton class="h-3.5 w-3/4 bg-white/15" />
            </div>
          </article>
        ))}
      </div>
    </div>

    {/* Desktop & Tablet Mode: 3-column Grid matching ServicesSection.astro */}
    <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 justify-items-stretch gap-6 2xl:gap-8">
      {serviceCardSkeletons.map((card, index) => (
        <article
          class:list={[
            "flex flex-col items-center rounded-2xl border border-white/10 bg-white/10 p-8 text-center shadow-xs ring-1 ring-black/5 backdrop-blur-xl size-full",
            { "md:col-span-2 lg:col-span-1": index === 2 },
          ]}
        >
          {/* Circular icon skeleton */}
          <div class="mbe-6 inline-flex size-25 items-center justify-center rounded-full bg-white/5 ring-1 ring-white/10">
            <Skeleton class="size-15 rounded-full bg-white/15" />
          </div>

          {/* Card Title Skeleton */}
          <div class="w-full flex justify-center">
            <Skeleton class:list={["h-6 bg-white/20", card.titleWidth]} />
          </div>

          {/* Card Description Skeleton */}
          <div class="mbs-3 w-full space-y-2 flex flex-col items-center">
            <Skeleton class="h-3.5 w-full bg-white/15" />
            <Skeleton class="h-3.5 w-11/12 bg-white/15" />
            <Skeleton class="h-3.5 w-3/4 bg-white/15" />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
