---
import AsciiSkeleton from "@/shared/ui/feedback/AsciiSkeleton.astro";

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;

const serviceCardSkeletons = [
  { key: "handcrafted", titleWidth: "15rem", textLines: 3, textWidths: ["100%", "94%", "68%"] },
  { key: "guide", titleWidth: "11rem", textLines: 4, textWidths: ["100%", "98%", "92%", "58%"] },
  { key: "price", titleWidth: "12rem", textLines: 3, textWidths: ["100%", "95%", "76%"] },
];
---

<section
  aria-busy="true"
  aria-label="Loading services"
  class:list={[
    "relative overflow-visible py-12 sm:py-16 lg:py-24 text-orange-200 bg-stone-950",
    className,
  ]}
>
  {/* Background ASCII skeleton image & dark overlay matching services-bg.webp */}
  <div class="absolute inset-0 size-full overflow-hidden bg-stone-950">
    <AsciiSkeleton
      class="ars-image ars-hero-bg size-full text-stone-700/35"
      rows={40}
      variant="dither"
    />
  </div>
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-black/45"
  ></div>

  <div class="relative mx-auto px-4 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420 sm:px-6 lg:px-8">
    <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-white/10 pb-6 sm:pb-8">
      <hgroup class="max-w-2xl space-y-2">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl text-balance flex flex-wrap items-baseline gap-x-3">
          <AsciiSkeleton
            class="text-stone-300"
            lines={1}
            variant="dither"
            widths={["14rem"]}
          />
          <AsciiSkeleton
            class="text-stone-400"
            lines={1}
            variant="dither"
            widths={["17rem"]}
          />
        </h2>
        <div class="border-s-2 border-yellow ps-4 py-0.5 text-sm sm:text-base text-zinc-100/90 leading-relaxed max-w-[62ch]">
          <AsciiSkeleton
            class="text-zinc-100/85"
            lines={2}
            variant="dither"
            widths={["100%", "85%"]}
          />
        </div>
      </hgroup>
    </div>

    {/* Mobile Mode: Stacked Cards matching ServicesScrollStack */}
    <div class="block md:hidden w-full">
      <div class="flex flex-col gap-5 w-full">
        {serviceCardSkeletons.map((card) => (
          <article
            class="flex flex-col items-center rounded-2xl border border-white/10 bg-white/10 p-8 text-center shadow-xs ring-1 ring-black/5 backdrop-blur-xl size-full"
            style="backdrop-filter: blur(20px);"
          >
            <div class="mbe-6 inline-flex size-25 items-center justify-center rounded-full bg-white/5 ring-1 ring-white/10">
              <AsciiSkeleton
                class="size-15 rounded-full overflow-hidden text-stone-400"
                rows={5}
                variant="dither"
              />
            </div>
            <h3 class="w-full text-center text-xl font-semibold text-white">
              <AsciiSkeleton
                class="text-stone-300 text-center mx-auto"
                lines={1}
                variant="dither"
                widths={[card.titleWidth]}
              />
            </h3>
            <div class="mbs-3 w-full text-center text-sm text-zinc-200 leading-relaxed">
              <AsciiSkeleton
                class="text-zinc-200/85 text-center mx-auto"
                lines={card.textLines}
                variant="dither"
                widths={card.textWidths}
              />
            </div>
          </article>
        ))}
      </div>
    </div>

    {/* Desktop & Tablet Mode: 3-column Grid matching ServicesSection.astro */}
    <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 justify-items-stretch gap-6 2xl:gap-8">
      {serviceCardSkeletons.map((card, index) => (
        <article
          class:list={[
            "flex flex-col items-center rounded-2xl border border-white/10 bg-white/10 p-8 text-center shadow-xs ring-1 ring-black/5 backdrop-blur-xl size-full",
            { "md:col-span-2 lg:col-span-1": index === 2 },
          ]}
          style="backdrop-filter: blur(20px);"
        >
          {/* Circular icon skeleton */}
          <div class="mbe-6 inline-flex size-25 items-center justify-center rounded-full bg-white/5 ring-1 ring-white/10">
            <AsciiSkeleton
              class="size-15 rounded-full overflow-hidden text-stone-400"
              rows={5}
              variant="dither"
            />
          </div>

          {/* Card Title Skeleton matching exact h3 typography and content width */}
          <h3 class="w-full text-center text-xl font-semibold text-white">
            <AsciiSkeleton
              class="text-stone-300 text-center mx-auto"
              lines={1}
              variant="dither"
              widths={[card.titleWidth]}
            />
          </h3>

          {/* Card Description Skeleton matching exact p typography and line count */}
          <div class="mbs-3 w-full text-center text-sm text-zinc-200 leading-relaxed">
            <AsciiSkeleton
              class="text-zinc-200/85 text-center mx-auto"
              lines={card.textLines}
              variant="dither"
              widths={card.textWidths}
            />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
