---
import AsciiSkeleton from "@/shared/ui/AsciiSkeleton.astro";
import { MapPinned } from "@lucide/astro";

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<section
  aria-busy="true"
  aria-label="Loading fleet and transport services"
  class:list={[
    "relative bg-stone-100 py-12 sm:py-16 lg:py-24 text-stone-900 border-y border-stone-200",
    className,
  ]}
>
  <div class="mx-auto px-4 max-inline-7xl sm:px-6 lg:px-8">
    <!-- Header: Editorial & Left-Aligned with Meta -->
    <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8">
      <hgroup class="max-w-2xl space-y-2">
        <AsciiSkeleton
          class="text-3xl font-bold tracking-tight text-stone-800 sm:text-4xl"
          lines={1}
          variant="dither"
          widths={["22rem"]}
        />
        <div class="border-s-2 border-stone-300 ps-4 py-0.5 max-w-[62ch]">
          <AsciiSkeleton
            class="text-stone-500 text-sm sm:text-base"
            lines={2}
            variant="dither"
            widths={["100%", "85%"]}
          />
        </div>
      </hgroup>
    </div>

    <!-- Asymmetric 7/5 Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <!-- Left 7 Cols: Image & Fleet Specifications -->
      <div class="lg:col-span-7 flex flex-col justify-between rounded-2xl border border-stone-200/90 bg-white p-6 sm:p-8 shadow-xs">
        <div class="relative overflow-hidden rounded-xl aspect-video mbe-6 bg-stone-900">
          <AsciiSkeleton
            class="ars-image size-full text-stone-700/40"
            rows={28}
            variant="dither"
          />
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/70 via-black/20 to-transparent"
          ></div>
          <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-white text-xs font-mono">
            <span class="flex items-center gap-2">
              <MapPinned
                aria-hidden="true"
                class="size-3.5 text-stone-300"
                stroke-width={2}
              />
              <AsciiSkeleton
                class="text-stone-300 text-xs font-mono"
                lines={1}
                variant="scan"
                widths={["14ch"]}
              />
            </span>
            <AsciiSkeleton
              class="text-stone-400 text-xs font-mono"
              lines={1}
              variant="scan"
              widths={["8ch"]}
            />
          </div>
        </div>

        <div>
          <AsciiSkeleton
            class="text-lg font-bold tracking-tight text-stone-800 mbe-3"
            lines={1}
            variant="dither"
            widths={["16rem"]}
          />
          <div class="mbe-6">
            <AsciiSkeleton
              class="text-sm text-stone-500 leading-relaxed"
              lines={2}
              variant="dither"
              widths={["100%", "78%"]}
            />
          </div>

          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-stone-100 pt-5">
            {Array.from({ length: 4 }, () => (
              <div class="space-y-1.5">
                <AsciiSkeleton
                  class="font-mono text-xs text-stone-400 uppercase tracking-wider"
                  lines={1}
                  variant="terminal"
                  widths={["7rem"]}
                />
                <AsciiSkeleton
                  class="text-sm font-semibold text-stone-800"
                  lines={1}
                  variant="scan"
                  widths={["12rem"]}
                />
              </div>
            ))}
          </dl>
        </div>
      </div>

      <!-- Right 5 Cols: 3 Purposeful Pillars -->
      <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 lg:grid-rows-3 gap-4 items-stretch">
        {Array.from({ length: 3 }, (_, index) => (
          <div class:list={["flex size-full", { "sm:col-span-2 lg:col-span-1": index === 2 }]}>
            <article class="flex-1 rounded-2xl border border-stone-200/90 bg-white p-6 shadow-xs flex flex-col justify-between w-full">
              <div>
                <div class="flex items-center justify-between mbe-3">
                  <AsciiSkeleton
                    class="font-mono text-xs font-bold text-stone-500 tracking-wider"
                    lines={1}
                    variant="terminal"
                    widths={["3ch"]}
                  />
                  <div class="size-8 rounded-lg bg-stone-100 flex items-center justify-center text-stone-400">
                    <span class="size-4 rounded bg-stone-300/60 block"></span>
                  </div>
                </div>
                <AsciiSkeleton
                  class="text-base font-bold text-stone-800 tracking-tight mbe-2"
                  lines={1}
                  variant="dither"
                  widths={["85%"]}
                />
                <AsciiSkeleton
                  class="text-xs sm:text-sm text-stone-500 leading-relaxed"
                  lines={2}
                  variant="dither"
                  widths={["100%", "70%"]}
                />
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
