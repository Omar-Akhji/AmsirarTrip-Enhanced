---
import { useTranslations } from "@/i18n/utils";
import CheckCircleIcon from "@/shared/ui/icons/CheckCircleIcon.astro";
import QuoteIcon from "@/shared/ui/icons/QuoteIcon.astro";
import StarIcon from "@/shared/ui/icons/StarIcon.astro";

interface TestimonialItem {
  key: string;
}

interface Props {
  testimonials: TestimonialItem[];
}

const { testimonials } = Astro.props;
const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);
---

<testimonials-scroll-stack class="block relative w-full overflow-visible">
  <!-- Scroll runway: comfortable distance to progressively stack all review cards -->
  <div
    class="testimonials-stack-track relative w-full h-auto motion-safe:h-[calc(100vh+var(--runway))]"
    style={`--runway: ${testimonials.length * 40}vh;`}
  >
    <!-- Pinned Stage: Stays sticky in the viewport, using full container width -->
    <div class="testimonials-stack-stage static h-auto top-auto select-auto motion-safe:sticky motion-safe:top-18 motion-safe:h-135 sm:motion-safe:h-140 motion-safe:select-none w-full mx-auto overflow-visible">
      <!-- Cards Stack Layer with 3D perspective -->
      <div class="cards-stack-layer static h-auto flex flex-col gap-4 motion-safe:block motion-safe:absolute motion-safe:inset-x-0 motion-safe:top-2 motion-safe:h-105 sm:motion-safe:h-108 motion-safe:will-change-transform motion-safe:z-10 motion-safe:perspective-distant">
        {testimonials.map((tst, index) => {
          const guestName = t(`testimonials.items.${tst.key}.name`);
          const guestCountry = t(`testimonials.items.${tst.key}.country`);
          const guestQuote = t(`testimonials.items.${tst.key}.quote`);

          return (
            <div
              data-stack-card={index}
              class="testimonial-card-slot static inset-auto opacity-100 transform-none h-105 sm:h-108 w-full origin-top motion-safe:absolute motion-safe:inset-x-0 motion-safe:top-0 motion-safe:will-change-transform"
              style={`z-index: ${10 + index * 2};`}
            >
              <article class="group relative flex h-full w-full flex-col justify-between overflow-hidden rounded-2xl border border-stone-200/90 bg-white p-5 shadow-md transition duration-300 sm:p-6 dark:border-white/10 dark:bg-surface-card/90 dark:shadow-[0_12px_28px_rgba(0,0,0,0.6)]">
                <!-- Backgrounded Quote Watermark matching About page -->
                <QuoteIcon
                  aria-hidden="true"
                  class="pointer-events-none absolute top-4 right-4 sm:top-5 sm:right-5 size-8 sm:size-10 text-orange-600/15 transition-colors duration-300 pointer-fine:group-hover:text-orange-600/25"
                />

                <figure class="m-0 flex size-full flex-col justify-between p-0">
                  <div>
                    <!-- Review Meta Header -->
                    <div class="relative z-1 mbe-3 flex items-center justify-between border-b border-stone-100 dark:border-stone-800 pbe-2.5 font-mono text-[11px]">
                      <span class="font-bold tracking-[0.14em] text-orange-700 dark:text-orange-400 uppercase">
                        TRIPADVISOR REVIEW
                      </span>
                      <div class="flex items-center gap-1 text-amber-500">
                        {Array.from({ length: 5 }, () => (
                          <StarIcon
                            aria-hidden="true"
                            class="size-3.5 text-amber-500"
                          />
                        ))}
                      </div>
                    </div>

                    <!-- Editorial Quote -->
                    <blockquote class="mbe-4 text-xs leading-relaxed text-stone-600 dark:text-stone-300 sm:text-sm text-pretty">
                      “{guestQuote}”
                    </blockquote>
                  </div>

                  <!-- Guest Signature -->
                  <figcaption class="mbs-auto border-t border-stone-100 dark:border-stone-800 pbs-3">
                    <span class="block truncate text-xs sm:text-sm font-bold text-stone-950 dark:text-stone-100">
                      {guestName}
                    </span>
                    <div class="mbs-1 flex items-center gap-2 font-mono text-[11px] text-stone-500 dark:text-stone-400">
                      <span>{guestCountry}</span>
                      <span class="text-stone-300 dark:text-stone-600">·</span>
                      <span class="inline-flex items-center gap-1 font-sans text-[11px] font-medium text-emerald-700 dark:text-emerald-400">
                        <CheckCircleIcon
                          aria-hidden="true"
                          class="size-2.5"
                        />
                        TripAdvisor
                      </span>
                    </div>
                  </figcaption>
                </figure>
              </article>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</testimonials-scroll-stack>

<script src="../scripts/testimonials-scroll-stack.ts"></script>
