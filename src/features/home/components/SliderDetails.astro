---
import BlurText from "@/shared/ui/primitives/BlurText.astro";

interface Props {
  tagline?: string;
  title: string;
  type: string;
  description: string;
  isH1?: boolean;
}

const { tagline, title, type, description, isH1 = false } = Astro.props;
---

<div class="content absolute max-md:top-[calc((100dvh-var(--thumb-bottom)-var(--thumb-height)+3.75rem+env(safe-area-inset-top,0px))/2)] max-md:-translate-y-1/2 max-sm:inset-x-4 max-sm:flex max-sm:flex-col max-sm:items-center max-sm:text-center sm:left-8 sm:w-auto md:left-[5%] lg:left-[max(7%,calc(50%-570px))] 2xl:left-[max(7%,calc(50%-640px))] 3xl:left-[max(8%,calc(50%-720px))] z-10 box-border max-w-[calc(100vw-2rem)] text-white text-shadow-sm text-shadow-black/40 md:top-[clamp(4.25rem,9.5vh,6rem)] lg:top-[clamp(4.75rem,11vh,7rem)] xl:top-[clamp(5.25rem,13vh,7.5rem)] 2xl:top-[clamp(6rem,14vh,8.5rem)] 3xl:top-[clamp(7rem,15vh,10rem)]">
  {tagline && (
    <div
      style="color: #fdba74;"
      class="tagline mb-2 inline-flex items-center justify-center sm:justify-start gap-2 whitespace-nowrap text-shadow-xs text-shadow-black/80 sm:mb-2 sm:gap-2 md:mb-3 md:gap-3 text-[0.7rem] xs:text-xs font-bold uppercase tracking-[0.16em] sm:tracking-[0.2em] md:tracking-[0.25em] text-orange-300"
    >
      <span
        class="tagline-line inline-block h-[1.5px] w-5 shrink-0 bg-orange-400/60 xs:w-6 sm:w-8 md:w-12"
        aria-hidden="true"
      ></span>
      <span class="truncate max-w-[70vw] sm:max-w-none">{tagline}</span>
      <span
        class="tagline-line inline-block h-[1.5px] w-5 shrink-0 bg-orange-400/60 xs:w-6 sm:w-8 md:w-12"
        aria-hidden="true"
      ></span>
    </div>
  )}

  <BlurText
    as={isH1 ? "h1" : "h2"}
    blur={4}
    style="color: #fff;"
    class="title m-0 whitespace-nowrap text-center sm:text-left text-shadow-md text-shadow-black/50 text-[clamp(1.25rem,4.6vw,1.9rem)] xs:text-[clamp(1.45rem,4.4vw,2.2rem)] font-extrabold uppercase leading-[1.08] tracking-tight sm:text-[clamp(1.65rem,4vw,2.6rem)] sm:leading-[1.1] md:text-[clamp(2.1rem,3.8vw,3.6rem)] md:leading-[1.12] lg:text-[clamp(2.6rem,4.2vw,4.5rem)] 2xl:text-[clamp(3rem,4vw,5rem)] 3xl:text-[clamp(3.5rem,3.8vw,5.5rem)]"
    delay={150}
    direction="bottom"
    distance={24}
    stepDuration={0.65}
    text={title}
  />

  <BlurText
    as="div"
    blur={4}
    style="color: #ea580c;"
    class="type m-0 mt-0.5 whitespace-nowrap text-center sm:text-left text-shadow-md text-shadow-black/45 text-[clamp(1.25rem,4.6vw,1.9rem)] xs:text-[clamp(1.45rem,4.4vw,2.2rem)] font-extrabold uppercase leading-[1.08] tracking-tight text-orange-600 sm:mt-1 sm:text-[clamp(1.65rem,4vw,2.6rem)] sm:leading-[1.1] md:mt-2 md:text-[clamp(2.1rem,3.8vw,3.6rem)] md:leading-[1.12] lg:mt-2 lg:text-[clamp(2.6rem,4.2vw,4.5rem)] 2xl:text-[clamp(3rem,4vw,5rem)] 3xl:text-[clamp(3.5rem,3.8vw,5.5rem)]"
    delay={260}
    direction="bottom"
    distance={20}
    stepDuration={0.65}
    text={type}
  />

  <BlurText
    as="p"
    blur={3}
    style="color: #f1f5f9;"
    class="description mt-3 mx-auto sm:mx-0 max-w-[min(100%,42ch)] xs:max-w-[min(100%,44ch)] text-center sm:text-left text-shadow-md text-shadow-black/85 text-[clamp(0.8125rem,0.72rem+0.42vw,1.05rem)] font-normal leading-normal text-pretty text-slate-100/95 sm:mt-4 sm:max-w-[46ch] sm:leading-[1.58] md:mt-4 md:max-w-[min(46ch,calc(100vw-10%))] md:leading-[1.65] lg:mt-6 lg:max-w-[calc(var(--thumb-left)-max(7%,calc(50%-570px))-3rem)] lg:leading-[1.7] xl:max-w-120 2xl:max-w-136 3xl:max-w-150"
    delay={360}
    direction="bottom"
    distance={18}
    stagger={0.02}
    stepDuration={0.6}
    text={description}
  />
</div>
