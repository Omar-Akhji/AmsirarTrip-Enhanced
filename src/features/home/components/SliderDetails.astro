---
import BlurText from "@/shared/ui/BlurText.astro";

interface Props {
  tagline?: string;
  title: string;
  type: string;
  description: string;
  isH1?: boolean;
}

const { tagline, title, type, description, isH1 = false } = Astro.props;
---

<div class="content absolute top-[clamp(4.25rem,9.5vh,5.5rem)] left-5 sm:left-8 md:left-[5%] lg:left-[max(7%,calc(50%-570px))] z-10 box-border w-auto max-w-[calc(100vw-2.5rem)] text-white text-shadow-lg text-shadow-black/75 sm:top-[clamp(4.5rem,11vh,6.5rem)] md:top-[clamp(5.25rem,12.5vh,8rem)] lg:top-[clamp(5.5rem,15vh,8.5rem)] xl:top-[clamp(6rem,17vh,9.5rem)]">
  {tagline && (
    <div class="tagline mb-2 inline-flex items-center gap-2 whitespace-nowrap text-shadow-xs text-shadow-black/80 sm:mb-2 sm:gap-2 md:mb-3 md:gap-3 text-[0.7rem] sm:text-xs md:text-xs font-bold uppercase tracking-[0.16em] sm:tracking-[0.2em] md:tracking-[0.25em] text-[#fdba74]">
      <span
        class="tagline-line inline-block h-[1.5px] w-5 shrink-0 bg-orange-400/60 sm:w-8 md:w-12"
        aria-hidden="true"
      ></span>
      <span class="truncate max-w-[70vw] sm:max-w-none">{tagline}</span>
      <span
        class="tagline-line inline-block h-[1.5px] w-5 shrink-0 bg-orange-400/60 sm:w-8 md:w-12"
        aria-hidden="true"
      ></span>
    </div>
  )}

  <BlurText
    as={isH1 ? "h1" : "h2"}
    blur={10}
    class="title m-0 whitespace-nowrap text-shadow-lg text-shadow-black/80 text-[clamp(1.25rem,4.6vw,1.9rem)] font-extrabold uppercase leading-[1.08] tracking-tight sm:text-[clamp(1.65rem,4vw,2.6rem)] sm:leading-[1.1] md:text-[clamp(2.1rem,3.8vw,3.6rem)] md:leading-[1.12] lg:text-[clamp(2.6rem,4.2vw,4.5rem)]"
    delay={150}
    direction="top"
    distance={50}
    stepDuration={0.35}
    text={title}
  />

  <BlurText
    as="div"
    blur={10}
    class="type m-0 mt-0.5 whitespace-nowrap text-shadow-lg text-shadow-black/70 drop-shadow-md text-[clamp(1.25rem,4.6vw,1.9rem)] font-extrabold uppercase leading-[1.08] tracking-tight text-orange sm:mt-1 sm:text-[clamp(1.65rem,4vw,2.6rem)] sm:leading-[1.1] md:mt-2 md:text-[clamp(2.1rem,3.8vw,3.6rem)] md:leading-[1.12] lg:mt-2 lg:text-[clamp(2.6rem,4.2vw,4.5rem)]"
    delay={280}
    direction="top"
    distance={40}
    stepDuration={0.35}
    text={type}
  />

  <BlurText
    as="p"
    blur={8}
    class="description mt-3 max-w-[min(100%,44ch)] text-shadow-md text-shadow-black/85 text-[clamp(0.8125rem,0.72rem+0.42vw,1.05rem)] font-normal leading-normal text-pretty text-slate-100/95 sm:mt-4 sm:max-w-[46ch] sm:leading-[1.58] md:mt-4 md:max-w-[min(46ch,calc(100vw-10%))] md:leading-[1.65] lg:mt-6 lg:max-w-[calc(var(--thumb-left)-max(7%,calc(50%-570px))-3rem)] lg:leading-[1.7] xl:max-w-120"
    delay={400}
    direction="top"
    distance={30}
    stagger={0.02}
    stepDuration={0.35}
    text={description}
  />
</div>
