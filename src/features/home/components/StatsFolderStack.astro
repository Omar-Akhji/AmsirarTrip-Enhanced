---
import FolderStack from "@/shared/ui/widgets/FolderStack.astro";

interface StatItem {
  code: string;
  description: string;
  footerLeft: string;
  footerRight: string;
  id: string;
  label: string;
  value: string;
}

interface Props {
  stats: StatItem[];
}

const { stats } = Astro.props;
---

<FolderStack idPrefix="stats">
  {stats.map((stat, index) => (
    <article
      class="stat-card relative flex h-55 w-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/95 p-5 shadow-xl shadow-stone-900/10 backdrop-blur-xs transition-shadow duration-300 dark:border-white/10 dark:bg-surface-card/90 dark:shadow-[0_12px_28px_rgba(0,0,0,0.6)]"
      slot={`card-${index}`}
    >
      <div>
        <div class="mbe-3 flex items-center justify-between border-b border-stone-200/70 pb-2 text-[0.6875rem] font-mono uppercase tracking-wider text-stone-400 dark:border-white/10 dark:text-mist-400">
          <span class="font-semibold text-stone-600 dark:text-mist-200">{stat.code}</span>
        </div>

        <div class="mbe-1.5">
          <data
            class="text-4xl font-bold tracking-tight text-orange-700 dark:text-orange-400 tabular-nums block"
            value={stat.value}
          >
            {stat.value}
          </data>
        </div>

        <h3 class="text-base font-semibold tracking-tight text-stone-900 dark:text-mist-100">
          {stat.label}
        </h3>

        <p class="mbs-1 text-xs/relaxed text-stone-600 dark:text-mist-200 line-clamp-2">
          {stat.description}
        </p>
      </div>

      <div class="mbs-2 flex items-center justify-between border-t border-stone-200/60 pt-2 text-[0.6875rem] font-mono text-stone-400 uppercase tracking-wider dark:border-white/10 dark:text-mist-400">
        <span class="text-stone-600 dark:text-mist-200">{stat.footerLeft}</span>
        <span class="inline-flex items-center gap-1 text-stone-600 dark:text-mist-200">
          {stat.footerRight}
        </span>
      </div>
    </article>
  ))}
</FolderStack>
