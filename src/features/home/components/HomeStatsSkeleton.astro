---
import { Skeleton } from "@/components/ui/skeleton";

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<section
  aria-busy="true"
  aria-label="Loading expedition heritage statistics"
  class:list={["bg-white py-12 sm:py-16 lg:py-24", className]}
>
  <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
    {/* Mobile Mode: Card Stack matching HomeStats mobile layout */}
    <div class="block md:hidden w-full">
      <div class="flex flex-col gap-5 w-full">
        {Array.from({ length: 3 }, () => (
          <article class="stat-card relative flex h-55 w-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/95 p-5 shadow-xl shadow-stone-900/10">
            <div>
              <div class="mbe-3 flex items-center justify-between border-b border-stone-200/70 pb-2">
                <Skeleton class="h-3.5 w-24" />
              </div>

              <div class="mbe-2">
                <Skeleton class="h-8 w-20" />
              </div>

              <Skeleton class="h-5 w-40" />

              <div class="mbs-2 space-y-1.5">
                <Skeleton class="h-3.5 w-full" />
                <Skeleton class="h-3.5 w-4/5" />
              </div>
            </div>

            <div class="flex items-center justify-between border-t border-stone-200/70 pt-2">
              <Skeleton class="h-3 w-20" />
              <Skeleton class="h-3 w-24" />
            </div>
          </article>
        ))}
      </div>
    </div>

    {/* Desktop & Tablet Mode: 3-column Grid matching HomeStats.astro */}
    <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 2xl:gap-8 items-stretch">
      {Array.from({ length: 3 }, (_, index) => (
        <div class:list={["flex size-full", { "md:col-span-2 lg:col-span-1": index === 2 }]}>
          <article class="group relative flex h-full w-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/80 p-6 sm:p-7 shadow-xs shadow-stone-900/5">
            <div>
              {/* Editorial Bar */}
              <div class="mbe-5 flex items-center justify-between border-b border-stone-200/60 pb-3">
                <Skeleton class="h-3.5 w-28" />
              </div>

              {/* Stat Value */}
              <div class="mbe-3">
                <Skeleton class="h-10 w-24" />
              </div>

              {/* Stat Label */}
              <Skeleton class="h-6 w-44" />

              {/* Stat Description */}
              <div class="mbs-3 space-y-2">
                <Skeleton class="h-3.5 w-full" />
                <Skeleton class="h-3.5 w-11/12" />
                <Skeleton class="h-3.5 w-3/4" />
              </div>
            </div>

            {/* Footer Metadata */}
            <div class="mbs-6 flex items-center justify-between border-t border-stone-200/60 pt-3">
              <Skeleton class="h-3 w-20" />
              <Skeleton class="h-3 w-24" />
            </div>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>
