---
import { Skeleton } from "@/components/ui/skeleton";

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<section
  aria-busy="true"
  aria-label="Loading expedition heritage statistics"
  class:list={["bg-white py-12 sm:py-16 lg:py-24", className]}
>
  <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
    {/* Mobile Mode: Match StatsFolderStack 220vh runway & stage */}
    <div class="block md:hidden w-full">
      <div class="relative w-full overflow-x-clip">
        <div class="relative w-full h-auto motion-safe:h-[220vh]">
          <div class="static h-auto motion-safe:sticky motion-safe:top-18 motion-safe:h-102.5 w-full mx-auto">
            <div class="flex flex-col gap-5 w-full motion-safe:hidden">
              {Array.from({ length: 3 }, () => (
                <article class="stat-card relative flex h-55 w-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/95 p-5 shadow-xl shadow-stone-900/10">
                  <div>
                    <div class="mbe-3 flex items-center justify-between border-b border-stone-200/70 pb-2">
                      <Skeleton class="h-3.5 w-24" />
                    </div>
                    <div class="mbe-1.5">
                      <Skeleton class="h-9 w-20" />
                    </div>
                    <Skeleton class="h-5 w-40" />
                    <div class="mbs-1 space-y-1.5">
                      <Skeleton class="h-3.5 w-full" />
                      <Skeleton class="h-3.5 w-4/5" />
                    </div>
                  </div>
                  <div class="mbs-2 flex items-center justify-between border-t border-stone-200/70 pt-2">
                    <Skeleton class="h-3 w-20" />
                    <Skeleton class="h-3 w-24" />
                  </div>
                </article>
              ))}
            </div>
            <div class="hidden motion-safe:block relative top-2 h-85 w-full">
              <article class="stat-card relative flex h-55 w-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/95 p-5 shadow-xl shadow-stone-900/10">
                <div>
                  <div class="mbe-3 flex items-center justify-between border-b border-stone-200/70 pb-2">
                    <Skeleton class="h-3.5 w-24" />
                  </div>
                  <div class="mbe-1.5">
                    <Skeleton class="h-9 w-20" />
                  </div>
                  <Skeleton class="h-5 w-40" />
                  <div class="mbs-1 space-y-1.5">
                    <Skeleton class="h-3.5 w-full" />
                    <Skeleton class="h-3.5 w-4/5" />
                  </div>
                </div>
                <div class="mbs-2 flex items-center justify-between border-t border-stone-200/70 pt-2">
                  <Skeleton class="h-3 w-20" />
                  <Skeleton class="h-3 w-24" />
                </div>
              </article>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Desktop & Tablet Mode: 3-column Grid matching HomeStats.astro */}
    <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 2xl:gap-8 items-stretch">
      {Array.from({ length: 3 }, (_, index) => (
        <div class:list={["flex size-full", { "md:col-span-2 lg:col-span-1": index === 2 }]}>
          <article class="group relative flex size-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/80 p-6 sm:p-7 shadow-xs shadow-stone-900/5">
            <div>
              {/* Editorial Bar */}
              <div class="mbe-5 flex items-center justify-between border-b border-stone-200/60 pb-3">
                <Skeleton class="h-4 w-28" />
              </div>

              {/* Stat Value matching text-4xl */}
              <div class="mbe-3">
                <Skeleton class="h-10 w-24" />
              </div>

              {/* Stat Label matching text-base sm:text-lg */}
              <Skeleton class="h-7 w-48" />

              {/* Stat Description matching text-xs/relaxed sm:text-sm */}
              <div class="mbs-3 space-y-2">
                <Skeleton class="h-4 w-full" />
                <Skeleton class="h-4 w-11/12" />
                <Skeleton class="h-4 w-4/5" />
                <Skeleton class="h-4 w-2/3" />
              </div>
            </div>

            {/* Footer Metadata */}
            <div class="mbs-6 flex items-center justify-between border-t border-stone-200/60 pt-3">
              <Skeleton class="h-4 w-20" />
              <Skeleton class="h-4 w-24" />
            </div>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>
