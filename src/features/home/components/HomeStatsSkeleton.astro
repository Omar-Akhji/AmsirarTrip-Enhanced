---
import AsciiSkeleton from "@/shared/ui/feedback/AsciiSkeleton.astro";

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<section
  aria-busy="true"
  aria-label="Loading expedition heritage statistics"
  class:list={["bg-white py-12 sm:py-16 lg:py-24", className]}
>
  <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
    {/* Section Header matching HomeStats.astro */}
    <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8">
      <div class="max-w-2xl space-y-2">
        <AsciiSkeleton
          class="text-stone-400 font-mono text-xs uppercase"
          lines={1}
          variant="dither"
          widths={["14rem"]}
        />
        <AsciiSkeleton
          class="text-2xl sm:text-3xl md:text-4xl text-stone-800 font-bold"
          lines={1}
          variant="dither"
          widths={["20rem"]}
        />
        <div class="pt-1">
          <AsciiSkeleton
            class="text-stone-400 text-sm"
            lines={2}
            variant="dither"
            widths={["100%", "75%"]}
          />
        </div>
      </div>
    </div>

    {/* Stat Cards Grid matching HomeStats.astro breakpoints */}
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 2xl:gap-8 items-stretch">
      {Array.from({ length: 3 }, () => (
        <div class="flex size-full last:md:col-span-2 last:lg:col-span-1">
          <article class="group relative flex h-full w-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/80 p-6 sm:p-8 shadow-xs">
            <div>
              {/* Editorial Bar */}
              <div class="mbe-4 flex items-center justify-between border-b border-stone-200/60 pb-3 text-[11px] font-mono uppercase tracking-wider">
                <div class="flex items-center gap-2">
                  <span class="size-2 rounded-full bg-stone-400"></span>
                  <AsciiSkeleton
                    class="text-stone-500 font-mono text-xs"
                    lines={1}
                    variant="dither"
                    widths={["7rem"]}
                  />
                </div>
                <AsciiSkeleton
                  class="text-stone-400 font-mono text-xs"
                  lines={1}
                  variant="dither"
                  widths={["2rem"]}
                />
              </div>

              {/* Stat Value */}
              <div class="mbe-3">
                <AsciiSkeleton
                  class="text-3xl sm:text-4xl font-mono font-bold text-stone-800"
                  lines={1}
                  variant="dither"
                  widths={["6rem"]}
                />
              </div>

              {/* Stat Label */}
              <div class="mbe-2">
                <AsciiSkeleton
                  class="text-lg font-bold text-stone-700"
                  lines={1}
                  variant="dither"
                  widths={["11rem"]}
                />
              </div>

              {/* Stat Description */}
              <div class="mbs-2.5 space-y-1.5">
                <AsciiSkeleton
                  class="text-stone-400 text-sm"
                  lines={3}
                  variant="dither"
                  widths={["100%", "90%", "70%"]}
                />
              </div>
            </div>

            {/* Footer Metadata */}
            <div class="mbs-6 flex items-center justify-between border-t border-stone-200/60 pt-3.5 text-[11px] font-mono uppercase tracking-wider">
              <AsciiSkeleton
                class="text-stone-400 font-mono text-xs"
                lines={1}
                variant="dither"
                widths={["4rem"]}
              />
              <AsciiSkeleton
                class="text-stone-400 font-mono text-xs"
                lines={1}
                variant="dither"
                widths={["6rem"]}
              />
            </div>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>
