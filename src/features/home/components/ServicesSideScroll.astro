---
import { useTranslations } from "@/i18n/utils";

interface ServiceItem {
  icon: (_props: Record<string, unknown>) => unknown;
  key: string;
}

interface Props {
  services: ServiceItem[];
}

const { services } = Astro.props;
const locale = Astro.locals.locale;
const t = useTranslations(locale);
---

<side-scroll class="block relative w-full overflow-visible">
  <div
    class="relative w-full h-auto motion-safe:h-[200vh]"
    data-side-track
  >
    <div
      class="static motion-safe:sticky motion-safe:top-20 w-full @container overflow-hidden py-4"
      data-side-stage
    >
      <div
        class="services-side-slider flex w-full flex-col items-stretch gap-6 will-change-transform motion-safe:w-max motion-safe:flex-row pb-4"
        data-side-slider
      >
        {services.map(({ icon: Icon, ...service }) => (
          <div class="w-[100cqi] shrink-0 flex flex-col snap-start motion-safe:snap-none">
            <article class="group relative flex size-full flex-col items-center rounded-2xl border border-white/10 bg-white/10 p-6 sm:p-8 text-center shadow-xs ring-1 ring-black/5 backdrop-blur-xl transition-all duration-300 pointer-fine:hover:-translate-y-1 pointer-fine:hover:shadow-[0_12px_36px_rgba(0,0,0,0.35)]">
              <div class="mbe-6 inline-flex size-25 items-center justify-center rounded-full bg-white/5 ring-1 ring-white/10 transition-transform duration-300 pointer-fine:group-hover:scale-105">
                <Icon
                  aria-hidden="true"
                  class="size-13 text-zinc-50"
                />
              </div>
              <h3 class="text-xl font-semibold text-white">
                {t(`services.cards.${service.key}.title`)}
              </h3>
              <p class="mbs-3 text-sm/relaxed text-zinc-200">
                {t(`services.cards.${service.key}.text`)}
              </p>
            </article>
          </div>
        ))}
      </div>
    </div>
  </div>
</side-scroll>

<script src="@/scripts/side-scroll.ts"></script>
