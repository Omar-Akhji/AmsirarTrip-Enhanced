---
import TestimonialsSideScroll from "./TestimonialsSideScroll.astro";
import Button from "@/shared/ui/primitives/Button.astro";

const locale = Astro.currentLocale || "en";
const testimonials = [
  { key: "chrissy" },
  { key: "bianca" },
  { key: "pac" },
  { key: "franziska" },
  { key: "tanja" },
  { key: "margret" },
  { key: "marianne" },
  { key: "melina" },
];
const TRIPADVISOR_URL =
  "https://www.tripadvisor.com/Attraction_Review-g293734-d32584739-Reviews-Amsirar_Travel-Marrakech_Marrakech_Safi.html";
---

<section
  aria-labelledby="testimonials-heading"
  class="bg-zinc-50 py-12 sm:py-16 lg:py-24 dark:bg-surface-base"
  id="testimonials"
>
  <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
    <div
      class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8 dark:border-white/10"
      data-animate="fade-up"
    >
      <hgroup class="max-w-2xl space-y-2">
        <h2
          class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance dark:text-mist-100"
          id="testimonials-heading"
        >
          {locale === "fr" ?
            <>
              Avis de <span class="text-orange">Nos Voyageurs</span>
            </>
          : locale === "es" ?
            <>
              Experiencias de <span class="text-orange">Nuestros Viajeros</span>
            </>
          : locale === "de" ?
            <>
              Erfahrungen <span class="text-orange">Unserer Reisenden</span>
            </>
          : <>
              What Our <span class="text-orange">Guests Say</span>
            </>
          }
        </h2>
        <p class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 dark:text-mist-300 leading-relaxed max-w-[62ch]">
          {locale === "fr" ?
            "Avis authentiques vérifiés sur TripAdvisor après leurs circuits dans le désert, l'Atlas et les villes impériales."
          : locale === "es" ?
            "Opiniones verificadas en TripAdvisor tras expediciones privadas por el desierto, el Atlas y ciudades imperiales."
          : locale === "de" ?
            "Authentische TripAdvisor-Bewertungen von Reisenden nach Sahara-, Atlas- und Königsstädte-Touren."
          : "Verified TripAdvisor reviews from travelers who explored Morocco with our licensed drivers."
          }
        </p>
      </hgroup>
      <div class="flex items-center">
        <Button
          href={TRIPADVISOR_URL}
          target="_blank"
          rel="noopener noreferrer"
          variant="outline"
          size="sm"
          class="gap-2 text-xs font-semibold text-stone-700"
          aria-label="View our reviews on TripAdvisor"
        >
          <span class="inline-block size-2 rounded-full bg-emerald-500"></span>
          <span>TripAdvisor</span>
          <svg
            class="size-3.5 text-stone-400"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M7 17L17 7M17 7H7M17 7V17" />
          </svg>
        </Button>
      </div>
    </div>
    <div class="relative w-full">
      <TestimonialsSideScroll testimonials={testimonials} />
    </div>
  </div>
</section>
