---
import { useTranslations } from "@/i18n/utils";
import { CircleCheck, Star } from "@lucide/astro";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);
const testimonials = [{ key: "kevin" }, { key: "ben" }, { key: "sara" }];
---

<section
  aria-labelledby="testimonials-heading"
  class="bg-zinc-50 py-12 sm:py-16 lg:py-24"
  id="testimonials"
>
  <div class="mx-auto px-4 max-inline-330">
    <div
      class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8"
      data-animate="fade-up"
    >
      <hgroup class="max-w-2xl space-y-2">
        <h2
          class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance"
          id="testimonials-heading"
        >
          {locale === "fr" ?
            "Témoignages de voyageurs"
          : locale === "es" ?
            "Experiencias de nuestros viajeros"
          : locale === "de" ?
            "Erfahrungen unserer Reisenden"
          : "Verified traveler dispatches"}
        </h2>
        <p class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 leading-relaxed max-w-[62ch]">
          {locale === "fr" ?
            "Avis vérifiés de nos clients après leurs circuits à travers le désert, l'Atlas et les villes impériales."
          : locale === "es" ?
            "Opiniones verificadas tras expediciones privadas por el desierto, el Atlas y ciudades imperiales."
          : locale === "de" ?
            "Authentische Berichte von Reisenden nach privaten Sahara-, Atlas- und Königsstädte-Touren."
          : "Firsthand accounts from private Sahara expeditions, High Atlas treks, and imperial city routes."
          }
        </p>
      </hgroup>
    </div>
    <div class="relative">
      <div class="grid grid-cols-1 justify-items-stretch gap-6 md:grid-cols-2 lg:grid-cols-3">
        {testimonials.map((tst, index) => {
          const guestName = t(`testimonials.items.${tst.key}.name`);
          const guestCountry = t(`testimonials.items.${tst.key}.country`);
          const guestQuote = t(`testimonials.items.${tst.key}.quote`);
          return (
            <div
              class:list={[`flex size-full`, { "md:col-span-2 lg:col-span-1": index === 2 }]}
              data-animate="fade-up"
              style={`transition-delay: ${index * 150}ms`}
            >
              <article class="group relative flex size-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-white p-6 shadow-xs transition duration-300 pointer-fine:hover:-translate-y-1 pointer-fine:hover:border-stone-300 pointer-fine:hover:shadow-xl sm:p-8">
                <figure class="m-0 flex size-full flex-col justify-between p-0">
                  <div>
                    <!-- Dispatch Meta Header -->
                    <div class="mbe-4 flex items-center justify-between border-b border-stone-100 pbe-3 font-mono text-xs">
                      <span class="font-bold tracking-[0.14em] text-orange-600 uppercase">
                        VERIFIED REVIEW
                      </span>
                      <div class="flex items-center gap-0.5 text-amber-500">
                        {Array.from({ length: 5 }, () => (
                          <Star
                            aria-hidden="true"
                            class="size-3.5 fill-current"
                            stroke-width={1.5}
                          />
                        ))}
                      </div>
                    </div>

                    <!-- Editorial Quote -->
                    <blockquote class="mbe-6 text-sm leading-relaxed text-stone-600 sm:text-base text-pretty">
                      “{guestQuote}”
                    </blockquote>
                  </div>

                  <!-- Guest Signature -->
                  <figcaption class="mbs-auto border-t border-stone-100 pbs-4">
                    <span class="block truncate text-sm font-bold text-stone-950">{guestName}</span>
                    <div class="mbs-1 flex items-center gap-2 font-mono text-xs text-stone-500">
                      <span>{guestCountry}</span>
                      <span class="text-stone-300">·</span>
                      <span class="inline-flex items-center gap-1 font-sans text-xs font-medium text-emerald-600">
                        <CircleCheck
                          aria-hidden="true"
                          class="size-3"
                        />
                        Verified
                      </span>
                    </div>
                  </figcaption>
                </figure>
              </article>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
