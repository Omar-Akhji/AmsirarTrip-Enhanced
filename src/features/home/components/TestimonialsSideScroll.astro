---
import { useTranslations } from "@/i18n/utils";
import CheckCircleIcon from "@/shared/ui/icons/CheckCircleIcon.astro";
import QuoteIcon from "@/shared/ui/icons/QuoteIcon.astro";
import StarIcon from "@/shared/ui/icons/StarIcon.astro";

interface TestimonialItem {
  key: string;
}

interface Props {
  testimonials: TestimonialItem[];
}

const { testimonials } = Astro.props;
const locale = Astro.locals.locale;
const t = useTranslations(locale);
---

<side-scroll class="block relative w-full overflow-visible">
  <div
    class="relative w-full h-auto motion-safe:h-[280vh]"
    data-side-track
  >
    <div
      class="static motion-safe:sticky motion-safe:top-20 w-full @container overflow-hidden py-4"
      data-side-stage
    >
      <div
        class="testimonials-side-slider flex w-full flex-wrap items-stretch gap-6 will-change-transform motion-safe:w-max motion-safe:flex-nowrap pb-4"
        data-side-slider
      >
        {testimonials.map((tst) => {
          const guestName = t(`testimonials.items.${tst.key}.name`);
          const guestCountry = t(`testimonials.items.${tst.key}.country`);
          const guestQuote = t(`testimonials.items.${tst.key}.quote`);

          return (
            <div class="w-[100cqi] sm:w-88 md:w-88 lg:w-92 2xl:w-96 3xl:w-105 shrink-0 flex flex-col snap-start motion-safe:snap-none">
              <article class="group relative flex size-full flex-col justify-between overflow-hidden rounded-2xl border border-stone-200/90 bg-white p-5 shadow-xs transition duration-300 pointer-fine:hover:-translate-y-1 pointer-fine:hover:border-stone-300 pointer-fine:hover:shadow-xl sm:p-6 dark:border-white/10 dark:bg-surface-card/90 dark:shadow-[0_4px_20px_-2px_rgba(0,0,0,0.4)] dark:pointer-fine:hover:border-white/20 dark:pointer-fine:hover:bg-surface-hover/95">
                <QuoteIcon
                  aria-hidden="true"
                  class="pointer-events-none absolute top-4 inset-e-4 sm:top-5 sm:inset-e-5 size-8 sm:size-10 text-orange-600/15 transition-colors duration-300 pointer-fine:group-hover:text-orange-600/25"
                />

                <figure class="m-0 flex size-full flex-col justify-between p-0">
                  <div>
                    <div class="relative z-1 mbe-3 flex items-center justify-between border-b border-stone-100 dark:border-stone-800 pbe-2.5 font-mono text-[0.6875rem]">
                      <span class="font-bold tracking-[0.14em] text-orange-700 dark:text-orange-400 uppercase">
                        {t("testimonials.badge")}
                      </span>
                      <div class="flex items-center gap-1 text-amber-500">
                        <span class="sr-only">{t("ui.ratingFiveStars")}</span>
                        {Array.from({ length: 5 }, () => (
                          <StarIcon
                            aria-hidden="true"
                            class="size-3.5 text-amber-500"
                          />
                        ))}
                      </div>
                    </div>

                    <blockquote class="mbe-4 text-xs/relaxed text-stone-600 dark:text-stone-300 md:text-[0.8125rem] text-pretty">
                      “{guestQuote}”
                    </blockquote>
                  </div>

                  <figcaption class="mbs-auto border-t border-stone-100 dark:border-stone-800 pbs-3">
                    <span class="block truncate text-xs font-bold text-stone-950 dark:text-stone-100 sm:text-sm">
                      {guestName}
                    </span>
                    <div class="mbs-1 flex items-center gap-2 font-mono text-[0.6875rem] text-stone-500 dark:text-stone-400">
                      <span>{guestCountry}</span>
                      <span class="text-stone-300 dark:text-stone-600">·</span>
                      <span class="inline-flex items-center gap-1 font-sans text-[0.6875rem] font-medium text-emerald-700 dark:text-emerald-400">
                        <CheckCircleIcon
                          aria-hidden="true"
                          class="size-2.5"
                        />
                        TripAdvisor
                      </span>
                    </div>
                  </figcaption>
                </figure>
              </article>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</side-scroll>

<script src="@/scripts/side-scroll.ts"></script>
