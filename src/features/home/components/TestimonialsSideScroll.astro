---
import { useTranslations } from "@/i18n/utils";
import CheckCircleIcon from "@/shared/ui/icons/CheckCircleIcon.astro";
import QuoteIcon from "@/shared/ui/icons/QuoteIcon.astro";
import StarIcon from "@/shared/ui/icons/StarIcon.astro";

interface TestimonialItem {
  key: string;
}

interface Props {
  testimonials: TestimonialItem[];
}

const { testimonials } = Astro.props;
const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);
---

<testimonials-side-scroll class="block relative w-full overflow-visible">
  <!-- Scroll runway: comfortable vertical scroll distance to smoothly transition all cards from side -->
  <div class="testimonials-side-track relative w-full h-auto motion-safe:h-[280vh]">
    <!-- Pinned Stage: Stays sticky in the viewport, using full container width -->
    <div class="testimonials-side-stage static motion-safe:sticky motion-safe:top-20 w-full overflow-x-auto motion-safe:overflow-hidden py-4">
      <!-- Horizontal Slider: translates horizontally on scroll with natural equal card heights -->
      <div class="testimonials-side-slider flex items-stretch gap-6 will-change-transform overflow-x-auto snap-x motion-safe:overflow-visible motion-safe:snap-none pb-4">
        {testimonials.map((tst) => {
          const guestName = t(`testimonials.items.${tst.key}.name`);
          const guestCountry = t(`testimonials.items.${tst.key}.country`);
          const guestQuote = t(`testimonials.items.${tst.key}.quote`);

          return (
            <div class="w-80 md:w-88 lg:w-92 2xl:w-96 3xl:w-105 shrink-0 flex flex-col snap-start motion-safe:snap-none">
              <article class="group relative flex size-full flex-col justify-between overflow-hidden rounded-2xl border border-stone-200/90 bg-white p-5 shadow-xs transition duration-300 pointer-fine:hover:-translate-y-1 pointer-fine:hover:border-stone-300 pointer-fine:hover:shadow-xl sm:p-6 dark:border-white/10 dark:bg-surface-card/90 dark:shadow-[0_4px_20px_-2px_rgba(0,0,0,0.4)] dark:pointer-fine:hover:border-white/20 dark:pointer-fine:hover:bg-surface-hover/95">
                <!-- Backgrounded Quote Watermark matching About page -->
                <QuoteIcon
                  aria-hidden="true"
                  class="pointer-events-none absolute top-4 right-4 sm:top-5 sm:right-5 size-8 sm:size-10 text-orange-600/15 transition-colors duration-300 pointer-fine:group-hover:text-orange-600/25"
                />

                <figure class="m-0 flex size-full flex-col justify-between p-0">
                  <div>
                    <!-- Review Meta Header -->
                    <div class="relative z-1 mbe-3 flex items-center justify-between border-b border-stone-100 dark:border-stone-800 pbe-2.5 font-mono text-[11px]">
                      <span class="font-bold tracking-[0.14em] text-orange-700 dark:text-orange-400 uppercase">
                        TRIPADVISOR REVIEW
                      </span>
                      <div class="flex items-center gap-1 text-amber-500">
                        {Array.from({ length: 5 }, () => (
                          <StarIcon
                            aria-hidden="true"
                            class="size-3.5 text-amber-500"
                          />
                        ))}
                      </div>
                    </div>

                    <!-- Editorial Quote (smaller, refined typography) -->
                    <blockquote class="mbe-4 text-xs leading-relaxed text-stone-600 dark:text-stone-300 md:text-[13px] text-pretty">
                      “{guestQuote}”
                    </blockquote>
                  </div>

                  <!-- Guest Signature -->
                  <figcaption class="mbs-auto border-t border-stone-100 dark:border-stone-800 pbs-3">
                    <span class="block truncate text-xs font-bold text-stone-950 dark:text-stone-100 sm:text-sm">
                      {guestName}
                    </span>
                    <div class="mbs-1 flex items-center gap-2 font-mono text-[11px] text-stone-500 dark:text-stone-400">
                      <span>{guestCountry}</span>
                      <span class="text-stone-300 dark:text-stone-600">·</span>
                      <span class="inline-flex items-center gap-1 font-sans text-[11px] font-medium text-emerald-700 dark:text-emerald-400">
                        <CheckCircleIcon
                          aria-hidden="true"
                          class="size-2.5"
                        />
                        TripAdvisor
                      </span>
                    </div>
                  </figcaption>
                </figure>
              </article>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</testimonials-side-scroll>

<script src="../scripts/testimonials-side-scroll.ts"></script>
