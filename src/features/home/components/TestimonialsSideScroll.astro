---
import { useTranslations } from "@/i18n/utils";
import { CircleCheck, Star } from "@lucide/astro";

interface TestimonialItem {
  key: string;
}

interface Props {
  testimonials: TestimonialItem[];
}

const { testimonials } = Astro.props;
const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);
---

<testimonials-side-scroll class="block relative w-full overflow-visible">
  <!-- Scroll runway: comfortable vertical scroll distance to smoothly transition all cards from side -->
  <div class="testimonials-side-track relative w-full h-auto motion-safe:h-[280vh]">
    <!-- Pinned Stage: Stays sticky in the viewport, using full container width -->
    <div class="testimonials-side-stage static motion-safe:sticky motion-safe:top-20 w-full overflow-x-auto motion-safe:overflow-hidden py-4">
      <!-- Horizontal Slider: translates horizontally on scroll with natural equal card heights -->
      <div class="testimonials-side-slider flex items-stretch gap-6 will-change-transform overflow-x-auto snap-x motion-safe:overflow-visible motion-safe:snap-none pb-4">
        {testimonials.map((tst) => {
          const guestName = t(`testimonials.items.${tst.key}.name`);
          const guestCountry = t(`testimonials.items.${tst.key}.country`);
          const guestQuote = t(`testimonials.items.${tst.key}.quote`);

          return (
            <div class="w-80 md:w-88 lg:w-92 shrink-0 flex flex-col snap-start motion-safe:snap-none">
              <article class="group relative flex size-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-white p-5 shadow-xs transition duration-300 pointer-fine:hover:-translate-y-1 pointer-fine:hover:border-stone-300 pointer-fine:hover:shadow-xl sm:p-6">
                <figure class="m-0 flex size-full flex-col justify-between p-0">
                  <div>
                    <!-- Review Meta Header -->
                    <div class="mbe-3 flex items-center justify-between border-b border-stone-100 pbe-2.5 font-mono text-[11px]">
                      <span class="font-bold tracking-[0.14em] text-orange-600 uppercase">
                        TRIPADVISOR REVIEW
                      </span>
                      <div class="flex items-center gap-0.5 text-amber-500">
                        {Array.from({ length: 5 }, () => (
                          <Star
                            aria-hidden="true"
                            class="size-3 fill-current"
                            stroke-width={1.5}
                          />
                        ))}
                      </div>
                    </div>

                    <!-- Editorial Quote (smaller, refined typography) -->
                    <blockquote class="mbe-4 text-xs leading-relaxed text-stone-600 md:text-[13px] text-pretty">
                      “{guestQuote}”
                    </blockquote>
                  </div>

                  <!-- Guest Signature -->
                  <figcaption class="mbs-auto border-t border-stone-100 pbs-3">
                    <span class="block truncate text-xs font-bold text-stone-950 sm:text-sm">
                      {guestName}
                    </span>
                    <div class="mbs-1 flex items-center gap-2 font-mono text-[11px] text-stone-500">
                      <span>{guestCountry}</span>
                      <span class="text-stone-300">·</span>
                      <span class="inline-flex items-center gap-1 font-sans text-[11px] font-medium text-emerald-600">
                        <CircleCheck
                          aria-hidden="true"
                          class="size-2.5"
                        />
                        TripAdvisor
                      </span>
                    </div>
                  </figcaption>
                </figure>
              </article>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</testimonials-side-scroll>

<script src="../scripts/testimonials-side-scroll.ts"></script>
