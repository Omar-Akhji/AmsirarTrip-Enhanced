---
import servicesBg from "@/assets/images/services-bg.webp";
import { useTranslations } from "@/i18n/utils";
import { Image } from "astro:assets";
import ServicesScrollStack from "./ServicesScrollStack.astro";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const services = [
  { key: "handcrafted", icon: "/icons/globus-icon.svg", altKey: "services.cards.handcrafted.alt" },
  { key: "guide", icon: "/icons/map-icon.svg", altKey: "services.cards.guide.alt" },
  { key: "price", icon: "/icons/dollar-icon.svg", altKey: "services.cards.price.alt" },
];

const titleMap: Record<string, { main: string; accent: string }> = {
  fr: { main: "Flotte Privée et", accent: "Transport Touristique" },
  es: { main: "Flota Privada y", accent: "Transporte Turístico" },
  de: { main: "Eigene Fahrzeugflotte und", accent: "Tourismus-Transport" },
  en: { main: "Private Fleet and", accent: "Expedition Transport" },
};

const subtitleMap: Record<string, string> = {
  fr: "Amsirar Transport Touristique assure tous vos déplacements avec des véhicules agréés, confortables et conduits par des professionnels locaux.",
  es: "Amsirar Transport Touristique garantiza sus traslados con vehículos autorizados, modernos y conducidos por profesionales locales.",
  de: "Amsirar Transport Touristique garantiert lückenlose Mobilität mit zugelassenen, modernen Fahrzeugen und erfahrenen Chauffeuren.",
  en: "Licensed tourist transport across all Moroccan regions. Certified late-model vehicles, professional driver-guides, and door-to-door comfort.",
};

const defaultHeading = { main: "Private Fleet and", accent: "Expedition Transport" };
const defaultSubtitle =
  "Licensed tourist transport across all Moroccan regions. Certified late-model vehicles, professional driver-guides, and door-to-door comfort.";

const heading = titleMap[locale] ?? titleMap["en"] ?? defaultHeading;
const subtitle = subtitleMap[locale] ?? subtitleMap["en"] ?? defaultSubtitle;
---

<section
  aria-labelledby="services-heading"
  class="relative overflow-visible py-12 sm:py-16 lg:py-24 text-orange-200"
  id="services"
  style="

--ascii-glyph: #f4f4f5; --ascii-surface: #09090b;"
>
  <Image
    alt=""
    class="absolute inset-0 size-full object-cover"
    data-ascii="skip"
    decoding="async"
    height={1277}
    loading="lazy"
    src={servicesBg}
    width={1920}
  />
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-black/45"
  ></div>
  <div class="relative mx-auto px-4 max-inline-7xl sm:px-6 lg:px-8">
    <div
      class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-white/10 pb-6 sm:pb-8"
      data-animate="fade-up"
    >
      <hgroup class="max-w-2xl space-y-2">
        <h2
          class="text-3xl font-bold tracking-tight text-white sm:text-4xl text-balance"
          id="services-heading"
        >
          {heading.main} <span class="text-yellow text-shadow-sm">{heading.accent}</span>
        </h2>
        <p class="border-s-2 border-yellow ps-4 py-0.5 text-sm sm:text-base text-zinc-100/90 leading-relaxed max-w-[62ch] text-shadow-sm">
          {subtitle}
        </p>
      </hgroup>
    </div>

    {/* Mobile Mode: Animated ScrollStack cards without folder */}
    <div class="block md:hidden w-full">
      <ServicesScrollStack services={services} />
    </div>

    {/* Desktop & Tablet Mode: 3-column Grid */}
    <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 justify-items-stretch gap-6">
      {services.map((service, index) => (
        <article
          class:list={[
            "group relative flex size-full flex-col items-center rounded-2xl border border-white/10 bg-white/10 p-8 text-center shadow-xs ring-1 ring-black/5 backdrop-blur-xl transition-all duration-300 pointer-fine:hover:-translate-y-1 pointer-fine:hover:shadow-[0_12px_36px_rgba(0,0,0,0.35)]",
            { "md:col-span-2 lg:col-span-1": index === 2 },
          ]}
          data-animate="fade-up"
          data-ascii="surface"
          style={`transition-delay: ${index * 150}ms; -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);`}
        >
          <div
            data-ascii="fade"
            class="mbe-6 inline-flex size-25 items-center justify-center rounded-full bg-white/5 ring-1 ring-white/10 transition-transform duration-300 pointer-fine:group-hover:scale-105"
          >
            <Image
              alt={t(service.altKey)}
              class="size-15"
              decoding="async"
              height={60}
              loading="lazy"
              src={service.icon}
              width={60}
            />
          </div>
          <h3 class="text-xl font-semibold text-white">
            {t(`services.cards.${service.key}.title`)}
          </h3>
          <p class="mbs-3 text-sm text-zinc-200 leading-relaxed">
            {t(`services.cards.${service.key}.text`)}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
