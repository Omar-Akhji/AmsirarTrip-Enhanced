---
import AsciiSkeleton from "@/shared/ui/feedback/AsciiSkeleton.astro";

interface Props {
  count?: number | undefined;
  class?: string | undefined;
}

const { count = 6, class: className } = Astro.props;
---

<section
  aria-busy="true"
  aria-label="Loading regional destinations"
  class:list={[
    "relative isolate overflow-hidden bg-neutral-50 py-12 sm:py-16 lg:py-24 text-neutral-900",
    className,
  ]}
>
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(248,250,252,0.3),transparent_70%)]"
  ></div>

  <div class="relative z-10 mx-auto px-4 max-inline-7xl">
    {/* Section Header matching FeaturedTours.astro */}
    <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8">
      <div class="max-w-2xl space-y-2">
        <AsciiSkeleton
          class="text-stone-400 font-mono text-xs uppercase"
          lines={1}
          variant="dither"
          widths={["12rem"]}
        />
        <AsciiSkeleton
          class="text-2xl sm:text-3xl text-stone-800 font-bold"
          lines={1}
          variant="dither"
          widths={["20rem"]}
        />
        <div class="pt-1">
          <AsciiSkeleton
            class="text-stone-400 text-sm"
            lines={2}
            variant="dither"
            widths={["100%", "75%"]}
          />
        </div>
      </div>

      {/* View all destinations button — rendered as full ASCII dither button pill */}
      <AsciiSkeleton
        class="h-8.5 w-32 rounded-full overflow-hidden text-stone-400"
        rows={2}
        variant="dither"
      />
    </div>

    {/* Destination Cards Grid matching FeaturedTours.astro */}
    <div class="grid grid-cols-1 gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3">
      {Array.from({ length: count }, () => (
        <article class="group relative block aspect-4/3 w-full select-none">
          <div class="relative size-full overflow-hidden rounded-2xl border-2 border-stone-200/90 bg-stone-100 dark:bg-stone-900 shadow-xs">
            {/* Background ASCII Dither decoding matching full aspect-4/3 card */}
            <AsciiSkeleton
              class="ars-image size-full text-stone-400"
              rows={30}
              variant="dither"
            />

            {/* Ambient Scrim Overlay in gray tone */}
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/85 via-black/40 to-transparent"
            ></div>

            {/* Editorial Typography Layer matching FeaturedTours resting state */}
            <div class="relative z-10 flex size-full flex-col justify-end p-3 sm:p-3.5 text-white pointer-events-none">
              <div
                class="rounded-2xl border border-white/10 bg-white/10 p-4 sm:p-5 shadow-xs ring-1 ring-black/5 backdrop-blur-xl"
                style="backdrop-filter: blur(20px);"
              >
                <hgroup class="mbe-1.5">
                  <AsciiSkeleton
                    class="text-stone-300 font-bold mbe-1.5 text-xs font-mono uppercase"
                    lines={1}
                    variant="dither"
                    widths={["7rem"]}
                  />
                  <AsciiSkeleton
                    class="text-xl sm:text-2xl text-white font-bold"
                    lines={1}
                    variant="dither"
                    widths={["11rem"]}
                  />
                </hgroup>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
