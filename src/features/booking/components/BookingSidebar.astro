---
import { useTranslations } from "@/i18n/utils";
import { ExternalLink } from "@lucide/astro";
import { Image } from "astro:assets";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const t = useTranslations(locale);

const perks = [
  { id: "experts", text: t("booking.perkLocalExperts", "Licensed local drivers & guides") },
  { id: "flexible", text: t("booking.perkFlexible", "Flexible departures from Marrakech") },
  { id: "support", text: t("booking.perkSupport", "Fast responses within 24 hours") },
];
---

<aside class="overflow-hidden rounded-2xl bg-slate-950 p-6 text-white shadow-xl block-full lg:p-8">
  <div class="flex flex-col gap-8">
    <div class="flex flex-col items-center gap-3 text-center">
      <p class="font-mono text-xs font-semibold tracking-[0.16em] text-orange-400 uppercase">
        {t("booking.checkBadge", "Check us")}
      </p>
      <h3 class="mbs-1 font-sans text-2xl font-semibold tracking-tight sm:text-3xl">
        {t("booking.checkTitle", "Find us on TripAdvisor")}
      </h3>
      <div class="inline-flex size-36 items-center justify-center rounded-full border border-slate-800 bg-slate-900/60 p-4 shadow-inner ring-1 ring-white/5">
        <Image
          src="/icons/tripadvisor-nav_icon.svg"
          alt={t("booking.tripadvisorAlt", "TripAdvisor icon")}
          width={96}
          height={96}
          loading="lazy"
          decoding="async"
          class="size-24 object-contain"
        />
      </div>
    </div>

    <div class="mx-auto flex w-fit items-center gap-3 rounded-xl border border-slate-800 bg-slate-900/60 px-4 py-3">
      <div class="font-mono text-2xl leading-none font-extrabold text-amber-300 tabular-nums">
        5.0
      </div>
      <div class="font-sans text-xs text-slate-200">
        {t("booking.ratingLabel", "Average guest rating")}
        <span class="block font-sans text-xs font-medium text-amber-200">
          {t("booking.reviewCount", "Based on 180+ verified reviews")}
        </span>
      </div>
    </div>

    <p class="font-sans text-sm leading-relaxed text-slate-300">
      {t(
        "booking.checkCopy",
        "Read honest reviews and, if you prefer, request your booking directly through our TripAdvisor listing.",
      )}
    </p>

    <ul class="grid gap-4 font-sans text-sm">
      {perks.map((perk, index) => (
        <li class="inline-flex items-center gap-3">
          <span class="inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-orange-500/20 text-orange-400 font-mono text-xs font-bold tabular-nums">
            {index + 1}
          </span>
          <span class="flex-1 font-sans text-xs leading-relaxed text-slate-200 sm:text-sm">
            {perk.text}
          </span>
        </li>
      ))}
    </ul>

    <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="https://www.tripadvisor.com/Attraction_Review-g293734-d32584739-Reviews-Amsirar_Travel-Marrakech_Marrakech_Safi.html"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 rounded-full bg-linear-to-br from-emerald-500 to-emerald-700 px-6 py-3 font-mono text-xs font-semibold tracking-wider text-white uppercase shadow-md shadow-emerald-600/25 transition-all duration-200 hover:shadow-lg hover:shadow-emerald-600/35 hover:brightness-105 focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 focus-visible:outline-hidden active:scale-[0.98] pointer-fine:hover:-translate-y-0.5"
        aria-label={t("booking.tripadvisorCtaAria", "Open TripAdvisor reviews in new tab")}
      >
        <span>{t("booking.checkCta", "Check reviews & book")}</span>
        <ExternalLink
          class="size-4"
          aria-hidden="true"
        />
      </a>
    </div>
  </div>
</aside>
