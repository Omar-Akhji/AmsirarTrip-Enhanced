---
import { getTourRouteMap } from "@/features/maps/data/routes";
import { parseStringArray, useTranslations } from "@/i18n/utils";
import TripLayout from "@/layouts/TripLayout.astro";
import FaqAccordion from "@/shared/ui/widgets/FaqAccordion.astro";
import PricingCard from "@/shared/ui/widgets/PricingCard.astro";
import TripInfoSections from "@/shared/ui/widgets/TripInfoSections.astro";
import type { CollectionEntry } from "astro:content";
import TourItinerary from "./TourItinerary.astro";
import TourSeoSections from "./TourSeoSections.astro";

interface Props {
  readonly tour?: CollectionEntry<"tours">["data"] | undefined;
  readonly tourKey: string;
  readonly bookingId?: number | undefined;
  readonly imageSrc: ImageMetadata;
  readonly seo: {
    readonly title: string;
    readonly metaDescription: string;
    readonly lead: string;
    readonly highlights: readonly string[];
    readonly faqs: readonly { readonly question: string; readonly answer: string }[];
    readonly price?: { readonly label: string; readonly note: string } | undefined;
    readonly imageAlt?: string | undefined;
  };
  readonly locale: string;
  readonly slug?: string | undefined;
}

const { tour, tourKey, imageSrc, seo, locale, slug = "" } = Astro.props;
const t = useTranslations(locale);

const tourSlug = slug.length > 0 ? slug : tourKey;
const transitionName = `trip-image-tours-${tourSlug}`;

const sidebarItems = parseStringArray(t.raw("tours.sidebar.items"));

const overview = t(`${tourKey}.overview`);
const includes = t(`${tourKey}.includes`);
const excludes = t(`${tourKey}.excludes`);
const goodToKnow = t(`${tourKey}.goodToKnow`);

const isEnglish = locale === "en";
const rawTitle = t(`${tourKey}.title`);
const duration = tour?.durationDays || 3;
const baseTitle = isEnglish && seo?.title ? seo.title : rawTitle;
const dossierTitle = baseTitle
  .replace(/^\s*\d+[- ]*(?:Days?|Jours?|Días?|Tage?)\s*[:|-]?\s*/i, "")
  .replace(/\s*\(\s*\d+[- ]*(?:Days?|Jours?|Días?|Tage?)\s*\)\s*$/i, "")
  .trim();

const lead = isEnglish && seo?.lead ? seo.lead : overview;

const heroSubtitle = t(
  t.has(`tours.${tourKey}.description`) ? `tours.${tourKey}.description` : "tours.headerSubtitle",
);

const startCityKey =
  tour ? `tours.cities.${tour.startLocation.toLowerCase()}` : "tours.cities.marrakech";
const endCityKey =
  tour ? `tours.cities.${tour.endLocation.toLowerCase()}` : "tours.cities.marrakech";
const endCity = t(endCityKey);
const startCity = t(startCityKey);

const highlightsTitle = t("tours.highlightsTitle");
const pricingTitle = t("tours.pricingTitle");
const priceLabel = t("tours.priceLabel");
const faqTitle = t("tours.faqTitle");
const reserveNow = t("booking.checkAvailability");

const accommodationLabel = t("tours.accommodationLabel");
const mealsLabel = t("tours.mealsLabel");
const activitiesLabel = t("tours.activitiesLabel");
const arrivalLabel = t("tours.arrivalLabel");

const days = [];
for (let index = 1; index <= duration; index++) {
  const dayKey = `${tourKey}.day${index}`;
  const defaultDayTitle = `${t("tours.day")} ${index}`;
  let dayTitle = t.has(`${dayKey}.title`) ? t(`${dayKey}.title`) : defaultDayTitle;
  if (!dayTitle || dayTitle === `${dayKey}.title`) {
    dayTitle = defaultDayTitle;
  }
  const rawDayText = t.raw(`${dayKey}.text`);
  const dayText = Array.isArray(rawDayText) ? (rawDayText as string[]) : [];

  let accommodation = "";
  let meals = "";
  let activities = "";
  let arrival = "";

  if (t.has(`${dayKey}.accommodation`)) {
    accommodation = t(`${dayKey}.accommodation`);
  }
  if (t.has(`${dayKey}.meals`)) {
    meals = t(`${dayKey}.meals`);
  }
  if (t.has(`${dayKey}.activities`)) {
    activities = t(`${dayKey}.activities`);
  }
  if (t.has(`${dayKey}.arrival`)) {
    arrival = t(`${dayKey}.arrival`);
  }

  if (dayTitle && dayTitle !== dayKey) {
    days.push({
      number: index,
      title: dayTitle,
      text: Array.isArray(dayText) ? dayText : [],
      accommodation,
      meals,
      activities,
      arrival,
    });
  }
}

const routeMap = getTourRouteMap(tourKey, startCity, endCity, dossierTitle);
---

<TripLayout
  breadcrumbs={[
    { label: t("nav.home"), href: "/" },
    { label: t("nav.tours"), href: "/tours" },
    { label: t("tours.breadcrumb") },
  ]}
  hasUnderline={true}
  headingId="tour-title"
  imageAlt={seo.imageAlt}
  imageSrc={imageSrc}
  lead={lead}
  pageSubtitle={heroSubtitle}
  pageTitle={t("tours.detailsTitle")}
  routeMap={routeMap}
  sectionId="tour-single"
  sidebar={{
    sidebarTitle: t("tours.sidebar.title"),
    mainBrand: t("tours.sidebar.mainBrand"),
    intro: t("tours.sidebar.intro"),
    details: t("tours.sidebar.details"),
    sidebarItems,
    conclusion: t("tours.sidebar.conclusion"),
    ctaTitle: t("tours.sidebar.ctaTitle"),
    ctaDescription: t("tours.sidebar.ctaDescription"),
    ctaPoint01: t("tours.sidebar.ctaPoint01"),
    ctaPoint02: t("tours.sidebar.ctaPoint02"),
    ctaPoint03: t("tours.sidebar.ctaPoint03"),
  }}
  smTitle={t("tours.detailsTitle")}
  title={dossierTitle}
  transitionName={transitionName}
>
  <Fragment slot="content">
    <TourSeoSections
      daysLabel={t("tours.days")}
      duration={duration}
      durationLabel={t("tours.duration")}
      endCity={endCity}
      endLabel={t("tours.end")}
      highlights={seo.highlights}
      highlightsTitle={highlightsTitle}
      startCity={startCity}
      startLabel={t("tours.start")}
      tourTypeLabel={t("tours.tourTypeLabel")}
      tourTypeValue={t("tours.tourTypeValue")}
    />

    <section
      aria-labelledby="tour-overview-heading"
      class="animate-delay-300"
      data-animate="fade-up"
    >
      <hgroup>
        <p class="font-sans text-xs font-bold tracking-wider text-orange-700 uppercase dark:text-orange-400">
          {t("tours.kickerAbout")}
        </p>
        <h3
          id="tour-overview-heading"
          class="mbs-1 mbe-4 text-xl font-bold tracking-tight text-stone-900 sm:text-2xl md:text-3xl dark:text-mist-100"
        >
          {t("tours.overview")}
        </h3>
      </hgroup>
      <p class="font-sans text-sm sm:text-base leading-relaxed whitespace-pre-line text-stone-700 dark:text-mist-200">
        {overview}
      </p>
    </section>

    <section
      aria-labelledby="tour-itinerary-heading"
      class="animate-delay-450"
      data-animate="fade-up"
    >
      <TourItinerary
        accommodationLabel={accommodationLabel}
        activitiesLabel={activitiesLabel}
        arrivalLabel={arrivalLabel}
        days={days}
        defaultTitle={t("tours.itinerary")}
        kicker={t("tours.kickerSchedule")}
        mealsLabel={mealsLabel}
      />
    </section>

    <TripInfoSections
      idPrefix="tour"
      excludedTitle={t("tours.excluded")}
      excludes={excludes}
      goodToKnow={goodToKnow}
      goodToKnowTitle={t("tours.goodToKnow")}
      includedTitle={t("tours.included")}
      includes={includes}
    />

    <PricingCard
      idPrefix="tour"
      pricingTitle={pricingTitle}
      priceLabel={priceLabel}
      price={seo.price ?? { label: priceLabel, note: t("tours.priceNote") }}
      reserveNow={reserveNow}
      formatComparisonTitle={t("tours.formatComparisonTitle")}
      privateOption={t("tours.privateOption")}
      privateBadge={t("tours.privateOptionBadge")}
      privateDesc={t("tours.privateOptionDesc")}
      sharedOption={t("tours.sharedOption")}
      sharedBadge={t("tours.sharedOptionBadge")}
      sharedDesc={t("tours.sharedOptionDesc")}
    />

    {seo.faqs && seo.faqs.length > 0 && (
      <FaqAccordion
        idPrefix="tour"
        faqTitle={faqTitle}
        faqs={seo.faqs}
      />
    )}
  </Fragment>
  <slot />
</TripLayout>
