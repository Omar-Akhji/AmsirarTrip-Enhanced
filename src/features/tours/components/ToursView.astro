---
import bgImage from "@/assets/images/Header/header-1.webp";
import { useTranslations } from "@/i18n/utils";
import PageHeader from "@/shared/layout/PageHeader.astro";
import Button from "@/shared/ui/Button.astro";
import StatHighlights from "@/shared/ui/StatHighlights.astro";
import TripCard from "@/shared/ui/TripCard.astro";
import { ChevronRight } from "@lucide/astro";
import { getToursData } from "../data/tours-data";

const locale = Astro.currentLocale || "en";
const tours = await getToursData();
const t = useTranslations(locale);

const tourStats = [
  {
    id: "routes",
    value: "12+",
    label: t("tours.stats.routes") || "Signature itineraries",
    description:
      t("tours.stats.routesDesc")
      || "Multi-day journeys curated across imperial cities, desert dunes, and Atlas passes.",
  },
  {
    id: "comfort",
    value: "4x4",
    label: t("tours.stats.comfort") || "Comfort fleet",
    description:
      t("tours.stats.comfortDesc")
      || "Modern 4x4s and mini-coaches with seasoned driver-guides on every route.",
  },
  {
    id: "support",
    value: "24/7",
    label: t("tours.stats.support") || "Concierge support",
    description:
      t("tours.stats.supportDesc")
      || "On-trip coordination for hotels, dietary requests, and schedule tweaks.",
  },
];

const DELAY_CLASSES = [
  "delay-0",
  "delay-150",
  "delay-300",
  "delay-[450ms]",
  "delay-[600ms]",
  "delay-[750ms]",
  "delay-[900ms]",
  "delay-[1050ms]",
] as const;
---

<PageHeader
  bgImage={bgImage}
  breadcrumbs={[{ label: t("nav.home"), href: "/" }, { label: t("nav.tours") }]}
  subtitle={t("tours.headerSubtitle")}
  title={t("tours.title")}
>
  <Button
    variant="secondary"
    href="#tours-grid"
  >
    <span>{t("tours.detailsTitle")}</span>
    <ChevronRight
      aria-hidden="true"
      class="size-4"
    />
  </Button>
  <Button
    variant="ghost"
    href="https://www.tripadvisor.com/Attraction_Review-g293734-d32584739-Reviews-Amsirar_Travel-Marrakech_Marrakech_Safi.html"
    rel="noopener noreferrer"
    target="_blank"
  >
    Offers on TripAdvisor
  </Button>
</PageHeader>

<div class="text-zinc-900">
  <section
    aria-labelledby="tour-highlights"
    class="bg-white py-12 sm:py-16 lg:py-24"
  >
    <div class="mx-auto px-4 max-inline-7xl">
      <div
        class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8"
        data-animate="fade-up"
      >
        <hgroup class="max-w-2xl space-y-2">
          <h2
            class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance"
            id="tour-highlights"
          >
            {t("tours.detailsTitle")}
          </h2>
          <p class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 leading-relaxed max-w-[62ch] text-pretty">
            {t("tours.detailsSubtitle")}
          </p>
        </hgroup>
      </div>

      <div>
        <StatHighlights
          cardBg="bg-stone-50/80"
          stats={tourStats}
        />
      </div>
    </div>
  </section>

  <section
    aria-labelledby="tours-grid-heading"
    class="border-t border-zinc-200 bg-linear-to-b from-zinc-50 to-white py-12 sm:py-16 lg:py-24"
    id="tours-grid"
  >
    <div class="mx-auto px-4 max-inline-7xl">
      <div
        class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8"
        data-animate="fade-up"
      >
        <hgroup class="max-w-2xl space-y-2">
          <h2
            class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance"
            id="tours-grid-heading"
          >
            {t("tours.tour.lgTitle")}
          </h2>
          <p class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 leading-relaxed max-w-[62ch] text-pretty">
            {t("tours.sectionSubtitle") || t("tours.detailsSubtitle")}
          </p>
        </hgroup>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {tours.map((tour, index) => (
          <div
            class:list={["flex size-full", DELAY_CLASSES[index] || "delay-0"]}
            data-animate="fade-up"
          >
            <TripCard
              badge={`${tour.duration} Days`}
              description={t(tour.description)}
              end={t(tour.end)}
              endLabel={t("tours.endLabelShort") || "End"}
              exploreLink={t("tours.exploreLink")}
              item={{ image: tour.image, imageAlt: t(tour.title), route: tour.route }}
              start={t(tour.start)}
              startLabel={t("tours.startLabelShort") || "Start"}
              title={t(tour.title)}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
</div>
