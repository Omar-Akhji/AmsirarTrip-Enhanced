---
import bgImage from "@/assets/images/Header/header-1.webp";
import { useTranslations } from "@/i18n/utils";
import PageHeader from "@/layouts/PageHeader.astro";
import { splitTitleAccent } from "@/lib/utils";
import StatHighlights from "@/shared/ui/widgets/StatHighlights.astro";
import TripCard from "@/shared/ui/widgets/TripCard.astro";
import QuestionCircleIcon from "@/shared/ui/icons/QuestionCircleIcon.astro";
import { getToursData } from "../data/tours-data";

const locale = Astro.locals.locale;
const tours = await getToursData();
const t = useTranslations(locale);

const toursGridTitle = splitTitleAccent(t("tours.tour.lgTitle"));
const toursFaqTitle = splitTitleAccent(t("tours.faq.title"));

const tourStats = [
  {
    id: "routes",
    value: "12+",
    label: t("tours.stats.routes"),
    description: t("tours.stats.routesDesc"),
  },
  {
    id: "comfort",
    value: "4x4",
    label: t("tours.stats.comfort"),
    description: t("tours.stats.comfortDesc"),
  },
  {
    id: "support",
    value: "24/7",
    label: t("tours.stats.support"),
    description: t("tours.stats.supportDesc"),
  },
];

const TOURS_FAQS = [
  { q: "tours.faq.q1", a: "tours.faq.a1" },
  { q: "tours.faq.q2", a: "tours.faq.a2" },
  { q: "tours.faq.q3", a: "tours.faq.a3" },
  { q: "tours.faq.q4", a: "tours.faq.a4" },
] as const;

import { DELAY_CLASSES } from "@/shared/ui/primitives/animation-constants";
---

<PageHeader
  bgImage={bgImage}
  breadcrumbs={[{ label: t("nav.home"), href: "/" }, { label: t("nav.tours") }]}
  hasUnderline={true}
  subtitle={t("tours.headerSubtitle")}
  title={t("tours.title")}
/>

<div class="text-zinc-900 dark:text-mist-100">
  <section
    aria-labelledby="tour-highlights"
    class="bg-white py-12 sm:py-16 lg:py-24 dark:bg-surface-base"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <h2
        class="sr-only"
        id="tour-highlights"
      >
        {t("tours.detailsTitle")}
      </h2>

      <div>
        <StatHighlights
          cardBg="bg-stone-50/80 dark:bg-surface-card/75 dark:border-white/10 dark:hover:border-white/20 dark:hover:bg-surface-hover/90"
          stats={tourStats}
        />
      </div>
    </div>
  </section>

  <section
    aria-labelledby="tours-grid-heading"
    class="border-t border-zinc-200 bg-linear-to-b from-zinc-50 to-white py-12 sm:py-16 lg:py-24 dark:border-white/10 dark:bg-surface-base dark:bg-none"
    id="tours-grid"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <div
        class="mbe-8 sm:mbe-12 flex flex-col gap-6 border-b border-stone-200 pb-6 sm:pb-8 dark:border-white/10"
        data-animate="fade-up"
      >
        <hgroup class="max-w-2xl space-y-2">
          <h2
            class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance dark:text-mist-100"
            id="tours-grid-heading"
          >
            {toursGridTitle.main}{" "}
            {toursGridTitle.accent && <span class="text-orange">{toursGridTitle.accent}</span>}
          </h2>
          <p class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 leading-relaxed max-w-[62ch] text-pretty dark:text-mist-300">
            {t("tours.sectionSubtitle")}
          </p>
        </hgroup>

        <!-- Departure Hub Filter Pills -->
        <nav
          aria-label="Filter tours by departure city"
          class="flex flex-wrap items-center gap-2 pt-1"
        >
          <span class="text-xs font-semibold uppercase tracking-wider text-stone-500 pe-1 dark:text-mist-400">
            Departure:
          </span>
          <button
            type="button"
            class="hub-filter-btn rounded-full px-4 py-1.5 text-xs font-semibold transition-all duration-200 cursor-pointer border data-[active=true]:bg-stone-900 data-[active=true]:text-white data-[active=true]:border-stone-900 data-[active=true]:shadow-xs data-[active=false]:bg-stone-100 data-[active=false]:text-stone-700 data-[active=false]:border-stone-200/80 data-[active=false]:hover:bg-stone-200 data-[active=false]:hover:text-stone-900 data-[active=false]:hover:border-stone-300 dark:data-[active=true]:bg-white dark:data-[active=true]:text-stone-950 dark:data-[active=true]:border-white dark:data-[active=true]:shadow-xs dark:data-[active=false]:bg-white/5 dark:data-[active=false]:text-mist-300 dark:data-[active=false]:border-white/10 dark:data-[active=false]:hover:bg-white/10 dark:data-[active=false]:hover:text-white dark:data-[active=false]:hover:border-white/20"
            data-city="all"
            data-active="true"
            aria-pressed="true"
            data-ascii="fade"
          >
            All Cities
          </button>
          <button
            type="button"
            class="hub-filter-btn rounded-full px-4 py-1.5 text-xs font-semibold transition-all duration-200 cursor-pointer border data-[active=true]:bg-stone-900 data-[active=true]:text-white data-[active=true]:border-stone-900 data-[active=true]:shadow-xs data-[active=false]:bg-stone-100 data-[active=false]:text-stone-700 data-[active=false]:border-stone-200/80 data-[active=false]:hover:bg-stone-200 data-[active=false]:hover:text-stone-900 data-[active=false]:hover:border-stone-300 dark:data-[active=true]:bg-white dark:data-[active=true]:text-stone-950 dark:data-[active=true]:border-white dark:data-[active=true]:shadow-xs dark:data-[active=false]:bg-white/5 dark:data-[active=false]:text-mist-300 dark:data-[active=false]:border-white/10 dark:data-[active=false]:hover:bg-white/10 dark:data-[active=false]:hover:text-white dark:data-[active=false]:hover:border-white/20"
            data-city="marrakech"
            data-active="false"
            aria-pressed="false"
            data-ascii="fade"
          >
            From Marrakech
          </button>
          <button
            type="button"
            class="hub-filter-btn rounded-full px-4 py-1.5 text-xs font-semibold transition-all duration-200 cursor-pointer border data-[active=true]:bg-stone-900 data-[active=true]:text-white data-[active=true]:border-stone-900 data-[active=true]:shadow-xs data-[active=false]:bg-stone-100 data-[active=false]:text-stone-700 data-[active=false]:border-stone-200/80 data-[active=false]:hover:bg-stone-200 data-[active=false]:hover:text-stone-900 data-[active=false]:hover:border-stone-300 dark:data-[active=true]:bg-white dark:data-[active=true]:text-stone-950 dark:data-[active=true]:border-white dark:data-[active=true]:shadow-xs dark:data-[active=false]:bg-white/5 dark:data-[active=false]:text-mist-300 dark:data-[active=false]:border-white/10 dark:data-[active=false]:hover:bg-white/10 dark:data-[active=false]:hover:text-white dark:data-[active=false]:hover:border-white/20"
            data-city="fes"
            data-active="false"
            aria-pressed="false"
            data-ascii="fade"
          >
            From Fes
          </button>
          <button
            type="button"
            class="hub-filter-btn rounded-full px-4 py-1.5 text-xs font-semibold transition-all duration-200 cursor-pointer border data-[active=true]:bg-stone-900 data-[active=true]:text-white data-[active=true]:border-stone-900 data-[active=true]:shadow-xs data-[active=false]:bg-stone-100 data-[active=false]:text-stone-700 data-[active=false]:border-stone-200/80 data-[active=false]:hover:bg-stone-200 data-[active=false]:hover:text-stone-900 data-[active=false]:hover:border-stone-300 dark:data-[active=true]:bg-white dark:data-[active=true]:text-stone-950 dark:data-[active=true]:border-white dark:data-[active=true]:shadow-xs dark:data-[active=false]:bg-white/5 dark:data-[active=false]:text-mist-300 dark:data-[active=false]:border-white/10 dark:data-[active=false]:hover:bg-white/10 dark:data-[active=false]:hover:text-white dark:data-[active=false]:hover:border-white/20"
            data-city="casablanca"
            data-active="false"
            aria-pressed="false"
            data-ascii="fade"
          >
            From Casablanca
          </button>
          <button
            type="button"
            class="hub-filter-btn rounded-full px-4 py-1.5 text-xs font-semibold transition-all duration-200 cursor-pointer border data-[active=true]:bg-stone-900 data-[active=true]:text-white data-[active=true]:border-stone-900 data-[active=true]:shadow-xs data-[active=false]:bg-stone-100 data-[active=false]:text-stone-700 data-[active=false]:border-stone-200/80 data-[active=false]:hover:bg-stone-200 data-[active=false]:hover:text-stone-900 data-[active=false]:hover:border-stone-300 dark:data-[active=true]:bg-white dark:data-[active=true]:text-stone-950 dark:data-[active=true]:border-white dark:data-[active=true]:shadow-xs dark:data-[active=false]:bg-white/5 dark:data-[active=false]:text-mist-300 dark:data-[active=false]:border-white/10 dark:data-[active=false]:hover:bg-white/10 dark:data-[active=false]:hover:text-white dark:data-[active=false]:hover:border-white/20"
            data-city="tangier"
            data-active="false"
            aria-pressed="false"
            data-ascii="fade"
          >
            From Tangier
          </button>
        </nav>
      </div>

      <div
        class="grid grid-cols-1 gap-6 xs:gap-7 md:grid-cols-2 lg:grid-cols-3 lg:gap-8 2xl:gap-10"
        id="tours-grid-container"
      >
        {tours.map((tour, index) => (
          <div
            class:list={["tour-card-item flex size-full", DELAY_CLASSES[index] || "delay-0"]}
            data-animate="fade-up"
            data-departure={tour.startLocation}
          >
            <TripCard
              badge={`${tour.duration} Days`}
              tourTypeBadge={t("tours.bothAvailable")}
              description={t(tour.description)}
              end={t(tour.end)}
              endLabel={t("tours.endLabelShort")}
              exploreLink={t("tours.exploreLink")}
              item={{ image: tour.image, imageAlt: t(tour.title), route: tour.route }}
              start={t(tour.start)}
              startLabel={t("tours.startLabelShort")}
              title={t(tour.title)}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section
    aria-labelledby="tours-faq-heading"
    class="border-t border-zinc-200 bg-white py-12 sm:py-16 lg:py-20 dark:border-white/10 dark:bg-surface-base"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <hgroup
        class="mb-8 max-w-2xl"
        data-animate="fade-up"
      >
        <h2
          class="text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl dark:text-mist-100"
          id="tours-faq-heading"
        >
          {toursFaqTitle.main}{" "}
          {toursFaqTitle.accent && <span class="text-orange">{toursFaqTitle.accent}</span>}
        </h2>
        <p class="mt-2 border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 leading-relaxed max-w-[62ch] text-pretty dark:text-mist-300">
          {t("tours.faq.subtitle")}
        </p>
      </hgroup>

      <dl
        class="max-w-3xl overflow-hidden rounded-2xl border border-stone-200/90 bg-white shadow-2xs divide-y divide-stone-200/80 dark:border-white/10 dark:bg-surface-card/85 dark:divide-white/10 dark:shadow-[0_4px_20px_-2px_rgba(0,0,0,0.4)]"
        data-animate="fade-up"
        data-ascii="surface"
        itemscope
        itemtype="https://schema.org/FAQPage"
      >
        {TOURS_FAQS.map((faq) => (
          <div
            itemprop="mainEntity"
            itemscope
            itemtype="https://schema.org/Question"
          >
            <dt>
              <details class="group px-4 py-3.5 sm:px-5 sm:py-4 transition-colors open:bg-stone-50/40 dark:open:bg-white/5 details-content:block-0 details-content:overflow-clip details-content:opacity-0 details-content:transition-[block-size,content-visibility,opacity] details-content:duration-300 details-content:ease-out-expo details-content:transition-discrete motion-reduce:details-content:transition-none open:details-content:block-auto open:details-content:opacity-100">
                <summary class="flex cursor-pointer items-start justify-between gap-4 text-base font-semibold text-stone-900 dark:text-mist-100 marker:content-none list-none select-none">
                  <span
                    class="flex items-center gap-2.5 min-w-0"
                    itemprop="name"
                  >
                    <QuestionCircleIcon
                      aria-hidden="true"
                      class="size-5 shrink-0 text-orange-600 dark:text-orange"
                    />
                    <span>{t(faq.q)}</span>
                  </span>
                  <span
                    aria-hidden="true"
                    class="mt-0.5 shrink-0 text-orange-600 dark:text-orange group-open:rotate-45 transition-transform duration-200 motion-reduce:transition-none font-medium text-lg leading-none select-none"
                  >
                    +
                  </span>
                </summary>
                <div
                  class="mt-4 pt-3.5 border-t border-stone-100 dark:border-white/10 text-sm leading-relaxed text-stone-600 dark:text-mist-300 prose prose-sm max-w-none"
                  itemprop="acceptedAnswer"
                  itemscope
                  itemtype="https://schema.org/Answer"
                >
                  <p itemprop="text">{t(faq.a)}</p>
                </div>
              </details>
            </dt>
          </div>
        ))}
      </dl>
    </div>
  </section>
</div>

<script src="../scripts/tour-departure-filter.ts"></script>
