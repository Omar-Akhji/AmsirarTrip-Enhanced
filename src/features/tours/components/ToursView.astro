---
import bgImage from "@/assets/images/Header/header-1.webp";
import { useTranslations } from "@/i18n/utils";
import PageHeader from "@/layouts/PageHeader.astro";
import { splitTitleAccent } from "@/lib/utils";
import StatHighlights from "@/shared/ui/widgets/StatHighlights.astro";
import TripCard from "@/shared/ui/widgets/TripCard.astro";
import QuestionCircleIcon from "@/shared/ui/icons/QuestionCircleIcon.astro";
import { getToursData } from "../data/tours-data";

const locale = Astro.currentLocale || "en";
const tours = await getToursData();
const t = useTranslations(locale);

const toursGridTitle = splitTitleAccent(t("tours.tour.lgTitle"));
const toursFaqTitle = splitTitleAccent(
  t("tours.faq.title") || "Common Questions About Our Morocco Tours",
);

const tourStats = [
  {
    id: "routes",
    value: "12+",
    label: t("tours.stats.routes") || "Signature itineraries",
    description:
      t("tours.stats.routesDesc")
      || "Multi-day journeys curated across imperial cities, desert dunes, and Atlas passes.",
  },
  {
    id: "comfort",
    value: "4x4",
    label: t("tours.stats.comfort") || "Comfort fleet",
    description:
      t("tours.stats.comfortDesc")
      || "Modern 4x4s and mini-coaches with seasoned driver-guides on every route.",
  },
  {
    id: "support",
    value: "24/7",
    label: t("tours.stats.support") || "Concierge support",
    description:
      t("tours.stats.supportDesc")
      || "On-trip coordination for hotels, dietary requests, and schedule tweaks.",
  },
];

const TOURS_FAQS = [
  {
    q: "tours.faq.q1",
    defQ: "What types of desert tours are available from Marrakech?",
    a: "tours.faq.a1",
    defA: "Amsirar Trip offers multi-day Morocco tours ranging from 3 to 14 days. Options include Sahara desert camel treks starting from Marrakech to Erg Chebbi dunes in Merzouga, High Atlas mountain crossings via Tizi n'Tichka pass, and imperial city circuits through Fes, Meknes, and Rabat. All tours depart from Marrakech and are available year-round with private 4×4 vehicles and licensed Moroccan guides.",
  },
  {
    q: "tours.faq.q2",
    defQ: "Is Amsirar Trip a licensed tour operator in Morocco?",
    a: "tours.faq.a2",
    defA: "Yes. Amsirar Trip operates under Moroccan tourism license number 24/TT/RAK, issued by the Ministry of Tourism, Handicraft, Social Economy and Solidarity. We are headquartered in Marrakech and fully comply with Moroccan travel industry regulations.",
  },
  {
    q: "tours.faq.q3",
    defQ: "What is the best time of year for a Sahara desert tour from Marrakech?",
    a: "tours.faq.a3",
    defA: "The ideal months for a Sahara desert tour from Marrakech are October to April, when daytime temperatures in the Erg Chebbi dunes range between 18°C and 28°C. Summer (June–August) sees temperatures above 40°C in the desert but remains manageable in the High Atlas. We operate tours year-round and can advise on the best itinerary for your travel dates.",
  },
  {
    q: "tours.faq.q4",
    defQ: "Are tours private or shared group departures?",
    a: "tours.faq.a4",
    defA: "Amsirar Trip offers both private VIP departures and budget-friendly small-group shared departures. Private tours travel exclusively with your party in a dedicated 4×4 or minibus with flexible start times and custom stops, while shared departures connect small groups of 8 to 14 travelers on scheduled desert routes.",
  },
] as const;

import { DELAY_CLASSES } from "@/shared/ui/primitives/animation-constants";
---

<PageHeader
  bgImage={bgImage}
  breadcrumbs={[{ label: t("nav.home"), href: "/" }, { label: t("nav.tours") }]}
  hasUnderline={true}
  subtitle={t("tours.headerSubtitle")}
  title={t("tours.title")}
/>

<div class="text-zinc-900">
  <section
    aria-labelledby="tour-highlights"
    class="bg-white py-12 sm:py-16 lg:py-24"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <h2
        class="sr-only"
        id="tour-highlights"
      >
        {t("tours.detailsTitle")}
      </h2>

      <div>
        <StatHighlights
          cardBg="bg-stone-50/80"
          stats={tourStats}
        />
      </div>
    </div>
  </section>

  <section
    aria-labelledby="tours-grid-heading"
    class="border-t border-zinc-200 bg-linear-to-b from-zinc-50 to-white py-12 sm:py-16 lg:py-24"
    id="tours-grid"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <div
        class="mbe-8 sm:mbe-12 flex flex-col gap-6 border-b border-stone-200 pb-6 sm:pb-8"
        data-animate="fade-up"
      >
        <hgroup class="max-w-2xl space-y-2">
          <h2
            class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance"
            id="tours-grid-heading"
          >
            {toursGridTitle.main}{" "}
            {toursGridTitle.accent && <span class="text-orange">{toursGridTitle.accent}</span>}
          </h2>
          <p class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 leading-relaxed max-w-[62ch] text-pretty">
            {t("tours.sectionSubtitle") || t("tours.detailsSubtitle")}
          </p>
        </hgroup>

        <!-- Departure Hub Filter Pills -->
        <nav
          aria-label="Filter tours by departure city"
          class="flex flex-wrap items-center gap-2 pt-1"
        >
          <span class="text-xs font-semibold uppercase tracking-wider text-stone-500 pe-1">
            Departure:
          </span>
          <button
            type="button"
            class="hub-filter-btn rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors bg-stone-900 text-white cursor-pointer"
            data-city="all"
            data-ascii="fade"
          >
            All Cities
          </button>
          <button
            type="button"
            class="hub-filter-btn rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors bg-stone-100 text-stone-700 hover:bg-stone-200 cursor-pointer"
            data-city="marrakech"
            data-ascii="fade"
          >
            From Marrakech
          </button>
          <button
            type="button"
            class="hub-filter-btn rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors bg-stone-100 text-stone-700 hover:bg-stone-200 cursor-pointer"
            data-city="fes"
            data-ascii="fade"
          >
            From Fes
          </button>
          <button
            type="button"
            class="hub-filter-btn rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors bg-stone-100 text-stone-700 hover:bg-stone-200 cursor-pointer"
            data-city="casablanca"
            data-ascii="fade"
          >
            From Casablanca
          </button>
          <button
            type="button"
            class="hub-filter-btn rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors bg-stone-100 text-stone-700 hover:bg-stone-200 cursor-pointer"
            data-city="tangier"
            data-ascii="fade"
          >
            From Tangier
          </button>
        </nav>
      </div>

      <div
        class="grid grid-cols-1 gap-6 xs:gap-7 md:grid-cols-2 lg:grid-cols-3 lg:gap-8 2xl:gap-10"
        id="tours-grid-container"
      >
        {tours.map((tour, index) => (
          <div
            class:list={["tour-card-item flex size-full", DELAY_CLASSES[index] || "delay-0"]}
            data-animate="fade-up"
            data-departure={tour.startLocation}
          >
            <TripCard
              badge={`${tour.duration} Days`}
              tourTypeBadge={t("tours.bothAvailable", "Private & Shared")}
              description={t(tour.description)}
              end={t(tour.end)}
              endLabel={t("tours.endLabelShort") || "End"}
              exploreLink={t("tours.exploreLink")}
              item={{ image: tour.image, imageAlt: t(tour.title), route: tour.route }}
              start={t(tour.start)}
              startLabel={t("tours.startLabelShort") || "Start"}
              title={t(tour.title)}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section
    aria-labelledby="tours-faq-heading"
    class="border-t border-zinc-200 bg-white py-12 sm:py-16 lg:py-20"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <hgroup
        class="mb-8 max-w-2xl"
        data-animate="fade-up"
      >
        <h2
          class="text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl"
          id="tours-faq-heading"
        >
          {toursFaqTitle.main}{" "}
          {toursFaqTitle.accent && <span class="text-orange">{toursFaqTitle.accent}</span>}
        </h2>
        <p class="mt-2 border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 leading-relaxed max-w-[62ch] text-pretty">
          {t("tours.faq.subtitle") || "Everything you need to plan your desert journey."}
        </p>
      </hgroup>

      <dl
        class="max-w-3xl overflow-hidden rounded-2xl border border-stone-200/90 bg-white shadow-2xs divide-y divide-stone-200/80"
        data-animate="fade-up"
        data-ascii="surface"
        itemscope
        itemtype="https://schema.org/FAQPage"
      >
        {TOURS_FAQS.map((faq) => (
          <div
            itemprop="mainEntity"
            itemscope
            itemtype="https://schema.org/Question"
          >
            <dt>
              <details class="group px-4 py-3.5 sm:px-5 sm:py-4 transition-colors open:bg-stone-50/40 details-content:block-0 details-content:overflow-clip details-content:opacity-0 details-content:transition-[block-size,content-visibility,opacity] details-content:duration-300 details-content:ease-out-expo details-content:transition-discrete motion-reduce:details-content:transition-none open:details-content:block-auto open:details-content:opacity-100">
                <summary class="flex cursor-pointer items-start justify-between gap-4 text-base font-semibold text-stone-900 marker:content-none list-none select-none">
                  <span
                    class="flex items-center gap-2.5 min-w-0"
                    itemprop="name"
                  >
                    <QuestionCircleIcon
                      aria-hidden="true"
                      class="size-5 shrink-0 text-orange-600"
                    />
                    <span>{t(faq.q) || faq.defQ}</span>
                  </span>
                  <span
                    aria-hidden="true"
                    class="mt-0.5 shrink-0 text-orange-600 group-open:rotate-45 transition-transform duration-200 motion-reduce:transition-none font-medium text-lg leading-none select-none"
                  >
                    +
                  </span>
                </summary>
                <div
                  class="mt-4 pt-3.5 border-t border-stone-100 text-sm leading-relaxed text-stone-600 prose prose-sm max-w-none"
                  itemprop="acceptedAnswer"
                  itemscope
                  itemtype="https://schema.org/Answer"
                >
                  <p itemprop="text">{t(faq.a) || faq.defA}</p>
                </div>
              </details>
            </dt>
          </div>
        ))}
      </dl>
    </div>
  </section>
</div>

<script src="../scripts/tour-departure-filter.ts"></script>
