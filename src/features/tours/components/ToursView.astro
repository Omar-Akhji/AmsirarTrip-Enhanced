---
import bgImage from "@/assets/images/Header/header-1.webp";
import { useTranslations } from "@/i18n/utils";
import PageHeader from "@/layouts/PageHeader.astro";
import StatHighlights from "@/shared/ui/widgets/StatHighlights.astro";
import TripCard from "@/shared/ui/widgets/TripCard.astro";
import { getToursData } from "../data/tours-data";

const locale = Astro.currentLocale || "en";
const tours = await getToursData();
const t = useTranslations(locale);

const tourStats = [
  {
    id: "routes",
    value: "12+",
    label: t("tours.stats.routes") || "Signature itineraries",
    description:
      t("tours.stats.routesDesc")
      || "Multi-day journeys curated across imperial cities, desert dunes, and Atlas passes.",
  },
  {
    id: "comfort",
    value: "4x4",
    label: t("tours.stats.comfort") || "Comfort fleet",
    description:
      t("tours.stats.comfortDesc")
      || "Modern 4x4s and mini-coaches with seasoned driver-guides on every route.",
  },
  {
    id: "support",
    value: "24/7",
    label: t("tours.stats.support") || "Concierge support",
    description:
      t("tours.stats.supportDesc")
      || "On-trip coordination for hotels, dietary requests, and schedule tweaks.",
  },
];

import { DELAY_CLASSES } from "@/shared/ui/primitives/animation-constants";
---

<PageHeader
  bgImage={bgImage}
  breadcrumbs={[{ label: t("nav.home"), href: "/" }, { label: t("nav.tours") }]}
  hasUnderline={true}
  subtitle={t("tours.headerSubtitle")}
  title={t("tours.title")}
/>

<div class="text-zinc-900">
  <section
    aria-labelledby="tour-highlights"
    class="bg-white py-12 sm:py-16 lg:py-24"
  >
    <div class="mx-auto px-4 max-inline-7xl">
      <h2
        class="sr-only"
        id="tour-highlights"
      >
        {t("tours.detailsTitle")}
      </h2>

      <div>
        <StatHighlights
          cardBg="bg-stone-50/80"
          stats={tourStats}
        />
      </div>
    </div>
  </section>

  <section
    aria-labelledby="tours-grid-heading"
    class="border-t border-zinc-200 bg-linear-to-b from-zinc-50 to-white py-12 sm:py-16 lg:py-24"
    id="tours-grid"
  >
    <div class="mx-auto px-4 max-inline-7xl">
      <div
        class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8"
        data-animate="fade-up"
      >
        <hgroup class="max-w-2xl space-y-2">
          <h2
            class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance"
            id="tours-grid-heading"
          >
            {t("tours.tour.lgTitle")}
          </h2>
          <p class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 leading-relaxed max-w-[62ch] text-pretty">
            {t("tours.sectionSubtitle") || t("tours.detailsSubtitle")}
          </p>
        </hgroup>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {tours.map((tour, index) => (
          <div
            class:list={["flex size-full", DELAY_CLASSES[index] || "delay-0"]}
            data-animate="fade-up"
          >
            <TripCard
              badge={`${tour.duration} Days`}
              description={t(tour.description)}
              end={t(tour.end)}
              endLabel={t("tours.endLabelShort") || "End"}
              exploreLink={t("tours.exploreLink")}
              item={{ image: tour.image, imageAlt: t(tour.title), route: tour.route }}
              start={t(tour.start)}
              startLabel={t("tours.startLabelShort") || "Start"}
              title={t(tour.title)}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section
    aria-labelledby="tours-faq-heading"
    class="border-t border-zinc-200 bg-white py-12 sm:py-16 lg:py-20"
  >
    <div class="mx-auto px-4 max-inline-7xl">
      <hgroup
        class="mb-8 max-w-2xl"
        data-animate="fade-up"
      >
        <h2
          class="text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl"
          id="tours-faq-heading"
        >
          {t("tours.faq.title") || "Common Questions About Our Morocco Tours"}
        </h2>
        <p class="mt-2 text-sm text-stone-500">
          {t("tours.faq.subtitle") || "Everything you need to plan your desert journey."}
        </p>
      </hgroup>

      <dl
        class="divide-y divide-stone-200 max-w-3xl"
        data-animate="fade-up"
        itemscope
        itemtype="https://schema.org/FAQPage"
      >
        <div
          class="py-5"
          itemprop="mainEntity"
          itemscope
          itemtype="https://schema.org/Question"
        >
          <dt>
            <details class="group">
              <summary class="flex cursor-pointer items-start justify-between gap-4 text-base font-semibold text-stone-900 marker:content-none list-none">
                <span itemprop="name">
                  {t("tours.faq.q1") || "What types of desert tours are available from Marrakech?"}
                </span>
                <span
                  aria-hidden="true"
                  class="mt-0.5 shrink-0 text-orange-600 group-open:rotate-45 transition-transform duration-200"
                >
                  +
                </span>
              </summary>
              <div
                class="mt-3 text-sm leading-7 text-stone-600 prose prose-sm max-w-none"
                itemprop="acceptedAnswer"
                itemscope
                itemtype="https://schema.org/Answer"
              >
                <p itemprop="text">
                  {t("tours.faq.a1")
                    || "Amsirar Trip offers multi-day Morocco tours ranging from 3 to 14 days. Options include Sahara desert camel treks starting from Marrakech to Erg Chebbi dunes in Merzouga, High Atlas mountain crossings via Tizi n'Tichka pass, and imperial city circuits through Fes, Meknes, and Rabat. All tours depart from Marrakech and are available year-round with private 4×4 vehicles and licensed Moroccan guides."}
                </p>
              </div>
            </details>
          </dt>
        </div>

        <div
          class="py-5"
          itemprop="mainEntity"
          itemscope
          itemtype="https://schema.org/Question"
        >
          <dt>
            <details class="group">
              <summary class="flex cursor-pointer items-start justify-between gap-4 text-base font-semibold text-stone-900 marker:content-none list-none">
                <span itemprop="name">
                  {t("tours.faq.q2") || "Is Amsirar Trip a licensed tour operator in Morocco?"}
                </span>
                <span
                  aria-hidden="true"
                  class="mt-0.5 shrink-0 text-orange-600 group-open:rotate-45 transition-transform duration-200"
                >
                  +
                </span>
              </summary>
              <div
                class="mt-3 text-sm leading-7 text-stone-600 prose prose-sm max-w-none"
                itemprop="acceptedAnswer"
                itemscope
                itemtype="https://schema.org/Answer"
              >
                <p itemprop="text">
                  {t("tours.faq.a2")
                    || "Yes. Amsirar Trip operates under Moroccan tourism license number 24/TT/RAK, issued by the Ministry of Tourism, Handicraft, Social Economy and Solidarity. We are headquartered in Marrakech and fully comply with Moroccan travel industry regulations."}
                </p>
              </div>
            </details>
          </dt>
        </div>

        <div
          class="py-5"
          itemprop="mainEntity"
          itemscope
          itemtype="https://schema.org/Question"
        >
          <dt>
            <details class="group">
              <summary class="flex cursor-pointer items-start justify-between gap-4 text-base font-semibold text-stone-900 marker:content-none list-none">
                <span itemprop="name">
                  {t("tours.faq.q3")
                    || "What is the best time of year for a Sahara desert tour from Marrakech?"}
                </span>
                <span
                  aria-hidden="true"
                  class="mt-0.5 shrink-0 text-orange-600 group-open:rotate-45 transition-transform duration-200"
                >
                  +
                </span>
              </summary>
              <div
                class="mt-3 text-sm leading-7 text-stone-600 prose prose-sm max-w-none"
                itemprop="acceptedAnswer"
                itemscope
                itemtype="https://schema.org/Answer"
              >
                <p itemprop="text">
                  {t("tours.faq.a3")
                    || "The ideal months for a Sahara desert tour from Marrakech are October to April, when daytime temperatures in the Erg Chebbi dunes range between 18°C and 28°C. Summer (June–August) sees temperatures above 40°C in the desert but remains manageable in the High Atlas. We operate tours year-round and can advise on the best itinerary for your travel dates."}
                </p>
              </div>
            </details>
          </dt>
        </div>

        <div
          class="py-5"
          itemprop="mainEntity"
          itemscope
          itemtype="https://schema.org/Question"
        >
          <dt>
            <details class="group">
              <summary class="flex cursor-pointer items-start justify-between gap-4 text-base font-semibold text-stone-900 marker:content-none list-none">
                <span itemprop="name">
                  {t("tours.faq.q4") || "Are tours private or shared group departures?"}
                </span>
                <span
                  aria-hidden="true"
                  class="mt-0.5 shrink-0 text-orange-600 group-open:rotate-45 transition-transform duration-200"
                >
                  +
                </span>
              </summary>
              <div
                class="mt-3 text-sm leading-7 text-stone-600 prose prose-sm max-w-none"
                itemprop="acceptedAnswer"
                itemscope
                itemtype="https://schema.org/Answer"
              >
                <p itemprop="text">
                  {t("tours.faq.a4")
                    || "All Amsirar Trip tours are private departures. Your group travels exclusively with your party in a dedicated 4×4 or minibus, with a personal driver-guide. We do not combine guests from different bookings. This allows flexible start times, route adjustments, and personalised stop preferences throughout your Morocco journey."}
                </p>
              </div>
            </details>
          </dt>
        </div>
      </dl>
    </div>
  </section>
</div>
