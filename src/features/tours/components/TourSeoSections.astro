---
import FaqAccordion from "@/shared/ui/FaqAccordion.astro";
import HighlightsList from "@/shared/ui/HighlightsList.astro";
import PricingCard from "@/shared/ui/PricingCard.astro";
import { Clock, Flag, MapPinned } from "@lucide/astro";

interface Props {
  readonly duration?: number | undefined;
  readonly durationLabel: string;
  readonly daysLabel: string;
  readonly startLabel: string;
  readonly startCity: string;
  readonly endLabel: string;
  readonly endCity: string;
  readonly priceLabel: string;
  readonly price: { readonly label: string; readonly note: string };
  readonly highlightsTitle: string;
  readonly highlights: readonly string[];
  readonly pricingTitle: string;
  readonly reserveNow: string;
  readonly faqTitle: string;
  readonly faqs: readonly { readonly question: string; readonly answer: string }[];
}

const {
  duration = 3,
  durationLabel,
  daysLabel,
  startLabel,
  startCity,
  endLabel,
  endCity,
  priceLabel,
  price,
  highlightsTitle,
  highlights,
  pricingTitle,
  reserveNow,
  faqTitle,
  faqs,
} = Astro.props;
---

<div
  class="delay-150"
  data-animate="fade-up"
>
  <dl class="m-0 p-0 grid grid-cols-1 gap-3 sm:gap-4 sm:grid-cols-3">
    <div class="flex items-center gap-4 rounded-2xl border border-stone-200/90 bg-white px-5 py-3 shadow-2xs transition-colors hover:border-stone-300 min-block-20">
      <Clock
        aria-hidden="true"
        class="size-5 shrink-0 text-orange-600"
      />
      <div class="text-start min-w-0">
        <dt class="font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase">
          {durationLabel}
        </dt>
        <dd class="m-0 font-mono text-sm sm:text-base font-bold text-stone-900 tabular-nums">
          {duration ?? 3} {daysLabel}
        </dd>
      </div>
    </div>

    <div class="flex items-center gap-4 rounded-2xl border border-stone-200/90 bg-white px-5 py-3 shadow-2xs transition-colors hover:border-stone-300 min-block-20">
      <MapPinned
        aria-hidden="true"
        class="size-5 shrink-0 text-orange-600"
        stroke-width={2}
      />
      <div class="text-start min-w-0">
        <dt class="font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase">
          {startLabel}
        </dt>
        <dd class="m-0 font-mono text-sm sm:text-base font-bold text-stone-900 truncate">
          {startCity}
        </dd>
      </div>
    </div>

    <div class="flex items-center gap-4 rounded-2xl border border-stone-200/90 bg-white px-5 py-3 shadow-2xs transition-colors hover:border-stone-300 min-block-20">
      <Flag
        aria-hidden="true"
        class="size-5 shrink-0 text-orange-600"
      />
      <div class="text-start min-w-0">
        <dt class="font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase">
          {endLabel}
        </dt>
        <dd class="m-0 font-mono text-sm sm:text-base font-bold text-stone-900 truncate">
          {endCity}
        </dd>
      </div>
    </div>
  </dl>
</div>

<HighlightsList
  idPrefix="tour"
  highlightsTitle={highlightsTitle}
  highlights={highlights}
/>

<PricingCard
  idPrefix="tour"
  pricingTitle={pricingTitle}
  priceLabel={priceLabel}
  price={price}
  reserveNow={reserveNow}
/>

<FaqAccordion
  idPrefix="tour"
  faqTitle={faqTitle}
  faqs={faqs}
/>
