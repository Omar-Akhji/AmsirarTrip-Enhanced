---
import ClockCircleIcon from "@/shared/ui/icons/ClockCircleIcon.astro";
import FlagIcon from "@/shared/ui/icons/FlagIcon.astro";
import PointOnMapIcon from "@/shared/ui/icons/PointOnMapIcon.astro";
import SparklesIcon from "@/shared/ui/icons/SparklesIcon.astro";
import HighlightsList from "@/shared/ui/widgets/HighlightsList.astro";

interface Props {
  readonly duration?: number | undefined;
  readonly durationLabel: string;
  readonly daysLabel: string;
  readonly startLabel: string;
  readonly startCity: string;
  readonly endLabel: string;
  readonly endCity: string;
  readonly highlightsTitle: string;
  readonly highlights: readonly string[];
  readonly tourTypeLabel?: string | undefined;
  readonly tourTypeValue?: string | undefined;
}

const {
  duration = 3,
  durationLabel,
  daysLabel,
  startLabel,
  startCity,
  endLabel,
  endCity,
  highlightsTitle,
  highlights,
  tourTypeLabel,
  tourTypeValue = "Private & Shared",
} = Astro.props;
---

<div
  class="delay-150"
  data-animate="fade-up"
>
  <dl
    class:list={[
      "m-0 p-0 grid grid-cols-1 gap-3 sm:gap-4",
      { "grid-cols-2 lg:grid-cols-4": tourTypeLabel, "sm:grid-cols-3": !tourTypeLabel },
    ]}
  >
    <div
      class="flex items-center gap-4 rounded-2xl border border-stone-200/90 bg-white px-5 py-3 shadow-2xs transition-colors hover:border-stone-300 min-block-20"
      data-ascii="surface"
    >
      <ClockCircleIcon
        aria-hidden="true"
        class="size-5 shrink-0 text-orange-600"
      />
      <div class="text-start min-w-0">
        <dt class="font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase">
          {durationLabel}
        </dt>
        <dd
          class="m-0 font-mono text-sm sm:text-base font-bold text-stone-900 tabular-nums"
          data-ascii-digits
        >
          {duration ?? 3} {daysLabel}
        </dd>
      </div>
    </div>

    <div
      class="flex items-center gap-4 rounded-2xl border border-stone-200/90 bg-white px-5 py-3 shadow-2xs transition-colors hover:border-stone-300 min-block-20"
      data-ascii="surface"
    >
      <PointOnMapIcon
        aria-hidden="true"
        class="size-5 shrink-0 text-orange-600"
      />
      <div class="text-start min-w-0">
        <dt class="font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase">
          {startLabel}
        </dt>
        <dd class="m-0 font-mono text-sm sm:text-base font-bold text-stone-900 truncate">
          {startCity}
        </dd>
      </div>
    </div>

    <div
      class="flex items-center gap-4 rounded-2xl border border-stone-200/90 bg-white px-5 py-3 shadow-2xs transition-colors hover:border-stone-300 min-block-20"
      data-ascii="surface"
    >
      <FlagIcon
        aria-hidden="true"
        class="size-5 shrink-0 text-orange-600"
      />
      <div class="text-start min-w-0">
        <dt class="font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase">
          {endLabel}
        </dt>
        <dd class="m-0 font-mono text-sm sm:text-base font-bold text-stone-900 truncate">
          {endCity}
        </dd>
      </div>
    </div>

    {tourTypeLabel && (
      <div
        class="flex items-center gap-4 rounded-2xl border border-stone-200/90 bg-white px-5 py-3 shadow-2xs transition-colors hover:border-stone-300 min-block-20"
        data-ascii="surface"
      >
        <SparklesIcon
          aria-hidden="true"
          class="size-5 shrink-0 text-orange-600"
        />
        <div class="text-start min-w-0">
          <dt class="font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase">
            {tourTypeLabel}
          </dt>
          <dd class="m-0 font-mono text-sm sm:text-base font-bold text-stone-900 truncate">
            {tourTypeValue}
          </dd>
        </div>
      </div>
    )}
  </dl>
</div>

<HighlightsList
  idPrefix="tour"
  highlightsTitle={highlightsTitle}
  highlights={highlights}
/>
