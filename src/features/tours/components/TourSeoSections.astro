---
import ClockCircleIcon from "@/shared/ui/icons/ClockCircleIcon.astro";
import FlagIcon from "@/shared/ui/icons/FlagIcon.astro";
import PointOnMapIcon from "@/shared/ui/icons/PointOnMapIcon.astro";
import SparklesIcon from "@/shared/ui/icons/SparklesIcon.astro";
import HighlightsList from "@/shared/ui/widgets/HighlightsList.astro";

interface Props {
  readonly duration?: number | undefined;
  readonly durationLabel: string;
  readonly daysLabel: string;
  readonly startLabel: string;
  readonly startCity: string;
  readonly endLabel: string;
  readonly endCity: string;
  readonly highlightsTitle: string;
  readonly highlights: readonly string[];
  readonly tourTypeLabel?: string | undefined;
  readonly tourTypeValue?: string | undefined;
}

const {
  duration = 3,
  durationLabel,
  daysLabel,
  startLabel,
  startCity,
  endLabel,
  endCity,
  highlightsTitle,
  highlights,
  tourTypeLabel,
  tourTypeValue = "Private & Shared",
} = Astro.props;
---

<div
  class="delay-150"
  data-animate="fade-up"
>
  <dl
    class:list={[
      "m-0 p-0 grid grid-cols-1 gap-3 sm:gap-4",
      { "grid-cols-2 lg:grid-cols-4": tourTypeLabel, "sm:grid-cols-3": !tourTypeLabel },
    ]}
  >
    <div class="flex items-center gap-4 rounded-2xl border border-stone-200/90 bg-white px-5 py-3 shadow-2xs transition-colors hover:border-stone-300 min-block-20 dark:border-white/10 dark:bg-surface-card/85 dark:hover:border-white/20">
      <ClockCircleIcon
        aria-hidden="true"
        class="size-5 shrink-0 text-orange-600"
      />
      <div class="text-start min-w-0">
        <dt class="font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase dark:text-mist-400">
          {durationLabel}
        </dt>
        <dd class="m-0 font-mono text-sm sm:text-base font-bold text-stone-900 tabular-nums dark:text-mist-100">
          {duration ?? 3} {daysLabel}
        </dd>
      </div>
    </div>

    <div class="flex items-center gap-4 rounded-2xl border border-stone-200/90 bg-white px-5 py-3 shadow-2xs transition-colors hover:border-stone-300 min-block-20 dark:border-white/10 dark:bg-surface-card/85 dark:hover:border-white/20">
      <PointOnMapIcon
        aria-hidden="true"
        class="size-5 shrink-0 text-orange-600"
      />
      <div class="text-start min-w-0">
        <dt class="font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase dark:text-mist-400">
          {startLabel}
        </dt>
        <dd class="m-0 font-mono text-sm sm:text-base font-bold text-stone-900 truncate dark:text-mist-100">
          {startCity}
        </dd>
      </div>
    </div>

    <div class="flex items-center gap-4 rounded-2xl border border-stone-200/90 bg-white px-5 py-3 shadow-2xs transition-colors hover:border-stone-300 min-block-20 dark:border-white/10 dark:bg-surface-card/85 dark:hover:border-white/20">
      <FlagIcon
        aria-hidden="true"
        class="size-5 shrink-0 text-orange-600"
      />
      <div class="text-start min-w-0">
        <dt class="font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase dark:text-mist-400">
          {endLabel}
        </dt>
        <dd class="m-0 font-mono text-sm sm:text-base font-bold text-stone-900 truncate dark:text-mist-100">
          {endCity}
        </dd>
      </div>
    </div>

    {tourTypeLabel && (
      <div class="flex items-center gap-4 rounded-2xl border border-stone-200/90 bg-white px-5 py-3 shadow-2xs transition-colors hover:border-stone-300 min-block-20 dark:border-white/10 dark:bg-surface-card/85 dark:hover:border-white/20">
        <SparklesIcon
          aria-hidden="true"
          class="size-5 shrink-0 text-orange-600"
        />
        <div class="text-start min-w-0">
          <dt class="font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase dark:text-mist-400">
            {tourTypeLabel}
          </dt>
          <dd class="m-0 font-mono text-sm sm:text-base font-bold text-stone-900 truncate dark:text-mist-100">
            {tourTypeValue}
          </dd>
        </div>
      </div>
    )}
  </dl>
</div>

<HighlightsList
  idPrefix="tour"
  highlightsTitle={highlightsTitle}
  highlights={highlights}
/>
