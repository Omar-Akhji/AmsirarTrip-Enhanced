---
import ClockCircleIcon from "@/shared/ui/icons/ClockCircleIcon.astro";
import FlagIcon from "@/shared/ui/icons/FlagIcon.astro";
import PointOnMapIcon from "@/shared/ui/icons/PointOnMapIcon.astro";
import SparklesIcon from "@/shared/ui/icons/SparklesIcon.astro";
import HighlightsList from "@/shared/ui/widgets/HighlightsList.astro";

interface Props {
  readonly duration?: number | undefined;
  readonly durationLabel: string;
  readonly daysLabel: string;
  readonly startLabel: string;
  readonly startCity: string;
  readonly endLabel: string;
  readonly endCity: string;
  readonly highlightsTitle: string;
  readonly highlights: readonly string[];
  readonly tourTypeLabel?: string | undefined;
  readonly tourTypeValue?: string | undefined;
}

const {
  duration = 3,
  durationLabel,
  daysLabel,
  startLabel,
  startCity,
  endLabel,
  endCity,
  highlightsTitle,
  highlights,
  tourTypeLabel,
  tourTypeValue = "Private & Shared",
} = Astro.props;
---

<div
  class="animate-delay-150"
  data-animate="focus-unblur"
>
  <dl
    class:list={[
      "m-0 p-0 grid grid-cols-1 gap-3 sm:gap-4",
      { "grid-cols-2 lg:grid-cols-4": tourTypeLabel, "sm:grid-cols-3": !tourTypeLabel },
    ]}
  >
    <div class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-4 rounded-2xl border border-stone-200/90 bg-white px-5 py-3 shadow-2xs transition-colors hover:border-stone-300 min-block-20 dark:border-white/10 dark:bg-surface-card/85 dark:hover:border-white/20">
      <dt class="contents">
        <ClockCircleIcon
          aria-hidden="true"
          class="col-start-1 row-start-1 row-span-2 size-5 shrink-0 self-center text-orange-600"
        />
        <span class="col-start-2 row-start-1 font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase dark:text-mist-400">
          {durationLabel}
        </span>
      </dt>
      <dd class="m-0 col-start-2 row-start-2 font-mono text-sm sm:text-base font-bold text-stone-900 tabular-nums dark:text-mist-100">
        {duration ?? 3} {daysLabel}
      </dd>
    </div>

    <div class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-4 rounded-2xl border border-stone-200/90 bg-white px-5 py-3 shadow-2xs transition-colors hover:border-stone-300 min-block-20 dark:border-white/10 dark:bg-surface-card/85 dark:hover:border-white/20">
      <dt class="contents">
        <PointOnMapIcon
          aria-hidden="true"
          class="col-start-1 row-start-1 row-span-2 size-5 shrink-0 self-center text-orange-600"
        />
        <span class="col-start-2 row-start-1 font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase dark:text-mist-400">
          {startLabel}
        </span>
      </dt>
      <dd class="m-0 col-start-2 row-start-2 truncate font-mono text-sm sm:text-base font-bold text-stone-900 dark:text-mist-100">
        {startCity}
      </dd>
    </div>

    <div class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-4 rounded-2xl border border-stone-200/90 bg-white px-5 py-3 shadow-2xs transition-colors hover:border-stone-300 min-block-20 dark:border-white/10 dark:bg-surface-card/85 dark:hover:border-white/20">
      <dt class="contents">
        <FlagIcon
          aria-hidden="true"
          class="col-start-1 row-start-1 row-span-2 size-5 shrink-0 self-center text-orange-600"
        />
        <span class="col-start-2 row-start-1 font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase dark:text-mist-400">
          {endLabel}
        </span>
      </dt>
      <dd class="m-0 col-start-2 row-start-2 truncate font-mono text-sm sm:text-base font-bold text-stone-900 dark:text-mist-100">
        {endCity}
      </dd>
    </div>

    {tourTypeLabel && (
      <div class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-4 rounded-2xl border border-stone-200/90 bg-white px-5 py-3 shadow-2xs transition-colors hover:border-stone-300 min-block-20 dark:border-white/10 dark:bg-surface-card/85 dark:hover:border-white/20">
        <dt class="contents">
          <SparklesIcon
            aria-hidden="true"
            class="col-start-1 row-start-1 row-span-2 size-5 shrink-0 self-center text-orange-600"
          />
          <span class="col-start-2 row-start-1 font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase dark:text-mist-400">
            {tourTypeLabel}
          </span>
        </dt>
        <dd class="m-0 col-start-2 row-start-2 truncate font-mono text-sm sm:text-base font-bold text-stone-900 dark:text-mist-100">
          {tourTypeValue}
        </dd>
      </div>
    )}
  </dl>
</div>

<HighlightsList
  idPrefix="tour"
  highlightsTitle={highlightsTitle}
  highlights={highlights}
/>
