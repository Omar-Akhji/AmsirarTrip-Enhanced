---
import { Clock, Hotel, MapPinned, Road, Tent, Utensils } from "@lucide/astro";

const getOrdinalSuffix = (number_: number): string => {
  const index = number_ % 10;
  const k = number_ % 100;
  if (index === 1 && k !== 11) return `${number_}st`;
  if (index === 2 && k !== 12) return `${number_}nd`;
  return number_ + (index === 3 && k !== 13 ? "rd" : "th");
};

export interface ItineraryDay {
  number: number;
  title: string;
  text: string[];
  accommodation?: string | undefined;
  meals?: string | undefined;
  activities?: string | undefined;
  arrival?: string | undefined;
}

export interface Props {
  days: readonly ItineraryDay[];
  accommodationLabel: string;
  mealsLabel: string;
  activitiesLabel: string;
  arrivalLabel: string;
}

const { days, accommodationLabel, mealsLabel, activitiesLabel, arrivalLabel } =
  Astro.props as Props;

const DAY_DELAYS = [
  "delay-0",
  "delay-100",
  "delay-200",
  "delay-300",
  "delay-[400ms]",
  "delay-500",
  "delay-[600ms]",
  "delay-700",
  "delay-[800ms]",
  "delay-[900ms]",
  "delay-1000",
] as const;
---

<ol
  role="list"
  class="itinerary-stages-list m-0 list-none p-0 space-y-8"
>
  {days.map((day: ItineraryDay, index: number) => {
    const isRoute = day.title.includes("➜");
    const routeLocations: string[] =
      isRoute ? day.title.split("➜").map((s: string) => s.trim()) : [];

    return (
      <li
        class:list={[DAY_DELAYS[index] || "delay-0"]}
        data-animate="fade-up"
      >
        <div class="group relative">
          <div class="mbe-4 flex items-center gap-3">
            <span class="inline-flex items-center gap-2 rounded-full border border-orange-500/30 bg-orange-500/10 px-4 py-1.5 font-mono text-xs font-bold tracking-[0.14em] text-orange-700 uppercase shadow-2xs">
              <span class="size-2 rounded-full bg-orange-600"></span>
              STAGE {String(day.number).padStart(2, "0")} ·{" "}
              {getOrdinalSuffix(day.number).toUpperCase()} DAY
            </span>
          </div>

          <div class="relative space-y-4 border-s-0 ps-0 sm:ms-5 sm:border-s sm:border-stone-200 sm:ps-8">
            {isRoute ?
              <h4 class="text-base sm:text-lg font-bold text-stone-900 tracking-tight">
                <span class="sr-only">{day.title.replaceAll("➜", " to ")}</span>
                <span
                  class="flex flex-wrap items-center gap-2 font-normal"
                  aria-hidden="true"
                >
                  {routeLocations.map((location: string, locIndex: number) => (
                    <span class="inline-flex items-center gap-2">
                      <span class="inline-flex items-center gap-1.5 rounded-full border border-stone-200/90 bg-white px-3.5 py-1 font-mono text-xs font-semibold text-stone-800 shadow-2xs">
                        <MapPinned class="size-3 text-orange-600 shrink-0" />
                        {location}
                      </span>
                      {locIndex < routeLocations.length - 1 && (
                        <Road class="size-3.5 shrink-0 text-orange-500" />
                      )}
                    </span>
                  ))}
                </span>
              </h4>
            : <h4 class="text-base sm:text-lg font-bold text-stone-900 tracking-tight">
                {day.title}
              </h4>
            }

            <div class="space-y-2.5">
              {day.text.map((item: string) => (
                <div class="flex items-start gap-3">
                  <span class="mbs-2 size-1.5 shrink-0 rounded-full bg-orange-600"></span>
                  <p class="flex-1 text-sm leading-relaxed text-stone-700 sm:text-base font-normal">
                    {item}
                  </p>
                </div>
              ))}
            </div>

            {(day.accommodation || day.meals || day.activities || day.arrival) && (
              <dl class="m-0 mbs-4 grid gap-3 p-0 sm:grid-cols-2">
                {day.accommodation && (
                  <div class="flex items-center gap-3 rounded-xl border border-stone-200/90 bg-stone-50/70 p-3 shadow-2xs">
                    <Hotel
                      aria-hidden="true"
                      class="size-4 shrink-0 text-orange-600"
                    />
                    <div>
                      <dt class="font-mono text-[10px] font-semibold tracking-wider text-stone-500 uppercase">
                        {accommodationLabel}
                      </dt>
                      <dd class="m-0 font-mono text-xs font-bold text-stone-900">
                        {day.accommodation}
                      </dd>
                    </div>
                  </div>
                )}
                {day.meals && (
                  <div class="flex items-center gap-3 rounded-xl border border-stone-200/90 bg-stone-50/70 p-3 shadow-2xs">
                    <Utensils
                      aria-hidden="true"
                      class="size-4 shrink-0 text-orange-600"
                    />
                    <div>
                      <dt class="font-mono text-[10px] font-semibold tracking-wider text-stone-500 uppercase">
                        {mealsLabel}
                      </dt>
                      <dd class="m-0 font-mono text-xs font-bold text-stone-900">{day.meals}</dd>
                    </div>
                  </div>
                )}
                {day.activities && (
                  <div class="flex items-center gap-3 rounded-xl border border-stone-200/90 bg-stone-50/70 p-3 shadow-2xs">
                    <Tent
                      aria-hidden="true"
                      class="size-4 shrink-0 text-orange-600"
                    />
                    <div>
                      <dt class="font-mono text-[10px] font-semibold tracking-wider text-stone-500 uppercase">
                        {activitiesLabel}
                      </dt>
                      <dd class="m-0 font-mono text-xs font-bold text-stone-900">
                        {day.activities}
                      </dd>
                    </div>
                  </div>
                )}
                {day.arrival && (
                  <div class="flex items-center gap-3 rounded-xl border border-stone-200/90 bg-stone-50/70 p-3 shadow-2xs">
                    <Clock
                      aria-hidden="true"
                      class="size-4 shrink-0 text-orange-600"
                    />
                    <div>
                      <dt class="font-mono text-[10px] font-semibold tracking-wider text-stone-500 uppercase">
                        {arrivalLabel}
                      </dt>
                      <dd class="m-0 font-mono text-xs font-bold text-stone-900">{day.arrival}</dd>
                    </div>
                  </div>
                )}
              </dl>
            )}
          </div>
        </div>
      </li>
    );
  })}
</ol>
