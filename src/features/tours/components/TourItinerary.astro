---
import BicyclingIcon from "@/shared/ui/icons/BicyclingIcon.astro";
import BuildingsIcon from "@/shared/ui/icons/BuildingsIcon.astro";
import ClockCircleIcon from "@/shared/ui/icons/ClockCircleIcon.astro";
import UtensilsIcon from "@/shared/ui/icons/UtensilsIcon.astro";

const getOrdinalSuffix = (number_: number): string => {
  const index = number_ % 10;
  const k = number_ % 100;
  if (index === 1 && k !== 11) return `${number_}st`;
  if (index === 2 && k !== 12) return `${number_}nd`;
  return number_ + (index === 3 && k !== 13 ? "rd" : "th");
};

export interface ItineraryDay {
  number: number;
  title: string;
  text: string[];
  accommodation?: string | undefined;
  meals?: string | undefined;
  activities?: string | undefined;
  arrival?: string | undefined;
}

export interface Props {
  days: readonly ItineraryDay[];
  accommodationLabel: string;
  mealsLabel: string;
  activitiesLabel: string;
  arrivalLabel: string;
  kicker?: string | undefined;
  defaultTitle?: string | undefined;
}

const {
  days,
  accommodationLabel,
  mealsLabel,
  activitiesLabel,
  arrivalLabel,
  kicker = "Daily Schedule",
  defaultTitle = "Day-by-Day Route Plan",
} = Astro.props as Props;

const initialDay = days[0];
const initialDayTitle =
  initialDay ? `${getOrdinalSuffix(initialDay.number).toUpperCase()} DAY` : defaultTitle;

const DAY_DELAYS = [
  "delay-0",
  "delay-100",
  "delay-200",
  "delay-300",
  "delay-[400ms]",
  "delay-500",
  "delay-[600ms]",
  "delay-700",
  "delay-[800ms]",
  "delay-[900ms]",
  "delay-1000",
] as const;
---

<tour-itinerary-tracker class="block relative w-full">
  {/* Sticky Header: matching stage separator width */}
  <header
    class="sticky top-16 sm:top-20 z-20 ms-6 sm:ms-8 w-[calc(100%-1.5rem)] sm:w-[calc(100%-2rem)] bg-white/95 backdrop-blur-md pt-2 pb-4 border-b border-stone-200/80 mbe-8 transition-colors dark:bg-[#0d0e12]/95 dark:border-white/10"
    data-itinerary-header
  >
    <div class="space-y-3">
      <hgroup class="space-y-1 min-w-0">
        <p class="font-sans text-xs font-bold tracking-wider text-orange-700 uppercase dark:text-orange-400">
          {kicker}
        </p>
        <h3
          id="tour-itinerary-heading"
          class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-stone-950 transition-all duration-200 dark:text-mist-100"
          data-sticky-heading
        >
          {initialDayTitle}
        </h3>
      </hgroup>

      {/* Route Cities in Sticky Bar: Single Unified Frame */}
      <div class="min-h-7">
        {days.map((dayItem, dIndex) => {
          const isRouteItem = dayItem.title.includes("➜");
          const locations: string[] =
            isRouteItem ? dayItem.title.split("➜").map((s: string) => s.trim()) : [dayItem.title];

          return (
            <div
              data-sticky-route-group={dIndex}
              class:list={[
                "flex flex-wrap items-center gap-2 transition-opacity duration-200",
                { hidden: dIndex !== 0 },
              ]}
            >
              <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-stone-200/90 bg-white px-3.5 py-1 font-mono text-xs font-semibold text-stone-800 shadow-2xs dark:border-white/10 dark:bg-surface-card dark:text-mist-100">
                {locations.map((loc, lIdx) => (
                  <span class="inline-flex items-center gap-2">
                    <span>{loc}</span>
                    {lIdx < locations.length - 1 && (
                      <svg
                        aria-hidden="true"
                        class="size-3.5 shrink-0 text-orange-500"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M4 19 8 5" />
                        <path d="m16 5 4 14" />
                        <path d="M12 8v-2" />
                        <path d="M12 13v-2" />
                        <path d="M12 18v-2" />
                      </svg>
                    )}
                  </span>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      {/* 01 / 03 counter and progress bar positioned below the cities, aligned to the right */}
      <div class="flex items-center justify-end gap-3 pt-0.5 w-full">
        <div class="flex items-center gap-1.5 font-mono text-xs font-bold text-stone-500 tabular-nums dark:text-mist-400">
          <span data-sticky-counter-current>01</span>
          <span class="text-stone-300 dark:text-mist-500">/</span>
          <span>{String(days.length).padStart(2, "0")}</span>
        </div>
        <div class="w-24 sm:w-36 h-1.5 bg-stone-200/80 overflow-hidden dark:bg-white/10">
          <div
            class="h-full bg-orange-600 transition-all duration-300 ease-out"
            data-sticky-progress
            style={`width: ${(1 / Math.max(1, days.length)) * 100}%`}
          ></div>
        </div>
      </div>
    </div>
  </header>

  {/* Timeline Rail & Day-by-Day Stages List */}
  <div class="relative w-full">
    {/* Continuous Timeline Vertical Track */}
    <div
      class="timeline-track absolute left-0 top-0 bottom-8 w-0.5 bg-stone-200 dark:bg-white/10"
      data-timeline-track
      aria-hidden="true"
    >
      {/* Active Progress Fill */}
      <div
        class="timeline-progress-fill absolute top-0 inset-x-0 w-full bg-orange-600/70 transition-all duration-75"
        data-timeline-progress-fill
        style="height: 0%;"
      ></div>
      {/* Single Travelling Indicator Dot (Centered directly inside the vertical line) */}
      <div
        class="timeline-traveling-dot absolute left-1/2 top-0 size-3 rounded-full bg-orange-600 ring-4 ring-orange-100 shadow-md shadow-orange-600/30 transition-opacity duration-200 will-change-transform dark:ring-orange-950/60 z-20"
        data-timeline-traveling-dot
        style="transform: translate3d(-50%, -50%, 0);"
      ></div>
    </div>

    <ol
      role="list"
      class="itinerary-stages-list m-0 list-none p-0 space-y-10"
    >
      {days.map((day: ItineraryDay, index: number) => {
        return (
          <li
            class:list={[
              "itinerary-stage-item group/stage relative pl-6 sm:pl-8 transition-all duration-300",
              { "pt-8 sm:pt-10": index > 0 },
              DAY_DELAYS[index] || "delay-0",
            ]}
            data-animate="fade-up"
            data-itinerary-stage
            data-stage-number={day.number}
            data-stage-ordinal={`${getOrdinalSuffix(day.number)} Day`}
            data-stage-title={day.title}
            data-stage-route={day.title.replaceAll("➜", "→")}
          >
            {/* Horizontal Line separating stages with space from the vertical line */}
            {index > 0 && (
              <div
                class="stage-separator absolute left-6 sm:left-8 right-0 top-0 h-px bg-stone-200/80 dark:bg-white/10"
                aria-hidden="true"
              />
            )}

            {/* Vertical Dot in vertical line, in same baseline as horizontal line */}
            <div
              class:list={[
                "stage-node absolute left-px -translate-x-1/2 -translate-y-1/2 z-10 size-3 rounded-full transition-all duration-300",
                "bg-stone-300 ring-4 ring-stone-100 shadow-sm shadow-stone-300/30 dark:bg-mist-400 dark:ring-white/10",
                "group-data-[active=true]/stage:bg-orange-600 group-data-[active=true]/stage:ring-orange-100 group-data-[active=true]/stage:shadow-md group-data-[active=true]/stage:shadow-orange-600/30 dark:group-data-[active=true]/stage:ring-orange-950/60",
                "group-data-[passed=true]/stage:bg-orange-600 group-data-[passed=true]/stage:ring-orange-100/70",
                { "top-0": index > 0, "top-2.5": index === 0 },
              ]}
              aria-hidden="true"
            />

            <div class="relative space-y-4">
              <div class="space-y-2.5">
                {day.text.map((item: string) => (
                  <div class="flex items-start gap-3">
                    <span class="mbs-2 size-1.5 shrink-0 rounded-full bg-orange-600"></span>
                    <p class="flex-1 text-sm leading-relaxed text-stone-700 sm:text-base font-normal dark:text-mist-200">
                      {item}
                    </p>
                  </div>
                ))}
              </div>

              {(day.accommodation || day.meals || day.activities || day.arrival) && (
                <dl class="m-0 mbs-4 grid gap-3 p-0 sm:grid-cols-2">
                  {day.accommodation && (
                    <div
                      class="flex items-center gap-3 rounded-xl border border-stone-200/90 bg-stone-50/70 p-3 shadow-2xs dark:border-white/10 dark:bg-surface-card/85"
                      data-ascii="surface"
                    >
                      <BuildingsIcon
                        aria-hidden="true"
                        class="size-4 shrink-0 text-orange-600"
                      />
                      <div>
                        <dt class="font-mono text-[10px] font-semibold tracking-wider text-stone-500 uppercase dark:text-mist-400">
                          {accommodationLabel}
                        </dt>
                        <dd class="m-0 font-mono text-xs font-bold text-stone-900 dark:text-mist-100">
                          {day.accommodation}
                        </dd>
                      </div>
                    </div>
                  )}
                  {day.meals && (
                    <div
                      class="flex items-center gap-3 rounded-xl border border-stone-200/90 bg-stone-50/70 p-3 shadow-2xs dark:border-white/10 dark:bg-surface-card/85"
                      data-ascii="surface"
                    >
                      <UtensilsIcon
                        aria-hidden="true"
                        class="size-4 shrink-0 text-orange-600"
                      />
                      <div>
                        <dt class="font-mono text-[10px] font-semibold tracking-wider text-stone-500 uppercase dark:text-mist-400">
                          {mealsLabel}
                        </dt>
                        <dd class="m-0 font-mono text-xs font-bold text-stone-900 dark:text-mist-100">{day.meals}</dd>
                      </div>
                    </div>
                  )}
                  {day.activities && (
                    <div
                      class="flex items-center gap-3 rounded-xl border border-stone-200/90 bg-stone-50/70 p-3 shadow-2xs dark:border-white/10 dark:bg-surface-card/85"
                      data-ascii="surface"
                    >
                      <BicyclingIcon
                        aria-hidden="true"
                        class="size-4 shrink-0 text-orange-600"
                      />
                      <div>
                        <dt class="font-mono text-[10px] font-semibold tracking-wider text-stone-500 uppercase dark:text-mist-400">
                          {activitiesLabel}
                        </dt>
                        <dd class="m-0 font-mono text-xs font-bold text-stone-900 dark:text-mist-100">
                          {day.activities}
                        </dd>
                      </div>
                    </div>
                  )}
                  {day.arrival && (
                    <div
                      class="flex items-center gap-3 rounded-xl border border-stone-200/90 bg-stone-50/70 p-3 shadow-2xs dark:border-white/10 dark:bg-surface-card/85"
                      data-ascii="surface"
                    >
                      <ClockCircleIcon
                        aria-hidden="true"
                        class="size-4 shrink-0 text-orange-600"
                      />
                      <div>
                        <dt class="font-mono text-[10px] font-semibold tracking-wider text-stone-500 uppercase dark:text-mist-400">
                          {arrivalLabel}
                        </dt>
                        <dd class="m-0 font-mono text-xs font-bold text-stone-900 dark:text-mist-100">
                          {day.arrival}
                        </dd>
                      </div>
                    </div>
                  )}
                </dl>
              )}
            </div>
          </li>
        );
      })}
    </ol>

    {/* Horizontal Line separating final stage from Service Coverage */}
    <div
      class="final-stage-separator w-full h-px bg-stone-200/80 dark:bg-white/10 mbs-10 sm:mbs-12"
      aria-hidden="true"
    />
  </div>
</tour-itinerary-tracker>

<script src="../scripts/tour-itinerary-tracker.ts"></script>
