---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import Button from "../../shared/ui/primitives/Button.astro";

const locale = Astro.locals.locale;
const t = useTranslations(locale);
Astro.response.status = 404;
---

<Layout
  description={t("404.description")}
  noindex={true}
  title={t("404.title")}
>
  <div>
    <section class="relative isolate flex min-h-[72dvh] flex-col items-center justify-center gap-6 overflow-hidden bg-zinc-950 px-4 pbs-28 pbe-24 text-center text-white">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,color-mix(in_oklch,var(--color-orange)_30%,transparent),transparent_65%)]"
      ></div>
      <div class="relative z-10 flex flex-col items-center gap-6">
        <h1 class="text-6xl font-bold text-orange-600 sm:text-7xl">404</h1>
        <p class="max-w-md font-mono text-base text-zinc-300 sm:text-lg">{t("404.message")}</p>
        <Button
          href={getRelativeLocaleUrl(locale, "/")}
          size="lg"
        >
          {t("404.cta")}
        </Button>
      </div>
    </section>
  </div>
</Layout>
