---
import { getEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import BookingForm from "../../../features/booking/components/BookingForm.vue";
import BookingSidebar from "../../../features/booking/components/BookingSidebar.astro";
import ExcursionLayout from "../../../features/excursions/components/ExcursionLayout.astro";
import { useTranslations } from "../../../i18n/utils";
import Layout from "../../../layouts/Layout.astro";
import {
  generateBreadcrumbJsonLd,
  generateExcursionJsonLd,
  generateFaqJsonLd,
} from "../../../lib/structured-data";
import JsonLd from "../../../shared/ui/primitives/JsonLd.astro";

const { slug } = Astro.params;
const locale = Astro.locals.locale;

const excursionEntry =
  slug ? await getEntry({ collection: "excursions", id: slug.toLowerCase() }) : undefined;

if (!excursionEntry) {
  Astro.response.status = 404;
  return Astro.rewrite(locale === "en" ? "/404" : `/${locale}/404`);
}

const excursion = excursionEntry.data;

const t = useTranslations(locale);
const isEnglish = locale === "en";
const keyPrefix = `excursion.list.${excursion.i18nKeyPrefix}`;

const title = isEnglish && excursion.seo?.title ? excursion.seo.title : t(`${keyPrefix}.title`);
const description =
  isEnglish && excursion.seo?.metaDescription ?
    excursion.seo.metaDescription
  : `${t(`${keyPrefix}.description`)} ${t(`${keyPrefix}.tagline`)}`;

const itinerary = excursion.program.map((stage, index) => ({
  position: index + 1,
  name: `${stage.time} : ${stage.title} (${stage.location})`,
  description: stage.description,
}));

const excursionName =
  isEnglish && excursion.seo?.title ? excursion.seo.title
  : t.has(`${keyPrefix}.title`) ? t(`${keyPrefix}.title`)
  : excursion.jsonLd.name;
const excursionDescription =
  isEnglish ? (excursion.seo?.lead ?? excursion.jsonLd.description)
  : t.has(`${keyPrefix}.overview`) ? t(`${keyPrefix}.overview`)
  : (excursion.seo?.lead ?? excursion.jsonLd.description);

const excursionJsonLd = generateExcursionJsonLd({
  name: excursionName,
  description: excursionDescription,
  provider: "Amsirar Trip",
  image: `https://amsirartrip.com${excursion.image.src}`,
  price: excursion.jsonLd.price,
  currency: excursion.jsonLd.currency,
  duration: excursion.duration,
  location: { point: excursion.location },
  url: new URL(Astro.url.pathname, Astro.site ?? "https://amsirartrip.com").href,
  itinerary,
});

const faqJsonLd =
  excursion.seo?.faqs && excursion.seo.faqs.length > 0 ?
    generateFaqJsonLd(excursion.seo.faqs)
  : undefined;

const excursionTitleClean =
  isEnglish && excursion.seo?.title ? excursion.seo.title : t(`${keyPrefix}.title`);

const breadcrumbJsonLd = generateBreadcrumbJsonLd([
  { name: t("nav.home"), url: getRelativeLocaleUrl(locale, "/") },
  { name: t("nav.excursions"), url: getRelativeLocaleUrl(locale, "excursions") },
  { name: excursionTitleClean, url: Astro.url.pathname },
]);
---

<Layout
  description={description}
  image={excursion.image.src}
  imageAlt={excursion.seo?.imageAlt ?? t(`${excursion.excursionKey}.alt`)}
  title={title}
>
  <JsonLd
    data={excursionJsonLd}
    id={`${excursion.excursionKey}-jsonld`}
  />
  {faqJsonLd && (
    <JsonLd
      data={faqJsonLd}
      id={`${excursion.excursionKey}-faq-jsonld`}
    />
  )}
  <JsonLd
    data={breadcrumbJsonLd}
    id={`${excursion.excursionKey}-breadcrumb-jsonld`}
  />
  <ExcursionLayout
    excursion={excursion}
    excursionKey={excursion.excursionKey}
    imageSrc={excursion.image}
    locale={locale}
    slug={slug}
  >
    <BookingForm
      client:visible
      excursionId={String(excursion.bookingId)}
      excursionTitle={excursionTitleClean}
      fullWidth
      locale={locale}
      tourDuration={1}
    >
      <BookingSidebar
        slot="sidebar"
        locale={locale}
      />
    </BookingForm>
  </ExcursionLayout>
</Layout>
