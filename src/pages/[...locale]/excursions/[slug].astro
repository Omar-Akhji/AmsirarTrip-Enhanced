---
import { getEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import BookingForm from "../../../features/booking/components/BookingForm.vue";
import BookingSidebar from "../../../features/booking/components/BookingSidebar.astro";
import ExcursionLayout from "../../../features/excursions/components/ExcursionLayout.astro";
import { getLocalizedExcursionContent } from "../../../features/excursions/data/excursions-data";
import { useTranslations } from "../../../i18n/utils";
import Layout from "../../../layouts/Layout.astro";
import { getBookingFormCopy } from "../../../lib/form-copy";
import {
  generateBreadcrumbJsonLd,
  generateExcursionJsonLd,
  generateFaqJsonLd,
} from "../../../lib/structured-data";
import JsonLd from "../../../shared/ui/primitives/JsonLd.astro";

const { slug } = Astro.params;
const locale = Astro.locals.locale;

const excursionEntry =
  slug ? await getEntry({ collection: "excursions", id: slug.toLowerCase() }) : undefined;

if (!excursionEntry) {
  Astro.cache.set(false);
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const excursion = excursionEntry.data;

const t = useTranslations(locale);
const isEnglish = locale === "en";
const keyPrefix = `excursion.list.${excursion.i18nKeyPrefix}`;
const localized = getLocalizedExcursionContent(excursion, locale);

const title = localized.seo.title;
const description = localized.seo.metaDescription;

const itinerary = localized.program.map((stage, index) => ({
  position: index + 1,
  name: `${stage.time} : ${stage.title} (${stage.location})`,
  description: stage.description,
}));

const excursionName = localized.jsonLd.name;
const excursionDescription = localized.seo.lead || localized.jsonLd.description;

const excursionJsonLd = generateExcursionJsonLd({
  name: excursionName,
  description: excursionDescription,
  provider: "Amsirar Trip",
  image: `https://amsirartrip.com${excursion.image.src}`,
  price: excursion.jsonLd.price,
  currency: excursion.jsonLd.currency,
  duration: excursion.duration,
  location: { point: localized.location },
  url: new URL(Astro.url.pathname, Astro.site ?? "https://amsirartrip.com").href,
  itinerary,
});

const faqJsonLd =
  localized.seo.faqs.length > 0 ? generateFaqJsonLd([...localized.seo.faqs]) : undefined;

const excursionTitleClean = isEnglish ? localized.seo.title : t(`${keyPrefix}.title`);

const breadcrumbJsonLd = generateBreadcrumbJsonLd([
  { name: t("nav.home"), url: getRelativeLocaleUrl(locale, "/") },
  { name: t("nav.excursions"), url: getRelativeLocaleUrl(locale, "excursions") },
  { name: excursionTitleClean, url: Astro.url.pathname },
]);
---

<Layout
  description={description}
  image={excursion.image.src}
  imageAlt={localized.seo.imageAlt}
  title={title}
>
  <JsonLd
    data={excursionJsonLd}
    id={`${excursion.excursionKey}-jsonld`}
  />
  {faqJsonLd && (
    <JsonLd
      data={faqJsonLd}
      id={`${excursion.excursionKey}-faq-jsonld`}
    />
  )}
  <JsonLd
    data={breadcrumbJsonLd}
    id={`${excursion.excursionKey}-breadcrumb-jsonld`}
  />
  <ExcursionLayout
    excursion={excursion}
    excursionKey={excursion.excursionKey}
    imageSrc={excursion.image}
    locale={locale}
    slug={slug}
  >
    <div data-animate="step-unfold">
      <BookingForm
        client:visible
        copy={getBookingFormCopy(t)}
        excursionId={String(excursion.bookingId)}
        excursionTitle={excursionTitleClean}
        fullWidth
        locale={locale}
        tourDuration={1}
      >
        <BookingSidebar
          locale={locale}
          slot="sidebar"
        />
      </BookingForm>
    </div>
  </ExcursionLayout>
</Layout>
