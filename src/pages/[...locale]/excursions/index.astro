---
import ExcursionView from "../../../features/excursions/components/ExcursionsView.astro";
import { useTranslations } from "../../../i18n/utils";
import Layout from "../../../layouts/Layout.astro";
import { generateBreadcrumbJsonLd } from "../../../lib/structured-data";
import JsonLd from "../../../shared/ui/JsonLd.astro";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const title = t("excursion.meta.title");
const description = t("excursion.meta.description");

const breadcrumbJsonLd = generateBreadcrumbJsonLd([
  { name: t("nav.home") || "Home", url: locale === "en" ? "/" : `/${locale}` },
  { name: t("nav.excursions") || "Excursions", url: Astro.url.pathname },
]);
---

<Layout
  description={description}
  title={title}
>
  <JsonLd
    data={breadcrumbJsonLd}
    id="excursions-breadcrumb-jsonld"
  />
  <ExcursionView />
</Layout>
