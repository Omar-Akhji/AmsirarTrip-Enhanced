---
import { getRelativeLocaleUrl } from "astro:i18n";
import ContactForm from "../../features/contact/components/ContactForm.vue";
import ContactView from "../../features/contact/components/ContactView.astro";
import { useTranslations } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import { generateBreadcrumbJsonLd, generateContactPageJsonLd } from "../../lib/structured-data";
import JsonLd from "../../shared/ui/primitives/JsonLd.astro";

const locale = Astro.locals.locale;
const t = useTranslations(locale);

const title = t("contact.meta.title");
const description = t("contact.meta.description");

const breadcrumbJsonLd = generateBreadcrumbJsonLd([
  { name: t("nav.home") || "Home", url: getRelativeLocaleUrl(locale, "/") },
  { name: t("nav.contact") || "Contact", url: Astro.url.pathname },
]);

const contactPageJsonLd = generateContactPageJsonLd({
  name: title,
  description,
  url: Astro.url.pathname,
});
---

<Layout
  description={description}
  title={title}
>
  <JsonLd
    data={breadcrumbJsonLd}
    id="contact-breadcrumb-jsonld"
  />
  <JsonLd
    data={contactPageJsonLd}
    id="contact-page-jsonld"
  />
  <ContactView>
    <ContactForm
      client:visible
      locale={locale}
    />
  </ContactView>
</Layout>
