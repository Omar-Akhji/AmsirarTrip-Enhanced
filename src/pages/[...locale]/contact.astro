---
import { getRelativeLocaleUrl } from "astro:i18n";
import { actions } from "astro:actions";
import ContactForm from "../../features/contact/components/ContactForm.vue";
import { toInitialFormState } from "../../actions/helpers/form-helpers";
import ContactInfoSidebar from "../../features/contact/components/ContactInfoSidebar.astro";
import ContactView from "../../features/contact/components/ContactView.astro";
import { useTranslations } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import { getContactFormCopy } from "../../lib/form-copy";
import { generateBreadcrumbJsonLd, generateContactPageJsonLd } from "../../lib/structured-data";
import JsonLd from "../../shared/ui/primitives/JsonLd.astro";

const locale = Astro.locals.locale;
const t = useTranslations(locale);

const title = t("contact.meta.title");
const description = t("contact.meta.description");

const breadcrumbJsonLd = generateBreadcrumbJsonLd([
  { name: t("nav.home"), url: getRelativeLocaleUrl(locale, "/") },
  { name: t("nav.contact"), url: Astro.url.pathname },
]);

const contactPageJsonLd = generateContactPageJsonLd({
  name: title,
  description,
  inLanguage: locale,
  url: Astro.url.pathname,
});
const contactActionResult = Astro.getActionResult(actions.contact);
if (contactActionResult) {
  Astro.cache.set(false);
}
const initialContactState = toInitialFormState(
  contactActionResult,
  t("contact.form.errors.generic"),
);
---

<Layout
  description={description}
  title={title}
>
  <JsonLd
    data={breadcrumbJsonLd}
    id="contact-breadcrumb-jsonld"
  />
  <JsonLd
    data={contactPageJsonLd}
    id="contact-page-jsonld"
  />
  <ContactView>
    <ContactForm
      actionUrl={actions.contact.toString()}
      client:visible={{ rootMargin: "200px" }}
      copy={getContactFormCopy(t)}
      initialState={initialContactState}
      locale={locale}
    >
      <ContactInfoSidebar slot="sidebar" />
    </ContactForm>
  </ContactView>
</Layout>
