---
import { getRelativeLocaleUrl } from "astro:i18n";
import AboutView from "../../features/about/components/AboutView.astro";
import { useTranslations } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import { generateAboutPageJsonLd, generateBreadcrumbJsonLd } from "../../lib/structured-data";
import JsonLd from "../../shared/ui/primitives/JsonLd.astro";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const title = t("about.meta.title");
const description = t("about.meta.description");

const breadcrumbJsonLd = generateBreadcrumbJsonLd([
  { name: t("nav.home") || "Home", url: getRelativeLocaleUrl(locale, "/") },
  { name: t("nav.about") || "About Us", url: Astro.url.pathname },
]);

const aboutPageJsonLd = generateAboutPageJsonLd({
  name: title,
  description,
  url: Astro.url.pathname,
});
---

<Layout
  description={description}
  title={title}
>
  <JsonLd
    data={breadcrumbJsonLd}
    id="about-breadcrumb-jsonld"
  />
  <JsonLd
    data={aboutPageJsonLd}
    id="about-page-jsonld"
  />
  <AboutView />
</Layout>
