---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import bg4 from "../../assets/images/Excursions/Agafay.webp";
import bg1 from "../../assets/images/Header/header-1.webp";
import bg2 from "../../assets/images/Header/header-2.webp";
import bg3 from "../../assets/images/Header/header-3.webp";
import FeaturedTours from "../../features/home/components/FeaturedTours.astro";
import HomeHero from "../../features/home/components/HomeHero.astro";
import HomeStats from "../../features/home/components/HomeStats.astro";
import ServicesSection from "../../features/home/components/ServicesSection.astro";
import TestimonialsSection from "../../features/home/components/TestimonialsSection.astro";
import VideoSection from "../../features/home/components/VideoSection.vue";
import { useTranslations } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import {
  generateBreadcrumbJsonLd,
  generateItemListJsonLd,
  generateVideoObjectJsonLd,
} from "../../lib/structured-data";
import JsonLd from "../../shared/ui/primitives/JsonLd.astro";

const locale = Astro.locals.locale;
const t = useTranslations(locale);

const title = t("home.meta.title");
const description = t("home.meta.description");
const heroImages = [bg1, bg2, bg3, bg4];

const toursEntries = await getCollection("tours");
const sortedTours = [...toursEntries]
  .toSorted((a, b) => a.data.bookingId - b.data.bookingId)
  .slice(0, 6);

const featuredToursItemListJsonLd = generateItemListJsonLd({
  name: t("home.featured.title"),
  description,
  url: Astro.url.pathname,
  items: sortedTours.map((entry) => ({
    name: locale === "en" ? entry.data.seo.title : t(`${entry.data.tourKey}.title`),
    description:
      locale === "en" ?
        entry.data.seo.metaDescription
      : t(`tours.${entry.data.tourKey}.description`),
    url: getRelativeLocaleUrl(locale, `tours/${entry.id}`),
    image: entry.data.image.src,
  })),
});

const homeBreadcrumbJsonLd = generateBreadcrumbJsonLd([
  { name: t("nav.home"), url: getRelativeLocaleUrl(locale, "/") },
]);

const videoJsonLd = generateVideoObjectJsonLd({
  name: t("video.name"),
  description: t("video.description"),
  thumbnailUrl: "/images/hero/marrakech-medina.webp",
  uploadDate: "2026-01-15T09:00:00+01:00",
  contentUrl: "/videos/Morocco-Video.mp4",
  duration: "PT1M19S",
});
---

<Layout
  description={description}
  image={bg1.src}
  preloadImage={true}
  title={title}
>
  <JsonLd
    data={homeBreadcrumbJsonLd}
    id="home-breadcrumb-jsonld"
  />
  <JsonLd
    data={featuredToursItemListJsonLd}
    id="home-featured-tours-jsonld"
  />
  <JsonLd
    data={videoJsonLd}
    id="home-video-jsonld"
  />
  <HomeHero images={heroImages} />
  <div class="text-zinc-900 dark:text-stone-100">
    <HomeStats />
    <FeaturedTours />
    <ServicesSection />
    <TestimonialsSection />
    <div data-animate="fade-up">
      <VideoSection
        client:visible
        fallbackImage={bg1.src}
        locale={locale}
      />
    </div>
  </div>
</Layout>
