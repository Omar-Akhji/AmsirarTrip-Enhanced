---
import { getEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import BookingForm from "../../../features/booking/components/BookingForm.vue";
import BookingSidebar from "../../../features/booking/components/BookingSidebar.astro";
import TourLayout from "../../../features/tours/components/TourLayout.astro";
import { getToursData } from "../../../features/tours/data/tours-data";
import { getTourLocalizedSeo } from "../../../features/tours/data/tour-localized-seo";
import { useTranslations } from "../../../i18n/utils";
import Layout from "../../../layouts/Layout.astro";
import {
  generateBreadcrumbJsonLd,
  generateFaqJsonLd,
  generateTourJsonLd,
} from "../../../lib/structured-data";
import JsonLd from "../../../shared/ui/primitives/JsonLd.astro";
import TripCard from "../../../shared/ui/widgets/TripCard.astro";

const { slug } = Astro.params;
const locale = Astro.locals.locale;

const tourEntry =
  slug ? await getEntry({ collection: "tours", id: slug.toLowerCase() }) : undefined;

if (!tourEntry) {
  Astro.response.status = 404;
  return Astro.rewrite(locale === "en" ? "/404" : `/${locale}/404`);
}

const tour = tourEntry.data;

const t = useTranslations(locale);
const isEnglish = locale === "en";

const seoMeta = getTourLocalizedSeo(tour.tourKey, locale, {
  title: tour.seo.title,
  metaDescription: tour.seo.metaDescription,
});
const title = seoMeta.title;
const description = seoMeta.metaDescription;

const dayLabel = t("tours.day");
const itinerary = Array.from({ length: tour.durationDays }, (_, index) => {
  const dayNumber = index + 1;
  const dayKey = `${tour.tourKey}.day${dayNumber}`;
  let name = `${dayLabel} ${dayNumber}`;
  let dayDesc = "";

  try {
    name = t(`${dayKey}.title`);
  } catch {}

  try {
    const dayText = t.raw(`${dayKey}.text`);
    if (Array.isArray(dayText)) {
      dayDesc = dayText.slice(0, 2).join(" ");
    }
  } catch {}

  return { position: dayNumber, name: `${dayLabel} ${dayNumber}: ${name}`, description: dayDesc };
});

const tourName =
  isEnglish ? tour.jsonLd.name
  : t.has(`${tour.tourKey}.title`) ? t(`${tour.tourKey}.title`)
  : tour.jsonLd.name;
const tourDescription =
  isEnglish ? tour.seo.lead || tour.jsonLd.description
  : t.has(`${tour.tourKey}.overview`) ? t(`${tour.tourKey}.overview`)
  : tour.seo.lead || tour.jsonLd.description;

const tourJsonLd = generateTourJsonLd({
  name: tourName,
  description: tourDescription,
  provider: "Amsirar Trip",
  image: `https://amsirartrip.com${tour.image.src}`,
  price: tour.jsonLd.price,
  currency: tour.jsonLd.currency,
  duration: tour.duration,
  location: { start: tour.startLocation, end: tour.endLocation },
  url: new URL(Astro.url.pathname, Astro.site ?? "https://amsirartrip.com").href,
  itinerary,
});

const faqJsonLd = generateFaqJsonLd(tour.seo.faqs);
const tourTitleClean = isEnglish ? tour.seo.title : t(`${tour.tourKey}.title`);

const breadcrumbJsonLd = generateBreadcrumbJsonLd([
  { name: t("nav.home"), url: getRelativeLocaleUrl(locale, "/") },
  { name: t("nav.tours"), url: getRelativeLocaleUrl(locale, "tours") },
  { name: tourTitleClean, url: Astro.url.pathname },
]);

const allTours = await getToursData();
const currentStart = tour.startLocation.toLowerCase();
const relatedTours = allTours
  .filter((item) => item.id !== tour.bookingId)
  .toSorted((a, b) => {
    const aSame = a.startLocation === currentStart ? -1 : 1;
    const bSame = b.startLocation === currentStart ? -1 : 1;
    return aSame - bSame;
  })
  .slice(0, 3);
---

<Layout
  description={description}
  image={tour.image.src}
  imageAlt={tour.seo.imageAlt}
  title={title}
>
  <JsonLd
    data={tourJsonLd}
    id={`${tour.tourKey}-jsonld`}
  />
  <JsonLd
    data={faqJsonLd}
    id={`${tour.tourKey}-faq-jsonld`}
  />
  <JsonLd
    data={breadcrumbJsonLd}
    id={`${tour.tourKey}-breadcrumb-jsonld`}
  />
  <TourLayout
    tour={tour}
    bookingId={tour.bookingId}
    imageSrc={tour.image}
    locale={locale}
    seo={tour.seo}
    slug={slug}
    tourKey={tour.tourKey}
  >
    <div data-animate="card-fan-rise">
      <BookingForm
        client:visible
        fullWidth
        locale={locale}
        tourDuration={tour.durationDays}
        tourId={tour.bookingId.toString()}
        tourTitle={tourTitleClean}
      >
        <BookingSidebar
          slot="sidebar"
          locale={locale}
        />
      </BookingForm>
    </div>

    {relatedTours.length > 0 && (
      <section
        aria-labelledby="related-tours-heading"
        class="border-t border-stone-200 bg-white dark:border-white/10 dark:bg-transparent py-12 sm:py-16 lg:py-24"
        data-animate="pillar-rise"
      >
        <div class="mx-auto px-2 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
          <div class="mbe-8 sm:mbe-12 flex flex-col gap-4 border-b border-stone-200 pb-6 sm:pb-8 dark:border-white/10">
            <hgroup class="max-w-2xl space-y-2">
              <p class="font-sans text-xs font-bold tracking-wider text-orange-700 uppercase dark:text-orange-400">
                {t("tours.relatedTagline", "Alternative Morocco Circuits")}
              </p>
              <h2
                id="related-tours-heading"
                class="text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl md:text-4xl 2xl:text-[2.625rem] text-balance dark:text-mist-100"
              >
                {t("tours.relatedTitle", "Explore Companion Desert Itineraries")}
              </h2>
              <p class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base text-stone-600 leading-relaxed max-w-[62ch] text-pretty dark:text-mist-200">
                {t(
                  "tours.relatedSubtitle",
                  "Discover alternative durations and route variations crafted with private 4x4 transport and luxury desert camps.",
                )}
              </p>
            </hgroup>
          </div>
          <div class="grid grid-cols-1 gap-6 xs:gap-7 md:grid-cols-2 lg:grid-cols-3 lg:gap-8 2xl:gap-10">
            {relatedTours.map((item) => (
              <div class="flex size-full">
                <TripCard
                  badge={`${item.duration} Days`}
                  description={t(item.description)}
                  end={t(item.end)}
                  endLabel={t("tours.endLabelShort")}
                  exploreLink={t("tours.exploreLink")}
                  item={{ image: item.image, imageAlt: t(item.title), route: item.route }}
                  start={t(item.start)}
                  startLabel={t("tours.startLabelShort")}
                  title={t(item.title)}
                  tourTypeBadge={t("tours.bothAvailable")}
                />
              </div>
            ))}
          </div>
        </div>
      </section>
    )}
  </TourLayout>
</Layout>
