---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import ToursView from "../../../features/tours/components/ToursView.astro";
import { useTranslations } from "../../../i18n/utils";
import Layout from "../../../layouts/Layout.astro";
import { generateBreadcrumbJsonLd, generateItemListJsonLd } from "../../../lib/structured-data";
import JsonLd from "../../../shared/ui/primitives/JsonLd.astro";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const title = t("tours.meta.title");
const description = t("tours.meta.description");

const toursEntries = await getCollection("tours");
const sortedTours = [...toursEntries].toSorted((a, b) => a.data.bookingId - b.data.bookingId);
const toursItemListJsonLd = generateItemListJsonLd({
  name: title,
  description,
  url: Astro.url.pathname,
  items: sortedTours.map((entry) => ({
    name: locale === "en" ? entry.data.seo.title : t(`${entry.data.tourKey}.title`),
    description:
      locale === "en" ?
        entry.data.seo.metaDescription
      : t(`tours.${entry.data.tourKey}.description`),
    url: getRelativeLocaleUrl(locale, `tours/${entry.id}`),
    image: entry.data.image.src,
  })),
});

const breadcrumbJsonLd = generateBreadcrumbJsonLd([
  { name: t("nav.home") || "Home", url: getRelativeLocaleUrl(locale, "/") },
  { name: t("nav.tours") || "Tours", url: Astro.url.pathname },
]);
---

<Layout
  description={description}
  title={title}
>
  <JsonLd
    data={toursItemListJsonLd}
    id="tours-itemlist-jsonld"
  />
  <JsonLd
    data={breadcrumbJsonLd}
    id="tours-breadcrumb-jsonld"
  />
  <ToursView />
</Layout>
