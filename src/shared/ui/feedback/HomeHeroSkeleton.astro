---
import { Skeleton } from "@/components/ui/skeleton";

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<section
  id="home-hero-slider-section-skeleton"
  class:list={[
    "relative isolate w-full h-dvh min-h-160 overflow-hidden bg-black text-white",
    className,
  ]}
  aria-busy="true"
  aria-label="Loading Amsirar Trip Hero Carousel"
>
  <div
    class="slider relative h-full w-full overflow-hidden bg-[#050505] font-sans"
    id="home-hero-slider-skeleton"
  >
    {/* Dark Hero Background */}
    <div class="item absolute inset-0 size-full">
      <div class="size-full bg-[#050505]">
        <Skeleton class="size-full rounded-none bg-zinc-950/80" />
        <div
          class="pointer-events-none absolute inset-0 z-1 bg-[linear-gradient(to_bottom,rgb(0_0_0/55%)_0%,rgb(0_0_0/15%)_18%,transparent_32%),linear-gradient(to_top,rgb(0_0_0/40%)_0%,transparent_32%)]"
          aria-hidden="true"
        ></div>
      </div>

      {/* Slider Details exact position & typography match for Erg Chebbi Dunes slide */}
      <div class="content absolute max-md:top-[calc((100dvh-var(--thumb-bottom)-var(--thumb-height)+3.75rem+env(safe-area-inset-top,0px))/2)] max-md:-translate-y-1/2 left-4 sm:left-8 md:left-[5%] lg:left-[max(7%,calc(50%-570px))] 2xl:left-[max(7%,calc(50%-640px))] 3xl:left-[max(8%,calc(50%-720px))] z-10 box-border max-w-[calc(100vw-2rem)] text-white text-shadow-sm text-shadow-black/40 md:top-[clamp(4.75rem,10.5vh,6.75rem)] lg:top-[clamp(5.25rem,12vh,7.75rem)] xl:top-[clamp(5.75rem,13.5vh,8.5rem)] 2xl:top-[clamp(6.5rem,14.5vh,9.25rem)] 3xl:top-[clamp(7.5rem,15.5vh,10.5rem)]">
        {/* Title: Erg Chebbi Dunes */}
        <div class="mbe-2">
          <Skeleton class="h-10 sm:h-14 w-64 sm:w-96 bg-white/20" />
        </div>

        {/* Type: & Desert Camp Nights */}
        <div class="mbe-4">
          <Skeleton class="h-8 sm:h-11 w-72 sm:w-md bg-white/15" />
        </div>

        {/* Description: 3 lines matching paragraph font-size & line-height */}
        <div class="border-s-2 border-orange-600/70 ps-3.5 sm:ps-4 py-0.5 w-full mt-4 xs:mt-5 sm:mt-5 md:mt-6 lg:mt-7 space-y-2 max-w-[min(100%,44ch)] sm:max-w-[46ch]">
          <Skeleton class="h-4 w-full bg-white/15" />
          <Skeleton class="h-4 w-11/12 bg-white/15" />
          <Skeleton class="h-4 w-4/5 bg-white/15" />
        </div>
      </div>
    </div>

    {/* Thumbnail Carousel Cards matching SliderCards.astro position & dimensions */}
    <div
      class="thumbnail absolute z-100 flex w-max gap-(--thumb-gap) bottom-(--thumb-bottom) left-(--thumb-left)"
      aria-hidden="true"
    >
      {Array.from({ length: 3 }, () => (
        <div class="item relative shrink-0 overflow-hidden shadow-[0_8px_25px_rgb(0_0_0/45%)] w-(--thumb-width) h-(--thumb-height) rounded-(--thumb-radius) bg-slate-950">
          <Skeleton class="size-full rounded-(--thumb-radius) bg-zinc-900/80" />
          <div class="thumbnail-overlay pointer-events-none absolute inset-x-0 bottom-0 flex flex-col gap-1.5 px-2 py-2 sm:px-2.5 sm:py-3 bg-linear-to-t from-black/85 to-transparent">
            <Skeleton class="h-3 w-20 bg-white/20" />
            <Skeleton class="h-2.5 w-28 bg-white/15" />
          </div>
        </div>
      ))}
    </div>

    {/* Vertical Dots Navigation Skeleton positioned directly below the orange line and along the same vertical line */}
    <div
      class="hero-dots-nav pagination absolute z-100 flex flex-col items-center -translate-x-1/2 left-4 sm:left-8 md:left-[5%] lg:left-[max(7%,calc(50%-570px))] 2xl:left-[max(7%,calc(50%-640px))] 3xl:left-[max(8%,calc(50%-720px))]"
      aria-hidden="true"
    >
      <div class="relative flex flex-col items-center">
        {Array.from({ length: 3 }, (_, index) => (
          <div class="relative flex flex-col items-center">
            <div class="flex size-7 sm:size-8 items-center justify-center p-2">
              <div class="size-3.5 sm:size-4 rounded-full border border-white/20 bg-black/40 flex items-center justify-center">
                <div
                  class:list={[
                    "size-1.5 sm:size-2 rounded-full",
                    { "bg-amber-400/80": index === 0, "bg-stone-500/50": index !== 0 },
                  ]}
                />
              </div>
            </div>
            {index < 2 && <div class="h-6 sm:h-7 w-0.5 bg-white/15 my-0.5 rounded-full" />}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
