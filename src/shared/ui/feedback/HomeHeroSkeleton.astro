---
import { Skeleton } from "@/components/ui/skeleton";

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<section
  aria-busy="true"
  aria-label="Loading Amsirar Trip Hero Carousel"
  class:list={[
    "relative isolate w-full h-screen max-h-screen overflow-hidden bg-black text-white",
    className,
  ]}
  id="home-hero-slider-section-skeleton"
>
  <div
    class="slider relative size-full overflow-hidden bg-[#050505] font-sans"
    id="home-hero-slider-skeleton"
  >
    {/* Dark Hero Background */}
    <div class="item absolute inset-0 size-full">
      <div class="size-full bg-[#050505]">
        <Skeleton class="size-full rounded-none bg-zinc-950/80" />
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 z-1 bg-[linear-gradient(to_bottom,rgb(0_0_0/55%)_0%,rgb(0_0_0/15%)_18%,transparent_32%),linear-gradient(to_top,rgb(0_0_0/40%)_0%,transparent_32%)]"
        ></div>
      </div>

      {/* Slider Details exact position & typographic scale match for SliderDetails.astro */}
      <div class="content absolute max-md:top-[calc((100dvh-var(--thumb-bottom)-var(--thumb-height)+3.75rem+env(safe-area-inset-top,0px))/2)] max-md:-translate-y-1/2 left-4 sm:left-8 md:left-[5%] lg:left-[max(7%,calc(50%-570px))] 2xl:left-[max(7%,calc(50%-640px))] 3xl:left-[max(8%,calc(50%-720px))] z-10 box-border max-w-[calc(100vw-2rem)] text-white text-shadow-sm text-shadow-black/40 md:top-[clamp(4.75rem,10.5vh,6.75rem)] lg:top-[clamp(5.25rem,12vh,7.75rem)] xl:top-[clamp(5.75rem,13.5vh,8.5rem)] 2xl:top-[clamp(6.5rem,14.5vh,9.25rem)] 3xl:top-[clamp(7.5rem,15.5vh,10.5rem)]">
        {/* Title matching SliderDetails h1 scale */}
        <div class="m-0 max-sm:text-balance sm:whitespace-nowrap text-[clamp(1.85rem,7.5vw,2.4rem)] xs:text-[clamp(2.1rem,7vw,2.75rem)] leading-[1.08] sm:text-[clamp(2.4rem,4.8vw,3.2rem)] sm:leading-[1.1] md:text-[clamp(2.6rem,4vw,3.8rem)] md:leading-[1.12] lg:text-[clamp(3rem,4.2vw,4.6rem)] 2xl:text-[clamp(3.5rem,4.2vw,5.2rem)] 3xl:text-[clamp(4rem,4vw,6rem)]">
          <Skeleton class="block h-[1.08em] sm:h-[1.1em] md:h-[1.12em] w-[13ch] max-w-full bg-white/20" />
        </div>

        {/* Type matching SliderDetails subtitle scale */}
        <div class="m-0 mt-2 xs:mt-2.5 sm:mt-3 md:mt-3.5 max-sm:text-balance sm:whitespace-nowrap text-[clamp(1.65rem,6.8vw,2.2rem)] xs:text-[clamp(1.9rem,6.5vw,2.5rem)] leading-[1.1] sm:text-[clamp(2.1rem,4.5vw,2.9rem)] md:text-[clamp(2.4rem,3.8vw,3.6rem)] md:leading-[1.12] lg:text-[clamp(2.8rem,4vw,4.4rem)] 2xl:text-[clamp(3.2rem,4vw,5rem)] 3xl:text-[clamp(3.6rem,3.8vw,5.6rem)]">
          <Skeleton class="block h-[1.1em] md:h-[1.12em] w-[18ch] max-w-full bg-white/15" />
        </div>

        {/* Description matching SliderDetails paragraph bounds & rhythm */}
        <div class="border-s-2 border-orange-600/70 ps-3.5 sm:ps-4 py-0.5 mt-4 xs:mt-5 sm:mt-5 md:mt-6 lg:mt-7 text-[clamp(0.875rem,0.8rem+0.42vw,1.1rem)] leading-relaxed sm:leading-[1.62] md:leading-[1.68] lg:leading-[1.72] w-full max-w-[min(100%,44ch)] sm:max-w-[46ch] md:max-w-[50ch] lg:max-w-[54ch] xl:max-w-[58ch] 2xl:max-w-[62ch] space-y-2">
          <Skeleton class="h-[1.2em] w-full bg-white/15" />
          <Skeleton class="h-[1.2em] w-4/5 bg-white/15" />
          <Skeleton class="h-[1.2em] w-3/5 md:hidden bg-white/15" />
        </div>
      </div>
    </div>

    {/* Thumbnail Carousel Cards matching SliderCards.astro position & dimensions */}
    <div
      aria-hidden="true"
      class="thumbnail absolute z-100 flex w-max gap-(--thumb-gap) bottom-(--thumb-bottom) left-(--thumb-left)"
    >
      {Array.from({ length: 3 }, () => (
        <div class="item relative shrink-0 overflow-hidden shadow-[0_8px_25px_rgb(0_0_0/45%)] w-(--thumb-width) h-(--thumb-height) rounded-(--thumb-radius) bg-slate-950">
          <Skeleton class="size-full rounded-(--thumb-radius) bg-zinc-900/80" />
          <div class="thumbnail-overlay pointer-events-none absolute inset-x-0 bottom-0 flex flex-col gap-1.5 px-2 py-1.5 sm:px-2.5 sm:py-2 bg-linear-to-t from-black/85 to-transparent">
            <Skeleton class="h-3 w-20 bg-white/20" />
            <Skeleton class="h-2.5 w-28 bg-white/15" />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
