---
import AsciiSkeleton from "@/shared/ui/feedback/AsciiSkeleton.astro";
import ButtonSkeleton from "@/shared/ui/feedback/ButtonSkeleton.astro";
import PageHeaderSkeleton from "@/shared/ui/feedback/PageHeaderSkeleton.astro";

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<div
  aria-busy="true"
  aria-label="Loading contact view"
  class:list={["size-full bg-white text-stone-900", className]}
>
  <PageHeaderSkeleton
    crumbWidths={["w-12", "w-20"]}
    hasButtons={false}
    hasUnderline={true}
  />

  {/* DIRECT CHANNELS SKELETON */}
  <section class="relative isolate bg-white py-12 sm:py-16 lg:py-24">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      {/* Mobile Mode: Card Stack matching ContactFolderStack */}
      <div class="block md:hidden w-full">
        <div class="flex flex-col gap-5 w-full">
          {Array.from({ length: 3 }, () => (
            <article class="contact-info-card group flex h-auto w-full flex-col rounded-2xl border border-stone-200/90 bg-stone-50/95 p-5 sm:p-6 shadow-xl shadow-stone-900/10">
              <div>
                <div class="mbe-2.5 border-b border-stone-200/80 pb-2.5">
                  <AsciiSkeleton
                    class="text-base sm:text-lg font-bold text-stone-950"
                    lines={1}
                    variant="dither"
                    widths={["12rem"]}
                  />
                </div>
                <div class="space-y-1">
                  <AsciiSkeleton
                    class="text-sm leading-relaxed text-stone-600"
                    lines={2}
                    variant="dither"
                    widths={["100%", "85%"]}
                  />
                </div>
              </div>

              <div class="mbs-3.5 border-t border-stone-200/60 pbs-3.5">
                <ButtonSkeleton
                  size="md"
                  variant="outline"
                  class="w-full"
                />
              </div>
            </article>
          ))}
        </div>
      </div>

      {/* Desktop & Tablet Mode: 3-column Grid matching ContactView.astro */}
      <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 2xl:gap-8 items-stretch">
        {Array.from({ length: 3 }, (_, index) => (
          <div class:list={["flex size-full", { "md:col-span-2 lg:col-span-1": index === 2 }]}>
            <article class="contact-info-card group relative flex size-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/80 p-6 sm:p-8 shadow-xs shadow-stone-900/5">
              <div>
                <div class="mbe-3 border-b border-stone-200/80 pb-3">
                  <AsciiSkeleton
                    class="text-lg lg:text-xl font-bold text-stone-950"
                    lines={1}
                    variant="dither"
                    widths={["13rem"]}
                  />
                </div>
                <div class="space-y-1 pt-1">
                  <AsciiSkeleton
                    class="text-sm leading-relaxed text-stone-600"
                    lines={3}
                    variant="dither"
                    widths={["100%", "92%", "75%"]}
                  />
                </div>
              </div>

              {/* Action Button */}
              <div class="mbs-6 border-t border-stone-200/60 pbs-4">
                <ButtonSkeleton
                  size="md"
                  variant="outline"
                  class="w-full"
                />
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* EXPEDITION INQUIRY SKELETON */}
  <section
    class="relative isolate border-t border-stone-200 bg-stone-50 py-12 sm:py-16 lg:py-24"
    id="contact-form-section"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8">
        <hgroup class="max-w-2xl space-y-2">
          <h2 class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance">
            <AsciiSkeleton
              class="text-stone-900 font-bold"
              lines={1}
              variant="dither"
              widths={["18rem"]}
            />
          </h2>
          <div class="border-s-2 border-orange-600 ps-4 py-0.5 max-w-[62ch]">
            <AsciiSkeleton
              class="text-stone-600 text-sm sm:text-base leading-relaxed"
              lines={2}
              variant="dither"
              widths={["100%", "72%"]}
            />
          </div>
        </hgroup>
      </div>

      <div class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-5">
        {/* Left: Contact Form Card (col-span-3) */}
        <div class="inline-full lg:col-span-3">
          <div class="rounded-2xl border border-stone-200/90 bg-white p-6 shadow-xs shadow-stone-900/5 block-full sm:p-8">
            <div class="mbe-6 border-b border-stone-100 pbe-5">
              <span class="font-mono text-xs font-semibold tracking-[0.14em] text-orange-600 uppercase">
                <AsciiSkeleton
                  class="text-orange-600 font-mono text-xs uppercase"
                  lines={1}
                  variant="dither"
                  widths={["8rem"]}
                />
              </span>
              <div class="mbs-1">
                <h3 class="text-xl font-bold tracking-tight text-stone-900 sm:text-2xl">
                  <AsciiSkeleton
                    class="text-stone-900 font-bold"
                    lines={1}
                    variant="dither"
                    widths={["16rem"]}
                  />
                </h3>
              </div>
            </div>

            <div class="flex flex-col gap-5">
              {/* Row 1: Name & Email */}
              <div class="grid gap-5 md:grid-cols-2">
                <div>
                  <div class="mbe-1.5">
                    <AsciiSkeleton
                      class="font-sans text-xs font-semibold text-stone-700"
                      lines={1}
                      variant="dither"
                      widths={["5.5rem"]}
                    />
                  </div>
                  <AsciiSkeleton
                    class="h-12 w-full rounded-xl border border-stone-200/90 bg-stone-50/50 text-stone-400 select-none"
                    rows={3}
                    variant="dither"
                  />
                </div>
                <div>
                  <div class="mbe-1.5">
                    <AsciiSkeleton
                      class="font-sans text-xs font-semibold text-stone-700"
                      lines={1}
                      variant="dither"
                      widths={["4rem"]}
                    />
                  </div>
                  <AsciiSkeleton
                    class="h-12 w-full rounded-xl border border-stone-200/90 bg-stone-50/50 text-stone-400 select-none"
                    rows={3}
                    variant="dither"
                  />
                </div>
              </div>

              {/* Row 2: Phone & Topic */}
              <div class="grid gap-5 md:grid-cols-2">
                <div>
                  <div class="mbe-1.5">
                    <AsciiSkeleton
                      class="font-sans text-xs font-semibold text-stone-700"
                      lines={1}
                      variant="dither"
                      widths={["6.5rem"]}
                    />
                  </div>
                  <AsciiSkeleton
                    class="h-12 w-full rounded-xl border border-stone-200/90 bg-stone-50/50 text-stone-400 select-none"
                    rows={3}
                    variant="dither"
                  />
                </div>
                <div>
                  <div class="mbe-1.5">
                    <AsciiSkeleton
                      class="font-sans text-xs font-semibold text-stone-700"
                      lines={1}
                      variant="dither"
                      widths={["9rem"]}
                    />
                  </div>
                  <AsciiSkeleton
                    class="h-12 w-full rounded-xl border border-stone-200/90 bg-stone-50/50 text-stone-400 select-none"
                    rows={3}
                    variant="dither"
                  />
                </div>
              </div>

              {/* Row 3: Message */}
              <div>
                <div class="mbe-1.5">
                  <AsciiSkeleton
                    class="font-sans text-xs font-semibold text-stone-700"
                    lines={1}
                    variant="dither"
                    widths={["5rem"]}
                  />
                </div>
                <AsciiSkeleton
                  class="h-40 min-block-40 w-full rounded-xl border border-stone-200/90 bg-stone-50/50 text-stone-400 select-none"
                  rows={10}
                  variant="dither"
                />
              </div>

              {/* Bottom: Captcha + Submit button */}
              <div class="flex flex-col gap-4 pbs-2 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex justify-center sm:justify-start">
                  <div class="w-fit origin-center scale-85 rounded-xl border border-dashed border-stone-200 p-2 sm:scale-100">
                    <AsciiSkeleton
                      class="h-19.5 w-76 rounded-lg border border-stone-200/80 bg-stone-50/60 text-stone-400 select-none overflow-hidden"
                      rows={5}
                      variant="dither"
                    />
                  </div>
                </div>
                <ButtonSkeleton
                  size="md"
                  variant="primary"
                  class="w-48"
                />
              </div>
            </div>
          </div>
        </div>

        {/* Right: Contact Sidebar (col-span-2) */}
        <aside class="block-full inline-full lg:col-span-2">
          <div class="flex flex-col justify-between rounded-2xl border border-slate-900 bg-slate-950 p-6 text-white shadow-xl block-full sm:p-8">
            <div>
              <header>
                <AsciiSkeleton
                  class="font-mono text-xs uppercase text-orange-400"
                  lines={1}
                  variant="dither"
                  widths={["7rem"]}
                />
                <div class="mbs-3">
                  <h3 class="text-2xl sm:text-3xl font-semibold text-white">
                    <AsciiSkeleton
                      class="text-white"
                      lines={2}
                      variant="dither"
                      widths={["100%", "65%"]}
                    />
                  </h3>
                </div>
                <div class="mbs-4">
                  <AsciiSkeleton
                    class="font-mono text-xs sm:text-sm leading-relaxed text-slate-300"
                    lines={3}
                    variant="dither"
                    widths={["100%", "95%", "60%"]}
                  />
                </div>
              </header>

              <div class="mbs-8 space-y-6 text-sm">
                <!-- Item 1: Visit -->
                <div class="grid grid-cols-[48px_1fr] items-start gap-4">
                  <span class="inline-flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white/15 font-mono text-sm leading-none font-bold text-stone-300 tabular-nums">
                    01
                  </span>
                  <div class="self-start space-y-1">
                    <AsciiSkeleton
                      class="font-mono text-xs uppercase text-orange-400"
                      lines={1}
                      variant="dither"
                      widths={["3.5rem"]}
                    />
                    <AsciiSkeleton
                      class="font-mono text-xs sm:text-sm leading-relaxed text-slate-200"
                      lines={2}
                      variant="dither"
                      widths={["100%", "70%"]}
                    />
                  </div>
                </div>

                <!-- Item 2: Call -->
                <div class="grid grid-cols-[48px_1fr] items-start gap-4">
                  <span class="inline-flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white/15 font-mono text-sm leading-none font-bold text-stone-300 tabular-nums">
                    02
                  </span>
                  <div class="self-start space-y-1">
                    <AsciiSkeleton
                      class="font-mono text-xs uppercase text-orange-400"
                      lines={1}
                      variant="dither"
                      widths={["3rem"]}
                    />
                    <AsciiSkeleton
                      class="font-mono text-xs sm:text-sm text-slate-200"
                      lines={1}
                      variant="dither"
                      widths={["12rem"]}
                    />
                  </div>
                </div>

                <!-- Item 3: Email -->
                <div class="grid grid-cols-[48px_1fr] items-start gap-4">
                  <span class="inline-flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white/15 font-mono text-sm leading-none font-bold text-stone-300 tabular-nums">
                    03
                  </span>
                  <div class="self-start space-y-1">
                    <AsciiSkeleton
                      class="font-mono text-xs uppercase text-orange-400"
                      lines={1}
                      variant="dither"
                      widths={["3.5rem"]}
                    />
                    <AsciiSkeleton
                      class="font-mono text-xs sm:text-sm text-slate-200"
                      lines={1}
                      variant="dither"
                      widths={["11rem"]}
                    />
                  </div>
                </div>
              </div>
            </div>

            <div class="mbs-8">
              <AsciiSkeleton
                class="font-mono text-xs text-slate-400"
                lines={1}
                variant="dither"
                widths={["18rem"]}
              />
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* OFFICE & LOCATION SKELETON */}
  <section
    class="relative isolate border-t border-stone-200/90 bg-white py-12 sm:py-16 lg:py-24"
    id="location-skeleton"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8">
        <hgroup class="max-w-2xl space-y-2">
          <h2 class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance">
            <AsciiSkeleton
              class="text-stone-900 font-bold"
              lines={1}
              variant="dither"
              widths={["18rem"]}
            />
          </h2>
          <div class="border-s-2 border-orange-600 ps-4 py-0.5 max-w-[62ch]">
            <AsciiSkeleton
              class="text-stone-600 text-sm sm:text-base leading-relaxed"
              lines={2}
              variant="dither"
              widths={["100%", "45%"]}
            />
          </div>
        </hgroup>
      </div>

      <div class="overflow-hidden rounded-2xl border border-slate-900 bg-slate-950 text-white shadow-xl">
        <div class="relative flex flex-col items-center justify-center bg-slate-950 text-white block-75 md:block-100 lg:block-125">
          {/* Full-width ASCII background mesh */}
          <div class="absolute inset-0 size-full overflow-hidden bg-slate-950">
            <AsciiSkeleton
              class="ars-image ars-hero-bg size-full text-stone-700/35"
              rows={40}
              variant="dither"
            />
          </div>
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.06),transparent_70%)]"
          ></div>

          <div class="relative z-10 text-center space-y-4 px-6 max-w-lg mx-auto">
            {/* Centered Map icon skeleton */}
            <div class="mx-auto flex size-14 items-center justify-center rounded-full overflow-hidden text-stone-400">
              <AsciiSkeleton
                class="size-14 rounded-full overflow-hidden text-stone-400"
                rows={3}
                variant="dither"
              />
            </div>

            {/* Title */}
            <div class="mx-auto text-center">
              <h3 class="text-xl font-bold uppercase sm:text-2xl text-white tracking-tight">
                <AsciiSkeleton
                  class="text-white text-center mx-auto"
                  lines={1}
                  variant="dither"
                  widths={["16rem"]}
                />
              </h3>
            </div>

            {/* Description */}
            <div class="mx-auto max-w-lg text-center">
              <AsciiSkeleton
                class="font-mono text-xs sm:text-sm text-stone-300 leading-relaxed text-center mx-auto"
                lines={2}
                variant="dither"
                widths={["100%", "65%"]}
              />
            </div>

            {/* Centered Load Map CTA Button skeleton */}
            <div class="pt-2 flex justify-center">
              <ButtonSkeleton
                size="md"
                variant="primary"
                class="w-40"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
