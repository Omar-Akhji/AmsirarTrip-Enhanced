---
import { Skeleton } from "@/components/ui/skeleton";
import ButtonSkeleton from "@/shared/ui/feedback/ButtonSkeleton.astro";
import PageHeaderSkeleton from "@/shared/ui/feedback/PageHeaderSkeleton.astro";

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<PageHeaderSkeleton
  class:list={[className]}
  crumbWidths={["w-12", "w-20"]}
  hasButtons={false}
  hasUnderline={true}
/>

<div class="bg-white text-stone-900">
  {/* DIRECT CHANNELS SKELETON */}
  <section
    aria-busy="true"
    aria-label="Loading contact methods"
    class="relative isolate bg-white py-12 sm:py-16 lg:py-24"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      {/* Mobile Mode: Match ContactFolderStack 220vh runway */}
      <div class="block md:hidden w-full">
        <div class="relative w-full overflow-x-clip">
          <div class="relative w-full h-auto motion-safe:h-[220vh]">
            <div class="static h-auto motion-safe:sticky motion-safe:top-18 motion-safe:h-102.5 w-full mx-auto">
              <div class="flex flex-col gap-5 w-full motion-safe:hidden">
                {Array.from({ length: 3 }, () => (
                  <article class="contact-info-card relative flex h-55 w-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/95 p-5 shadow-xl shadow-stone-900/10">
                    <div>
                      <div class="mbe-2.5 border-b border-stone-200/80 pb-2.5">
                        <Skeleton class="h-6 w-48" />
                      </div>
                      <div class="space-y-2">
                        <Skeleton class="h-4 w-full" />
                        <Skeleton class="h-4 w-4/5" />
                      </div>
                    </div>
                    <div class="mbs-2 border-t border-stone-200/60 pbs-2.5">
                      <ButtonSkeleton
                        class="w-full"
                        size="md"
                        variant="outline"
                      />
                    </div>
                  </article>
                ))}
              </div>
              <div class="hidden motion-safe:block relative top-2 h-85 w-full">
                <article class="contact-info-card relative flex h-55 w-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/95 p-5 shadow-xl shadow-stone-900/10">
                  <div>
                    <div class="mbe-2.5 border-b border-stone-200/80 pb-2.5">
                      <Skeleton class="h-6 w-48" />
                    </div>
                    <div class="space-y-2">
                      <Skeleton class="h-4 w-full" />
                      <Skeleton class="h-4 w-4/5" />
                    </div>
                  </div>
                  <div class="mbs-2 border-t border-stone-200/60 pbs-2.5">
                    <ButtonSkeleton
                      class="w-full"
                      size="md"
                      variant="outline"
                    />
                  </div>
                </article>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Desktop & Tablet Mode: 3-column Grid matching ContactView.astro */}
      <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 2xl:gap-8 items-stretch">
        {Array.from({ length: 3 }, (_, index) => (
          <div class:list={["flex size-full", { "md:col-span-2 lg:col-span-1": index === 2 }]}>
            <article class="contact-info-card group relative flex size-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/80 p-6 sm:p-8 shadow-xs shadow-stone-900/5">
              <div>
                <div class="mbe-3 border-b border-stone-200/80 pb-3">
                  <Skeleton class="h-6 w-48" />
                </div>
                <div class="space-y-2 pt-1">
                  <Skeleton class="h-4 w-full" />
                  <Skeleton class="h-4 w-11/12" />
                  <Skeleton class="h-4 w-3/4" />
                </div>
              </div>

              {/* Action Button */}
              <div class="mbs-6 border-t border-stone-200/60 pbs-4">
                <ButtonSkeleton
                  class="w-full"
                  size="md"
                  variant="outline"
                />
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* EXPEDITION INQUIRY SKELETON */}
  <section
    class="relative isolate border-t border-stone-200 bg-stone-50 py-12 sm:py-16 lg:py-24"
    id="contact-form-section-skeleton"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8">
        <hgroup class="max-w-2xl space-y-2">
          <div class="text-3xl/tight sm:text-4xl font-bold ">
            <Skeleton class="h-[1.15em] w-64 sm:w-80 max-w-full" />
          </div>
          <div class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm/relaxed sm:text-base max-w-[62ch] space-y-1.5">
            <Skeleton class="h-4 sm:h-5 w-full" />
            <Skeleton class="h-4 w-3/4 sm:hidden" />
          </div>
        </hgroup>
      </div>

      <div class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-golden">
        {/* Left: Contact Form Card */}
        <div class="inline-full">
          <div class="rounded-2xl border border-stone-200/90 bg-white p-6 shadow-xs shadow-stone-900/5 block-full sm:p-8">
            <div class="mbe-6 border-b border-stone-100 pbe-5">
              <Skeleton class="h-4 w-32 mb-2" />
              <div class="mbs-1">
                <Skeleton class="h-7 w-56" />
              </div>
            </div>

            <div class="flex flex-col gap-6">
              {/* Row 1: Name & Email */}
              <div class="grid gap-5 md:grid-cols-2">
                <div>
                  <div class="mbe-1.5">
                    <Skeleton class="h-4 w-20" />
                  </div>
                  <Skeleton class="h-12 w-full rounded-xl" />
                </div>
                <div>
                  <div class="mbe-1.5">
                    <Skeleton class="h-4 w-16" />
                  </div>
                  <Skeleton class="h-12 w-full rounded-xl" />
                </div>
              </div>

              {/* Row 2: Phone & Topic */}
              <div class="grid gap-5 md:grid-cols-2">
                <div>
                  <div class="mbe-1.5">
                    <Skeleton class="h-4 w-24" />
                  </div>
                  <Skeleton class="h-12 w-full rounded-xl" />
                </div>
                <div>
                  <div class="mbe-1.5">
                    <Skeleton class="h-4 w-28" />
                  </div>
                  <Skeleton class="h-12 w-full rounded-xl" />
                </div>
              </div>

              {/* Row 3: Message */}
              <div>
                <div class="mbe-1.5">
                  <Skeleton class="h-4 w-20" />
                </div>
                <Skeleton class="h-44 min-block-44 w-full rounded-xl" />
              </div>

              {/* Bottom: Captcha + Submit button */}
              <div class="flex flex-col gap-4 pbs-2 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex justify-center sm:justify-start">
                  <Skeleton class="h-18 w-64 rounded-xl" />
                </div>
                <ButtonSkeleton
                  class="w-48"
                  size="md"
                  variant="card"
                />
              </div>
            </div>
          </div>
        </div>

        {/* Right: Contact Sidebar */}
        <aside class="block-full inline-full">
          <div class="flex flex-col justify-between rounded-2xl border border-slate-900 bg-slate-950 p-6 text-white shadow-xl block-full sm:p-8">
            <div>
              <header>
                <Skeleton class="h-3.5 w-24 bg-white/20" />
                <div class="mbs-3 space-y-2">
                  <Skeleton class="h-8 w-full bg-white/20" />
                  <Skeleton class="h-8 w-2/3 bg-white/20" />
                </div>
                <div class="mbs-4 space-y-2">
                  <Skeleton class="h-3.5 w-full bg-white/10" />
                  <Skeleton class="h-3.5 w-11/12 bg-white/10" />
                  <Skeleton class="h-3.5 w-3/5 bg-white/10" />
                </div>
              </header>

              <div class="mbs-8 space-y-6 text-sm">
                <div class="grid grid-cols-[48px_1fr] items-start gap-4">
                  <Skeleton class="size-12 rounded-full bg-white/15" />
                  <div class="self-start space-y-2">
                    <Skeleton class="h-3 w-16 bg-white/20" />
                    <Skeleton class="h-3.5 w-full bg-white/10" />
                    <Skeleton class="h-3.5 w-3/4 bg-white/10" />
                  </div>
                </div>
                <div class="grid grid-cols-[48px_1fr] items-start gap-4">
                  <Skeleton class="size-12 rounded-full bg-white/15" />
                  <div class="self-start space-y-2">
                    <Skeleton class="h-3 w-14 bg-white/20" />
                    <Skeleton class="h-3.5 w-40 bg-white/10" />
                  </div>
                </div>
                <div class="grid grid-cols-[48px_1fr] items-start gap-4">
                  <Skeleton class="size-12 rounded-full bg-white/15" />
                  <div class="self-start space-y-2">
                    <Skeleton class="h-3 w-14 bg-white/20" />
                    <Skeleton class="h-3.5 w-44 bg-white/10" />
                  </div>
                </div>
              </div>
            </div>

            <div class="mbs-8">
              <Skeleton class="h-3.5 w-60 bg-white/10" />
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* OFFICE & LOCATION SKELETON */}
  <section
    class="relative isolate border-t border-stone-200/90 bg-white py-12 sm:py-16 lg:py-24"
    id="location-skeleton"
  >
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8">
        <hgroup class="max-w-2xl space-y-2">
          <div class="text-3xl/tight sm:text-4xl font-bold ">
            <Skeleton class="h-[1.15em] w-64 sm:w-80 max-w-full" />
          </div>
          <div class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm/relaxed sm:text-base max-w-[62ch]">
            <Skeleton class="h-5 sm:h-6 w-full" />
          </div>
        </hgroup>
      </div>

      <div class="overflow-hidden rounded-2xl border border-slate-900 bg-slate-950 text-white shadow-xl">
        <div class="relative flex flex-col items-center justify-center bg-slate-950 text-white block-75 md:block-100 lg:block-125">
          <div class="absolute inset-0 size-full overflow-hidden bg-slate-950">
            <Skeleton class="size-full rounded-none bg-slate-900/60" />
          </div>
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.06),transparent_70%)]"
          ></div>

          <div class="relative z-10 text-center space-y-4 px-6 max-w-lg mx-auto flex flex-col items-center">
            <Skeleton class="size-14 rounded-full bg-white/15" />
            <Skeleton class="h-7 w-60 bg-white/20" />
            <div class="space-y-2 w-full flex flex-col items-center">
              <Skeleton class="h-4 w-full bg-white/10" />
              <Skeleton class="h-4 w-2/3 bg-white/10" />
            </div>
            <div class="pt-2 flex justify-center">
              <ButtonSkeleton
                class="w-40"
                size="md"
                variant="primary"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
