---
import AsciiSkeleton from "@/shared/ui/feedback/AsciiSkeleton.astro";
import ButtonSkeleton from "@/shared/ui/feedback/ButtonSkeleton.astro";
import PageHeaderSkeleton from "@/shared/ui/feedback/PageHeaderSkeleton.astro";

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<div
  aria-busy="true"
  aria-label="Loading contact view"
  class:list={["size-full bg-white text-stone-900 pb-20", className]}
>
  <PageHeaderSkeleton
    crumbWidths={["w-12", "w-20"]}
    hasButtons={false}
    hasUnderline={true}
  />

  {/* DIRECT CHANNELS SKELETON */}
  <section class="relative isolate bg-white py-12 sm:py-16 lg:py-24">
    <div class="mx-auto px-4 max-inline-7xl">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 items-stretch">
        {Array.from({ length: 3 }, () => (
          <div class="flex size-full last:md:col-span-2 last:lg:col-span-1">
            <article class="group flex size-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/80 p-6 sm:p-8 shadow-xs shadow-stone-900/5">
              <div>
                <AsciiSkeleton
                  class="mbe-3 text-xl font-bold tracking-tight text-stone-950"
                  lines={2}
                  variant="dither"
                  widths={["100%", "60%"]}
                />
                <div class="pt-1">
                  <AsciiSkeleton
                    class="text-sm leading-relaxed text-stone-600"
                    lines={3}
                    variant="dither"
                    widths={["100%", "95%", "70%"]}
                  />
                </div>
              </div>

              {/* Action Button */}
              <div class="mbs-6 border-t border-stone-200/60 pbs-4">
                <ButtonSkeleton
                  size="md"
                  variant="outline"
                  class="w-full"
                />
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* EXPEDITION INQUIRY SKELETON */}
  <section
    class="relative isolate border-t border-stone-200 bg-stone-50 py-12 sm:py-16 lg:py-24"
    id="contact-form-section"
  >
    <div class="mx-auto px-4 max-inline-7xl">
      <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8">
        <div class="max-w-2xl space-y-2">
          <AsciiSkeleton
            class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance"
            lines={1}
            variant="dither"
            widths={["17rem"]}
          />
          <div class="border-s-2 border-stone-300 ps-4 py-0.5 max-w-[62ch]">
            <AsciiSkeleton
              class="text-stone-600 text-sm sm:text-base leading-relaxed"
              lines={2}
              variant="dither"
              widths={["100%", "72%"]}
            />
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-5">
        {/* Left: Contact Form Card (col-span-3) */}
        <div class="inline-full lg:col-span-3">
          <div class="rounded-2xl border border-stone-200/90 bg-white p-6 shadow-xs shadow-stone-900/5 block-full sm:p-8">
            <div class="mbe-6 border-b border-stone-100 pbe-5">
              <AsciiSkeleton
                class="font-mono text-xs uppercase"
                lines={1}
                variant="dither"
                widths={["8rem"]}
              />
              <div class="mbs-1">
                <AsciiSkeleton
                  class="text-xl sm:text-2xl font-bold tracking-tight"
                  lines={2}
                  variant="dither"
                  widths={["100%", "48%"]}
                />
              </div>
            </div>

            <div class="flex flex-col gap-5">
              {/* Row 1: Name & Email */}
              <div class="grid gap-5 md:grid-cols-2">
                <div>
                  <div class="mbe-1.5">
                    <AsciiSkeleton
                      class="font-sans text-xs font-semibold"
                      lines={1}
                      variant="dither"
                      widths={["5.5rem"]}
                    />
                  </div>
                  <AsciiSkeleton
                    class="h-12 w-full rounded-xl border border-stone-200/90 bg-stone-50/50 text-stone-400 select-none"
                    rows={3}
                    variant="dither"
                  />
                </div>
                <div>
                  <div class="mbe-1.5">
                    <AsciiSkeleton
                      class="font-sans text-xs font-semibold"
                      lines={1}
                      variant="dither"
                      widths={["4rem"]}
                    />
                  </div>
                  <AsciiSkeleton
                    class="h-12 w-full rounded-xl border border-stone-200/90 bg-stone-50/50 text-stone-400 select-none"
                    rows={3}
                    variant="dither"
                  />
                </div>
              </div>

              {/* Row 2: Phone & Topic */}
              <div class="grid gap-5 md:grid-cols-2">
                <div>
                  <div class="mbe-1.5">
                    <AsciiSkeleton
                      class="font-sans text-xs font-semibold"
                      lines={1}
                      variant="dither"
                      widths={["6.5rem"]}
                    />
                  </div>
                  <AsciiSkeleton
                    class="h-12 w-full rounded-xl border border-stone-200/90 bg-stone-50/50 text-stone-400 select-none"
                    rows={3}
                    variant="dither"
                  />
                </div>
                <div>
                  <div class="mbe-1.5">
                    <AsciiSkeleton
                      class="font-sans text-xs font-semibold"
                      lines={1}
                      variant="dither"
                      widths={["9rem"]}
                    />
                  </div>
                  <AsciiSkeleton
                    class="h-12 w-full rounded-xl border border-stone-200/90 bg-stone-50/50 text-stone-400 select-none"
                    rows={3}
                    variant="dither"
                  />
                </div>
              </div>

              {/* Row 3: Message */}
              <div>
                <div class="mbe-1.5">
                  <AsciiSkeleton
                    class="font-sans text-xs font-semibold"
                    lines={1}
                    variant="dither"
                    widths={["5rem"]}
                  />
                </div>
                <AsciiSkeleton
                  class="h-40 min-block-40 w-full rounded-xl border border-stone-200/90 bg-stone-50/50 text-stone-400 select-none"
                  rows={10}
                  variant="dither"
                />
              </div>

              {/* Bottom: Captcha + Submit button */}
              <div class="flex flex-col gap-4 pbs-2 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex justify-center sm:justify-start">
                  <div class="w-fit origin-center scale-85 rounded-xl border border-dashed border-stone-200 p-2 sm:scale-100">
                    <AsciiSkeleton
                      class="h-19.5 w-76 rounded-lg border border-stone-200/80 bg-stone-50/60 text-stone-400 select-none overflow-hidden"
                      rows={5}
                      variant="dither"
                    />
                  </div>
                </div>
                <ButtonSkeleton
                  size="md"
                  variant="primary"
                  class="w-48"
                />
              </div>
            </div>
          </div>
        </div>

        {/* Right: Contact Sidebar (col-span-2) */}
        <aside class="block-full inline-full lg:col-span-2">
          <div class="flex flex-col justify-between rounded-2xl border border-slate-900 bg-slate-950 p-6 text-white shadow-xl block-full sm:p-8">
            <div>
              <header>
                <AsciiSkeleton
                  class="font-mono text-xs uppercase"
                  lines={1}
                  variant="dither"
                  widths={["7rem"]}
                />
                <div class="mbs-3">
                  <AsciiSkeleton
                    class="text-2xl sm:text-3xl font-semibold"
                    lines={2}
                    variant="dither"
                    widths={["100%", "65%"]}
                  />
                </div>
                <div class="mbs-4">
                  <AsciiSkeleton
                    class="font-mono text-xs sm:text-sm leading-relaxed"
                    lines={3}
                    variant="dither"
                    widths={["100%", "95%", "60%"]}
                  />
                </div>
              </header>

              <div class="mbs-8 space-y-6 text-sm">
                <!-- Item 1: Visit -->
                <div class="grid grid-cols-[48px_1fr] items-start gap-4">
                  <span class="inline-flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white/15 font-mono text-sm leading-none font-bold text-stone-300 tabular-nums">
                    01
                  </span>
                  <div class="self-start space-y-1">
                    <AsciiSkeleton
                      class="font-mono text-xs uppercase"
                      lines={1}
                      variant="dither"
                      widths={["3.5rem"]}
                    />
                    <AsciiSkeleton
                      class="font-mono text-xs sm:text-sm leading-relaxed"
                      lines={2}
                      variant="dither"
                      widths={["100%", "70%"]}
                    />
                  </div>
                </div>

                <!-- Item 2: Call -->
                <div class="grid grid-cols-[48px_1fr] items-start gap-4">
                  <span class="inline-flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white/15 font-mono text-sm leading-none font-bold text-stone-300 tabular-nums">
                    02
                  </span>
                  <div class="self-start space-y-1">
                    <AsciiSkeleton
                      class="font-mono text-xs uppercase"
                      lines={1}
                      variant="dither"
                      widths={["3rem"]}
                    />
                    <AsciiSkeleton
                      class="font-mono text-xs sm:text-sm"
                      lines={1}
                      variant="dither"
                      widths={["12rem"]}
                    />
                  </div>
                </div>

                <!-- Item 3: Email -->
                <div class="grid grid-cols-[48px_1fr] items-start gap-4">
                  <span class="inline-flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white/15 font-mono text-sm leading-none font-bold text-stone-300 tabular-nums">
                    03
                  </span>
                  <div class="self-start space-y-1">
                    <AsciiSkeleton
                      class="font-mono text-xs uppercase"
                      lines={1}
                      variant="dither"
                      widths={["3.5rem"]}
                    />
                    <AsciiSkeleton
                      class="font-mono text-xs sm:text-sm"
                      lines={1}
                      variant="dither"
                      widths={["11rem"]}
                    />
                  </div>
                </div>
              </div>
            </div>

            <div class="mbs-8">
              <AsciiSkeleton
                class="font-mono text-xs"
                lines={1}
                variant="dither"
                widths={["18rem"]}
              />
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* OFFICE & LOCATION SKELETON */}
  <section
    class="relative isolate border-t border-stone-200/90 bg-white py-12 sm:py-16 lg:py-24"
    id="location-skeleton"
  >
    <div class="mx-auto px-4 max-inline-7xl">
      <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8">
        <div class="max-w-2xl space-y-2">
          <AsciiSkeleton
            class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance"
            lines={1}
            variant="dither"
            widths={["18rem"]}
          />
          <div class="border-s-2 border-stone-300 ps-4 py-0.5 max-w-[62ch]">
            <AsciiSkeleton
              class="text-stone-600 text-sm sm:text-base leading-relaxed"
              lines={2}
              variant="dither"
              widths={["100%", "45%"]}
            />
          </div>
        </div>
      </div>

      <div class="overflow-hidden rounded-2xl border border-slate-900 bg-slate-950 text-white shadow-xl">
        <div class="relative flex flex-col items-center justify-center bg-slate-950 text-white block-75 md:block-100 lg:block-125">
          {/* Full-width ASCII background mesh spanning 100% edge-to-edge */}
          <div class="absolute inset-0 size-full overflow-hidden bg-slate-950">
            <AsciiSkeleton
              class="ars-image ars-hero-bg size-full text-stone-700/35"
              rows={40}
              variant="dither"
            />
          </div>
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.06),transparent_70%)]"
          ></div>

          <div class="relative z-10 text-center space-y-4 px-6 max-w-lg mx-auto">
            {/* Centered Map icon skeleton */}
            <div class="mx-auto flex size-14 items-center justify-center rounded-full overflow-hidden text-stone-400">
              <AsciiSkeleton
                class="size-14 rounded-full overflow-hidden text-stone-400"
                rows={3}
                variant="dither"
              />
            </div>

            {/* Title */}
            <div class="mx-auto text-center">
              <AsciiSkeleton
                class="text-xl font-bold uppercase sm:text-2xl text-stone-200 text-center mx-auto"
                lines={1}
                variant="dither"
                widths={["16rem"]}
              />
            </div>

            {/* Description */}
            <div class="mx-auto max-w-lg text-center">
              <AsciiSkeleton
                class="font-mono text-xs sm:text-sm text-stone-400 leading-relaxed text-center mx-auto"
                lines={2}
                variant="dither"
                widths={["100%", "65%"]}
              />
            </div>

            {/* Centered Load Map CTA Button skeleton — full ASCII dither button pill */}
            <div class="pt-2 flex justify-center">
              <ButtonSkeleton
                size="md"
                variant="primary"
                class="w-40"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
