---
import AsciiSkeleton from "@/shared/ui/feedback/AsciiSkeleton.astro";

interface Props {
  readonly count?: number | undefined;
  readonly categoryWidth?: string | undefined;
  readonly headingWidth?: string | undefined;
  readonly hasSubtitle?: boolean | undefined;
  readonly subtitleWidth?: string | undefined;
  readonly questionWidths?: readonly string[] | undefined;
  readonly isListing?: boolean | undefined;
  readonly maxDlWidth?: string | undefined;
}

const {
  count = 4,
  categoryWidth = "6rem",
  headingWidth = "18rem",
  hasSubtitle = false,
  subtitleWidth = "22rem",
  questionWidths = ["85%", "75%", "90%", "65%", "80%"],
  isListing = false,
  maxDlWidth = isListing ? "max-w-3xl" : "w-full",
} = Astro.props;

const items = Array.from({ length: count }, (_, i) => ({
  width: questionWidths[i % questionWidths.length] ?? "80%",
}));
---

{isListing ?
  <section class="border-t border-zinc-200 bg-white py-12 sm:py-16 lg:py-20">
    <div class="mx-auto px-4 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <hgroup class="mb-8">
        <AsciiSkeleton
          class="font-sans text-xs font-bold tracking-wider text-orange-700 uppercase"
          lines={1}
          variant="dither"
          widths={[categoryWidth]}
        />
        <div class="mt-1">
          <AsciiSkeleton
            class="text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl"
            lines={1}
            variant="dither"
            widths={[headingWidth]}
          />
        </div>
        {hasSubtitle && (
          <div class="mt-2">
            <AsciiSkeleton
              class="text-sm text-stone-500"
              lines={1}
              variant="dither"
              widths={[subtitleWidth]}
            />
          </div>
        )}
      </hgroup>

      <dl
        class:list={[
          "overflow-hidden rounded-2xl border border-stone-200/90 bg-white shadow-2xs divide-y divide-stone-200/80",
          maxDlWidth,
        ]}
        data-ascii="surface"
      >
        {items.map((item) => (
          <div class="px-4 py-3.5 sm:px-5 sm:py-4">
            <div class="flex items-start justify-between gap-4 text-base font-semibold text-stone-900">
              <div class="flex items-center gap-2.5 w-full">
                <AsciiSkeleton
                  class="size-5 shrink-0 rounded-full"
                  lines={1}
                  variant="dither"
                  widths={["1.25rem"]}
                />
                <AsciiSkeleton
                  class="text-base font-semibold text-stone-900 flex-1"
                  lines={1}
                  variant="dither"
                  widths={[item.width]}
                />
              </div>
              <span
                aria-hidden="true"
                class="mt-0.5 shrink-0 text-orange-600 select-none font-medium text-lg leading-none"
              >
                +
              </span>
            </div>
          </div>
        ))}
      </dl>
    </div>
  </section>
: <div>
    <section>
      <hgroup class="mbe-4">
        <AsciiSkeleton
          class="font-sans text-xs font-bold tracking-wider text-orange-700 uppercase"
          lines={1}
          variant="dither"
          widths={[categoryWidth]}
        />
        <div class="mbs-1">
          <AsciiSkeleton
            class="text-xl font-bold tracking-tight text-stone-900 sm:text-2xl md:text-3xl"
            lines={1}
            variant="dither"
            widths={[headingWidth]}
          />
        </div>
      </hgroup>

      <dl
        class:list={[
          "overflow-hidden rounded-2xl border border-stone-200/90 bg-white shadow-2xs divide-y divide-stone-200/80",
          maxDlWidth,
        ]}
        data-ascii="surface"
      >
        {items.map((item) => (
          <div class="px-4 py-3.5 sm:px-5 sm:py-4">
            <div class="flex items-start justify-between gap-4 text-base font-semibold text-stone-900">
              <div class="flex items-center gap-2.5 w-full">
                <AsciiSkeleton
                  class="size-5 shrink-0 rounded-full"
                  lines={1}
                  variant="dither"
                  widths={["1.25rem"]}
                />
                <AsciiSkeleton
                  class="text-base font-semibold text-stone-900 flex-1"
                  lines={1}
                  variant="dither"
                  widths={[item.width]}
                />
              </div>
              <span
                aria-hidden="true"
                class="mt-0.5 shrink-0 text-orange-600 select-none font-medium text-lg leading-none"
              >
                +
              </span>
            </div>
          </div>
        ))}
      </dl>
    </section>
  </div>
}
