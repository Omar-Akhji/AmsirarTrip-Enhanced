---
import { Skeleton } from "@/components/ui/skeleton";

interface Props {
  readonly categoryWidth?: string | undefined;
  readonly count?: number | undefined;
  readonly hasCategoryKicker?: boolean | undefined;
  readonly hasSubtitle?: boolean | undefined;
  readonly headingWidth?: string | undefined;
  readonly isListing?: boolean | undefined;
  readonly maxDlWidth?: string | undefined;
  readonly questionWidths?: readonly string[] | undefined;
  readonly subtitleWidth?: string | undefined;
}

const {
  count = 4,
  categoryWidth = "w-24",
  headingWidth = "w-72",
  isListing = false,
  hasCategoryKicker = !isListing,
  hasSubtitle = isListing,
  subtitleWidth = "w-80",
  questionWidths = ["w-4/5", "w-3/4", "w-11/12", "w-2/3", "w-4/5"],
  maxDlWidth = isListing ? "max-w-3xl" : "w-full",
} = Astro.props;

const items = Array.from({ length: count }, (_, i) => ({
  width: questionWidths[i % questionWidths.length] ?? "w-4/5",
}));
---

{isListing ?
  <section class="border-t border-zinc-200 bg-white py-12 sm:py-16 lg:py-20">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <hgroup class="mb-8 max-w-2xl">
        {hasCategoryKicker && <Skeleton class:list={["h-4", categoryWidth]} />}
        <div
          class:list={[
            { "mt-1": hasCategoryKicker },
            "text-2xl sm:text-3xl font-bold leading-tight",
          ]}
        >
          <Skeleton class:list={["h-[1.2em] max-w-full", headingWidth]} />
        </div>
        {hasSubtitle && (
          <div class="mt-2 border-s-2 border-orange-600 ps-4 py-0.5 text-sm/relaxed sm:text-base space-y-1.5 max-w-[62ch]">
            <Skeleton class:list={["h-6 max-w-full", subtitleWidth]} />
            <Skeleton class="h-6 w-3/4 md:hidden" />
          </div>
        )}
      </hgroup>

      <div
        class:list={[
          "overflow-hidden rounded-2xl border border-stone-200/90 bg-white shadow-2xs divide-y divide-stone-200/80",
          maxDlWidth,
        ]}
      >
        {items.map((item, idx) => (
          <div class="px-4 py-3.5 sm:px-5 sm:py-4">
            <div class="flex items-start justify-between gap-4 text-base font-semibold text-stone-900">
              <div class="flex items-start gap-2.5 min-w-0 flex-1">
                <Skeleton class="mbs-0.5 size-5 shrink-0 rounded-full" />
                <div class="flex-1 space-y-1.5">
                  <Skeleton class:list={["h-6", item.width]} />
                  {idx % 2 === 0 && <Skeleton class="h-6 w-1/2" />}
                </div>
              </div>
              <span
                aria-hidden="true"
                class="mt-0.5 shrink-0 text-orange-600 select-none font-medium text-lg leading-none"
              >
                +
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
: <div>
    <section>
      <hgroup class="mbe-4 space-y-1">
        {hasCategoryKicker && <Skeleton class:list={["h-4", categoryWidth]} />}
        <div
          class:list={[
            { "mbs-1": hasCategoryKicker },
            "text-xl sm:text-2xl md:text-3xl font-bold leading-tight",
          ]}
        >
          <Skeleton class:list={["h-[1.25em] max-w-full", headingWidth]} />
        </div>
        {hasSubtitle && (
          <div class="mt-2 border-s-2 border-orange-600 ps-4 py-0.5 text-sm/relaxed sm:text-base">
            <Skeleton class:list={["h-5 sm:h-6 max-w-full", subtitleWidth]} />
          </div>
        )}
      </hgroup>

      <div
        class:list={[
          "overflow-hidden rounded-2xl border border-stone-200/90 bg-white shadow-2xs divide-y divide-stone-200/80",
          maxDlWidth,
        ]}
      >
        {items.map((item) => (
          <div class="px-4 py-3.5 sm:px-5 sm:py-4">
            <div class="flex items-start justify-between gap-4 text-base font-semibold text-stone-900">
              <div class="flex items-center gap-2.5 min-w-0 flex-1">
                <Skeleton class="size-5 shrink-0 rounded-full" />
                <Skeleton class:list={["h-6 flex-1", item.width]} />
              </div>
              <span
                aria-hidden="true"
                class="mt-0.5 shrink-0 text-orange-600 select-none font-medium text-lg leading-none"
              >
                +
              </span>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
}
