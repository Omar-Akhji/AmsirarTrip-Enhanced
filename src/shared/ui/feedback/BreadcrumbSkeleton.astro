---
import { Skeleton } from "@/components/ui/skeleton";

interface Props {
  crumbWidths?: string[] | undefined;
  class?: string | undefined;
  variant?: "dark" | "light" | undefined;
}

const { crumbWidths = ["w-14", "w-24"], class: className, variant = "dark" } = Astro.props;

const containerClasses =
  variant === "light" ?
    "border border-stone-200/90 bg-stone-100/80 text-stone-400"
  : "border-[1.5px] border-white/10 bg-white/10 text-white/40 shadow-xs ring-1 ring-black/5 backdrop-blur-[20px]";

const crumbClasses = variant === "light" ? "bg-stone-300/80 dark:bg-stone-700/80" : "bg-white/25";
---

<nav
  aria-label="Loading breadcrumb navigation"
  class:list={["flex items-center justify-center", className]}
>
  <ol
    role="list"
    class:list={[
      "flex list-none flex-wrap items-center gap-2 rounded-full px-6 py-2 select-none",
      containerClasses,
    ]}
  >
    {crumbWidths.map((w, index) => (
      <li class="flex items-center gap-2">
        <Skeleton class:list={["h-3.5 rounded-full", crumbClasses, w]} />
        {index < crumbWidths.length - 1 && (
          <span
            class="text-xs opacity-60"
            aria-hidden="true"
          >
            /
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
