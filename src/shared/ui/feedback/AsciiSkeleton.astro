---
import { asciiSkeletonHTML, type SkeletonSpec, type SkeletonVariant } from "ascii-reveal/core";

interface Props {
  variant?: SkeletonVariant | undefined;
  lines?: number | undefined;
  widths?: (string | number)[] | undefined;
  rows?: number | undefined;
  width?: number | string | undefined;
  height?: number | string | undefined;
  circle?: boolean | undefined;
  seed?: number | undefined;
  animate?: boolean | undefined;
  class?: string | undefined;
  style?: string | undefined;
}

const {
  variant = "dither",
  lines,
  widths,
  rows,
  width,
  height,
  circle,
  seed = Math.floor(Math.random() * 100_000),
  animate = true,
  class: className,
  style: styleProp,
} = Astro.props;

// Build spec respecting exactOptionalPropertyTypes
const spec: SkeletonSpec = {
  variant,
  seed,
  animate,
  css: false,
  ...(lines !== undefined && { lines }),
  ...(widths !== undefined && { widths }),
  ...(rows !== undefined && { rows }),
};

const rawHtml = asciiSkeletonHTML(spec);

// Format pixel dimensions
const formatDim = (val: number | string | undefined): string | undefined => {
  if (val === undefined) return undefined;
  return typeof val === "number" ? `${val}px` : val;
};

const w = formatDim(width);
const h = formatDim(height);

// Compute styles for .ars-block when rows is specified (image / avatar block)
const blockStyles: string[] = [];
if (w) blockStyles.push(`width:${w};`);
if (h) blockStyles.push(`height:${h};`);
if (circle) blockStyles.push("--ars-radius:50%;border-radius:50%;");
const blockStyleAttr = blockStyles.join("");

let html = rawHtml;

// Expand .ars-base text lines to at least 320 characters to guarantee full-bleed edge coverage
html = html.replace(/<span class="ars-base">([\s\S]*?)<\/span>/g, (_, content: string) => {
  const expanded = content
    .split("\n")
    .map((line: string) => {
      if (line.length >= 320) return line;
      let rep = line;
      while (rep.length < 320) {
        rep += line;
      }
      return rep.slice(0, 320);
    })
    .join("\n");
  return `<span class="ars-base">${expanded}</span>`;
});

// Inject block styles into .ars-block
if (blockStyleAttr) {
  html = html.replace(
    'class="ars-block" style=""',
    () => `class="ars-block" style="${blockStyleAttr}"`,
  );
}

// Compute styles for the root .ars container
const rootStyles: string[] = [];
if (circle) {
  rootStyles.push("display:inline-flex;border-radius:50%;overflow:hidden;");
} else if (w && !className?.includes("w-") && !className?.includes("size-")) {
  rootStyles.push("display:inline-block;");
}
if (styleProp) {
  rootStyles.push(styleProp);
}

// Inject consumer classes directly into root .ars container
if (className) {
  html = html.replace('class="ars ', () => `class="ars ${className.trim()} `);
}

// Inject root styles if present
if (rootStyles.length > 0) {
  const rootStyleAttr = rootStyles.join("");
  html = html.replace('class="ars', () => `style="${rootStyleAttr}" class="ars`);
}
---

<Fragment set:html={html} />
