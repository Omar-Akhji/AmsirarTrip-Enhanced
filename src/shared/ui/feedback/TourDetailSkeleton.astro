---
import { Skeleton } from "@/components/ui/skeleton";
import ButtonSkeleton from "@/shared/ui/feedback/ButtonSkeleton.astro";
import FaqSkeleton from "@/shared/ui/feedback/FaqSkeleton.astro";
import PageHeaderSkeleton from "@/shared/ui/feedback/PageHeaderSkeleton.astro";

interface Props {
  crumbWidths?: string[] | undefined;
  class?: string | undefined;
}

const { crumbWidths = ["w-12", "w-14", "w-52"], class: className } = Astro.props;
---

<div
  aria-busy="true"
  aria-label="Loading tour details"
  class:list={["size-full bg-white text-stone-900", className]}
>
  <PageHeaderSkeleton
    crumbWidths={crumbWidths}
    hasButtons={false}
    hasUnderline={true}
  />

  {/* Trip Content Section matching TripLayout.astro */}
  <section class="py-12 sm:py-16 lg:py-24">
    <div class="mx-auto grid gap-4 sm:gap-6 lg:gap-8 px-2 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420 lg:grid-cols-golden">
      {/* Left Column: Dossier Article */}
      <article class="rounded-2xl bg-white p-4 pbe-8 shadow-xs ring-1 ring-zinc-100 xs:p-5 sm:p-6 sm:pbe-12 2xl:p-8 space-y-8">
        {/* Featured Image matching TripLayout.astro golden ratio */}
        <figure class="relative mbe-8 aspect-golden overflow-hidden rounded-xl border border-zinc-100 shadow-md inline-full bg-stone-100 dark:bg-stone-800">
          <Skeleton class="size-full rounded-xl" />
        </figure>

        {/* Dossier Header */}
        <div class="mbe-8 sm:mbe-12 block border-b border-stone-200 pb-6 sm:pb-8 text-start">
          <Skeleton class="h-9 sm:h-11 w-4/5" />
        </div>

        {/* Quick Specs 4-card Grid matching TourSeoSections.astro */}
        <dl class="m-0 p-0 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
          {[1, 2, 3, 4].map(() => (
            <div class="flex items-center gap-4 rounded-2xl border border-stone-200/90 bg-white px-5 py-3 shadow-2xs min-block-20">
              <span class="size-5 shrink-0 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center font-bold text-xs">
                •
              </span>
              <div class="text-start min-w-0 flex-1 space-y-1.5">
                <Skeleton class="h-3 w-16" />
                <Skeleton class="h-4 w-24" />
              </div>
            </div>
          ))}
        </dl>

        {/* Highlights Section matching HighlightsList.astro */}
        <section class="mbs-8">
          <hgroup class="mbe-4 space-y-2">
            <Skeleton class="h-3.5 w-32" />
            <Skeleton class="h-8 w-56" />
          </hgroup>
          <div class="rounded-2xl border border-stone-200/90 bg-white p-5 sm:p-6 shadow-2xs">
            <ul class="m-0 p-0 list-none grid gap-x-6 gap-y-3.5 sm:grid-cols-2">
              {Array.from({ length: 4 }, () => (
                <li class="flex items-start gap-3">
                  <span class="mbs-0.5 size-5 shrink-0 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center font-bold text-xs">
                    ✓
                  </span>
                  <div class="flex-1">
                    <Skeleton class="h-4 w-11/12" />
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </section>

        {/* Route Overview Section */}
        <section class="mbs-8">
          <hgroup class="mbe-4 space-y-2">
            <Skeleton class="h-3.5 w-32" />
            <Skeleton class="h-8 w-60" />
          </hgroup>
          <div class="space-y-2">
            <Skeleton class="h-4 w-full" />
            <Skeleton class="h-4 w-11/12" />
            <Skeleton class="h-4 w-3/4" />
          </div>
        </section>

        {/* Itinerary Timeline matching TourItinerary.astro */}
        <section class="mbs-8 space-y-4">
          <header class="ms-6 sm:ms-8 w-[calc(100%-1.5rem)] sm:w-[calc(100%-2rem)] bg-white/95 backdrop-blur-md pt-2 pb-4 border-b border-stone-200/80 mbe-8">
            <div class="space-y-3">
              <hgroup class="space-y-2">
                <Skeleton class="h-3.5 w-28" />
                <Skeleton class="h-10 sm:h-12 w-48" />
              </hgroup>
              <div class="min-h-7 flex items-center justify-between">
                <div class="inline-flex items-center rounded-full border border-stone-200/90 bg-white px-3.5 py-1">
                  <Skeleton class="h-4 w-52" />
                </div>
                <div class="flex items-center gap-3">
                  <Skeleton class="h-4 w-14" />
                  <div class="w-24 sm:w-36 h-1.5 bg-stone-200/80 rounded-full overflow-hidden">
                    <div class="h-full w-1/3 bg-orange-600"></div>
                  </div>
                </div>
              </div>
            </div>
          </header>

          {/* Timeline Nodes */}
          <div class="relative w-full pl-6 sm:pl-8 space-y-8">
            <div class="absolute left-0 top-0 bottom-8 w-0.5 bg-stone-200"></div>
            {Array.from({ length: 3 }, () => (
              <div class="relative space-y-2">
                <div class="absolute -left-6 sm:-left-8 top-1.5 size-3 -translate-x-1/2 rounded-full bg-orange-600 ring-4 ring-orange-100"></div>
                <div class="flex items-start gap-3">
                  <span class="mbs-2 size-1.5 shrink-0 rounded-full bg-orange-600"></span>
                  <div class="flex-1 space-y-2">
                    <Skeleton class="h-4 w-full" />
                    <Skeleton class="h-4 w-4/5" />
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        {/* TripInfoSections (Included & Excluded) matching TripInfoSections.astro */}
        <section class="mbs-8">
          <hgroup class="mbe-4 space-y-2">
            <Skeleton class="h-3.5 w-36" />
            <Skeleton class="h-8 w-60" />
          </hgroup>
          <div class="rounded-2xl border border-emerald-500/20 bg-emerald-50/30 p-6 shadow-2xs">
            <ul class="space-y-3 m-0 p-0 list-none">
              {Array.from({ length: 4 }, () => (
                <li class="flex items-start gap-3">
                  <span class="mbs-0.5 size-5 shrink-0 rounded-full bg-emerald-600/15 text-emerald-700 flex items-center justify-center font-bold text-xs">
                    ✓
                  </span>
                  <Skeleton class="h-4 w-4/5" />
                </li>
              ))}
            </ul>
          </div>
        </section>

        {/* PricingCard matching PricingCard.astro */}
        <section class="rounded-2xl border border-stone-200/90 bg-stone-50/80 p-6 sm:p-8 shadow-xs">
          <div class="space-y-6">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
              <div class="space-y-2">
                <Skeleton class="h-3.5 w-36" />
                <Skeleton class="h-7 w-56" />
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="rounded-xl border border-stone-200/80 bg-white p-4 space-y-2">
                <Skeleton class="h-3.5 w-20" />
                <Skeleton class="h-6 w-28" />
              </div>
              <div class="rounded-xl border border-stone-200/80 bg-white p-4 space-y-2">
                <Skeleton class="h-3.5 w-20" />
                <Skeleton class="h-6 w-28" />
              </div>
            </div>
          </div>
        </section>

        {/* FAQ Section */}
        <FaqSkeleton
          categoryWidth="w-28"
          count={4}
          headingWidth="w-64"
          isListing={false}
          questionWidths={["w-11/12", "w-4/5", "w-3/4", "w-2/3"]}
        />
      </article>

      {/* Right Column: DetailsSidebar */}
      <aside class="space-y-6 self-start lg:sticky lg:top-24">
        {/* Brand Card: Dark Luxury Container matching DetailsSidebar.astro */}
        <div class="overflow-hidden rounded-2xl bg-slate-950 text-white shadow-xl">
          <div class="p-6 sm:p-8">
            <hgroup class="text-center space-y-2 flex flex-col items-center">
              <Skeleton class="h-3.5 w-28 bg-white/20" />
              <Skeleton class="h-7 w-48 bg-white/20" />
            </hgroup>
            <div
              aria-hidden="true"
              class="my-4 border-t border-slate-800"
            ></div>
            <div class="space-y-2">
              <Skeleton class="h-4 w-full bg-white/10" />
              <Skeleton class="h-4 w-4/5 bg-white/10" />
            </div>
            <ul
              role="list"
              class="mbs-4 grid gap-3 p-0 list-none"
            >
              {[1, 2, 3, 4].map((idx) => (
                <li class="flex items-start gap-3">
                  <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-orange-500/20 text-orange-400 font-mono text-xs font-bold">
                    0{idx}
                  </span>
                  <div class="flex-1">
                    <Skeleton class="h-4 w-4/5 bg-white/10" />
                  </div>
                </li>
              ))}
            </ul>
            <div class="mbs-4">
              <Skeleton class="h-3.5 w-44 bg-white/10" />
            </div>
          </div>
        </div>

        {/* Dashed CTA Card matching DetailsSidebar.astro */}
        <div class="rounded-2xl border border-dashed border-stone-200 bg-white p-6 shadow-2xs space-y-3">
          <Skeleton class="h-5 w-36" />
          <Skeleton class="h-4 w-full" />
          <ul
            role="list"
            class="m-0 mbs-4 grid list-none gap-3 p-0 font-mono text-xs text-stone-700"
          >
            {Array.from({ length: 3 }, () => (
              <li class="flex items-start gap-3">
                <span class="mbs-1 size-2 shrink-0 rounded-full bg-orange-600"></span>
                <Skeleton class="h-4 w-40" />
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  {/* Booking Form Skeleton matching BookingForm.vue & BookingSidebar.astro */}
  <section class="relative isolate border-bs border-stone-200 bg-stone-50 py-12 sm:py-16 lg:py-24">
    <div class="mx-auto px-2 sm:px-6 lg:px-8 inline-full max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <div class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-golden lg:gap-6 xl:gap-8">
        {/* Left: Booking Form Card */}
        <div class="inline-full">
          <div class="rounded-2xl border border-stone-200/90 bg-white p-6 shadow-2xs block-full sm:p-8">
            <div class="mbe-6 border-be border-stone-100 pbe-5 space-y-2">
              <Skeleton class="h-3.5 w-28" />
              <Skeleton class="h-7 w-56" />
            </div>

            <div class="flex flex-col gap-5">
              {/* Row 1: Name & Email */}
              <div class="grid gap-5 md:grid-cols-2">
                <div class="space-y-1.5">
                  <Skeleton class="h-3.5 w-20" />
                  <Skeleton class="h-12 w-full rounded-xl" />
                </div>
                <div class="space-y-1.5">
                  <Skeleton class="h-3.5 w-16" />
                  <Skeleton class="h-12 w-full rounded-xl" />
                </div>
              </div>

              {/* Row 2: Phone */}
              <div class="space-y-1.5">
                <Skeleton class="h-3.5 w-24" />
                <Skeleton class="h-12 w-full rounded-xl" />
              </div>

              {/* Row 3: Persons & Date */}
              <div class="grid gap-5 md:grid-cols-2">
                <div class="space-y-1.5">
                  <Skeleton class="h-3.5 w-28" />
                  <Skeleton class="h-12 w-full rounded-xl" />
                </div>
                <div class="space-y-1.5">
                  <Skeleton class="h-3.5 w-28" />
                  <Skeleton class="h-12 w-full rounded-xl" />
                </div>
              </div>

              {/* Row 4: Message */}
              <div class="space-y-1.5">
                <Skeleton class="h-3.5 w-20" />
                <Skeleton class="h-40 min-block-40 w-full rounded-xl" />
              </div>

              {/* Bottom: Captcha + Submit button */}
              <div class="flex flex-col gap-4 pbs-2 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex justify-center sm:justify-start">
                  <Skeleton class="h-16 w-64 rounded-xl" />
                </div>
                <ButtonSkeleton
                  size="md"
                  variant="card"
                  class="w-48"
                />
              </div>
            </div>
          </div>
        </div>

        {/* Right: Booking Summary / Guarantee Card matching BookingSidebar.astro */}
        <div class="inline-full lg:block-full">
          <aside class="group relative flex flex-col justify-between rounded-2xl border border-slate-900 bg-slate-950 p-6 text-white shadow-xl block-full sm:p-8">
            <div class="flex h-full flex-col justify-between">
              <div class="space-y-4 sm:space-y-6">
                <hgroup class="flex flex-col items-center gap-2 sm:gap-2.5 text-center">
                  <Skeleton class="h-3.5 w-36 bg-white/20" />
                  <Skeleton class="h-8 w-56 bg-white/20" />
                  <div class="inline-flex size-24 sm:size-28 lg:size-32 items-center justify-center rounded-full border border-slate-800 bg-slate-900/60 p-3 sm:p-4">
                    <Skeleton class="size-16 rounded-full bg-white/10" />
                  </div>
                </hgroup>

                <div class="mx-auto flex w-fit items-center gap-3 rounded-xl border border-slate-800 bg-slate-900/60 px-4 py-2.5 sm:py-3 shadow-xs">
                  <div class="font-mono text-2xl leading-none font-extrabold text-amber-300 tabular-nums">
                    5.0
                  </div>
                  <div class="space-y-1">
                    <Skeleton class="h-3 w-24 bg-white/10" />
                    <Skeleton class="h-3 w-20 bg-amber-200/20" />
                  </div>
                </div>

                <div class="space-y-2">
                  <Skeleton class="h-3.5 w-full bg-white/10" />
                  <Skeleton class="h-3.5 w-4/5 bg-white/10" />
                </div>

                <ul class="space-y-3 sm:space-y-4 font-sans text-sm m-0 p-0 list-none">
                  {Array.from({ length: 3 }, () => (
                    <li class="flex items-center gap-3">
                      <span class="size-2 rounded-full bg-orange-400 shrink-0"></span>
                      <Skeleton class="h-4 w-44 bg-white/10" />
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </section>
</div>
