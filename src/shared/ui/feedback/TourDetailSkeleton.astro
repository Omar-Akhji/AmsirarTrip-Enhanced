---
import AsciiSkeleton from "@/shared/ui/feedback/AsciiSkeleton.astro";
import ButtonSkeleton from "@/shared/ui/feedback/ButtonSkeleton.astro";
import FaqSkeleton from "@/shared/ui/feedback/FaqSkeleton.astro";
import PageHeaderSkeleton from "@/shared/ui/feedback/PageHeaderSkeleton.astro";

interface Props {
  crumbWidths?: string[] | undefined;
  class?: string | undefined;
}

const { crumbWidths = ["w-12", "w-14", "w-52"], class: className } = Astro.props;
---

<div
  aria-busy="true"
  aria-label="Loading tour details"
  class:list={["size-full bg-white text-stone-900", className]}
>
  <PageHeaderSkeleton
    crumbWidths={crumbWidths}
    hasButtons={false}
    hasUnderline={true}
  />

  {/* Trip Content Section matching TripLayout.astro */}
  <section class="py-12 sm:py-16 lg:py-24">
    <div class="mx-auto grid gap-4 sm:gap-6 lg:gap-8 px-2 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420 lg:grid-cols-golden">
      {/* Left Column: Dossier Article */}
      <article class="rounded-2xl bg-white p-4 pbe-8 shadow-xs ring-1 ring-zinc-100 xs:p-5 sm:p-6 sm:pbe-12 2xl:p-8 space-y-8">
        {/* Featured Image with rich ASCII dither matching TripLayout.astro golden ratio */}
        <figure class="relative mbe-8 aspect-golden overflow-hidden rounded-xl border border-zinc-100 shadow-md inline-full bg-stone-100 dark:bg-stone-800">
          <AsciiSkeleton
            class="ars-image size-full text-stone-400"
            rows={48}
            variant="dither"
          />
        </figure>

        {/* Dossier Header */}
        <div class="mbe-8 sm:mbe-12 block border-b border-stone-200 pb-6 sm:pb-8 text-start">
          <h2 class="text-2xl sm:text-3xl lg:text-4xl 2xl:text-[2.625rem] font-bold tracking-tight text-stone-900 leading-[1.15] text-balance">
            <AsciiSkeleton
              class="text-stone-900 font-bold"
              lines={1}
              variant="dither"
              widths={["85%"]}
            />
          </h2>
        </div>

        {/* Quick Specs 4-card Grid matching TourSeoSections.astro */}
        <dl class="m-0 p-0 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
          {[
            { label: "DURATION", value: "3 Days" },
            { label: "STARTING", value: "Marrakech" },
            { label: "ENDING", value: "Fes" },
            { label: "TOUR TYPE", value: "Private & Shared" },
          ].map(() => (
            <div class="flex items-center gap-4 rounded-2xl border border-stone-200/90 bg-white px-5 py-3 shadow-2xs min-block-20">
              <span class="size-5 shrink-0 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center font-bold text-xs">
                •
              </span>
              <div class="text-start min-w-0 flex-1">
                <dt class="font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase">
                  <AsciiSkeleton
                    class="text-stone-500 font-mono text-[11px]"
                    lines={1}
                    variant="dither"
                    widths={["4rem"]}
                  />
                </dt>
                <dd class="m-0 font-mono text-sm sm:text-base font-bold text-stone-900 truncate">
                  <AsciiSkeleton
                    class="text-stone-900 font-mono font-bold text-sm"
                    lines={1}
                    variant="dither"
                    widths={["5.5rem"]}
                  />
                </dd>
              </div>
            </div>
          ))}
        </dl>

        {/* Highlights Section matching HighlightsList.astro */}
        <section class="mbs-8">
          <hgroup class="mbe-4">
            <AsciiSkeleton
              class="font-sans text-xs font-bold tracking-wider text-orange-700 uppercase"
              lines={1}
              variant="dither"
              widths={["8rem"]}
            />
            <div class="mbs-1">
              <h3 class="text-xl font-bold tracking-tight text-stone-900 sm:text-2xl md:text-3xl">
                <AsciiSkeleton
                  class="text-stone-900 font-bold"
                  lines={1}
                  variant="dither"
                  widths={["14rem"]}
                />
              </h3>
            </div>
          </hgroup>
          <div class="rounded-2xl border border-stone-200/90 bg-white p-5 sm:p-6 shadow-2xs">
            <ul class="m-0 p-0 list-none grid gap-x-6 gap-y-3.5 sm:grid-cols-2">
              {Array.from({ length: 4 }, () => (
                <li class="flex items-start gap-3">
                  <span class="mbs-0.5 size-5 shrink-0 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center font-bold text-xs">
                    ✓
                  </span>
                  <div class="flex-1">
                    <AsciiSkeleton
                      class="text-sm text-stone-800"
                      lines={1}
                      variant="dither"
                      widths={["90%"]}
                    />
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </section>

        {/* Route Overview Section */}
        <section class="mbs-8">
          <hgroup class="mbe-4">
            <AsciiSkeleton
              class="font-sans text-xs font-bold tracking-wider text-orange-700 uppercase"
              lines={1}
              variant="dither"
              widths={["8.5rem"]}
            />
            <div class="mbs-1">
              <h3 class="text-xl font-bold tracking-tight text-stone-900 sm:text-2xl md:text-3xl">
                <AsciiSkeleton
                  class="text-stone-900 font-bold"
                  lines={1}
                  variant="dither"
                  widths={["15rem"]}
                />
              </h3>
            </div>
          </hgroup>
          <div class="space-y-2">
            <AsciiSkeleton
              class="text-stone-700 text-sm sm:text-base leading-relaxed"
              lines={3}
              variant="dither"
              widths={["100%", "96%", "75%"]}
            />
          </div>
        </section>

        {/* Itinerary Timeline matching TourItinerary.astro */}
        <section class="mbs-8 space-y-4">
          <header class="ms-6 sm:ms-8 w-[calc(100%-1.5rem)] sm:w-[calc(100%-2rem)] bg-white/95 backdrop-blur-md pt-2 pb-4 border-b border-stone-200/80 mbe-8">
            <div class="space-y-3">
              <hgroup class="space-y-1">
                <AsciiSkeleton
                  class="font-sans text-xs font-bold tracking-wider text-orange-700 uppercase"
                  lines={1}
                  variant="dither"
                  widths={["7.5rem"]}
                />
                <h3 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-stone-950">
                  <AsciiSkeleton
                    class="text-stone-950 font-black"
                    lines={1}
                    variant="dither"
                    widths={["12rem"]}
                  />
                </h3>
              </hgroup>
              <div class="min-h-7 flex items-center justify-between">
                <div class="inline-flex items-center rounded-full border border-stone-200/90 bg-white px-3.5 py-1">
                  <AsciiSkeleton
                    class="text-stone-700 font-mono text-xs"
                    lines={1}
                    variant="dither"
                    widths={["14rem"]}
                  />
                </div>
                <div class="flex items-center gap-3">
                  <AsciiSkeleton
                    class="font-mono text-xs font-bold text-stone-500"
                    lines={1}
                    variant="dither"
                    widths={["3.5rem"]}
                  />
                  <div class="w-24 sm:w-36 h-1.5 bg-stone-200/80 rounded-full overflow-hidden">
                    <div class="h-full w-1/3 bg-orange-600"></div>
                  </div>
                </div>
              </div>
            </div>
          </header>

          {/* Timeline Nodes */}
          <div class="relative w-full pl-6 sm:pl-8 space-y-8">
            <div class="absolute left-0 top-0 bottom-8 w-0.5 bg-stone-200"></div>
            {Array.from({ length: 3 }, () => (
              <div class="relative space-y-2">
                <div class="absolute -left-6 sm:-left-8 top-1.5 size-3 -translate-x-1/2 rounded-full bg-orange-600 ring-4 ring-orange-100"></div>
                <div class="flex items-start gap-3">
                  <span class="mbs-2 size-1.5 shrink-0 rounded-full bg-orange-600"></span>
                  <div class="flex-1 space-y-1.5">
                    <AsciiSkeleton
                      class="text-stone-700 text-sm sm:text-base leading-relaxed"
                      lines={2}
                      variant="dither"
                      widths={["100%", "85%"]}
                    />
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        {/* TripInfoSections (Included & Excluded) matching TripInfoSections.astro */}
        <section class="mbs-8">
          <hgroup class="mbe-4">
            <AsciiSkeleton
              class="font-sans text-xs font-bold tracking-wider text-orange-700 uppercase"
              lines={1}
              variant="dither"
              widths={["9rem"]}
            />
            <div class="mbs-1">
              <h3 class="text-xl font-bold tracking-tight text-stone-900 sm:text-2xl md:text-3xl">
                <AsciiSkeleton
                  class="text-stone-900 font-bold"
                  lines={1}
                  variant="dither"
                  widths={["15rem"]}
                />
              </h3>
            </div>
          </hgroup>
          <div class="rounded-2xl border border-emerald-500/20 bg-emerald-50/30 p-6 shadow-2xs">
            <ul class="space-y-3 m-0 p-0 list-none">
              {Array.from({ length: 4 }, () => (
                <li class="flex items-start gap-3">
                  <span class="mbs-0.5 size-5 shrink-0 rounded-full bg-emerald-600/15 text-emerald-700 flex items-center justify-center font-bold text-xs">
                    ✓
                  </span>
                  <AsciiSkeleton
                    class="text-sm text-stone-800"
                    lines={1}
                    variant="dither"
                    widths={["80%"]}
                  />
                </li>
              ))}
            </ul>
          </div>
        </section>

        {/* PricingCard matching PricingCard.astro */}
        <section class="rounded-2xl border border-stone-200/90 bg-stone-50/80 p-6 sm:p-8 shadow-xs">
          <div class="space-y-6">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
              <div class="space-y-1">
                <AsciiSkeleton
                  class="font-sans text-xs font-bold tracking-wider text-orange-700 uppercase"
                  lines={1}
                  variant="dither"
                  widths={["10rem"]}
                />
                <h3 class="text-xl font-bold tracking-tight text-stone-900 sm:text-2xl">
                  <AsciiSkeleton
                    class="text-stone-900 font-bold"
                    lines={1}
                    variant="dither"
                    widths={["14rem"]}
                  />
                </h3>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="rounded-xl border border-stone-200/80 bg-white p-4">
                <AsciiSkeleton
                  class="font-mono text-xs uppercase text-orange-600 font-bold"
                  lines={1}
                  variant="dither"
                  widths={["5rem"]}
                />
                <div class="mbs-1">
                  <AsciiSkeleton
                    class="text-base font-bold text-stone-900"
                    lines={1}
                    variant="dither"
                    widths={["7rem"]}
                  />
                </div>
              </div>
              <div class="rounded-xl border border-stone-200/80 bg-white p-4">
                <AsciiSkeleton
                  class="font-mono text-xs uppercase text-stone-500 font-bold"
                  lines={1}
                  variant="dither"
                  widths={["5rem"]}
                />
                <div class="mbs-1">
                  <AsciiSkeleton
                    class="text-base font-bold text-stone-900"
                    lines={1}
                    variant="dither"
                    widths={["7rem"]}
                  />
                </div>
              </div>
            </div>
          </div>
        </section>

        {/* FAQ Section */}
        <FaqSkeleton
          categoryWidth="7rem"
          count={4}
          headingWidth="16rem"
          isListing={false}
          questionWidths={["92%", "88%", "82%", "70%"]}
        />
      </article>

      {/* Right Column: DetailsSidebar */}
      <aside class="space-y-6 self-start lg:sticky lg:top-24">
        {/* Brand Card: Dark Luxury Container matching DetailsSidebar.astro */}
        <div class="overflow-hidden rounded-2xl bg-slate-950 text-white shadow-xl">
          <div class="p-6 sm:p-8">
            <hgroup class="text-center">
              <AsciiSkeleton
                class="font-mono text-xs font-semibold tracking-[0.16em] text-orange-400 uppercase text-center mx-auto"
                lines={1}
                variant="dither"
                widths={["7rem"]}
              />
              <div class="mbs-2">
                <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-white text-center">
                  <AsciiSkeleton
                    class="text-white text-center mx-auto"
                    lines={1}
                    variant="dither"
                    widths={["12rem"]}
                  />
                </h3>
              </div>
            </hgroup>
            <div
              aria-hidden="true"
              class="my-4 border-t border-slate-800"
            ></div>
            <div class="space-y-2">
              <AsciiSkeleton
                class="font-mono text-xs sm:text-sm text-slate-300"
                lines={2}
                variant="dither"
                widths={["100%", "85%"]}
              />
            </div>
            <ul
              role="list"
              class="mbs-4 grid gap-3 p-0 list-none"
            >
              {Array.from({ length: 4 }, (_, idx) => (
                <li class="flex items-start gap-3">
                  <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-orange-500/20 text-orange-400 font-mono text-xs font-bold">
                    0{idx + 1}
                  </span>
                  <div class="flex-1">
                    <AsciiSkeleton
                      class="font-mono text-xs sm:text-sm text-slate-200"
                      lines={1}
                      variant="dither"
                      widths={["85%"]}
                    />
                  </div>
                </li>
              ))}
            </ul>
            <div class="mbs-4">
              <AsciiSkeleton
                class="font-mono text-xs text-slate-400"
                lines={1}
                variant="dither"
                widths={["11rem"]}
              />
            </div>
          </div>
        </div>

        {/* Dashed CTA Card matching DetailsSidebar.astro */}
        <div class="rounded-2xl border border-dashed border-stone-200 bg-white p-6 shadow-2xs">
          <h3 class="text-base font-bold text-stone-900 tracking-tight">
            <AsciiSkeleton
              class="text-stone-900 font-bold"
              lines={1}
              variant="dither"
              widths={["9rem"]}
            />
          </h3>
          <div class="mbs-2">
            <AsciiSkeleton
              class="font-mono text-xs text-stone-600 leading-relaxed"
              lines={1}
              variant="dither"
              widths={["100%"]}
            />
          </div>
          <ul
            role="list"
            class="m-0 mbs-4 grid list-none gap-3 p-0 font-mono text-xs text-stone-700"
          >
            {Array.from({ length: 3 }, () => (
              <li class="flex items-start gap-3">
                <span class="mbs-1 size-2 shrink-0 rounded-full bg-orange-600"></span>
                <AsciiSkeleton
                  class="text-stone-700 font-mono text-xs"
                  lines={1}
                  variant="dither"
                  widths={["10rem"]}
                />
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  {/* Booking Form Skeleton matching BookingForm.vue & BookingSidebar.astro */}
  <section class="relative isolate border-bs border-stone-200 bg-stone-50 py-12 sm:py-16 lg:py-24">
    <div class="mx-auto px-2 sm:px-6 lg:px-8 inline-full max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <div class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-golden lg:gap-6 xl:gap-8">
        {/* Left: Booking Form Card */}
        <div class="inline-full">
          <div class="rounded-2xl border border-stone-200/90 bg-white p-6 shadow-2xs block-full sm:p-8">
            <div class="mbe-6 border-be border-stone-100 pbe-5">
              <span class="font-mono text-xs font-semibold tracking-[0.14em] text-orange-600 uppercase">
                <AsciiSkeleton
                  class="text-orange-600 font-mono text-xs uppercase"
                  lines={1}
                  variant="dither"
                  widths={["7rem"]}
                />
              </span>
              <h3 class="mbs-1 text-xl font-bold tracking-tight text-stone-900 sm:text-2xl">
                <AsciiSkeleton
                  class="text-stone-900 font-bold"
                  lines={1}
                  variant="dither"
                  widths={["14rem"]}
                />
              </h3>
            </div>

            <div class="flex flex-col gap-5">
              {/* Row 1: Name & Email */}
              <div class="grid gap-5 md:grid-cols-2">
                <div>
                  <div class="mbe-1.5">
                    <AsciiSkeleton
                      class="font-sans text-xs font-semibold text-stone-700"
                      lines={1}
                      variant="dither"
                      widths={["5.5rem"]}
                    />
                  </div>
                  <AsciiSkeleton
                    class="h-12 w-full rounded-xl border border-stone-200/90 bg-stone-50/50 text-stone-400 select-none"
                    rows={3}
                    variant="dither"
                  />
                </div>
                <div>
                  <div class="mbe-1.5">
                    <AsciiSkeleton
                      class="font-sans text-xs font-semibold text-stone-700"
                      lines={1}
                      variant="dither"
                      widths={["4rem"]}
                    />
                  </div>
                  <AsciiSkeleton
                    class="h-12 w-full rounded-xl border border-stone-200/90 bg-stone-50/50 text-stone-400 select-none"
                    rows={3}
                    variant="dither"
                  />
                </div>
              </div>

              {/* Row 2: Phone */}
              <div>
                <div class="mbe-1.5">
                  <AsciiSkeleton
                    class="font-sans text-xs font-semibold text-stone-700"
                    lines={1}
                    variant="dither"
                    widths={["6.5rem"]}
                  />
                </div>
                <AsciiSkeleton
                  class="h-12 w-full rounded-xl border border-stone-200/90 bg-stone-50/50 text-stone-400 select-none"
                  rows={3}
                  variant="dither"
                />
              </div>

              {/* Row 3: Persons & Date */}
              <div class="grid gap-5 md:grid-cols-2">
                <div>
                  <div class="mbe-1.5">
                    <AsciiSkeleton
                      class="font-sans text-xs font-semibold text-stone-700"
                      lines={1}
                      variant="dither"
                      widths={["8rem"]}
                    />
                  </div>
                  <AsciiSkeleton
                    class="h-12 w-full rounded-xl border border-stone-200/90 bg-stone-50/50 text-stone-400 select-none"
                    rows={3}
                    variant="dither"
                  />
                </div>
                <div>
                  <div class="mbe-1.5">
                    <AsciiSkeleton
                      class="font-sans text-xs font-semibold text-stone-700"
                      lines={1}
                      variant="dither"
                      widths={["8rem"]}
                    />
                  </div>
                  <AsciiSkeleton
                    class="h-12 w-full rounded-xl border border-stone-200/90 bg-stone-50/50 text-stone-400 select-none"
                    rows={3}
                    variant="dither"
                  />
                </div>
              </div>

              {/* Row 4: Message */}
              <div>
                <div class="mbe-1.5">
                  <AsciiSkeleton
                    class="font-sans text-xs font-semibold text-stone-700"
                    lines={1}
                    variant="dither"
                    widths={["5rem"]}
                  />
                </div>
                <AsciiSkeleton
                  class="h-40 min-block-40 w-full rounded-xl border border-stone-200/90 bg-stone-50/50 text-stone-400 select-none"
                  rows={10}
                  variant="dither"
                />
              </div>

              {/* Bottom: Captcha + Submit button */}
              <div class="flex flex-col gap-4 pbs-2 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex justify-center sm:justify-start">
                  <div class="w-fit origin-center scale-85 rounded-xl border border-dashed border-stone-200 p-2 sm:scale-100">
                    <AsciiSkeleton
                      class="h-19.5 w-76 rounded-lg border border-stone-200/80 bg-stone-50/60 text-stone-400 select-none overflow-hidden"
                      rows={5}
                      variant="dither"
                    />
                  </div>
                </div>
                <ButtonSkeleton
                  size="md"
                  variant="card"
                  class="w-48"
                />
              </div>
            </div>
          </div>
        </div>

        {/* Right: Booking Summary / Guarantee Card matching BookingSidebar.astro */}
        <div class="inline-full lg:block-full">
          <aside class="group relative flex flex-col justify-between rounded-2xl border border-slate-900 bg-slate-950 p-6 text-white shadow-xl block-full sm:p-8">
            <div class="flex h-full flex-col justify-between">
              <div class="space-y-4 sm:space-y-6">
                <hgroup class="flex flex-col items-center gap-2 sm:gap-2.5 text-center">
                  <AsciiSkeleton
                    class="font-mono text-xs font-semibold tracking-[0.16em] uppercase text-orange-400 text-center mx-auto"
                    lines={1}
                    variant="dither"
                    widths={["9rem"]}
                  />
                  <div class="mbs-1">
                    <h3 class="font-sans text-2xl font-semibold tracking-tight sm:text-3xl text-white text-center">
                      <AsciiSkeleton
                        class="text-white text-center mx-auto"
                        lines={1}
                        variant="dither"
                        widths={["14rem"]}
                      />
                    </h3>
                  </div>
                  <div class="inline-flex size-24 sm:size-28 lg:size-32 items-center justify-center rounded-full border border-slate-800 bg-slate-900/60 p-3 sm:p-4">
                    <AsciiSkeleton
                      circle
                      width={64}
                      height={64}
                      rows={4}
                      variant="dither"
                      class="text-stone-400"
                    />
                  </div>
                </hgroup>

                <div class="mx-auto flex w-fit items-center gap-3 rounded-xl border border-slate-800 bg-slate-900/60 px-4 py-2.5 sm:py-3 shadow-xs">
                  <div class="font-mono text-2xl leading-none font-extrabold text-amber-300 tabular-nums">
                    5.0
                  </div>
                  <div class="space-y-1">
                    <AsciiSkeleton
                      class="text-xs text-slate-300"
                      lines={1}
                      variant="dither"
                      widths={["6rem"]}
                    />
                    <AsciiSkeleton
                      class="text-xs text-amber-200"
                      lines={1}
                      variant="dither"
                      widths={["5rem"]}
                    />
                  </div>
                </div>

                <div class="space-y-1">
                  <AsciiSkeleton
                    class="text-xs sm:text-sm text-slate-300 leading-relaxed"
                    lines={2}
                    variant="dither"
                    widths={["100%", "85%"]}
                  />
                </div>

                <ul class="space-y-3 sm:space-y-4 font-sans text-sm m-0 p-0 list-none">
                  {Array.from({ length: 3 }, () => (
                    <li class="flex items-center gap-3">
                      <span class="size-2 rounded-full bg-orange-400 shrink-0"></span>
                      <AsciiSkeleton
                        class="text-slate-200 text-sm"
                        lines={1}
                        variant="dither"
                        widths={["85%"]}
                      />
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </section>
</div>
