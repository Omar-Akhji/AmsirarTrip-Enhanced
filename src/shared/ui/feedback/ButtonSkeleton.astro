---
import { Skeleton } from "@/components/ui/skeleton";
import type { ButtonSize, ButtonVariant } from "../primitives/button-variants";

interface Props {
  size?: ButtonSize | undefined;
  variant?: ButtonVariant | undefined;
  class?: string | undefined;
  width?: string | number | undefined;
  rows?: number | undefined;
  seed?: number | undefined;
}

const { size = "md", variant = "primary", class: className, width } = Astro.props;

const sizeHeights: Record<ButtonSize, string> = { sm: "h-9", md: "h-11", lg: "h-13" };

const variantClasses: Record<ButtonVariant, string> = {
  primary: "bg-stone-300/80 dark:bg-stone-700/80",
  secondary: "bg-stone-200/80 dark:bg-stone-800/80",
  outline: "border border-stone-300 bg-stone-100/60 dark:border-stone-800 dark:bg-stone-900/60",
  ghost: "bg-stone-200/50 dark:bg-stone-800/50",
  tripadvisor: "bg-stone-300/80 dark:bg-stone-700/80",
  whatsapp: "bg-stone-300/80 dark:bg-stone-700/80",
  danger: "bg-stone-300/80 dark:bg-stone-700/80",
  card: "w-full bg-stone-300/80 dark:bg-stone-700/80",
};

const widthStyle =
  width ?
    typeof width === "number" ?
      `width: ${width}px;`
    : `width: ${width};`
  : undefined;
---

<Skeleton
  class:list={[
    "inline-flex items-center justify-center rounded-full",
    sizeHeights[size],
    variantClasses[variant],
    className,
  ]}
  style={widthStyle}
/>
