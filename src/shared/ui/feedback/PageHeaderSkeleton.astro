---
import { Skeleton } from "@/components/ui/skeleton";
import BreadcrumbSkeleton from "./BreadcrumbSkeleton.astro";
import ButtonSkeleton from "./ButtonSkeleton.astro";

interface Props {
  hasBreadcrumbs?: boolean | undefined;
  hasButtons?: boolean | undefined;
  hasUnderline?: boolean | undefined;
  crumbWidths?: string[] | undefined;
  titleWidth?: string | undefined;
  class?: string | undefined;
}

const {
  hasBreadcrumbs = true,
  hasButtons = false,
  hasUnderline = true,
  crumbWidths = ["w-12", "w-20"],
  titleWidth = "w-3/5 max-w-xs sm:w-1/2 sm:max-w-sm lg:w-1/3 lg:max-w-sm",
  class: className,
} = Astro.props;
---

<section
  aria-busy="true"
  aria-label="Loading page header"
  class:list={[
    "relative isolate flex flex-col justify-center overflow-hidden bg-zinc-950 pbs-20 pbe-10 xs:pbs-24 xs:pbe-12 sm:pbs-28 sm:pbe-16 lg:pbs-32 lg:pbe-20 2xl:pbs-36 2xl:pbe-24 text-center text-white shadow-xl inline-full min-h-[48dvh] sm:min-h-[52dvh] lg:min-h-[56dvh] max-h-150 3xl:max-h-175 print:hidden",
    className,
  ]}
>
  {/* Dark Hero Background */}
  <div class="absolute inset-0 -z-30 size-full overflow-hidden bg-zinc-950">
    <Skeleton class="size-full rounded-none bg-zinc-900/60" />
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.06),transparent_65%)]"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-linear-to-b from-black/40 via-black/20 to-black/45"
  ></div>

  <div class="relative z-20 mx-auto my-auto flex flex-col items-center justify-center px-4 text-center inline-full max-inline-7xl">
    <div class="w-full max-w-4xl space-y-6 text-center">
      {hasBreadcrumbs && (
        <BreadcrumbSkeleton
          class="mbe-6 sm:mbe-8"
          crumbWidths={crumbWidths}
        />
      )}

      <hgroup class="space-y-4 sm:space-y-5">
        {!hasBreadcrumbs && (
          <div class="flex items-center justify-center gap-4">
            <span class="bg-white/20 block-px inline-8"></span>
            <Skeleton class="h-4 w-32 bg-white/20" />
            <span class="bg-white/20 block-px inline-8"></span>
          </div>
        )}

        {/* Title matching PageHeader text-3xl sm:text-4xl lg:text-5xl */}
        <div class:list={["mx-auto text-center", titleWidth]}>
          <Skeleton class="h-10 sm:h-12 w-full mx-auto bg-white/20" />
        </div>

        {hasUnderline && (
          <div class="mx-auto mt-3 block-1 inline-20 rounded-none bg-white/30"></div>
        )}

        {/* Subtitle matching PageHeader single max-w-[62ch] paragraph — centered broken line */}
        <div class="mx-auto max-w-[62ch] space-y-2 flex flex-col items-center">
          <Skeleton class="h-4 w-full bg-white/15" />
          <Skeleton class="h-4 w-3/4 bg-white/15" />
        </div>
      </hgroup>

      {/* Action Buttons — using matching ButtonSkeleton */}
      {hasButtons && (
        <div class="flex flex-wrap items-center justify-center gap-4 pbs-2">
          <ButtonSkeleton
            size="md"
            variant="primary"
            class="w-36"
          />
          <ButtonSkeleton
            size="md"
            variant="secondary"
            class="w-44"
          />
        </div>
      )}
    </div>
  </div>
</section>
