---
import { Skeleton } from "@/components/ui/skeleton";
import PageHeaderSkeleton from "./PageHeaderSkeleton.astro";

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<div
  class:list={["about-skeleton", className]}
  aria-busy="true"
  aria-label="Loading About Us"
>
  <PageHeaderSkeleton
    crumbWidths={["w-12", "w-18"]}
    hasButtons={false}
    hasUnderline={true}
  />

  <div class="bg-white">
    {/* HERITAGE & MISSION: OUR STORY */}
    <section
      aria-label="Loading our story"
      class="relative isolate overflow-hidden py-12 sm:py-16 lg:py-24 text-stone-900"
    >
      <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
        {/* Section Header */}
        <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200/80 pb-6 sm:pb-8">
          <div class="max-w-2xl space-y-3">
            <Skeleton class="h-9 w-52" />
            <div class="border-s-2 border-stone-300 ps-4 py-0.5 max-w-[62ch] space-y-2">
              <Skeleton class="h-4 w-full" />
              <Skeleton class="h-4 w-3/4" />
            </div>
          </div>
        </div>

        {/* 2-Column Content Grid */}
        <div class="grid items-start gap-10 sm:gap-12 lg:grid-cols-golden lg:gap-6 xl:gap-8">
          {/* Left Column: 3 Images Collage */}
          <div class="order-1 lg:order-1">
            <div class="flex flex-col gap-3.5 sm:gap-4.5">
              {/* Top Landscape Image */}
              <div class="relative aspect-golden overflow-hidden rounded-2xl border border-stone-200/80 bg-stone-100 shadow-xs">
                <Skeleton class="size-full rounded-2xl" />
              </div>

              {/* Bottom Row: 2 Images Side-by-Side */}
              <div class="grid grid-cols-2 gap-gap-tight">
                <div class="relative aspect-golden-portrait overflow-hidden rounded-2xl border border-stone-200/80 bg-stone-100 shadow-xs">
                  <Skeleton class="size-full rounded-2xl" />
                </div>
                <div class="relative aspect-golden-portrait overflow-hidden rounded-2xl border border-stone-200/80 bg-stone-100 shadow-xs">
                  <Skeleton class="size-full rounded-2xl" />
                </div>
              </div>
            </div>
          </div>

          {/* Right Column: Editorial Narrative & Quote */}
          <div class="order-2 lg:order-2">
            <div class="inline-full">
              <article class="flex flex-col gap-6 sm:gap-8">
                {/* 3 Lead & Narrative Story Paragraphs */}
                <div class="flex flex-col gap-3.5 sm:gap-4.5">
                  <div class="space-y-2">
                    <Skeleton class="h-4 w-full" />
                    <Skeleton class="h-4 w-11/12" />
                    <Skeleton class="h-4 w-4/5" />
                  </div>
                  <div class="space-y-2">
                    <Skeleton class="h-4 w-full" />
                    <Skeleton class="h-4 w-11/12" />
                    <Skeleton class="h-4 w-3/4" />
                  </div>
                  <div class="space-y-2">
                    <Skeleton class="h-4 w-full" />
                    <Skeleton class="h-4 w-full" />
                    <Skeleton class="h-4 w-2/3" />
                  </div>
                </div>

                {/* Archival Editorial Quote Card */}
                <figure class="relative overflow-hidden rounded-2xl border border-stone-200/90 bg-stone-50/70 p-5 sm:p-6 shadow-2xs">
                  <div
                    aria-hidden="true"
                    class="pointer-events-none absolute top-4 right-4 sm:top-5 sm:right-5 size-5 sm:size-6 rounded-full bg-stone-200/80"
                  ></div>
                  <div class="pe-8 space-y-2">
                    <Skeleton class="h-5 w-full" />
                    <Skeleton class="h-5 w-3/4" />
                  </div>
                  <div class="mbs-3 flex items-center gap-2">
                    <span
                      class="size-1.5 rounded-full bg-stone-400"
                      aria-hidden="true"
                    ></span>
                    <Skeleton class="h-3.5 w-44" />
                  </div>
                </figure>
              </article>
            </div>
          </div>
        </div>

        {/* Core Pillars of Trust Expanded Across Full Width Below Image & Story */}
        <div class="mbs-[clamp(2.5rem,2rem+2vw,4rem)] border-t border-stone-200/80 pt-[clamp(2rem,1.5rem+1.5vw,3rem)]">
          <div class="mbe-[clamp(1.25rem,1rem+0.75vw,1.75rem)] max-w-2xl">
            <Skeleton class="h-6 w-80" />
          </div>
          <ul
            role="list"
            class="m-0 p-0 list-none grid grid-cols-1 xs:grid-cols-2 lg:grid-cols-4 gap-[clamp(1rem,0.8rem+0.5vw,1.5rem)] 2xl:gap-6"
          >
            {[1, 2, 3, 4].map((index) => (
              <li class="flex flex-col items-start gap-3 rounded-2xl border border-stone-200/80 bg-stone-50/60 p-[clamp(1.125rem,0.95rem+0.6vw,1.5rem)] shadow-2xs">
                <span class="inline-flex size-7 items-center justify-center rounded-lg bg-stone-200/80 font-mono text-xs font-bold text-stone-600 tabular-nums shrink-0">
                  0{index}
                </span>
                <div class="space-y-2 w-full">
                  <Skeleton class="h-3.5 w-full" />
                  <Skeleton class="h-3.5 w-11/12" />
                  <Skeleton class="h-3.5 w-4/5" />
                  <Skeleton class="h-3.5 w-3/5" />
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* EXPEDITION METRICS: OUR JOURNEY IN NUMBERS */}
    <section class="relative isolate overflow-hidden border-t border-stone-200/90 bg-stone-50/60 py-12 sm:py-16 lg:py-24 text-stone-900">
      <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
        <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8">
          <div class="max-w-2xl space-y-3">
            <Skeleton class="h-9 w-72" />
            <div class="border-s-2 border-stone-300 ps-4 py-0.5 max-w-[62ch]">
              <Skeleton class="h-4 w-full" />
            </div>
          </div>
        </div>

        <div class="mbs-16 grid gap-6 xs:grid-cols-2 sm:gap-8 lg:grid-cols-4 2xl:gap-10">
          {[
            { valueWidth: "w-28", labelWidth: "w-48" },
            { valueWidth: "w-20", labelWidth: "w-44" },
            { valueWidth: "w-16", labelWidth: "w-40" },
            { valueWidth: "w-20", labelWidth: "w-44" },
          ].map((card) => (
            <div class="flex size-full">
              <article class="flex size-full flex-col items-center justify-between overflow-hidden rounded-2xl border border-slate-900 bg-slate-950 px-8 py-10 text-center shadow-xl">
                <div class="flex flex-col items-center gap-y-6 w-full">
                  <figure class="relative inline-flex size-24 shrink-0 items-center justify-center overflow-hidden rounded-full border-2 border-white/20 bg-white/5 p-3">
                    <Skeleton class="size-16 rounded-full bg-white/10" />
                  </figure>
                  <div class="flex justify-center w-full">
                    <Skeleton class:list={["h-10 bg-white/20", card.valueWidth]} />
                  </div>
                  <div class="flex justify-center w-full">
                    <Skeleton class:list={["h-4 bg-white/10", card.labelWidth]} />
                  </div>
                </div>
              </article>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</div>
