---
import AsciiSkeleton from "./AsciiSkeleton.astro";
import ButtonSkeleton from "./ButtonSkeleton.astro";

interface Props {
  class?: string | undefined;
  hasItinerary?: boolean | undefined;
  hasBadge?: boolean | undefined;
}

const { class: className, hasItinerary = true, hasBadge = true } = Astro.props;
---

<article
  aria-busy="true"
  aria-label="Loading trip card"
  class:list={[
    "group relative flex flex-col justify-between overflow-hidden rounded-[2.5rem] border border-stone-200/90 bg-white p-4 shadow-[0_20px_40px_-14px_rgba(0,0,0,0.12)] size-full dark:border-stone-800 dark:bg-stone-900/95",
    className,
  ]}
>
  {/* Image thumbnail decoding through ASCII dither mesh matching TripCard.astro */}
  <div class="relative aspect-golden w-full shrink-0 overflow-hidden rounded-3xl bg-stone-100 dark:bg-stone-800">
    <AsciiSkeleton
      class="ars-image size-full text-stone-400"
      rows={30}
      variant="dither"
    />
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-linear-to-t from-slate-950/70 via-transparent to-transparent opacity-60"
    ></div>

    {/* Inverted Scoop Category Badge at Top-Left matching TripCard.astro */}
    {hasBadge && (
      <div class="absolute top-0 left-0 z-20 pointer-events-none inline-flex items-center px-5 py-2 rounded-ee-2xl bg-white dark:bg-stone-900 drop-shadow-[4px_4px_6px_rgba(0,0,0,0.12)] before:content-[''] before:absolute before:top-0 before:left-full before:size-4 before:bg-inherit before:[-webkit-mask-image:radial-gradient(circle_at_100%_100%,transparent_16px,#000_17px)] before:mask-[radial-gradient(circle_at_100%_100%,transparent_16px,#000_17px)] after:content-[''] after:absolute after:top-full after:left-0 after:size-4 after:bg-inherit after:[-webkit-mask-image:radial-gradient(circle_at_100%_100%,transparent_16px,#000_17px)] after:mask-[radial-gradient(circle_at_100%_100%,transparent_16px,#000_17px)]">
        <AsciiSkeleton
          class="font-mono text-[11px] uppercase text-orange-600 dark:text-orange-400"
          lines={1}
          variant="dither"
          widths={["5.5rem"]}
        />
      </div>
    )}

    {/* Tour Type Badge at Top-Right matching TripCard.astro */}
    <div class="absolute top-3.5 right-3.5 z-20 pointer-events-none inline-flex items-center rounded-full bg-stone-950/80 px-2.5 py-1 font-mono text-[10px] font-semibold tracking-wider text-white backdrop-blur-md border border-white/20 shadow-md uppercase">
      <AsciiSkeleton
        class="text-white text-[10px]"
        lines={1}
        variant="dither"
        widths={["3.5rem"]}
      />
    </div>
  </div>

  {/* Card body matching TripCard.astro typography & spacing */}
  <div class="flex flex-1 flex-col pt-4 pb-1">
    {/* Excursion Tagline Pill Skeleton on top of title */}
    {!hasItinerary && (
      <div class="mbe-2 flex flex-wrap items-center gap-2">
        <span class="inline-flex rounded-full bg-stone-100 px-3 py-1 font-mono text-xs font-medium text-stone-700 dark:bg-stone-800 dark:text-stone-300">
          <AsciiSkeleton
            class="text-stone-700 dark:text-stone-300 text-xs"
            lines={1}
            variant="dither"
            widths={["6rem"]}
          />
        </span>
      </div>
    )}

    {/* Title matching TripCard text-xl font-bold */}
    <div class="mbe-2">
      <h3 class="line-clamp-2 text-xl font-bold tracking-tight text-stone-900 dark:text-stone-50">
        <AsciiSkeleton
          class="text-stone-900 dark:text-stone-50"
          lines={1}
          variant="dither"
          widths={["80%"]}
        />
      </h3>
    </div>

    {/* Description matching TripCard line-clamp-3 text-sm */}
    <div class="mbe-3 space-y-1">
      <AsciiSkeleton
        class="text-stone-600 dark:text-stone-300 text-sm leading-relaxed"
        lines={3}
        variant="dither"
        widths={["100%", "92%", "75%"]}
      />
    </div>

    {/* Start / End Itinerary Box matching TripCard.astro */}
    {hasItinerary && (
      <dl class="mt-auto mbe-3 m-0 grid grid-cols-2 gap-3 rounded-xl border border-stone-200/80 bg-stone-50/80 px-3.5 py-2.5 text-xs font-mono dark:border-stone-800 dark:bg-stone-800/40">
        <div class="flex flex-col gap-1">
          <dt class="text-[10px] tracking-wider text-stone-400 uppercase dark:text-stone-500">
            <AsciiSkeleton
              class="text-stone-400 text-[10px]"
              lines={1}
              variant="dither"
              widths={["2.5rem"]}
            />
          </dt>
          <dd class="m-0 truncate font-semibold text-stone-900 dark:text-stone-100">
            <AsciiSkeleton
              class="text-stone-900 dark:text-stone-100 font-semibold text-xs"
              lines={1}
              variant="dither"
              widths={["4.5rem"]}
            />
          </dd>
        </div>
        <div class="flex flex-col border-s border-stone-200/80 ps-3 gap-1 dark:border-stone-800">
          <dt class="text-[10px] tracking-wider text-stone-400 uppercase dark:text-stone-500">
            <AsciiSkeleton
              class="text-stone-400 text-[10px]"
              lines={1}
              variant="dither"
              widths={["2.5rem"]}
            />
          </dt>
          <dd class="m-0 truncate font-semibold text-stone-900 dark:text-stone-100">
            <AsciiSkeleton
              class="text-stone-900 dark:text-stone-100 font-semibold text-xs"
              lines={1}
              variant="dither"
              widths={["4.5rem"]}
            />
          </dd>
        </div>
      </dl>
    )}

    {/* Footer CTA full pill button matching TripCard */}
    <div class:list={["pt-2", !hasItinerary && "mt-auto"]}>
      <ButtonSkeleton
        class="w-full text-xs"
        size="md"
        variant="card"
      />
    </div>
  </div>
</article>
