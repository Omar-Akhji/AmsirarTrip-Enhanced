---
import { ChevronDown, CircleQuestionMark } from "@lucide/astro";

interface Props {
  readonly idPrefix?: string | undefined;
  readonly faqTitle: string;
  readonly faqs: readonly { readonly question: string; readonly answer: string }[];
  readonly categoryLabel?: string | undefined;
}

const {
  idPrefix = "trip",
  faqTitle,
  faqs,
  categoryLabel = "Common Questions",
} = Astro.props;
---

<div data-animate="fade-up">
  <section aria-labelledby={`${idPrefix}-faq-title`}>
    <hgroup class="mbe-4">
      <p class="font-sans text-xs font-bold tracking-wider text-orange-700 uppercase">
        {categoryLabel}
      </p>
      <h3
        class="mbs-1 text-xl font-bold tracking-tight text-stone-900 sm:text-2xl md:text-3xl"
        id={`${idPrefix}-faq-title`}
      >
        {faqTitle}
      </h3>
    </hgroup>
    <div class="overflow-hidden rounded-2xl border border-stone-200/90 bg-white shadow-2xs divide-y divide-stone-200/80">
      {faqs.map((faq) => (
        <details
          name={`${idPrefix}-faq`}
          class="group transition-colors open:bg-stone-50/50"
        >
          <summary class="flex cursor-pointer list-none items-start gap-3 p-4 sm:p-5 text-start text-base font-semibold text-stone-900 marker:hidden hover:bg-stone-50/80 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-600/40 focus-visible:ring-inset">
            <CircleQuestionMark
              aria-hidden="true"
              class="mbs-0.5 size-5 shrink-0 text-orange-600"
            />
            <span class="flex-1 leading-snug">{faq.question}</span>
            <ChevronDown
              aria-hidden="true"
              class="mbs-0.5 size-5 shrink-0 text-stone-400 transition-transform duration-200 group-open:rotate-180"
            />
          </summary>
          <div class="px-4 pb-4 pt-0 ps-12 sm:px-5 sm:pb-5 sm:ps-13">
            <p class="font-sans text-sm sm:text-base leading-relaxed text-stone-600">
              {faq.answer}
            </p>
          </div>
        </details>
      ))}
    </div>
  </section>
</div>
