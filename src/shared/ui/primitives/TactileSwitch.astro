---
interface Props {
  id: string;
  name?: string;
  checked?: boolean;
  disabled?: boolean;
  class?: string;
  ariaLabel?: string;
}

const {
  id,
  name = id,
  checked = false,
  disabled = false,
  class: className = "",
  ariaLabel,
} = Astro.props;
---

<label
  class:list={[
    "tactile-switch relative inline-flex shrink-0 select-none items-center text-[8px]",
    { "cursor-not-allowed opacity-90": disabled, "cursor-pointer": !disabled },
    className,
  ]}
  for={id}
>
  <input
    aria-label={ariaLabel}
    checked={checked}
    class="peer sr-only amsirar-toggle-input"
    disabled={disabled}
    id={id}
    name={name}
    type="checkbox"
  />
  <span
    aria-hidden="true"
    class="tactile-switch-base relative block h-[3em] w-[5.5em] rounded-[1.5em] transition-[box-shadow,opacity] duration-300 peer-focus-visible:ring-2 peer-focus-visible:ring-orange-400 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-slate-950 motion-reduce:transition-none"
  >
    <!-- Channel (recessed groove with active green fill) -->
    <span class="tactile-switch-channel absolute inset-x-[0.75em] inset-y-[0.75em] h-[1.5em] w-[4em] rounded-[0.75em] transition-shadow duration-250 ease-in-out motion-reduce:transition-none"></span>

    <!-- Switch knob / thumb -->
    <span class="tactile-switch-thumb absolute top-[0.5em] left-[0.5em] size-[2em] rounded-full transition-[left] duration-250 ease-in-out motion-reduce:transition-none"></span>
  </span>
</label>
