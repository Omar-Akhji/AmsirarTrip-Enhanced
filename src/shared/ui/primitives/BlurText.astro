---
export interface Props {
  animateBy?: "words" | "letters";
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "div" | "p" | "span";
  blur?: number;
  class?: string;
  delay?: number;
  direction?: "top" | "bottom";
  distance?: number;
  locale?: string;
  stagger?: number;
  stepDuration?: number;
  style?: string;
  text: string;
}

const {
  text,
  as: Tag = "p",
  class: className = "",
  style: styleProp,
  animateBy = "words",
  direction = "top",
  delay = 200,
  stepDuration = 0.7,
  blur = 10,
  distance = 50,
  stagger = 0.045,
  locale = Astro.locals.locale ?? "en",
} = Astro.props;

function segmentText(input: string, mode: "words" | "letters", lang: string): string[] {
  if (typeof Intl !== "undefined" && typeof Intl.Segmenter === "function") {
    if (mode === "letters") {
      const segmenter = new Intl.Segmenter(lang, { granularity: "grapheme" });
      return [...segmenter.segment(input)].map((item) => item.segment);
    }

    const segmenter = new Intl.Segmenter(lang, { granularity: "word" });
    const words: string[] = [];
    let current = "";
    for (const part of segmenter.segment(input)) {
      if (/^\s+$/.test(part.segment)) {
        if (current.length > 0) {
          words.push(current);
          current = "";
        }
      } else {
        current += part.segment;
      }
    }
    if (current.length > 0) {
      words.push(current);
    }
    return words;
  }

  return mode === "letters" ? [...input] : input.split(" ");
}

const tokens = segmentText(text, animateBy, locale);
const initialY = direction === "top" ? -distance : distance;
const rootStyle = [
  styleProp,
  `--blur-radius:${blur}px;--blur-y:${initialY}px;--blur-duration:${stepDuration}s`,
]
  .filter(Boolean)
  .join(";");
---

<Tag
  class:list={[className]}
  style={rootStyle}
>
  <span
    aria-hidden="true"
    class="inline"
  >
    {tokens.map((token: string, idx: number) => (
      <span
        class="blur-token inline-block"
        style={`--token-delay:${delay + Math.round(idx * stagger * 1000)}ms`}
      >
        {token === " " ? "\u{A0}" : token}
        {animateBy === "words" && idx < tokens.length - 1 ? "\u{A0}" : ""}
      </span>
    ))}
  </span>
  <span class="sr-only">{text}</span>
</Tag>
