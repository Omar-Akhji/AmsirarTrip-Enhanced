---
export interface Props {
  text: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "div" | "p" | "span";
  class?: string;
  style?: string;
  animateBy?: "words" | "letters";
  direction?: "top" | "bottom";
  delay?: number;
  stepDuration?: number;
  blur?: number;
  distance?: number;
  stagger?: number;
}

const {
  text,
  as: Tag = "p",
  class: className = "",
  style: styleProp,
  animateBy = "words",
  direction = "top",
  delay = 200,
  stepDuration = 0.7,
  blur = 10,
  distance = 50,
  stagger = 0.045,
} = Astro.props;

const tokens: string[] = animateBy === "letters" ? [...text] : text.split(" ");
const initialY = direction === "top" ? -distance : distance;
const rootStyle = [
  styleProp,
  `--blur-radius:${blur}px;--blur-y:${initialY}px;--blur-duration:${stepDuration}s`,
]
  .filter(Boolean)
  .join(";");
---

<Tag
  class:list={["blur-text-root", className]}
  style={rootStyle}
>
  <span
    aria-hidden="true"
    class="blur-text-tokens inline"
  >
    {tokens.map((token: string, idx: number) => (
      <span
        class="blur-token inline-block"
        style={`--token-delay:${delay + Math.round(idx * stagger * 1000)}ms`}
      >
        {token === " " ? "\u{A0}" : token}
        {animateBy === "words" && idx < tokens.length - 1 ? "\u{A0}" : ""}
      </span>
    ))}
  </span>
  <span class="sr-only">{text}</span>
</Tag>
