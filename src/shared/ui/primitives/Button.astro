---
import type { HTMLAttributes } from "astro/types";
import { buttonStyles, type ButtonSize, type ButtonVariant } from "./button-variants";

type ButtonTag = "button" | "a" | "div" | "span";

interface BaseProps {
  as?: ButtonTag | undefined;
  variant?: ButtonVariant | undefined;
  size?: ButtonSize | undefined;
  class?: string | undefined;
  type?: "button" | "submit" | "reset" | string | undefined;
}

type AnchorProps = HTMLAttributes<"a"> & { href: string; as?: "a" | undefined };
type NativeButtonProps = HTMLAttributes<"button"> & { href?: never; as?: "button" | undefined };
type ElementProps = HTMLAttributes<"div"> & { as: "div" | "span"; href?: string | undefined };

type Props = BaseProps & (AnchorProps | NativeButtonProps | ElementProps | Record<string, unknown>);

const {
  as,
  variant = "primary",
  size = "md",
  class: className,
  type: explicitType,
  ...props
} = Astro.props as Props;

const rawProps = props as Record<string, unknown>;
const isLink = typeof rawProps["href"] === "string" && !as;
const Tag = as || (isLink ? "a" : "button");
const classes = buttonStyles({ variant, size, className });

const BUTTON_TYPES = ["button", "submit", "reset"] as const;
type ButtonNativeType = (typeof BUTTON_TYPES)[number];

const isButtonType = (val: unknown): val is ButtonNativeType =>
  typeof val === "string" && (BUTTON_TYPES as readonly string[]).includes(val);

const buttonType: ButtonNativeType | undefined =
  Tag === "button" ?
    isButtonType(explicitType) ? explicitType
    : "button"
  : undefined;
---

<Tag
  data-ascii={rawProps["data-ascii"] ?? "fade"}
  class:list={["font-mono", classes]}
  style="font-family: var(--font-mono, 'JetBrains Mono', 'JetBrains Mono Variable', ui-monospace, monospace);"
  type={buttonType}
  {...props}
>
  <slot />
</Tag>
