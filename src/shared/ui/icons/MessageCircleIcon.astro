---
interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className = "size-5", ...rest } = Astro.props;
---

<svg
  aria-hidden="true"
  class={className}
  fill="none"
  viewBox="0 0 24 24"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...rest}
>
  <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
</svg>
