---
interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className = "size-5", ...rest } = Astro.props;
---

<svg
  aria-hidden="true"
  class:list={className}
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width="1.5"
  viewBox="0 0 24 24"
  {...rest}
>
  <path d="m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z"></path>
  <circle
    cx="12"
    cy="12"
    r="10"
  ></circle>
</svg>
