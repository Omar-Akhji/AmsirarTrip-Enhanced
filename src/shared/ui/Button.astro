---
import type { HTMLAttributes } from "astro/types";
import { buttonStyles, type ButtonSize, type ButtonVariant } from "./button-variants";

interface BaseProps {
  variant?: ButtonVariant | undefined;
  size?: ButtonSize | undefined;
  class?: string | undefined;
}

type AnchorProps = HTMLAttributes<"a"> & { href: string };

type NativeButtonProps = HTMLAttributes<"button"> & { href?: never };

type Props = BaseProps & (AnchorProps | NativeButtonProps);

const { variant = "primary", size = "md", class: className, ...props } = Astro.props as Props;

const classes = buttonStyles({ variant, size, className });
const isLink = "href" in props && typeof props.href === "string";
---

{isLink ?
  <a
    class:list={classes}
    {...(props as HTMLAttributes<"a">)}
  >
    <slot />
  </a>
: <button
    class:list={classes}
    type={(props as HTMLAttributes<"button">).type ?? "button"}
    {...(props as HTMLAttributes<"button">)}
  >
    <slot />
  </button>
}
