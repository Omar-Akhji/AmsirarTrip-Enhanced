---
import AsciiSkeleton from "@/shared/ui/AsciiSkeleton.astro";
import PageHeaderSkeleton from "@/shared/ui/PageHeaderSkeleton.astro";
import { ChevronRight, MapPinned } from "@lucide/astro";

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<div
  aria-busy="true"
  aria-label="Loading contact view"
  class:list={["size-full bg-white text-stone-900 pb-20", className]}
>
  <PageHeaderSkeleton
    crumbWidths={["w-12", "w-20"]}
    hasButtons={true}
  />

  {/* 01 // DIRECT CHANNELS SKELETON */}
  <section class="relative isolate bg-white py-16">
    <div class="mx-auto px-4 max-inline-7xl">
      <div class="mbe-10 sm:mbe-12 max-w-3xl space-y-2">
        <AsciiSkeleton
          class="text-2xl sm:text-3xl text-stone-800 font-bold"
          lines={1}
          variant="dither"
          widths={["20rem"]}
        />
        <AsciiSkeleton
          class="text-stone-400 text-sm"
          lines={1}
          variant="scan"
          widths={["12rem"]}
        />
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-3 items-stretch">
        {Array.from({ length: 3 }, () => (
          <div class="flex size-full last:sm:col-span-2 last:xl:col-span-1">
            <article class="group flex size-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/80 p-7 shadow-xs">
              <div>
                <AsciiSkeleton
                  class="mbe-3 text-lg font-bold text-stone-800"
                  lines={1}
                  variant="dither"
                  widths={["75%"]}
                />
                <div class="pt-1">
                  <AsciiSkeleton
                    class="text-stone-400"
                    lines={3}
                    variant="dither"
                    widths={["100%", "90%", "70%"]}
                  />
                </div>
              </div>

              <div class="mbs-6 border-t border-stone-200/60 pbs-4">
                <div class="flex items-center justify-between rounded-full border border-stone-200 bg-white px-5 py-2.5">
                  <AsciiSkeleton
                    class="text-stone-500 font-mono text-xs"
                    lines={1}
                    variant="terminal"
                    widths={["8rem"]}
                  />
                  <ChevronRight
                    aria-hidden="true"
                    class="size-4 text-stone-400"
                  />
                </div>
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* 02 // EXPEDITION INQUIRY & DISPATCH SKELETON */}
  <section
    class="relative isolate border-t border-stone-200 bg-stone-50 py-20 sm:py-24"
    id="contact-form-section-skeleton"
  >
    <div class="mx-auto px-4 max-inline-7xl">
      <div class="mbe-10 sm:mbe-12 max-w-3xl space-y-2">
        <AsciiSkeleton
          class="text-2xl sm:text-3xl text-stone-800 font-bold"
          lines={1}
          variant="dither"
          widths={["16rem"]}
        />
        <AsciiSkeleton
          class="text-stone-400 text-sm"
          lines={1}
          variant="scan"
          widths={["32rem"]}
        />
      </div>

      <div class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-5">
        {/* Left: Contact Form Card (col-span-3) */}
        <div class="inline-full lg:col-span-3">
          <div class="rounded-2xl border border-stone-200/90 bg-white p-6 shadow-2xs block-full sm:p-8">
            <div class="mbe-6 border-b border-stone-100 pbe-5">
              <AsciiSkeleton
                class="mbe-2 text-stone-400 font-mono text-xs uppercase"
                lines={1}
                variant="scan"
                widths={["7rem"]}
              />
              <AsciiSkeleton
                class="text-xl sm:text-2xl text-stone-800 font-bold"
                lines={1}
                variant="dither"
                widths={["16rem"]}
              />
            </div>

            <div class="flex flex-col gap-5">
              {/* Row 1: Name & Email */}
              <div class="grid gap-5 md:grid-cols-2">
                <div class="h-12 w-full rounded-xl bg-stone-50/80 border border-stone-200/90 p-3 flex items-center">
                  <AsciiSkeleton
                    class="text-stone-300"
                    lines={1}
                    variant="terminal"
                    widths={["6rem"]}
                  />
                </div>
                <div class="h-12 w-full rounded-xl bg-stone-50/80 border border-stone-200/90 p-3 flex items-center">
                  <AsciiSkeleton
                    class="text-stone-300"
                    lines={1}
                    variant="terminal"
                    widths={["8rem"]}
                  />
                </div>
              </div>

              {/* Row 2: Phone & Topic */}
              <div class="grid gap-5 md:grid-cols-2">
                <div class="h-12 w-full rounded-xl bg-stone-50/80 border border-stone-200/90 p-3 flex items-center">
                  <AsciiSkeleton
                    class="text-stone-300"
                    lines={1}
                    variant="terminal"
                    widths={["7rem"]}
                  />
                </div>
                <div class="h-12 w-full rounded-xl bg-stone-50/80 border border-stone-200/90 p-3 flex items-center">
                  <AsciiSkeleton
                    class="text-stone-300"
                    lines={1}
                    variant="terminal"
                    widths={["5rem"]}
                  />
                </div>
              </div>

              {/* Row 3: Message */}
              <div class="min-block-40 w-full rounded-xl bg-stone-50/80 border border-stone-200/90 p-4">
                <AsciiSkeleton
                  class="text-stone-300"
                  lines={3}
                  variant="dither"
                  widths={["100%", "90%", "60%"]}
                />
              </div>

              {/* Bottom: Captcha + Submit button */}
              <div class="flex flex-col gap-4 pbs-2 sm:flex-row sm:items-center sm:justify-between">
                <div class="w-fit rounded-xl border border-stone-200 p-3 flex items-center gap-3">
                  <AsciiSkeleton
                    class="text-stone-400"
                    lines={1}
                    variant="scan"
                    widths={["8rem"]}
                  />
                </div>
                <div class="rounded-full border border-stone-300 bg-stone-100 px-8 py-3 w-fit">
                  <AsciiSkeleton
                    class="text-stone-700 font-bold font-mono text-xs uppercase"
                    lines={1}
                    variant="scan"
                    widths={["8rem"]}
                  />
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Right: Contact Sidebar in clean neutral gray (col-span-2) */}
        <aside class="block-full inline-full lg:col-span-2">
          <div class="flex flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-100 p-6 text-stone-900 shadow-xs block-full sm:p-8">
            <div>
              <div class="border-b border-stone-200 pb-4">
                <AsciiSkeleton
                  class="mbe-2 text-stone-500"
                  lines={1}
                  variant="scan"
                  widths={["6rem"]}
                />
                <AsciiSkeleton
                  class="text-lg font-bold text-stone-800"
                  lines={1}
                  variant="dither"
                  widths={["12rem"]}
                />
              </div>

              <div class="mbs-4">
                <AsciiSkeleton
                  class="text-stone-400 text-sm"
                  lines={2}
                  variant="dither"
                  widths={["100%", "85%"]}
                />
              </div>

              <div class="mbs-8 space-y-6 text-sm">
                {["01", "02", "03"].map((num) => (
                  <div class="grid grid-cols-[48px_1fr] items-start gap-4">
                    <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-stone-200 font-mono text-sm font-bold text-stone-500 tabular-nums">
                      {num}
                    </span>
                    <div class="space-y-1.5 self-start pt-1">
                      <AsciiSkeleton
                        class="text-stone-500 font-mono text-xs"
                        lines={1}
                        variant="terminal"
                        widths={["3rem"]}
                      />
                      <AsciiSkeleton
                        class="text-stone-700 font-mono text-xs"
                        lines={1}
                        variant="terminal"
                        widths={["9rem"]}
                      />
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div class="mbs-8">
              <AsciiSkeleton
                class="text-stone-400 text-xs font-mono"
                lines={1}
                variant="terminal"
                widths={["12rem"]}
              />
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* 03 // PHYSICAL ATELIER & COORDINATES SKELETON */}
  <section
    class="relative isolate border-t border-stone-200/90 bg-white py-20 sm:py-24"
    id="location-skeleton"
  >
    <div class="mx-auto px-4 max-inline-7xl">
      <div class="mbe-10 sm:mbe-12 max-w-3xl space-y-2">
        <AsciiSkeleton
          class="text-2xl sm:text-3xl text-stone-800 font-bold"
          lines={1}
          variant="dither"
          widths={["16rem"]}
        />
        <AsciiSkeleton
          class="text-stone-400 text-sm"
          lines={1}
          variant="scan"
          widths={["11rem"]}
        />
      </div>

      <div class="overflow-hidden rounded-2xl border border-slate-900 bg-slate-950 text-white shadow-xl">
        <div class="relative flex flex-col items-center justify-center bg-slate-950 text-white block-75 md:block-100 lg:block-125">
          {/* Full-width ASCII background mesh spanning 100% edge-to-edge */}
          <div class="absolute inset-0 size-full overflow-hidden bg-slate-950">
            <AsciiSkeleton
              class="ars-image ars-hero-bg size-full text-stone-700/35"
              rows={40}
              variant="dither"
            />
          </div>
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.06),transparent_70%)]"
          ></div>

          <div class="relative z-10 text-center space-y-4 px-6 max-w-lg mx-auto">
            {/* Centered MapPinned icon matching ContactView.astro */}
            <div class="mx-auto flex size-14 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-stone-300 font-mono text-xs shadow-xs">
              <MapPinned
                aria-hidden="true"
                class="size-6 text-stone-300"
                stroke-width={2}
              />
            </div>

            {/* Title: SHOW INTERACTIVE MAP (20ch) matching ContactView text-xl sm:text-2xl uppercase font-bold */}
            <div class="mx-auto text-center">
              <AsciiSkeleton
                class="text-xl font-bold uppercase sm:text-2xl text-white/95 text-center mx-auto"
                lines={1}
                variant="dither"
                widths={["20ch"]}
              />
            </div>

            {/* Description: Clicking will load the Google Maps widget which may set cookies and load third-party scripts. */}
            {/* 2 lines, centered in middle, matching font-mono text-xs sm:text-sm text-stone-300 */}
            <div class="mx-auto max-w-lg text-center">
              <AsciiSkeleton
                class="font-mono text-xs sm:text-sm text-stone-300 leading-relaxed text-center mx-auto"
                lines={2}
                variant="dither"
                widths={["100%", "68%"]}
              />
            </div>

            {/* Centered Load Map CTA Button skeleton */}
            <div class="pt-2">
              <div class="inline-flex min-h-11 items-center gap-2 rounded-full border border-white/20 bg-white/10 px-8 py-3 font-mono text-xs font-bold uppercase tracking-wider text-white">
                <AsciiSkeleton
                  class="text-white/80 font-mono text-xs font-bold uppercase"
                  lines={1}
                  variant="scan"
                  widths={["8ch"]}
                />
                <ChevronRight
                  aria-hidden="true"
                  class="size-4 text-white/50"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
