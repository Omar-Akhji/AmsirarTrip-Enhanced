---
import { useTranslations } from "@/i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const privacyPolicyHref = getRelativeLocaleUrl(locale, "/privacy-policy");
---

<!-- ========================================== -->
<!-- 1. Floating Cookie Notification (Right)    -->
<!-- ========================================== -->
<div
  aria-describedby="cookie-banner-desc"
  aria-labelledby="cookie-banner-title"
  class="pointer-events-none fixed right-4 bottom-4 left-4 z-50 transition-all duration-300 ease-out opacity-0 translate-y-3 sm:left-auto sm:right-6 sm:bottom-6 sm:max-w-md md:max-w-lg hidden"
  id="cookie-banner"
  role="region"
>
  <div class="pointer-events-auto relative overflow-hidden rounded-3xl border border-white/10 bg-slate-950/95 p-5 sm:p-6 text-white shadow-[0_20px_50px_rgba(0,0,0,0.85)] backdrop-blur-xl ring-1 ring-white/10">
    <div class="flex items-start gap-3.5 sm:gap-4">
      <!-- Cookie Icon Badge (Circular in Border) -->
      <div class="flex size-11 shrink-0 items-center justify-center rounded-full border-2 border-orange-500/40 bg-orange-500/10 text-orange-400 ring-4 ring-orange-500/10 shadow-[0_0_16px_rgba(249,115,22,0.15)] sm:size-12">
        <svg
          class="size-5 sm:size-6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          viewBox="0 0 24 24"
        >
          <path
            d="M12 2a10 10 0 1010 10c0-1.5-1-2.5-2.5-2.5a2.5 2.5 0 01-2.5-2.5c0-1.5-1-2.5-2.5-2.5a2.5 2.5 0 01-2.5-2.5z"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
          <circle
            cx="8.5"
            cy="8.5"
            fill="currentColor"
            r="1"
          ></circle>
          <circle
            cx="7.5"
            cy="14.5"
            fill="currentColor"
            r="1"
          ></circle>
          <circle
            cx="14.5"
            cy="14.5"
            fill="currentColor"
            r="1"
          ></circle>
          <circle
            cx="12"
            cy="11"
            fill="currentColor"
            r="0.75"
          ></circle>
          <circle
            cx="16.5"
            cy="10"
            fill="currentColor"
            r="0.75"
          ></circle>
        </svg>
      </div>

      <!-- Text Content -->
      <div class="flex-1 space-y-1.5">
        <h2
          class="text-sm font-bold tracking-tight text-white sm:text-base"
          id="cookie-banner-title"
        >
          {t("cookieConsent.title", "We value your privacy")}
        </h2>
        <p
          class="text-xs leading-relaxed text-zinc-300/90 sm:text-[13px]"
          id="cookie-banner-desc"
        >
          {t(
            "cookieConsent.description",
            "We use cookies to enhance your browsing experience, provide secure navigation, and analyze site traffic to deliver unforgettable Morocco adventures.",
          )}{" "}
          <a
            class="font-medium text-orange-400 underline underline-offset-2 transition-colors hover:text-orange-300"
            href={privacyPolicyHref}
          >
            {t("cookieConsent.privacyPolicyLink", "Read our Privacy Policy")}
          </a>
        </p>
      </div>
    </div>

    <!-- Action Buttons Row (Reversed Order) -->
    <div class="mt-4 flex flex-col gap-2 border-t border-white/10 pt-4 sm:flex-row sm:items-center sm:justify-between">
      <!-- Primary Action Buttons Group (Accept All first, Essential Only second) -->
      <div class="grid grid-cols-2 gap-2 sm:flex sm:items-center sm:gap-2">
        <button
          class="inline-flex h-9 cursor-pointer items-center justify-center rounded-xl bg-linear-to-r from-orange-600 via-orange-500 to-amber-600 px-4 text-xs font-bold text-white shadow-lg shadow-orange-600/30 transition-all duration-200 hover:shadow-orange-500/40 hover:brightness-110 active:scale-[0.98] sm:text-sm"
          data-cookie-accept-all
          type="button"
        >
          {t("cookieConsent.acceptAll", "Accept All")}
        </button>

        <button
          class="inline-flex h-9 cursor-pointer items-center justify-center rounded-xl border border-white/15 bg-white/5 px-3.5 text-xs font-semibold text-zinc-200 transition-all duration-200 hover:border-white/30 hover:bg-white/10 hover:text-white active:scale-[0.98]"
          data-cookie-reject-all
          type="button"
        >
          {t("cookieConsent.rejectAll", "Essential Only")}
        </button>
      </div>

      <!-- Settings button -->
      <button
        class="inline-flex h-9 cursor-pointer items-center justify-center rounded-xl border border-white/15 bg-white/5 px-3.5 text-xs font-semibold text-zinc-300 transition-all duration-200 hover:border-orange-500/40 hover:bg-white/10 hover:text-orange-300 active:scale-[0.98]"
        data-cookie-open-preferences
        type="button"
      >
        <span>{t("cookieConsent.customize", "Cookie Settings")}</span>
      </button>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- 2. Modal: Granular Cookie Preferences      -->
<!-- ========================================== -->
<div
  aria-labelledby="cookie-modal-title"
  aria-modal="true"
  class="fixed inset-0 z-999999 flex items-center justify-center p-4 opacity-0 transition-opacity duration-300 ease-out"
  id="cookie-preferences-modal"
  role="dialog"
>
  <!-- Backdrop -->
  <div
    class="fixed inset-0 bg-black/80 backdrop-blur-md transition-opacity"
    data-modal-backdrop
  ></div>

  <!-- Modal Content Box -->
  <div class="relative z-10 flex max-h-[88vh] w-full max-w-2xl flex-col overflow-hidden rounded-3xl bg-slate-950 text-white shadow-[0_25px_70px_rgba(0,0,0,0.9)] ring-1 ring-white/10">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-white/10 bg-slate-900/40 px-6 py-5 backdrop-blur-md">
      <div>
        <h2
          class="text-base font-bold tracking-tight text-white sm:text-lg"
          id="cookie-modal-title"
        >
          {t("cookieConsent.modalTitle", "Cookie & Privacy Preferences")}
        </h2>
        <p class="text-[11px] text-zinc-400">
          {t("cookieConsent.complianceNote", "Compliant with GDPR & Moroccan Law 09-08")}
        </p>
      </div>

      <button
        aria-label={t("cookieConsent.close", "Close")}
        class="inline-flex size-9 cursor-pointer items-center justify-center rounded-xl border border-white/10 bg-white/5 text-zinc-400 transition-colors hover:bg-white/10 hover:text-white"
        data-cookie-close-preferences
        type="button"
      >
        <svg
          class="size-4.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            d="M6 18L18 6M6 6l12 12"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
    </div>

    <!-- Scrollable Body with Clean Custom Scrollbar -->
    <div class="flex-1 space-y-4 overflow-y-auto p-6 text-sm text-zinc-300 scrollbar-thin scrollbar-track-transparent scrollbar-thumb-white/15 hover:scrollbar-thumb-orange-500/50">
      <!-- Info callout card -->
      <div class="rounded-2xl border border-white/10 bg-white/2 p-4 text-xs leading-relaxed text-zinc-300 sm:text-[13px]">
        <p>
          {t(
            "cookieConsent.modalSubtitle",
            "Manage how cookies and local storage are used during your visit. You can modify these settings at any time.",
          )}
        </p>
      </div>

      <!-- Categories Boxes -->
      <div class="space-y-3.5">
        <!-- 1. Strictly Necessary (Always On) -->
        <div class="rounded-2xl border border-white/10 bg-white/3 p-4.5 transition-all sm:p-5">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-sm font-semibold tracking-tight text-white sm:text-base">
                  {t("cookieConsent.necessaryTitle", "Strictly Necessary Cookies")}
                </h3>
                <span class="inline-flex items-center rounded-full bg-emerald-500/15 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-400 ring-1 ring-emerald-500/30">
                  {t("cookieConsent.alwaysActive", "Always Active")}
                </span>
              </div>
              <p class="pt-2 text-xs leading-relaxed text-zinc-400 sm:text-[13px]">
                {t(
                  "cookieConsent.necessaryDesc",
                  "Required for site navigation, security, language selection, and core features. These cannot be disabled.",
                )}
              </p>

              <!-- Feature tags -->
              <div class="mt-3 flex flex-wrap items-center gap-1.5 border-t border-white/5 pt-2.5 text-[10px] text-zinc-400">
                <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 font-medium">
                  Session Security
                </span>
                <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 font-medium">
                  Language Routing
                </span>
                <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 font-medium">
                  CSRF Token
                </span>
              </div>
            </div>

            <!-- Locked Active Switch -->
            <div class="relative inline-flex shrink-0 cursor-not-allowed items-center pt-0.5">
              <input
                checked
                class="amsirar-toggle-input sr-only"
                disabled
                id="cookie-toggle-necessary"
                type="checkbox"
              />
              <div
                aria-hidden="true"
                class="amsirar-toggle-track is-locked"
              >
                <div class="amsirar-toggle-thumb"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Analytics & Performance -->
        <div class="group rounded-2xl border border-white/10 bg-white/3 p-4.5 transition-all hover:border-white/20 hover:bg-white/6 sm:p-5">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
              <label
                class="flex cursor-pointer flex-wrap items-center gap-2"
                for="cookie-toggle-analytics"
              >
                <h3 class="text-sm font-semibold tracking-tight text-white transition-colors group-hover:text-orange-200 sm:text-base">
                  {t("cookieConsent.analyticsTitle", "Analytics & Performance")}
                </h3>
                <span class="inline-flex items-center rounded-full bg-white/10 px-2.5 py-0.5 text-[11px] font-medium text-zinc-400 ring-1 ring-white/10">
                  {t("cookieConsent.optional", "Optional")}
                </span>
              </label>
              <p class="pt-2 text-xs leading-relaxed text-zinc-400 sm:text-[13px]">
                {t(
                  "cookieConsent.analyticsDesc",
                  "Enables anonymous traffic metrics to help us understand popular itineraries and improve loading performance.",
                )}
              </p>

              <!-- Feature tags -->
              <div class="mt-3 flex flex-wrap items-center gap-1.5 border-t border-white/5 pt-2.5 text-[10px] text-zinc-400">
                <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 font-medium">
                  Traffic Analytics
                </span>
                <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 font-medium">
                  Page Speeds
                </span>
                <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 font-medium">
                  Anonymized Telemetry
                </span>
              </div>
            </div>

            <!-- Interactive Switch Toggle -->
            <label
              class="relative inline-flex shrink-0 cursor-pointer items-center pt-0.5"
              for="cookie-toggle-analytics"
            >
              <input
                class="amsirar-toggle-input sr-only"
                id="cookie-toggle-analytics"
                type="checkbox"
              />
              <div
                aria-hidden="true"
                class="amsirar-toggle-track"
              >
                <div class="amsirar-toggle-thumb"></div>
              </div>
            </label>
          </div>
        </div>

        <!-- 3. Preferences & Functional -->
        <div class="group rounded-2xl border border-white/10 bg-white/3 p-4.5 transition-all hover:border-white/20 hover:bg-white/6 sm:p-5">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
              <label
                class="flex cursor-pointer flex-wrap items-center gap-2"
                for="cookie-toggle-functional"
              >
                <h3 class="text-sm font-semibold tracking-tight text-white transition-colors group-hover:text-orange-200 sm:text-base">
                  {t("cookieConsent.functionalTitle", "Preferences & Functional")}
                </h3>
                <span class="inline-flex items-center rounded-full bg-white/10 px-2.5 py-0.5 text-[11px] font-medium text-zinc-400 ring-1 ring-white/10">
                  {t("cookieConsent.optional", "Optional")}
                </span>
              </label>
              <p class="pt-2 text-xs leading-relaxed text-zinc-400 sm:text-[13px]">
                {t(
                  "cookieConsent.functionalDesc",
                  "Remembers your choices (such as interactive agency maps and currency preferences) for a smoother journey.",
                )}
              </p>

              <!-- Feature tags -->
              <div class="mt-3 flex flex-wrap items-center gap-1.5 border-t border-white/5 pt-2.5 text-[10px] text-zinc-400">
                <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 font-medium">
                  Interactive Maps
                </span>
                <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 font-medium">
                  Custom Preferences
                </span>
                <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 font-medium">
                  Agency Cache
                </span>
              </div>
            </div>

            <!-- Interactive Switch Toggle -->
            <label
              class="relative inline-flex shrink-0 cursor-pointer items-center pt-0.5"
              for="cookie-toggle-functional"
            >
              <input
                class="amsirar-toggle-input sr-only"
                id="cookie-toggle-functional"
                type="checkbox"
              />
              <div
                aria-hidden="true"
                class="amsirar-toggle-track"
              >
                <div class="amsirar-toggle-thumb"></div>
              </div>
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer Actions with Perfected Alignment & Hierarchy -->
    <div class="flex flex-col gap-3.5 border-t border-white/10 bg-slate-900/60 px-6 py-4.5 backdrop-blur-md sm:flex-row sm:items-center sm:justify-between">
      <!-- Privacy Policy Link -->
      <a
        class="inline-flex items-center justify-center text-xs font-medium text-zinc-400 underline underline-offset-4 transition-colors hover:text-orange-400 sm:justify-start"
        href={privacyPolicyHref}
      >
        <span>{t("cookieConsent.privacyPolicyLink", "Read our Privacy Policy")}</span>
      </a>

      <!-- Action Buttons Suite -->
      <div class="flex flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:gap-2.5">
        <div class="grid grid-cols-2 gap-2 sm:flex sm:items-center sm:gap-2.5">
          <button
            class="inline-flex h-10 cursor-pointer items-center justify-center rounded-xl border border-white/15 bg-white/5 px-4 text-xs font-semibold text-zinc-200 transition-all duration-200 hover:border-white/30 hover:bg-white/10 hover:text-white active:scale-[0.98] sm:text-sm"
            data-cookie-reject-all
            type="button"
          >
            {t("cookieConsent.rejectAll", "Essential Only")}
          </button>

          <button
            class="inline-flex h-10 cursor-pointer items-center justify-center rounded-xl border border-orange-500/30 bg-orange-500/10 px-4 text-xs font-semibold text-orange-300 transition-all duration-200 hover:border-orange-500/50 hover:bg-orange-500/20 hover:text-white active:scale-[0.98] sm:text-sm"
            data-cookie-accept-all
            type="button"
          >
            {t("cookieConsent.acceptAll", "Accept All")}
          </button>
        </div>

        <button
          class="inline-flex h-10 cursor-pointer items-center justify-center rounded-xl bg-linear-to-r from-orange-600 via-orange-500 to-amber-600 px-5 text-xs font-bold text-white shadow-lg shadow-orange-600/30 transition-all duration-200 hover:shadow-orange-500/40 hover:brightness-110 active:scale-[0.98] sm:text-sm"
          data-cookie-save-preferences
          type="button"
        >
          {t("cookieConsent.savePreferences", "Save Preferences")}
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- 3. Discreet Floating Cookie Settings Badge -->
<!-- ========================================== -->
<button
  aria-label={t("cookieConsent.modalTitle", "Cookie Settings")}
  class="fixed bottom-6 left-6 z-40 flex size-11 cursor-pointer items-center justify-center rounded-full border-2 border-orange-500/40 bg-slate-950/90 text-orange-400 shadow-xl backdrop-blur-md ring-4 ring-orange-500/10 transition-all duration-300 hover:scale-110 hover:border-orange-500 hover:bg-slate-900 hover:text-orange-300 hover:shadow-orange-500/25 active:scale-95"
  data-cookie-open-preferences
  id="cookie-badge-btn"
  title={t("cookieConsent.customize", "Cookie Settings")}
  type="button"
>
  <svg
    class="size-5"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    viewBox="0 0 24 24"
  >
    <path
      d="M12 2a10 10 0 1010 10c0-1.5-1-2.5-2.5-2.5a2.5 2.5 0 01-2.5-2.5c0-1.5-1-2.5-2.5-2.5a2.5 2.5 0 01-2.5-2.5z"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <circle
      cx="8.5"
      cy="8.5"
      fill="currentColor"
      r="1"
    ></circle>
    <circle
      cx="7.5"
      cy="14.5"
      fill="currentColor"
      r="1"
    ></circle>
    <circle
      cx="14.5"
      cy="14.5"
      fill="currentColor"
      r="1"
    ></circle>
    <circle
      cx="12"
      cy="11"
      fill="currentColor"
      r="0.75"
    ></circle>
    <circle
      cx="16.5"
      cy="10"
      fill="currentColor"
      r="0.75"
    ></circle>
  </svg>
</button>

<style>
  /* Custom Toggle Switch Base Geometry */
  .amsirar-toggle-track {
    width: 48px;
    height: 26px;
    border-radius: 9999px;
    background-color: #27272a;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    padding: 2px;
    cursor: pointer;
    user-select: none;
    flex-shrink: 0;
  }

  .amsirar-toggle-thumb {
    width: 20px;
    height: 20px;
    border-radius: 9999px;
    background-color: #ffffff;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    will-change: transform;
    flex-shrink: 0;
  }

  /* Focus outline for keyboard accessibility */
  .amsirar-toggle-input:focus-visible + .amsirar-toggle-track {
    outline: 2px solid #f97316;
    outline-offset: 3px;
  }

  /* Necessary Cookies - Locked Active State */
  .amsirar-toggle-track.is-locked {
    background-color: #059669;
    border-color: rgba(52, 211, 153, 0.6);
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.35);
    cursor: not-allowed;
  }

  .amsirar-toggle-track.is-locked .amsirar-toggle-thumb {
    transform: translateX(22px);
  }
</style>

<script src="../../scripts/cookie-consent.ts"></script>
