---
import { useTranslations } from "@/i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const privacyPolicyHref = getRelativeLocaleUrl(locale, "/privacy-policy");
---

<!-- ========================================== -->
<!-- 1. Modal Cookie Consent Dialog             -->
<!-- ========================================== -->
<div
  aria-describedby="cookie-banner-desc"
  aria-labelledby="cookie-banner-title"
  aria-modal="true"
  class="fixed inset-0 z-999999 flex items-center justify-center p-4 opacity-0 transition-opacity duration-300 ease-out"
  id="cookie-banner"
  role="dialog"
>
  <!-- Backdrop (Dark + Blur) in front of everything -->
  <div
    aria-hidden="true"
    class="fixed inset-0 bg-black/75 backdrop-blur-md transition-opacity"
  ></div>

  <!-- Modal Card Dialog -->
  <div class="relative z-10 w-full max-w-lg overflow-hidden rounded-3xl bg-slate-950 p-6 text-white shadow-[0_25px_60px_rgba(0,0,0,0.85)] ring-1 ring-white/10 sm:p-8">
    <div class="flex items-start gap-4">
      <!-- Cookie Icon Badge -->
      <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-orange-500/10 text-orange-500 ring-1 ring-orange-500/30">
        <svg
          class="size-6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          viewBox="0 0 24 24"
        >
          <path
            d="M12 2a10 10 0 1010 10c0-1.5-1-2.5-2.5-2.5a2.5 2.5 0 01-2.5-2.5c0-1.5-1-2.5-2.5-2.5a2.5 2.5 0 01-2.5-2.5z"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
          <circle
            cx="8.5"
            cy="8.5"
            fill="currentColor"
            r="1"
          ></circle>
          <circle
            cx="7.5"
            cy="14.5"
            fill="currentColor"
            r="1"
          ></circle>
          <circle
            cx="14.5"
            cy="14.5"
            fill="currentColor"
            r="1"
          ></circle>
          <circle
            cx="12"
            cy="11"
            fill="currentColor"
            r="0.75"
          ></circle>
          <circle
            cx="16.5"
            cy="10"
            fill="currentColor"
            r="0.75"
          ></circle>
        </svg>
      </div>

      <!-- Text Content -->
      <div class="flex-1 space-y-2">
        <h2
          class="text-lg font-bold tracking-tight text-white sm:text-xl"
          id="cookie-banner-title"
        >
          {t("cookieConsent.title", "We value your privacy")}
        </h2>
        <p
          class="text-xs leading-relaxed text-orange-200/90 sm:text-sm"
          id="cookie-banner-desc"
        >
          {t(
            "cookieConsent.description",
            "We use cookies to enhance your browsing experience, provide secure navigation, and analyze site traffic to deliver unforgettable Morocco adventures.",
          )}{" "}
          <a
            class="font-medium text-orange-400 underline underline-offset-2 transition-colors hover:text-orange-300"
            href={privacyPolicyHref}
          >
            {t("cookieConsent.privacyPolicyLink", "Read our Privacy Policy")}
          </a>
        </p>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="mt-6 flex flex-col-reverse gap-2.5 sm:flex-row sm:items-center sm:justify-end">
      <button
        class="inline-flex cursor-pointer items-center justify-center px-2 py-2 text-xs font-semibold text-zinc-400 underline underline-offset-4 transition-all hover:text-orange-400 sm:me-auto"
        data-cookie-open-preferences
        type="button"
      >
        {t("cookieConsent.customize", "Cookie Settings")}
      </button>

      <button
        class="inline-flex cursor-pointer items-center justify-center rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-xs font-semibold text-zinc-200 transition-all hover:bg-white/10 hover:text-white active:scale-[0.98] sm:text-sm"
        data-cookie-reject-all
        type="button"
      >
        {t("cookieConsent.rejectAll", "Essential Only")}
      </button>

      <button
        class="inline-flex cursor-pointer items-center justify-center rounded-xl bg-orange-600 px-5 py-2.5 text-xs font-bold text-white shadow-lg shadow-orange-600/25 transition-all hover:bg-orange-500 hover:shadow-orange-500/35 active:scale-[0.98] sm:text-sm"
        data-cookie-accept-all
        type="button"
      >
        {t("cookieConsent.acceptAll", "Accept All")}
      </button>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- 2. Modal: Granular Cookie Preferences      -->
<!-- ========================================== -->
<div
  aria-labelledby="cookie-modal-title"
  aria-modal="true"
  class="fixed inset-0 z-999999 flex items-center justify-center p-4 opacity-0 transition-opacity duration-300 ease-out"
  id="cookie-preferences-modal"
  role="dialog"
>
  <!-- Backdrop -->
  <div
    class="fixed inset-0 bg-black/75 backdrop-blur-md transition-opacity"
    data-modal-backdrop
  ></div>

  <!-- Modal Content Box -->
  <div class="relative z-10 flex max-h-[90vh] w-full max-w-2xl flex-col overflow-hidden rounded-3xl bg-slate-950 text-white shadow-2xl ring-1 ring-white/10">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-white/10 px-6 py-5">
      <h2
        class="text-lg font-semibold tracking-tight text-white"
        id="cookie-modal-title"
      >
        {t("cookieConsent.modalTitle", "Cookie & Privacy Preferences")}
      </h2>

      <button
        aria-label={t("cookieConsent.close", "Close")}
        class="inline-flex size-9 cursor-pointer items-center justify-center rounded-xl text-zinc-400 transition-colors hover:bg-white/10 hover:text-white"
        data-cookie-close-preferences
        type="button"
      >
        <svg
          class="size-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            d="M6 18L18 6M6 6l12 12"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
    </div>

    <!-- Scrollable Body -->
    <div class="flex-1 space-y-6 overflow-y-auto px-6 py-6 text-sm text-zinc-300">
      <p class="text-xs leading-relaxed text-zinc-400 sm:text-sm">
        {t(
          "cookieConsent.modalSubtitle",
          "Manage how cookies and local storage are used during your visit. You can modify these settings at any time.",
        )}
      </p>

      <div class="space-y-4">
        <!-- 1. Strictly Necessary (Always On) -->
        <div class="rounded-2xl bg-white/5 p-4 ring-1 ring-white/10 transition-colors">
          <div class="flex items-center justify-between gap-4">
            <div class="flex-1 space-y-1">
              <div class="flex items-center gap-2">
                <h4 class="font-medium text-white">
                  {t("cookieConsent.necessaryTitle", "Strictly Necessary Cookies")}
                </h4>
                <span class="rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-400 ring-1 ring-emerald-500/30">
                  {t("cookieConsent.alwaysActive", "Always Active")}
                </span>
              </div>
              <p class="text-xs leading-relaxed text-zinc-400">
                {t(
                  "cookieConsent.necessaryDesc",
                  "Required for site navigation, security, language selection, and core features. These cannot be disabled.",
                )}
              </p>
            </div>
            <!-- Locked Active Switch -->
            <label
              class="relative inline-flex shrink-0 cursor-not-allowed items-center"
              for="cookie-toggle-necessary"
            >
              <input
                checked
                class="amsirar-toggle-input sr-only"
                disabled
                id="cookie-toggle-necessary"
                type="checkbox"
              />
              <div
                aria-hidden="true"
                class="amsirar-toggle-track is-locked"
              >
                <div class="amsirar-toggle-thumb">
                  <svg
                    class="size-3 text-emerald-600"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      clip-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      fill-rule="evenodd"
                    ></path>
                  </svg>
                </div>
              </div>
            </label>
          </div>
        </div>

        <!-- 2. Analytics & Performance -->
        <div class="group rounded-2xl bg-white/5 p-4 ring-1 ring-white/10 transition-colors hover:bg-white/[0.07] hover:ring-white/20">
          <div class="flex items-center justify-between gap-4">
            <label
              class="flex-1 cursor-pointer space-y-1"
              for="cookie-toggle-analytics"
            >
              <h4 class="font-medium text-white transition-colors group-hover:text-orange-200">
                {t("cookieConsent.analyticsTitle", "Analytics & Performance")}
              </h4>
              <p class="text-xs leading-relaxed text-zinc-400">
                {t(
                  "cookieConsent.analyticsDesc",
                  "Enables anonymous traffic metrics to help us understand popular itineraries and improve loading performance.",
                )}
              </p>
            </label>
            <!-- Interactive Switch Toggle -->
            <label
              class="relative inline-flex shrink-0 cursor-pointer items-center"
              for="cookie-toggle-analytics"
            >
              <input
                class="amsirar-toggle-input sr-only"
                id="cookie-toggle-analytics"
                type="checkbox"
              />
              <div
                aria-hidden="true"
                class="amsirar-toggle-track"
              >
                <div class="amsirar-toggle-thumb"></div>
              </div>
            </label>
          </div>
        </div>

        <!-- 3. Preferences & Functional -->
        <div class="group rounded-2xl bg-white/5 p-4 ring-1 ring-white/10 transition-colors hover:bg-white/[0.07] hover:ring-white/20">
          <div class="flex items-center justify-between gap-4">
            <label
              class="flex-1 cursor-pointer space-y-1"
              for="cookie-toggle-functional"
            >
              <h4 class="font-medium text-white transition-colors group-hover:text-orange-200">
                {t("cookieConsent.functionalTitle", "Preferences & Functional")}
              </h4>
              <p class="text-xs leading-relaxed text-zinc-400">
                {t(
                  "cookieConsent.functionalDesc",
                  "Remembers your choices (such as interactive agency maps and currency preferences) for a smoother journey.",
                )}
              </p>
            </label>
            <!-- Interactive Switch Toggle -->
            <label
              class="relative inline-flex shrink-0 cursor-pointer items-center"
              for="cookie-toggle-functional"
            >
              <input
                class="amsirar-toggle-input sr-only"
                id="cookie-toggle-functional"
                type="checkbox"
              />
              <div
                aria-hidden="true"
                class="amsirar-toggle-track"
              >
                <div class="amsirar-toggle-thumb"></div>
              </div>
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer Actions -->
    <div class="flex flex-col-reverse items-center justify-between gap-3 border-t border-white/10 bg-slate-900/60 px-6 py-4 sm:flex-row">
      <a
        class="text-xs font-medium text-zinc-400 underline underline-offset-2 transition-colors hover:text-white"
        href={privacyPolicyHref}
      >
        {t("cookieConsent.privacyPolicyLink", "Read our Privacy Policy")}
      </a>

      <div class="flex w-full items-center justify-end gap-2.5 sm:w-auto">
        <button
          class="flex-1 cursor-pointer rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-xs font-semibold text-zinc-200 transition-all hover:bg-white/10 sm:flex-none sm:text-sm"
          data-cookie-reject-all
          type="button"
        >
          {t("cookieConsent.rejectAll", "Essential Only")}
        </button>

        <button
          class="flex-1 cursor-pointer rounded-xl bg-orange-600 px-5 py-2.5 text-xs font-semibold text-white shadow-md shadow-orange-600/30 transition-all hover:bg-orange-500 sm:flex-none sm:text-sm"
          data-cookie-save-preferences
          type="button"
        >
          {t("cookieConsent.savePreferences", "Save Preferences")}
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- 3. Discreet Floating Cookie Settings Badge -->
<!-- ========================================== -->
<button
  aria-label={t("cookieConsent.modalTitle", "Cookie Settings")}
  class="fixed bottom-6 left-6 z-40 flex size-11 cursor-pointer items-center justify-center rounded-full bg-slate-950/90 text-orange-200/80 shadow-lg backdrop-blur-md ring-1 ring-white/10 transition-all duration-300 hover:scale-105 hover:bg-slate-900 hover:text-orange-400 hover:ring-orange-500/50 active:scale-95"
  data-cookie-open-preferences
  id="cookie-badge-btn"
  title={t("cookieConsent.customize", "Cookie Settings")}
  type="button"
>
  <svg
    class="size-5"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    viewBox="0 0 24 24"
  >
    <path
      d="M12 2a10 10 0 1010 10c0-1.5-1-2.5-2.5-2.5a2.5 2.5 0 01-2.5-2.5c0-1.5-1-2.5-2.5-2.5a2.5 2.5 0 01-2.5-2.5z"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <circle
      cx="8.5"
      cy="8.5"
      fill="currentColor"
      r="1"
    ></circle>
    <circle
      cx="7.5"
      cy="14.5"
      fill="currentColor"
      r="1"
    ></circle>
    <circle
      cx="14.5"
      cy="14.5"
      fill="currentColor"
      r="1"
    ></circle>
    <circle
      cx="12"
      cy="11"
      fill="currentColor"
      r="0.75"
    ></circle>
    <circle
      cx="16.5"
      cy="10"
      fill="currentColor"
      r="0.75"
    ></circle>
  </svg>
</button>

<style>
  /* Custom Toggle Switch - Smooth Glide Animation */
  .amsirar-toggle-track {
    width: 48px;
    height: 26px;
    border-radius: 9999px;
    background-color: #27272a;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    padding: 2px;
    transition:
      background-color 0.28s ease,
      border-color 0.28s ease,
      box-shadow 0.28s ease;
    cursor: pointer;
  }

  .amsirar-toggle-thumb {
    width: 20px;
    height: 20px;
    border-radius: 9999px;
    background-color: #ffffff;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.35);
    transform: translateX(0);
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Active checked state: circle moves 22px to the right */
  .amsirar-toggle-input:checked + .amsirar-toggle-track {
    background-color: #ea580c;
    border-color: rgba(251, 146, 60, 0.7);
    box-shadow: 0 0 14px rgba(234, 88, 12, 0.45);
  }

  .amsirar-toggle-input:checked + .amsirar-toggle-track .amsirar-toggle-thumb {
    transform: translateX(22px);
  }

  /* Focus outline for keyboard accessibility */
  .amsirar-toggle-input:focus-visible + .amsirar-toggle-track {
    outline: 2px solid #f97316;
    outline-offset: 3px;
  }

  /* Necessary Cookies - Locked Active State */
  .amsirar-toggle-track.is-locked {
    background-color: #059669;
    border-color: rgba(52, 211, 153, 0.6);
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.35);
    cursor: not-allowed;
  }

  .amsirar-toggle-track.is-locked .amsirar-toggle-thumb {
    transform: translateX(22px);
  }
</style>

<script src="../../scripts/cookie-consent.ts"></script>
