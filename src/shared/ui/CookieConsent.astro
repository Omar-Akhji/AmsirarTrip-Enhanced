---
import { useTranslations } from "@/i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Cookie, X } from "@lucide/astro";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const privacyPolicyHref = getRelativeLocaleUrl(locale, "/privacy-policy");
---

<!-- Floating Cookie Banner -->
<aside
  aria-describedby="cookie-banner-desc"
  aria-labelledby="cookie-banner-title"
  aria-label="Cookie consent"
  class="pointer-events-none fixed inset-x-4 inset-be-4 z-50 transition-[opacity,transform] duration-200 ease-out opacity-0 translate-y-3 sm:inset-s-auto sm:inset-e-6 sm:inset-be-6 sm:max-w-md md:max-w-lg hidden"
  id="cookie-banner"
  role="region"
>
  <div class="pointer-events-auto relative overflow-hidden rounded-2xl border border-white/10 bg-slate-950 p-5 sm:p-6 text-white shadow-xl">
    <div class="flex items-start gap-4">
      <div class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-orange/20 bg-orange/10 text-orange-400 sm:size-11">
        <Cookie
          class="size-5"
          stroke-width={1.75}
        />
      </div>

      <div class="flex-1 space-y-1.5">
        <h2
          class="text-sm font-semibold tracking-tight text-white sm:text-base font-sans"
          id="cookie-banner-title"
        >
          {t("cookieConsent.title", "Cookie preferences")}
        </h2>
        <p
          class="text-xs leading-relaxed text-zinc-300 sm:text-[13px]"
          id="cookie-banner-desc"
        >
          {t(
            "cookieConsent.description",
            "We use essential cookies to maintain secure sessions and keep your chosen language. With your consent, we also collect anonymized metrics to improve tour itineraries.",
          )}{" "}
          <a
            class="font-medium text-orange-400 underline underline-offset-4 decoration-orange-400/40 transition-colors hover:text-orange-300 hover:decoration-orange-300 focus-visible:outline-2 focus-visible:outline-orange-400 rounded-xs"
            href={privacyPolicyHref}
          >
            {t("cookieConsent.privacyPolicyLink", "Read our Privacy Policy")}
          </a>
        </p>
      </div>
    </div>

    <div class="mbs-4 flex flex-col gap-2.5 border-bs border-white/10 pbs-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="grid grid-cols-2 gap-2.5 sm:flex sm:items-center sm:gap-2">
        <button
          class="inline-flex min-h-11 h-11 cursor-pointer items-center justify-center whitespace-nowrap shrink-0 rounded-xl bg-orange px-4 font-sans text-xs font-semibold text-white shadow-sm transition-colors hover:bg-orange-dark active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-400 sm:h-10 sm:min-h-10 sm:text-sm"
          data-cookie-accept-all
          type="button"
        >
          <span>{t("cookieConsent.acceptAll", "Accept All")}</span>
        </button>

        <button
          class="inline-flex min-h-11 h-11 cursor-pointer items-center justify-center whitespace-nowrap shrink-0 rounded-xl border border-white/15 bg-white/5 px-4 font-sans text-xs font-medium text-zinc-200 transition-colors hover:border-white/25 hover:bg-white/10 hover:text-white active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-400 sm:h-10 sm:min-h-10 sm:text-sm"
          data-cookie-reject-all
          type="button"
        >
          <span>{t("cookieConsent.rejectAll", "Essential Only")}</span>
        </button>
      </div>

      <button
        class="inline-flex min-h-11 h-11 cursor-pointer items-center justify-center whitespace-nowrap shrink-0 rounded-xl border border-transparent px-3 font-sans text-xs font-medium text-zinc-400 transition-colors hover:text-white hover:bg-white/5 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-400 sm:h-10 sm:min-h-10"
        data-cookie-open-preferences
        type="button"
      >
        <span>{t("cookieConsent.customize", "Cookie Settings")}</span>
      </button>
    </div>
  </div>
</aside>

<!-- Cookie Preferences Modal -->
<dialog
  aria-labelledby="cookie-modal-title"
  class="cookie-preferences-dialog fixed inset-0 m-auto z-50 max-h-[calc(100dvh-2rem)] sm:max-h-[calc(100dvh-3rem)] lg:max-h-140 w-[calc(100vw-2rem)] sm:w-full max-w-xl flex-col overflow-hidden rounded-2xl border border-white/10 bg-slate-950 p-0 text-white shadow-2xl scheme-dark backdrop:bg-black/75 backdrop:backdrop-blur-xs open:flex"
  id="cookie-preferences-modal"
>
  <div class="flex items-center justify-between border-b border-white/10 bg-slate-900/60 px-5 py-4 sm:px-6">
    <div>
      <p class="text-[11px] font-medium tracking-wide text-orange-400/90 uppercase">
        {t("cookieConsent.complianceNote", "Privacy Controls")}
      </p>
      <h2
        class="mbs-0.5 text-base font-semibold tracking-tight text-white sm:text-lg font-sans"
        id="cookie-modal-title"
      >
        {t("cookieConsent.modalTitle", "Cookie & Privacy Preferences")}
      </h2>
    </div>

    <form
      method="dialog"
      class="m-0"
    >
      <button
        aria-label={t("cookieConsent.close", "Close")}
        class="inline-flex size-8 cursor-pointer items-center justify-center rounded-lg border border-white/10 bg-white/5 text-zinc-400 transition-colors hover:bg-white/10 hover:text-white focus-visible:outline-2 focus-visible:outline-orange-400"
        data-cookie-close-preferences
        type="submit"
        value="cancel"
      >
        <X
          class="size-4"
          stroke-width={2}
        />
      </button>
    </form>
  </div>

  <div class="dark-scrollbar flex-1 flex flex-col gap-4 overflow-y-auto p-5 sm:p-6 text-sm text-zinc-300">
    <div class="rounded-xl border border-white/10 bg-white/3 p-4 text-xs leading-relaxed text-zinc-300 sm:text-[13px]">
      <p>
        {t(
          "cookieConsent.modalSubtitle",
          "Choose which cookies you allow on your device. You can update or withdraw your consent at any time.",
        )}
      </p>
    </div>

    <div class="flex flex-col gap-3">
      <div class="rounded-xl border border-white/10 bg-white/2 p-4 sm:p-5">
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-sm font-semibold tracking-tight text-white sm:text-base font-sans">
                {t("cookieConsent.necessaryTitle", "Essential cookies")}
              </h3>
              <span class="inline-flex items-center rounded-sm border border-emerald-500/30 bg-emerald-500/10 px-2 py-1 text-[11px] font-medium text-emerald-400">
                {t("cookieConsent.alwaysActive", "Always Active")}
              </span>
            </div>
            <p class="pbs-2 text-xs leading-relaxed text-zinc-300 sm:text-[13px]">
              {t(
                "cookieConsent.necessaryDesc",
                "Required for secure navigation, session security, and language routing. These cannot be disabled.",
              )}
            </p>
          </div>

          <div class="relative inline-flex shrink-0 cursor-not-allowed items-center pbs-1">
            <input
              checked
              class="amsirar-toggle-input peer sr-only"
              disabled
              id="cookie-toggle-necessary"
              type="checkbox"
            />
            <div
              aria-hidden="true"
              class="amsirar-toggle-track is-locked flex h-6 w-11 shrink-0 cursor-not-allowed select-none items-center rounded-full border border-emerald-600/80 bg-emerald-700 p-0.5"
            >
              <div class="amsirar-toggle-thumb flex size-5 shrink-0 translate-x-5 rounded-full bg-white shadow-xs"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="group rounded-xl border border-white/10 bg-white/2 p-4 transition-colors hover:border-white/20 sm:p-5">
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <label
              class="flex cursor-pointer flex-wrap items-center gap-2"
              for="cookie-toggle-analytics"
            >
              <h3 class="text-sm font-semibold tracking-tight text-white transition-colors group-hover:text-orange-300 sm:text-base font-sans">
                {t("cookieConsent.analyticsTitle", "Analytics cookies")}
              </h3>
              <span class="inline-flex items-center rounded-sm border border-white/10 bg-white/5 px-2 py-1 text-[11px] font-medium text-zinc-400">
                {t("cookieConsent.optional", "Optional")}
              </span>
            </label>
            <p class="pbs-2 text-xs leading-relaxed text-zinc-300 sm:text-[13px]">
              {t(
                "cookieConsent.analyticsDesc",
                "Collects anonymous page visit counts and speed metrics to help us see which tour itineraries are popular and improve site performance.",
              )}
            </p>
          </div>

          <label
            class="relative inline-flex shrink-0 cursor-pointer items-center pbs-1"
            for="cookie-toggle-analytics"
          >
            <input
              class="amsirar-toggle-input peer sr-only"
              id="cookie-toggle-analytics"
              type="checkbox"
            />
            <div
              aria-hidden="true"
              class="amsirar-toggle-track flex h-6 w-11 shrink-0 cursor-pointer select-none items-center rounded-full border border-white/20 bg-zinc-800 p-0.5 transition-colors peer-focus-visible:ring-2 peer-focus-visible:ring-orange-400 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-slate-950"
            >
              <div class="amsirar-toggle-thumb flex size-5 shrink-0 rounded-full bg-white shadow-xs will-change-transform"></div>
            </div>
          </label>
        </div>
      </div>

      <div class="group rounded-xl border border-white/10 bg-white/2 p-4 transition-colors hover:border-white/20 sm:p-5">
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <label
              class="flex cursor-pointer flex-wrap items-center gap-2"
              for="cookie-toggle-functional"
            >
              <h3 class="text-sm font-semibold tracking-tight text-white transition-colors group-hover:text-orange-300 sm:text-base font-sans">
                {t("cookieConsent.functionalTitle", "Preference cookies")}
              </h3>
              <span class="inline-flex items-center rounded-sm border border-white/10 bg-white/5 px-2 py-1 text-[11px] font-medium text-zinc-400">
                {t("cookieConsent.optional", "Optional")}
              </span>
            </label>
            <p class="pbs-2 text-xs leading-relaxed text-zinc-300 sm:text-[13px]">
              {t(
                "cookieConsent.functionalDesc",
                "Remembers your choices (such as interactive itinerary map views and currency selections) across visits.",
              )}
            </p>
          </div>

          <label
            class="relative inline-flex shrink-0 cursor-pointer items-center pbs-1"
            for="cookie-toggle-functional"
          >
            <input
              class="amsirar-toggle-input peer sr-only"
              id="cookie-toggle-functional"
              type="checkbox"
            />
            <div
              aria-hidden="true"
              class="amsirar-toggle-track flex h-6 w-11 shrink-0 cursor-pointer select-none items-center rounded-full border border-white/20 bg-zinc-800 p-0.5 transition-colors peer-focus-visible:ring-2 peer-focus-visible:ring-orange-400 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-slate-950"
            >
              <div class="amsirar-toggle-thumb flex size-5 shrink-0 rounded-full bg-white shadow-xs will-change-transform"></div>
            </div>
          </label>
        </div>
      </div>
    </div>
  </div>

  <div class="flex flex-col gap-4 border-bs border-white/10 bg-slate-900/60 px-5 py-4 sm:px-6">
    <div>
      <a
        class="inline-flex items-center text-xs text-zinc-400 underline underline-offset-4 decoration-zinc-600 transition-colors hover:text-orange-400 hover:decoration-orange-400 focus-visible:outline-2 focus-visible:outline-orange-400 rounded-xs"
        href={privacyPolicyHref}
      >
        <span>{t("cookieConsent.privacyPolicyLink", "Read our Privacy Policy")}</span>
      </a>
    </div>

    <div class="flex flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-3">
      <div class="grid grid-cols-2 gap-2 sm:flex sm:items-center sm:gap-2">
        <button
          class="inline-flex h-9 cursor-pointer items-center justify-center whitespace-nowrap shrink-0 rounded-lg border border-white/15 bg-white/5 px-4 font-sans text-xs font-medium text-zinc-200 transition-colors hover:border-white/25 hover:bg-white/10 hover:text-white active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-400 sm:text-sm"
          data-cookie-reject-all
          type="button"
        >
          <span>{t("cookieConsent.rejectAll", "Essential Only")}</span>
        </button>

        <button
          class="inline-flex h-9 cursor-pointer items-center justify-center whitespace-nowrap shrink-0 rounded-lg border border-white/15 bg-white/5 px-4 font-sans text-xs font-medium text-zinc-200 transition-colors hover:border-white/25 hover:bg-white/10 hover:text-white active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-400 sm:text-sm"
          data-cookie-accept-all
          type="button"
        >
          <span>{t("cookieConsent.acceptAll", "Accept All")}</span>
        </button>
      </div>

      <button
        class="inline-flex h-9 cursor-pointer items-center justify-center whitespace-nowrap shrink-0 rounded-lg bg-linear-to-br from-amber-orange to-orange px-4 font-sans text-xs font-semibold text-white shadow-sm shadow-orange/25 transition-all duration-150 hover:brightness-105 hover:shadow-md hover:shadow-orange/35 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-400 sm:text-sm"
        data-cookie-save-preferences
        type="button"
      >
        <span>{t("cookieConsent.savePreferences", "Save Preferences")}</span>
      </button>
    </div>
  </div>
</dialog>

<!-- Cookie Settings Trigger -->
<button
  aria-label={t("cookieConsent.modalTitle", "Cookie Settings")}
  class="group fixed inset-e-0 inset-be-20 z-40 flex size-11 cursor-pointer items-center justify-start ps-2.5 rounded-s-md border-[1.5px] border-e-0 border-white/15 bg-slate-950/95 text-zinc-300 shadow-md backdrop-blur-md transition-[transform,background-color,border-color,color,box-shadow] duration-200 ease-out pointer-fine:hover:-translate-x-1.5 pointer-fine:hover:border-orange-400/50 pointer-fine:hover:bg-slate-900 pointer-fine:hover:text-white pointer-fine:hover:shadow-xl focus-visible:outline-2 focus-visible:outline-orange-400 motion-reduce:transform-none"
  data-cookie-open-preferences
  id="cookie-badge-btn"
  title={t("cookieConsent.customize", "Cookie Settings")}
  type="button"
>
  <Cookie
    class="size-6 shrink-0 text-orange-400 transition-transform duration-200 ease-out pointer-fine:group-hover:scale-110 motion-reduce:transform-none"
    stroke-width={1.75}
  />
</button>

<script src="../../scripts/cookie-consent.ts"></script>
