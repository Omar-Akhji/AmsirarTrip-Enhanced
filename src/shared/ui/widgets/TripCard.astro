---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  readonly item: {
    readonly image: ImageMetadata | string;
    readonly route: string;
    readonly imageAlt?: string | undefined;
    readonly alt?: string | undefined;
  };
  readonly title: string;
  readonly description: string;
  readonly exploreLink?: string | undefined;
  readonly badge?: string | undefined;
  readonly priority?: boolean | undefined;
  readonly tagline?: string | undefined;
  readonly start?: string | undefined;
  readonly end?: string | undefined;
  readonly startLabel?: string | undefined;
  readonly endLabel?: string | undefined;
  readonly transitionName?: string | undefined;
  readonly tourTypeBadge?: string | undefined;
}

const {
  item,
  title,
  description,
  exploreLink = "Explore",
  badge,
  priority = false,
  tagline,
  start,
  end,
  startLabel,
  endLabel,
  transitionName,
  tourTypeBadge,
} = Astro.props;

const locale = Astro.currentLocale || "en";

const cardTransitionName =
  transitionName
  || (item.route.length > 0 ?
    `trip-image-${item.route.replace(/^\/+/, "").replaceAll(/[^a-zA-Z0-9_-]/g, "-")}`
  : undefined);

const categoryText = badge || tagline || "Morocco Tour";
---

<article
  data-ascii="surface"
  class="group relative flex flex-col justify-between overflow-hidden rounded-[2.5rem] border border-stone-200/90 bg-white p-4 shadow-[0_20px_40px_-14px_rgba(0,0,0,0.12)] transition duration-500 ease-out-expo size-full dark:border-white/10 dark:bg-surface-card/85 dark:shadow-[0_4px_20px_-2px_rgba(0,0,0,0.4)] pointer-fine:hover:-translate-y-1.5 pointer-fine:hover:shadow-[0_28px_50px_-14px_rgba(0,0,0,0.22)] dark:pointer-fine:hover:border-white/20 dark:pointer-fine:hover:bg-surface-hover/95 dark:pointer-fine:hover:shadow-[0_16px_36px_-8px_rgba(0,0,0,0.6)]"
>
  {/* Full-card accessible click target */}
  <a
    class="absolute inset-0 z-30 rounded-[2.5rem] focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-stone-900"
    href={getRelativeLocaleUrl(locale, item.route)}
  >
    <span class="sr-only">
      {exploreLink} - {title}
    </span>
  </a>

  {/* Image Thumbnail with Scoop Category Tab & Hover Reveal Stack */}
  <div class="relative aspect-golden w-full shrink-0 overflow-hidden rounded-3xl bg-stone-100 dark:bg-surface-card">
    {/* Inverted Scoop Category Badge at Top-Left */}
    <div
      class="absolute top-0 left-0 z-20 pointer-events-none inline-flex items-center px-5 py-2 rounded-ee-2xl bg-white dark:bg-surface-card drop-shadow-[4px_4px_6px_rgba(0,0,0,0.12)] before:content-[''] before:absolute before:top-0 before:left-full before:size-4 before:bg-inherit before:[-webkit-mask-image:radial-gradient(circle_at_100%_100%,transparent_16px,#000_17px)] before:mask-[radial-gradient(circle_at_100%_100%,transparent_16px,#000_17px)] after:content-[''] after:absolute after:top-full after:left-0 after:size-4 after:bg-inherit after:[-webkit-mask-image:radial-gradient(circle_at_100%_100%,transparent_16px,#000_17px)] after:mask-[radial-gradient(circle_at_100%_100%,transparent_16px,#000_17px)]"
      data-ascii="fade"
    >
      <span class="font-mono text-[11px] font-bold tracking-[0.08em] uppercase text-orange-600 dark:text-yellow">
        {categoryText}
      </span>
    </div>

    {/* Thumbnail Stack (Dual-layer wipe on hover) */}
    <div class="relative grid size-full overflow-hidden rounded-3xl filter-[url(#svg-inset-shadow)] *:col-start-1 *:row-start-1 *:size-full">
      {/* Base Layer: Atmospheric tone */}
      <Image
        alt={item.imageAlt || item.alt || title || "Morocco Trip"}
        class="size-full object-cover filter-[brightness(0.92)_saturate(0.9)] motion-reduce:filter-none"
        decoding="async"
        height={480}
        loading={priority ? "eager" : "lazy"}
        sizes="(max-width: 480px) 320px, (max-width: 640px) 480px, (max-width: 1024px) 560px, 640px"
        src={item.image as ImageMetadata}
        {...(cardTransitionName ? { "transition:name": cardTransitionName } : {})}
        width={640}
        widths={[320, 480, 640]}
      />

      {/* Reveal Layer: Vibrant color unveil with clip-path on hover */}
      <Image
        alt=""
        aria-hidden="true"
        class="pointer-events-none size-full object-cover [clip-path:inset(100%_0_0_0_round_24px)] pointer-fine:group-hover:[clip-path:inset(0_0_0_0_round_24px)] transition-[clip-path] duration-500 ease-out-expo motion-reduce:hidden"
        decoding="async"
        height={480}
        loading="lazy"
        sizes="(max-width: 480px) 320px, (max-width: 640px) 480px, (max-width: 1024px) 560px, 640px"
        src={item.image as ImageMetadata}
        width={640}
        widths={[320, 480, 640]}
      />
    </div>
  </div>

  {/* Content Body */}
  <div class="flex flex-1 flex-col pt-4 pb-1">
    {/* Tagline Badge with Gray Background (On top of title) */}
    {tagline && (
      <div class="mbe-2 flex flex-wrap items-center gap-2">
        <span class="inline-flex rounded-full bg-stone-100 px-3 py-1 font-mono text-xs font-medium text-stone-700 dark:bg-white/10 dark:text-mist-200">
          {tagline}
        </span>
      </div>
    )}

    {/* Heading */}
    <div class="mbe-2">
      <h3 class="line-clamp-2 text-xl font-bold tracking-tight text-stone-900 transition-colors duration-200 group-hover:text-orange-600 dark:text-mist-100 dark:group-hover:text-orange-400">
        {title}
      </h3>
    </div>

    {/* Description */}
    <p class="mbe-3 line-clamp-3 text-sm leading-relaxed text-stone-600 dark:text-mist-300">
      {description}
    </p>

    {/* Start / End Itinerary Box */}
    {start && end && (
      <dl class="mt-auto mbe-3 m-0 grid grid-cols-2 gap-3 rounded-xl border border-stone-200/80 bg-stone-50/80 px-3.5 py-2.5 text-xs font-mono dark:border-white/10 dark:bg-white/5">
        <div class="flex flex-col">
          <dt class="text-[10px] tracking-wider text-stone-400 uppercase dark:text-mist-400">
            {startLabel}
          </dt>
          <dd class="m-0 truncate font-semibold text-stone-900 dark:text-mist-100">{start}</dd>
        </div>
        <div class="flex flex-col border-s border-stone-200/80 ps-3 dark:border-white/10">
          <dt class="text-[10px] tracking-wider text-stone-400 uppercase dark:text-mist-400">
            {endLabel}
          </dt>
          <dd class="m-0 truncate font-semibold text-stone-900 dark:text-mist-100">{end}</dd>
        </div>
      </dl>
    )}

    {/* Action Row: Tour Type Badge (Left) + Signature Reserve-Style Action Button (Right) */}
    <div
      class:list={["pt-2 flex items-center justify-between gap-3", !start && "mt-auto"]}
      data-ascii="fade"
    >
      {tourTypeBadge && (
        <span class="inline-flex items-center rounded-full border border-stone-200/90 bg-stone-100/90 px-3 py-1.5 font-mono text-[10px] font-semibold tracking-wider text-stone-700 uppercase shadow-xs transition-colors duration-300 group-hover:border-stone-300 group-hover:bg-stone-200/90 dark:border-white/10 dark:bg-white/5 dark:text-mist-200 dark:group-hover:border-white/20 dark:group-hover:bg-white/10">
          {tourTypeBadge}
        </span>
      )}
      <div class="inline-flex min-h-12 items-center justify-between gap-3 rounded-full border border-white/10 bg-slate-950 py-1.5 ps-5 pe-1.5 font-mono text-xs font-semibold tracking-wider text-white uppercase shadow-lg shadow-black/25 transition-colors duration-200 group-hover:border-white/20 group-hover:bg-black group-hover:shadow-xl sm:gap-4 sm:ps-6 sm:pe-2 dark:border-stone-300 dark:bg-white dark:text-dark-surface dark:group-hover:bg-white">
        <span class="truncate">{exploreLink}</span>
        <span class="relative flex size-8 shrink-0 items-center justify-center overflow-hidden rounded-full bg-linear-to-br from-amber-orange to-orange text-white shadow-xs shadow-orange/40 transition-transform duration-300 ease-out group-hover:scale-105">
          <span class="relative flex size-full items-center justify-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="absolute size-4.5 transition-all duration-300 ease-out group-hover:translate-x-3 group-hover:-translate-y-3 group-hover:opacity-0 rtl:-scale-x-100 rtl:group-hover:-translate-x-3"
              aria-hidden="true"
            >
              <path d="M18 15V6H9M18 6L11.5 12.5M6 18L8.5 15.5" />
            </svg>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="absolute size-4.5 -translate-x-3 translate-y-2 opacity-0 transition-all duration-300 ease-out group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100 rtl:translate-x-3 rtl:-scale-x-100 rtl:group-hover:translate-x-0"
              aria-hidden="true"
            >
              <path d="M14 18L20 12L14 6M20 12H9.5M4 12H6.5" />
            </svg>
          </span>
        </span>
      </div>
    </div>
  </div>

  {/* Inset Shadow Filter */}
  <svg
    aria-hidden="true"
    class="sr-only"
    height="0"
    width="0"
  >
    <filter id="svg-inset-shadow">
      <feOffset
        dx="4"
        dy="6"
        in="SourceAlpha"
      />
      <feGaussianBlur
        in="SourceAlpha"
        stdDeviation="6"
      />
      <feComposite
        in="SourceAlpha"
        operator="out"
      />
      <feBlend
        in2="SourceGraphic"
        mode="multiply"
      />
    </filter>
  </svg>
</article>
