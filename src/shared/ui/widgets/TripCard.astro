---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import ActionPill from "@/shared/ui/primitives/ActionPill.astro";

interface Props {
  readonly badge?: string | undefined;
  readonly description: string;
  readonly end?: string | undefined;
  readonly endLabel?: string | undefined;
  readonly exploreLink?: string | undefined;
  readonly item: {
    readonly image: ImageMetadata | string;
    readonly route: string;
    readonly imageAlt?: string | undefined;
    readonly alt?: string | undefined;
  };
  readonly priority?: boolean | undefined;
  readonly start?: string | undefined;
  readonly startLabel?: string | undefined;
  readonly tagline?: string | undefined;
  readonly title: string;
  readonly tourTypeBadge?: string | undefined;
  readonly transitionName?: string | undefined;
}

const {
  item,
  title,
  description,
  exploreLink = "Explore",
  badge,
  priority = false,
  tagline,
  start,
  end,
  startLabel,
  endLabel,
  transitionName,
  tourTypeBadge,
} = Astro.props;

const locale = Astro.locals.locale;

const cardTransitionName =
  transitionName
  || (item.route.length > 0 ?
    `trip-image-${item.route.replace(/^\/+/, "").replaceAll(/[^\p{L}\p{N}_-]/gu, "-")}`
  : undefined);

const categoryText = badge || tagline || "Morocco Tour";
---

<article class="group relative flex flex-col justify-between overflow-hidden rounded-[2.5rem] border border-stone-200/90 bg-white p-4 shadow-[0_20px_40px_-14px_rgba(0,0,0,0.12)] transition duration-500 ease-out-expo size-full dark:border-white/10 dark:bg-surface-card/85 dark:shadow-[0_4px_20px_-2px_rgba(0,0,0,0.4)] pointer-fine:hover:-translate-y-1.5 pointer-fine:hover:shadow-[0_28px_50px_-14px_rgba(0,0,0,0.22)] dark:pointer-fine:hover:border-white/20 dark:pointer-fine:hover:bg-surface-hover/95 dark:pointer-fine:hover:shadow-[0_16px_36px_-8px_rgba(0,0,0,0.6)]">
  {/* Full-card accessible click target */}
  <a
    class="absolute inset-0 z-30 rounded-[2.5rem] focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-stone-900"
    data-astro-prefetch
    href={getRelativeLocaleUrl(locale, item.route)}
  >
    <span class="sr-only">
      {exploreLink} - {title}
    </span>
  </a>

  {/* Image Thumbnail with Scoop Category Tab & Hover Reveal Stack */}
  <div class="relative aspect-golden w-full shrink-0 overflow-hidden rounded-3xl bg-stone-100 dark:bg-surface-card">
    {/* Inverted Scoop Category Badge at Top-Start */}
    <div class="absolute top-0 inset-s-0 z-20 pointer-events-none inline-flex items-center px-5 py-2 rounded-ee-2xl bg-white dark:bg-surface-card drop-shadow-[4px_4px_6px_rgba(0,0,0,0.12)] before:content-[''] before:absolute before:top-0 before:inset-s-full before:size-4 before:bg-inherit before:[-webkit-mask-image:radial-gradient(circle_at_100%_100%,transparent_16px,#000_17px)] before:mask-[radial-gradient(circle_at_100%_100%,transparent_16px,#000_17px)] rtl:before:scale-x-[-1] after:content-[''] after:absolute after:top-full after:inset-s-0 after:size-4 after:bg-inherit after:[-webkit-mask-image:radial-gradient(circle_at_100%_100%,transparent_16px,#000_17px)] after:mask-[radial-gradient(circle_at_100%_100%,transparent_16px,#000_17px)] rtl:after:scale-x-[-1]">
      <span class="font-mono text-[0.6875rem] font-bold tracking-[0.08em] uppercase text-orange-600 dark:text-yellow">
        {categoryText}
      </span>
    </div>

    {/* Thumbnail */}
    <div class="relative size-full overflow-hidden rounded-3xl after:pointer-events-none after:absolute after:inset-0 after:z-10 after:rounded-3xl after:shadow-[inset_0_2px_14px_rgba(0,0,0,0.24)]">
      <Image
        alt={item.imageAlt || item.alt || title || "Morocco Trip"}
        class="size-full object-cover brightness-[0.92] saturate-[0.9] transition-[filter,transform] duration-500 ease-out-expo pointer-fine:group-hover:scale-103 pointer-fine:group-hover:brightness-100 pointer-fine:group-hover:saturate-100 motion-reduce:transform-none motion-reduce:filter-none"
        data-vt-name={cardTransitionName}
        decoding="async"
        height={480}
        loading={priority ? "eager" : "lazy"}
        src={item.image as ImageMetadata}
        width={640}
      />
    </div>
  </div>

  {/* Content Body */}
  <div class="flex flex-1 flex-col pt-4 pb-1">
    {/* Tagline Badge with Gray Background (On top of title) */}
    {tagline && (
      <div class="mbe-2 flex flex-wrap items-center gap-2">
        <span class="inline-flex rounded-full bg-stone-100 px-3 py-1 font-mono text-xs font-medium text-stone-700 dark:bg-white/10 dark:text-mist-200">
          {tagline}
        </span>
      </div>
    )}

    {/* Heading */}
    <div class="mbe-2">
      <h3 class="line-clamp-2 text-xl font-bold tracking-tight text-stone-900 transition-colors duration-200 group-hover:text-orange-600 dark:text-mist-100 dark:group-hover:text-orange-400">
        {title}
      </h3>
    </div>

    {/* Description */}
    <p class="mbe-3 line-clamp-3 text-sm/relaxed text-stone-600 dark:text-mist-300">
      {description}
    </p>

    {/* Start / End Itinerary Box */}
    {start && end && (
      <dl class="mt-auto mbe-3 m-0 grid grid-cols-2 gap-3 rounded-xl border border-stone-200/80 bg-stone-50/80 px-3.5 py-2.5 text-xs font-mono dark:border-white/10 dark:bg-white/5">
        <div class="flex flex-col">
          <dt class="text-[0.625rem] tracking-wider text-stone-400 uppercase dark:text-mist-400">
            {startLabel}
          </dt>
          <dd class="m-0 truncate font-semibold text-stone-900 dark:text-mist-100">{start}</dd>
        </div>
        <div class="flex flex-col border-s border-stone-200/80 ps-3 dark:border-white/10">
          <dt class="text-[0.625rem] tracking-wider text-stone-400 uppercase dark:text-mist-400">
            {endLabel}
          </dt>
          <dd class="m-0 truncate font-semibold text-stone-900 dark:text-mist-100">{end}</dd>
        </div>
      </dl>
    )}

    {/* Action Row: Tour Type Badge (Left) + Signature Reserve-Style Action Button (Right) */}
    <div class:list={["pt-2 flex items-center justify-between gap-3", !start && "mt-auto"]}>
      {tourTypeBadge && (
        <span class="inline-flex items-center rounded-full border border-stone-200/90 bg-stone-100/90 px-3 py-1.5 font-mono text-[0.625rem] font-semibold tracking-wider text-stone-700 uppercase shadow-xs transition-colors duration-300 group-hover:border-stone-300 group-hover:bg-stone-200/90 dark:border-white/10 dark:bg-white/5 dark:text-mist-200 dark:group-hover:border-white/20 dark:group-hover:bg-white/10">
          {tourTypeBadge}
        </span>
      )}
      <ActionPill
        as="span"
        groupHoverTarget="parent"
        label={exploreLink}
        variant="adaptive"
      />
    </div>
  </div>
</article>
