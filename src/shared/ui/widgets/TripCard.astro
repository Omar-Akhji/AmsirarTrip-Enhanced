---
import { ChevronRight } from "@lucide/astro";
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import Button from "../primitives/Button.astro";

interface Props {
  readonly item: {
    readonly image: ImageMetadata | string;
    readonly route: string;
    readonly imageAlt?: string | undefined;
    readonly alt?: string | undefined;
  };
  readonly title: string;
  readonly description: string;
  readonly exploreLink?: string | undefined;
  readonly badge?: string | undefined;
  readonly priority?: boolean | undefined;
  readonly tagline?: string | undefined;
  readonly start?: string | undefined;
  readonly end?: string | undefined;
  readonly startLabel?: string | undefined;
  readonly endLabel?: string | undefined;
  readonly transitionName?: string | undefined;
}

const {
  item,
  title,
  description,
  exploreLink = "Explore",
  badge,
  priority = false,
  tagline,
  start,
  end,
  startLabel,
  endLabel,
  transitionName,
} = Astro.props;

const locale = Astro.currentLocale || "en";

const cardTransitionName =
  transitionName
  || (item.route.length > 0 ?
    `trip-image-${item.route.replace(/^\/+/, "").replaceAll(/[^a-zA-Z0-9_-]/g, "-")}`
  : undefined);

const categoryText = badge || tagline || "Morocco Tour";
---

<article class="group relative flex flex-col justify-between overflow-hidden rounded-[2.5rem] border border-stone-200/90 bg-white p-4 shadow-[0_20px_40px_-14px_rgba(0,0,0,0.12)] transition duration-500 ease-out-expo size-full dark:border-stone-800 dark:bg-stone-900/95 pointer-fine:hover:-translate-y-1.5 pointer-fine:hover:shadow-[0_28px_50px_-14px_rgba(0,0,0,0.22)]">
  {/* Full-card accessible click target */}
  <a
    class="absolute inset-0 z-30 rounded-[2.5rem] focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-stone-900"
    href={getRelativeLocaleUrl(locale, item.route)}
  >
    <span class="sr-only">
      {exploreLink} - {title}
    </span>
  </a>

  {/* Image Thumbnail with Scoop Category Tab & Hover Reveal Stack */}
  <div class="relative aspect-4/3 w-full shrink-0 overflow-hidden rounded-3xl bg-stone-100 dark:bg-stone-800">
    {/* Inverted Scoop Category Badge at Top-Left */}
    <div
      class="absolute top-0 left-0 z-20 pointer-events-none inline-flex items-center px-5 py-2 rounded-ee-2xl bg-white dark:bg-stone-900 drop-shadow-[4px_4px_6px_rgba(0,0,0,0.12)] before:content-[''] before:absolute before:top-0 before:left-full before:size-4 before:bg-inherit before:[-webkit-mask-image:radial-gradient(circle_at_100%_100%,transparent_16px,#000_17px)] before:mask-[radial-gradient(circle_at_100%_100%,transparent_16px,#000_17px)] after:content-[''] after:absolute after:top-full after:left-0 after:size-4 after:bg-inherit after:[-webkit-mask-image:radial-gradient(circle_at_100%_100%,transparent_16px,#000_17px)] after:mask-[radial-gradient(circle_at_100%_100%,transparent_16px,#000_17px)]"
      data-ascii="fade"
    >
      <span class="font-mono text-[11px] font-bold tracking-[0.08em] uppercase text-orange-600 dark:text-orange-400">
        {categoryText}
      </span>
    </div>

    {/* Thumbnail Stack (Dual-layer wipe on hover) */}
    <div class="relative grid size-full overflow-hidden rounded-3xl filter-[url(#svg-inset-shadow)] *:col-start-1 *:row-start-1 *:size-full">
      {/* Base Layer: Atmospheric tone */}
      <Image
        alt={item.imageAlt || item.alt || title || "Morocco Trip"}
        class="size-full object-cover filter-[brightness(0.92)_saturate(0.9)] motion-reduce:filter-none"
        decoding="async"
        height={480}
        loading={priority ? "eager" : "lazy"}
        sizes="(max-width: 480px) 320px, (max-width: 768px) 480px, 640px"
        src={item.image as ImageMetadata}
        {...(cardTransitionName ? { "transition:name": cardTransitionName } : {})}
        width={640}
        widths={[320, 480, 640]}
      />

      {/* Reveal Layer: Vibrant color unveil with clip-path on hover */}
      <Image
        alt=""
        aria-hidden="true"
        class="pointer-events-none size-full object-cover [clip-path:inset(100%_0_0_0_round_24px)] pointer-fine:group-hover:[clip-path:inset(0_0_0_0_round_24px)] transition-[clip-path] duration-500 ease-out-expo motion-reduce:hidden"
        decoding="async"
        height={480}
        loading="lazy"
        sizes="(max-width: 480px) 320px, (max-width: 768px) 480px, 640px"
        src={item.image as ImageMetadata}
        width={640}
        widths={[320, 480, 640]}
      />
    </div>
  </div>

  {/* Content Body */}
  <div class="flex flex-1 flex-col justify-between pt-4 pb-1">
    <div>
      {/* Tagline Badge with Gray Background (On top of title) */}
      {tagline && (
        <div class="mbe-2 flex flex-wrap items-center gap-2">
          <span class="inline-flex rounded-full bg-stone-100 px-3 py-1 font-mono text-xs font-medium text-stone-700 dark:bg-stone-800 dark:text-stone-300">
            {tagline}
          </span>
        </div>
      )}

      {/* Heading */}
      <div class="mbe-2">
        <h3 class="line-clamp-2 text-xl font-bold tracking-tight text-stone-900 transition-colors duration-200 group-hover:text-orange-600 dark:text-stone-50 dark:group-hover:text-orange-400">
          {title}
        </h3>
      </div>

      {/* Description */}
      <p class="mbe-3 line-clamp-3 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
        {description}
      </p>

      {/* Start / End Itinerary Box */}
      {start && end && (
        <dl class="mbe-3 m-0 grid grid-cols-2 gap-3 rounded-xl border border-stone-200/80 bg-stone-50/80 px-3.5 py-2.5 text-xs font-mono dark:border-stone-800 dark:bg-stone-800/40">
          <div class="flex flex-col">
            <dt class="text-[10px] tracking-wider text-stone-400 uppercase dark:text-stone-500">
              {startLabel}
            </dt>
            <dd class="m-0 truncate font-semibold text-stone-900 dark:text-stone-100">{start}</dd>
          </div>
          <div class="flex flex-col border-s border-stone-200/80 ps-3 dark:border-stone-800">
            <dt class="text-[10px] tracking-wider text-stone-400 uppercase dark:text-stone-500">
              {endLabel}
            </dt>
            <dd class="m-0 truncate font-semibold text-stone-900 dark:text-stone-100">{end}</dd>
          </div>
        </dl>
      )}
    </div>

    {/* Full Pill Action Button */}
    <div
      class="pt-2"
      data-ascii="fade"
    >
      <Button
        as="div"
        variant="card"
        size="md"
        class="w-full text-xs"
      >
        <span>{exploreLink}</span>
        <ChevronRight
          aria-hidden="true"
          class="size-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1 rtl:rotate-180 rtl:group-hover:-translate-x-1"
        />
      </Button>
    </div>
  </div>

  {/* Inset Shadow Filter */}
  <svg
    aria-hidden="true"
    class="sr-only"
    height="0"
    width="0"
  >
    <filter id="svg-inset-shadow">
      <feOffset
        dx="4"
        dy="6"
        in="SourceAlpha"
      />
      <feGaussianBlur
        in="SourceAlpha"
        stdDeviation="6"
      />
      <feComposite
        in="SourceAlpha"
        operator="out"
      />
      <feBlend
        in2="SourceGraphic"
        mode="multiply"
      />
    </filter>
  </svg>
</article>
