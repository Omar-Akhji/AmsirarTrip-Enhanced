---
interface Props {
  readonly compact?: boolean | undefined;
  readonly label: string;
  readonly tabularNums?: boolean | undefined;
  readonly truncate?: boolean | undefined;
  readonly value: string;
}

const { compact = false, label, tabularNums = false, truncate = false, value } = Astro.props;
---

<div
  class:list={[
    "grid grid-cols-[auto_minmax(0,1fr)] items-center rounded-2xl border border-stone-200/90 bg-white shadow-2xs transition-colors hover:border-stone-300 min-block-20 dark:border-white/10 dark:bg-surface-card/85 dark:hover:border-white/20",
    { "gap-x-3.5 px-4 py-3 sm:px-5 sm:py-3.5": compact, "gap-x-4 px-5 py-3": !compact },
  ]}
>
  <dt class="contents">
    <slot />
    <span class="col-start-2 row-start-1 font-mono text-xs font-semibold tracking-wider text-stone-500 uppercase dark:text-mist-400">
      {label}
    </span>
  </dt>
  <dd
    class:list={[
      "m-0 col-start-2 row-start-2 font-mono font-bold text-stone-900 dark:text-mist-100",
      {
        "text-xs/snug sm:text-sm": compact,
        "text-sm sm:text-base": !compact,
        "tabular-nums": tabularNums,
        truncate,
      },
    ]}
  >
    {value}
  </dd>
</div>
