---
import VerifiedCheckIcon from "@/shared/ui/icons/VerifiedCheckIcon.astro";

interface Props {
  readonly highlights: readonly string[];
  readonly highlightsTitle: string;
  readonly idPrefix?: string | undefined;
  readonly kicker?: string | undefined;
}

const { highlights, highlightsTitle, idPrefix = "trip", kicker = "Trip Highlights" } = Astro.props;
---

<div
  class="delay-225"
  data-animate="fade-up"
>
  <section aria-labelledby={`${idPrefix}-highlights-title`}>
    <hgroup class="mbe-4 space-y-1">
      <p class="font-sans text-xs font-bold tracking-wider text-orange-900 uppercase dark:text-orange-400">
        {kicker}
      </p>
      <h3
        class="mbs-1 text-xl font-bold tracking-tight text-stone-900 sm:text-2xl md:text-3xl dark:text-mist-100"
        id={`${idPrefix}-highlights-title`}
      >
        {highlightsTitle}
      </h3>
    </hgroup>

    <div class="rounded-2xl border border-stone-200/90 bg-white p-5 sm:p-6 shadow-2xs dark:border-white/10 dark:bg-surface-card/85">
      <ul
        role="list"
        class="m-0 p-0 list-none grid gap-x-6 gap-y-3.5 sm:grid-cols-2"
      >
        {highlights.map((highlight) => (
          <li class="flex items-start gap-3">
            <VerifiedCheckIcon
              aria-hidden="true"
              class="mbs-0.5 size-5 shrink-0 text-orange-600"
            />
            <p class="flex-1 text-start font-sans text-sm text-stone-800 leading-relaxed font-normal dark:text-mist-200">
              {highlight}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</div>
