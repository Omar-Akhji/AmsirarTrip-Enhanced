---
import SquareTopDownIcon from "@/shared/ui/icons/SquareTopDownIcon.astro";
import type { RouteMapData } from "@/features/maps/types";

interface Props {
  readonly routeMap: RouteMapData;
  readonly kicker?: string | undefined;
}

const { routeMap, kicker = "Google Maps Route" } = Astro.props;
---

<article
  aria-label={routeMap.title}
  class="overflow-hidden rounded-2xl border border-stone-200 bg-white p-4 shadow-sm dark:border-white/10 dark:bg-surface-card/85 sm:p-5"
>
  <header class="mbe-4 flex items-center justify-between gap-2 border-b border-stone-100 pb-3 dark:border-white/10">
    <span class="inline-flex items-center rounded-full border border-stone-200 bg-stone-100 px-3 py-1 font-sans text-xs font-semibold text-stone-900 shadow-2xs dark:border-white/15 dark:bg-white/10 dark:text-mist-100">
      {kicker}
    </span>
  </header>

  <!-- Google Maps Interactive Embed (Facade Pattern for Core Web Vitals) -->
  <div class="route-map-wrapper relative mbe-4 overflow-hidden rounded-xl border border-stone-200/80 bg-stone-100 dark:border-white/10 dark:bg-[#090a0d] h-64 sm:h-72">
    <!-- Lightweight Facade -->
    <div class="map-facade absolute inset-0 z-10 flex flex-col items-center justify-center p-5 text-center select-none bg-[radial-gradient(circle_at_center,rgba(249,115,22,0.12),transparent_75%)]">
      <div class="mbe-2.5 flex size-12 items-center justify-center rounded-full border border-orange-500/20 bg-orange-500/10 text-orange-600 shadow-2xs dark:text-orange-400">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="1.5"
          class="size-6 text-current solar solar-streets-map-point-broken"
          aria-hidden="true"
        >
          <path
            d="M5.5 8.7572C5.5 6.95823 7.067 5.49988 9 5.49988C10.933 5.49988 12.5 6.95823 12.5 8.7572C12.5 10.5421 11.3829 12.6248 9.64003 13.3697C9.23374 13.5433 8.76626 13.5433 8.35997 13.3697C6.61708 12.6248 5.5 10.5421 5.5 8.7572Z"
            stroke-linecap="round"
            stroke="currentColor"
          />
          <path
            d="M14.0004 13.9998L20.5004 20.4998M16 12.0003L14.0004 13.9998L6.39453 21.6057M21.6072 6.39307L19 9.00027"
            stroke-linecap="round"
            stroke="currentColor"
          />
          <path
            d="M2 12C2 16.714 2 19.0711 3.46447 20.5355C4.92893 22 7.28595 22 12 22C16.714 22 19.0711 22 20.5355 20.5355C22 19.0711 22 16.714 22 12C22 7.28595 22 4.92893 20.5355 3.46447C19.0711 2 16.714 2 12 2C7.28595 2 4.92893 2 3.46447 3.46447C2.49073 4.43821 2.16444 5.80655 2.0551 8"
            stroke-linecap="round"
            stroke="currentColor"
          />
          <path
            d="M9 9H9.0001"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke="currentColor"
          />
        </svg>
      </div>

      <p class="font-mono text-xs text-stone-500 dark:text-mist-400 mbe-3.5">
        Interactive Route Map · {routeMap.waypoints.length} Stops
      </p>

      <button
        type="button"
        class="load-route-map-btn group inline-flex min-h-11 cursor-pointer items-center justify-between gap-3 rounded-full border border-white/10 bg-slate-950 py-1.5 ps-5 pe-1.5 font-mono text-xs font-semibold tracking-wider text-white uppercase shadow-lg shadow-black/25 transition-colors duration-200 hover:border-white/20 hover:bg-black hover:shadow-xl active:scale-[0.98] sm:gap-4 sm:ps-6 sm:pe-2 dark:border-stone-300 dark:bg-white dark:text-dark-surface dark:hover:bg-white"
        data-embed-url={routeMap.googleMapsEmbedUrl}
        data-map-title={routeMap.title}
        aria-label={`Load interactive route map: ${routeMap.title}`}
      >
        <span class="truncate">Explore Route Map</span>
        <span class="relative flex size-8 shrink-0 items-center justify-center overflow-hidden rounded-full bg-linear-to-br from-amber-orange to-orange text-white shadow-xs shadow-orange/40 transition-transform duration-300 ease-out group-hover:scale-105">
          <span class="relative flex size-full items-center justify-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="absolute size-4 transition-all duration-300 ease-out group-hover:translate-x-3 group-hover:-translate-y-3 group-hover:opacity-0 rtl:-scale-x-100 rtl:group-hover:-translate-x-3"
              aria-hidden="true"
            >
              <path d="M18 15V6H9M18 6L11.5 12.5M6 18L8.5 15.5" />
            </svg>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="absolute size-4 -translate-x-3 translate-y-2 opacity-0 transition-all duration-300 ease-out group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100 rtl:translate-x-3 rtl:-scale-x-100 rtl:group-hover:translate-x-0"
              aria-hidden="true"
            >
              <path d="M14 18L20 12L14 6M20 12H9.5M4 12H6.5" />
            </svg>
          </span>
        </span>
      </button>
    </div>

    <!-- Live iframe container injected upon user interaction -->
    <div class="map-iframe-container size-full"></div>
  </div>

  <!-- Waypoints Accordion / Stops Schedule -->
  <details class="group rounded-xl border border-stone-100 bg-stone-50/50 p-2 text-stone-700 dark:border-white/10 dark:bg-white/5 dark:text-mist-200 details-content:block-0 details-content:overflow-clip details-content:opacity-0 details-content:transition-[block-size,content-visibility,opacity] details-content:duration-300 details-content:ease-out-expo details-content:transition-discrete motion-reduce:details-content:transition-none open:details-content:block-auto open:details-content:opacity-100">
    <summary class="flex cursor-pointer list-none items-center justify-between p-1.5 font-mono text-xs font-semibold text-stone-800 hover:text-orange-600 dark:text-mist-100 dark:hover:text-orange-400">
      <span class="flex items-center gap-2">
        <svg
          class="size-3.5 text-orange-500"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <circle
            cx="12"
            cy="12"
            r="3"
          ></circle>
          <path d="M12 2v3m0 14v3M2 12h3m14 0h3"></path>
        </svg>
        View {routeMap.waypoints.length} Route Stops & Schedule
      </span>
      <span class="font-mono text-xs text-stone-400 transition-transform duration-200 motion-reduce:transition-none group-open:rotate-180 dark:text-mist-400">
        ▼
      </span>
    </summary>
    <ol class="mbs-3 space-y-2 border-t border-stone-200/60 p-1.5 dark:border-white/10">
      {routeMap.waypoints.map((wp, index) => (
        <li class="flex items-start gap-2.5 text-xs">
          <span
            class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full font-mono text-[11px] font-bold"
            class:list={[
              wp.type === "start" && "bg-emerald-600 text-white",
              wp.type === "end" && "bg-rose-600 text-white",
              wp.type === "highlight" && "bg-amber-500 text-white",
              wp.type === "waypoint"
                && "bg-orange-500/20 text-orange-600 dark:bg-orange-400/20 dark:text-orange-400",
            ]}
          >
            {index + 1}
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline justify-between gap-2">
              <span class="font-semibold text-stone-900 dark:text-mist-100">{wp.name}</span>
              {wp.dayOrTime && (
                <span class="font-mono text-[10px] text-stone-400 shrink-0 dark:text-mist-400">
                  {wp.dayOrTime}
                </span>
              )}
            </div>
            {wp.description && (
              <p class="font-mono text-[11px] leading-relaxed text-stone-500 dark:text-mist-300">
                {wp.description}
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
  </details>

  <!-- External Google Maps Link -->
  <footer class="mbs-3 flex items-center justify-end gap-2 pt-2 text-[11px]">
    <a
      href={routeMap.googleMapsAppUrl}
      target="_blank"
      rel="noreferrer noopener"
      class="inline-flex items-center gap-1.5 font-mono font-medium text-orange-700 hover:text-orange-800 hover:underline dark:text-orange-400 dark:hover:text-orange-300"
    >
      Open in Google Maps
      <SquareTopDownIcon
        class="size-3.5"
        aria-hidden="true"
      />
    </a>
  </footer>
</article>

<script src="../../../scripts/route-map-facade.ts"></script>
