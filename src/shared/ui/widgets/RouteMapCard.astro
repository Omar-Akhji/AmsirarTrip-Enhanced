---
import type { RouteMapData } from "@/features/maps/types";

interface Props {
  readonly routeMap: RouteMapData;
  readonly kicker?: string | undefined;
}

const { routeMap, kicker = "Google Maps Route" } = Astro.props;
---

<article
  aria-label={routeMap.title}
  class="overflow-hidden rounded-2xl border border-stone-200 bg-white p-4 shadow-sm dark:border-white/10 dark:bg-surface-card/85 sm:p-5"
  data-ascii="surface"
>
  <header class="mbe-4 flex flex-wrap items-center justify-between gap-2 border-b border-stone-100 pb-3 dark:border-white/10">
    <div>
      <span class="inline-flex items-center gap-1.5 font-mono text-[11px] font-bold tracking-[0.16em] text-orange-600 uppercase dark:text-orange-400">
        <svg
          class="size-3.5 text-orange-500"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"></path>
        </svg>
        {kicker}
      </span>
      <h3 class="mbs-1 text-base font-bold tracking-tight text-stone-900 dark:text-mist-100 sm:text-lg">
        {routeMap.subtitle || "Expedition Route"}
      </h3>
    </div>
    {routeMap.distance && (
      <span class="inline-flex items-center rounded-full bg-stone-100 px-2.5 py-0.5 font-mono text-xs font-semibold text-stone-700 dark:bg-white/10 dark:text-mist-200">
        {routeMap.distance}
      </span>
    )}
  </header>

  <!-- Google Maps Interactive Embed -->
  <div class="relative mbe-4 overflow-hidden rounded-xl border border-stone-200/80 bg-stone-100 dark:border-white/10 dark:bg-[#090a0d]">
    <iframe
      src={routeMap.googleMapsEmbedUrl}
      title={routeMap.title}
      class="h-64 w-full border-0 sm:h-72"
      loading="lazy"
      allowfullscreen
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
    <div class="pointer-events-none absolute inset-x-2 top-2 z-10 flex items-center justify-between">
      <span class="inline-flex items-center gap-1.5 rounded-md bg-white/90 px-2 py-1 font-mono text-[10px] font-medium text-stone-700 shadow-xs backdrop-blur-xs dark:bg-surface-card/90 dark:text-mist-200">
        <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse motion-reduce:animate-none"></span>
        Live Google Route
      </span>
    </div>
  </div>

  <!-- Waypoints Accordion / Stops Schedule -->
  <details class="group rounded-xl border border-stone-100 bg-stone-50/50 p-2 text-stone-700 dark:border-white/10 dark:bg-white/5 dark:text-mist-200 details-content:block-0 details-content:overflow-clip details-content:opacity-0 details-content:transition-[block-size,content-visibility,opacity] details-content:duration-300 details-content:ease-out-expo details-content:transition-discrete motion-reduce:details-content:transition-none open:details-content:block-auto open:details-content:opacity-100">
    <summary class="flex cursor-pointer list-none items-center justify-between p-1.5 font-mono text-xs font-semibold text-stone-800 hover:text-orange-600 dark:text-mist-100 dark:hover:text-orange-400">
      <span class="flex items-center gap-2">
        <svg
          class="size-3.5 text-orange-500"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <circle
            cx="12"
            cy="12"
            r="3"
          ></circle>
          <path d="M12 2v3m0 14v3M2 12h3m14 0h3"></path>
        </svg>
        View {routeMap.waypoints.length} Route Stops & Schedule
      </span>
      <span class="font-mono text-xs text-stone-400 transition-transform duration-200 motion-reduce:transition-none group-open:rotate-180 dark:text-mist-400">
        ▼
      </span>
    </summary>
    <ol class="mbs-3 space-y-2 border-t border-stone-200/60 p-1.5 dark:border-white/10">
      {routeMap.waypoints.map((wp, index) => (
        <li class="flex items-start gap-2.5 text-xs">
          <span
            class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full font-mono text-[11px] font-bold"
            class:list={[
              wp.type === "start" && "bg-emerald-600 text-white",
              wp.type === "end" && "bg-rose-600 text-white",
              wp.type === "highlight" && "bg-amber-500 text-white",
              wp.type === "waypoint"
                && "bg-orange-500/20 text-orange-600 dark:bg-orange-400/20 dark:text-orange-400",
            ]}
          >
            {index + 1}
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline justify-between gap-2">
              <span class="font-semibold text-stone-900 dark:text-mist-100">{wp.name}</span>
              {wp.dayOrTime && (
                <span class="font-mono text-[10px] text-stone-400 shrink-0 dark:text-mist-400">{wp.dayOrTime}</span>
              )}
            </div>
            {wp.description && (
              <p class="font-mono text-[11px] leading-relaxed text-stone-500 dark:text-mist-300">
                {wp.description}
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
  </details>

  <!-- External Google Maps Link -->
  <footer class="mbs-3 flex items-center justify-between gap-2 pt-2 text-[11px]">
    {routeMap.startCity.toLowerCase() !== routeMap.endCity.toLowerCase() && (
      <span class="font-mono text-stone-400 dark:text-mist-400">
        {routeMap.startCity} ➔ {routeMap.endCity}
      </span>
    )}
    <a
      href={routeMap.googleMapsAppUrl}
      target="_blank"
      rel="noreferrer noopener"
      class="ms-auto inline-flex items-center gap-1 font-mono font-medium text-orange-600 hover:text-orange-700 hover:underline dark:text-orange-400 dark:hover:text-orange-300"
    >
      Open in Google Maps
      <svg
        class="size-3"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
        ></path>
      </svg>
    </a>
  </footer>
</article>
