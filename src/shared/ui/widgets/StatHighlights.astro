---
interface Props {
  readonly cardBg?: string;
  readonly stats: readonly {
    readonly value: string;
    readonly label: string;
    readonly description: string;
  }[];
}

import { useTranslations } from "@/i18n/utils";
import { DELAY_CLASSES } from "@/shared/ui/primitives/animation-constants";
import FolderStack from "@/shared/ui/widgets/FolderStack.astro";

const {
  stats,
  cardBg = "bg-stone-50/80 dark:bg-surface-card/75 dark:border-white/10 dark:shadow-[0_4px_20px_-2px_rgba(0,0,0,0.4)] dark:hover:border-white/20 dark:hover:bg-surface-hover/90",
} = Astro.props;
const t = useTranslations(Astro.locals.locale);
---

<div class="w-full">
  <!-- Mobile Mode: Folder Stack (matches Home page experience) -->
  <div class="block md:hidden w-full">
    <FolderStack idPrefix="highlights">
      {stats.map((stat, index) => (
        <article
          class:list={[
            "relative flex h-55 w-full flex-col justify-between rounded-2xl border border-stone-200/90",
            cardBg,
            "p-5 sm:p-6 shadow-xl shadow-stone-900/10 backdrop-blur-xs transition-shadow duration-300",
          ]}
          slot={`card-${index}`}
        >
          <div>
            <div class="mbe-3.5 flex items-center justify-between border-b border-stone-100 pb-2.5 text-[0.6875rem] font-mono uppercase tracking-wider text-stone-400 dark:border-white/10 dark:text-mist-400">
              <span class="font-semibold text-stone-600 dark:text-mist-200">
                {t("statsMeta.standard")}
              </span>
              <span class="text-stone-600 dark:text-mist-300">{t("statsMeta.verified")}</span>
            </div>
            <data
              class="text-4xl font-bold tracking-tight text-orange-700 dark:text-orange-400 block tabular-nums"
              value={stat.value}
            >
              {stat.value}
            </data>
            <h3 class="mbs-2.5 text-base font-semibold tracking-tight text-stone-900 dark:text-mist-100">
              {stat.label}
            </h3>
            <p class="mbs-1.5 text-xs/relaxed text-stone-600 dark:text-mist-300 line-clamp-2">
              {stat.description}
            </p>
          </div>
        </article>
      ))}
    </FolderStack>
  </div>

  <!-- Desktop & Tablet Mode: Responsive Multi-Column Grid -->
  <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 2xl:gap-8 items-stretch">
    {stats.map((stat, index) => (
      <div
        class:list={[
          "flex size-full",
          { "md:col-span-2 lg:col-span-1": index === stats.length - 1 && stats.length % 2 === 1 },
          DELAY_CLASSES[index] || "animate-delay-0",
        ]}
        data-animate="focus-unblur"
      >
        <article
          class:list={[
            "group relative flex size-full  flex-col justify-between rounded-2xl border border-stone-200/90",
            cardBg,
            "p-6 sm:p-7 shadow-xs shadow-stone-900/5 transition-all duration-300 hover:-translate-y-1 hover:border-stone-300 hover:shadow-md",
          ]}
        >
          <div>
            <div class="mbe-5 flex items-center justify-between border-b border-stone-100 pb-3 text-[0.6875rem] font-mono uppercase tracking-wider text-stone-400 dark:border-white/10 dark:text-mist-400">
              <span class="font-semibold text-stone-600 dark:text-mist-200">
                {t("statsMeta.standard")}
              </span>
              <span class="text-stone-600 dark:text-mist-300">{t("statsMeta.verified")}</span>
            </div>
            <data
              class="text-4xl font-bold tracking-tight text-orange-700 dark:text-orange-400 block"
              value={stat.value}
            >
              {stat.value}
            </data>
            <h3 class="mbs-3 text-base sm:text-lg font-semibold tracking-tight text-stone-900 dark:text-mist-100">
              {stat.label}
            </h3>
            <p class="mbs-2 text-sm/relaxed text-stone-600 dark:text-mist-300 text-pretty">
              {stat.description}
            </p>
          </div>
        </article>
      </div>
    ))}
  </div>
</div>
