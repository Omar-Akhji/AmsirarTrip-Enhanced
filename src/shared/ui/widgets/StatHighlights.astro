---
interface Props {
  readonly stats: readonly {
    readonly value: string;
    readonly label: string;
    readonly description: string;
  }[];
  readonly cardBg?: string;
}

import { DELAY_CLASSES } from "@/shared/ui/primitives/animation-constants";
import FolderShape from "@/shared/ui/primitives/FolderShape.astro";

const { stats, cardBg = "bg-stone-50/80" } = Astro.props;
---

<div class="w-full">
  <!-- Mobile Mode: Folder Stack (matches Home page experience) -->
  <div class="block md:hidden w-full">
    <stat-highlights-stack class="block relative w-full overflow-visible">
      <!-- Scroll runway -->
      <div class="stat-highlights-track relative w-full h-auto motion-safe:h-[220vh]">
        <!-- Pinned Stage -->
        <div class="stat-highlights-stage static h-auto top-auto select-auto motion-safe:sticky motion-safe:top-18 motion-safe:h-102.5 motion-safe:select-none w-full mx-auto overflow-visible">
          <!-- Layer 1: Folder Back Plate (z-index: 2, behind the cards) -->
          <div class="folder-back-plate hidden motion-safe:block absolute inset-x-0 bottom-4 h-66.25 overflow-visible pointer-events-none will-change-transform z-2 opacity-0 translate-y-85 drop-shadow-[0_12px_24px_rgba(0,0,0,0.5)]">
            <FolderShape id="highlights-back" variant="back" />
          </div>

          <!-- Layer 2: The Cards Stack (z-index: 10, between folder back and front pocket) -->
          <div class="cards-stack-layer static h-auto flex flex-col gap-5 motion-safe:block motion-safe:absolute motion-safe:inset-x-0 motion-safe:top-2 motion-safe:h-85 motion-safe:will-change-transform motion-safe:z-10 motion-safe:perspective-distant">
            {stats.map((stat, index) => (
              <div
                data-stack-card={index}
                class:list={[
                  "stat-card-slot static inset-auto opacity-100 transform-none w-full origin-top motion-safe:absolute motion-safe:inset-x-0 motion-safe:top-0 motion-safe:will-change-transform",
                  { "z-10": index === 0, "z-12": index === 1, "z-14": index >= 2 },
                ]}
              >
                <article
                  class:list={[
                    "stat-card relative flex h-55 w-full flex-col justify-between rounded-2xl border border-stone-200/90",
                    cardBg,
                    "p-5 sm:p-6 shadow-xl shadow-stone-900/10 backdrop-blur-xs transition-shadow duration-300",
                  ]}
                >
                  <div>
                    <div class="mbe-3.5 flex items-center justify-between border-b border-stone-100 pb-2.5 text-[11px] font-mono uppercase tracking-wider text-stone-400">
                      <span class="inline-flex items-center gap-2 font-semibold text-stone-500">
                        <span class="size-2 rounded-full bg-orange-600" />
                        Standard
                      </span>
                      <span class="text-stone-400">Verified</span>
                    </div>
                    <data
                      value={stat.value}
                      class="text-4xl font-bold tracking-tight text-orange-600 block tabular-nums"
                    >
                      {stat.value}
                    </data>
                    <h3 class="mbs-2.5 text-base font-semibold tracking-tight text-stone-900">
                      {stat.label}
                    </h3>
                    <p class="mbs-1.5 text-xs leading-relaxed text-stone-600 line-clamp-2">
                      {stat.description}
                    </p>
                  </div>
                </article>
              </div>
            ))}
          </div>

          <!-- Layer 3: Folder Front Pocket (z-index: 25, in front of the cards) -->
          <!-- Matches reference folder silhouette: tabbed folder with smooth shoulder, no texts, original obsidian palette -->
          <div class="folder-front-pocket hidden motion-safe:block absolute inset-x-0 bottom-4 h-58.75 overflow-visible pointer-events-none will-change-transform z-25 opacity-0 origin-bottom translate-y-85 drop-shadow-[0_-12px_28px_rgba(0,0,0,0.65)]">
            <FolderShape id="highlights-front" variant="front" />
          </div>
        </div>
      </div>
    </stat-highlights-stack>
  </div>

  <!-- Desktop & Tablet Mode: Responsive Multi-Column Grid -->
  <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
    {stats.map((stat, index) => (
      <div
        class:list={[
          "flex size-full",
          { "md:col-span-2 lg:col-span-1": index === stats.length - 1 && stats.length % 2 === 1 },
          DELAY_CLASSES[index] || "delay-0",
        ]}
        data-animate="fade-up"
      >
        <article
          class:list={[
            "group relative flex h-full w-full flex-col justify-between rounded-2xl border border-stone-200/90",
            cardBg,
            "p-6 sm:p-7 shadow-xs shadow-stone-900/5 transition-all duration-300 hover:-translate-y-1 hover:border-stone-300 hover:shadow-md",
          ]}
        >
          <div>
            <div class="mbe-5 flex items-center justify-between border-b border-stone-100 pb-3 text-[11px] font-mono uppercase tracking-wider text-stone-400">
              <span class="inline-flex items-center gap-2 font-semibold text-stone-500">
                <span class="size-2 rounded-full bg-orange-600" />
                Standard
              </span>
              <span class="text-stone-400">Verified</span>
            </div>
            <data
              value={stat.value}
              class="text-4xl font-bold tracking-tight text-orange-600 block"
            >
              {stat.value}
            </data>
            <h3 class="mbs-3 text-base sm:text-lg font-semibold tracking-tight text-stone-900">
              {stat.label}
            </h3>
            <p class="mbs-2 text-sm leading-relaxed text-stone-600 text-pretty">
              {stat.description}
            </p>
          </div>
        </article>
      </div>
    ))}
  </div>
</div>

<script src="../../../scripts/stat-highlights-stack.ts"></script>
