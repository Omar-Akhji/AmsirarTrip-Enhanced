---
import QuestionCircleIcon from "@/shared/ui/icons/QuestionCircleIcon.astro";

interface Props {
  readonly idPrefix?: string | undefined;
  readonly faqTitle: string;
  readonly faqs: readonly { readonly question: string; readonly answer: string }[];
  readonly categoryLabel?: string | undefined;
}

const { idPrefix = "trip", faqTitle, faqs, categoryLabel = "Common Questions" } = Astro.props;
---

<div data-animate="fade-up">
  <section aria-labelledby={`${idPrefix}-faq-title`}>
    <hgroup class="mbe-4">
      <p class="font-sans text-xs font-bold tracking-wider text-orange-700 uppercase">
        {categoryLabel}
      </p>
      <h3
        class="mbs-1 text-xl font-bold tracking-tight text-stone-900 sm:text-2xl md:text-3xl"
        id={`${idPrefix}-faq-title`}
      >
        {faqTitle}
      </h3>
    </hgroup>
    <dl
      class="overflow-hidden rounded-2xl border border-stone-200/90 bg-white shadow-2xs divide-y divide-stone-200/80"
      data-ascii="surface"
      itemscope
      itemtype="https://schema.org/FAQPage"
    >
      {faqs.map((faq) => (
        <div
          itemprop="mainEntity"
          itemscope
          itemtype="https://schema.org/Question"
        >
          <dt>
            <details class="group px-4 py-3.5 sm:px-5 sm:py-4 transition-colors open:bg-stone-50/40">
              <summary class="flex cursor-pointer items-start justify-between gap-4 text-base font-semibold text-stone-900 marker:content-none list-none select-none">
                <span
                  class="flex items-center gap-2.5 min-w-0"
                  itemprop="name"
                >
                  <QuestionCircleIcon
                    aria-hidden="true"
                    class="size-5 shrink-0 text-orange-600"
                  />
                  <span>{faq.question}</span>
                </span>
                <span
                  aria-hidden="true"
                  class="mt-0.5 shrink-0 text-orange-600 group-open:rotate-45 transition-transform duration-200 select-none font-medium text-lg leading-none"
                >
                  +
                </span>
              </summary>
              <div
                class="mt-4 pt-3.5 border-t border-stone-100 text-sm leading-relaxed text-stone-600 prose prose-sm max-w-none"
                itemprop="acceptedAnswer"
                itemscope
                itemtype="https://schema.org/Answer"
              >
                <p itemprop="text">{faq.answer}</p>
              </div>
            </details>
          </dt>
        </div>
      ))}
    </dl>
  </section>
</div>
