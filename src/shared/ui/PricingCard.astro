---
interface Props {
  readonly idPrefix?: string | undefined;
  readonly pricingTitle: string;
  readonly priceLabel: string;
  readonly price: { readonly label: string; readonly note: string };
  readonly reserveNow?: string | undefined;
  readonly reserveHref?: string | undefined;
}

const { idPrefix = "trip", pricingTitle, priceLabel, price } = Astro.props;
---

<div
  class="delay-375"
  data-animate="fade-up"
>
  <section
    aria-labelledby={`${idPrefix}-pricing-title`}
    class="rounded-2xl border border-stone-200/90 bg-stone-50/80 p-6 sm:p-8 shadow-xs"
  >
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="space-y-1">
        <hgroup class="space-y-1">
          <p class="font-sans text-xs font-bold tracking-wider text-orange-700 uppercase">
            Reservation & Pricing
          </p>
          <h3
            class="text-xl font-bold tracking-tight text-stone-900 sm:text-2xl"
            id={`${idPrefix}-pricing-title`}
          >
            {pricingTitle}
          </h3>
        </hgroup>
        <p class="font-sans text-xs font-semibold tracking-wider text-stone-500 uppercase pbs-1">
          {priceLabel}
        </p>
        <p class="font-mono text-3xl font-bold text-orange-600 tabular-nums pbs-0.5">
          {price.label}
        </p>
        <p class="font-sans text-xs text-stone-600 leading-relaxed max-w-[62ch]">{price.note}</p>
      </div>
    </div>
  </section>
</div>
