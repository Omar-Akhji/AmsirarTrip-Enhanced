---
interface Props {
  readonly stats: readonly {
    readonly value: string;
    readonly label: string;
    readonly description: string;
  }[];
  readonly cardBg?: string;
}

const { stats, cardBg = "bg-stone-50/80" } = Astro.props;
const DELAY_CLASSES = [
  "delay-0",
  "delay-150",
  "delay-300",
  "delay-[450ms]",
  "delay-[600ms]",
] as const;
---

<div class="w-full">
  <!-- Mobile Mode: Folder Stack (matches Home page experience) -->
  <div class="block md:hidden w-full">
    <stat-highlights-stack class="block relative w-full overflow-visible">
      <!-- Scroll runway -->
      <div class="stat-highlights-track relative w-full h-[220vh] motion-reduce:h-auto!">
        <!-- Pinned Stage -->
        <div class="stat-highlights-stage sticky top-18 h-102.5 w-full mx-auto overflow-visible select-none motion-reduce:static! motion-reduce:h-auto! motion-reduce:top-auto! motion-reduce:select-auto!">
          <!-- Layer 1: Folder Back Plate (z-index: 2, behind the cards) -->
          <div class="folder-back-plate absolute inset-x-0 bottom-4 h-66.25 overflow-visible pointer-events-none will-change-transform z-2 opacity-0 translate-y-85 motion-reduce:hidden!">
            <!-- 1. Top Tab: Left edge at left-0, sharing the same vertical line -->
            <div class="absolute top-0 left-0 h-7.75 w-28 rounded-tl-2xl bg-slate-950 border-t border-l border-white/10"></div>

            <!-- 2. Diagonal Slanted Shoulder: Starts at left-28 (112px), width 24px -->
            <div class="absolute top-0 left-28 h-7.75 w-6">
              <svg
                class="size-full text-slate-950"
                viewBox="0 0 24 31"
                fill="currentColor"
              >
                <polygon points="0,0 24,31 0,31"></polygon>
                <line
                  x1="0"
                  y1="0"
                  x2="24"
                  y2="31"
                  stroke="rgba(255,255,255,0.12)"
                  stroke-width="1.2"
                ></line>
              </svg>
            </div>

            <!-- 3. Top-Right Shoulder Border: Continues from shoulder to right edge -->
            <div class="absolute top-7.5 left-34 right-0 h-px bg-white/10"></div>

            <!-- 4. Main Back Body: Left edge at left-0 in exact same vertical line with tab -->
            <div class="absolute top-7.5 inset-x-0 bottom-0 rounded-b-2xl rounded-tr-2xl bg-slate-950 border-x border-b border-white/10 shadow-2xl">
              <!-- Subtle interior backdrop -->
              <div class="absolute inset-0 rounded-b-2xl rounded-tr-2xl bg-linear-to-b from-slate-900/60 to-slate-950 pointer-events-none"></div>
            </div>
          </div>

          <!-- Layer 2: The Cards Stack (z-index: 10, between folder back and front pocket) -->
          <div class="cards-stack-layer absolute inset-x-0 top-2 h-85 will-change-transform z-10 perspective-distant motion-reduce:static! motion-reduce:h-auto! motion-reduce:perspective-none! motion-reduce:flex! motion-reduce:flex-col! motion-reduce:gap-5!">
            {stats.map((stat, index) => (
              <div
                data-stack-card={index}
                class:list={[
                  "stat-card-slot absolute inset-x-0 top-0 w-full origin-top will-change-transform motion-reduce:static! motion-reduce:inset-auto! motion-reduce:transform-none! motion-reduce:opacity-100! motion-reduce:will-change-auto!",
                  { "z-10": index === 0, "z-[12]": index === 1, "z-[14]": index >= 2 },
                ]}
              >
                <article
                  class:list={[
                    "stat-card relative flex h-55 w-full flex-col justify-between rounded-2xl border border-stone-200/90 motion-reduce:transform-none!",
                    cardBg,
                    "p-5 sm:p-6 shadow-xl shadow-stone-900/10 backdrop-blur-xs transition-shadow duration-300",
                  ]}
                >
                  <div>
                    <div class="mbe-3.5 flex items-center justify-between border-b border-stone-100 pb-2.5 text-[11px] font-mono uppercase tracking-wider text-stone-400">
                      <span class="inline-flex items-center gap-2 font-semibold text-stone-500">
                        <span class="size-2 rounded-full bg-orange-600" />
                        Standard
                      </span>
                      <span class="text-stone-400">Verified</span>
                    </div>
                    <data
                      value={stat.value}
                      class="text-4xl font-bold tracking-tight text-orange-600 block tabular-nums"
                    >
                      {stat.value}
                    </data>
                    <h3 class="mbs-2.5 text-base font-semibold tracking-tight text-stone-900">
                      {stat.label}
                    </h3>
                    <p class="mbs-1.5 text-xs leading-relaxed text-stone-600 line-clamp-2">
                      {stat.description}
                    </p>
                  </div>
                </article>
              </div>
            ))}
          </div>

          <!-- Layer 3: Folder Front Pocket (z-index: 25, in front of the cards) -->
          <div class="folder-front-pocket absolute inset-x-0 bottom-4 h-58.75 rounded-2xl bg-slate-900/98 border border-white/10 shadow-[0_-14px_35px_rgba(0,0,0,0.7)] ring-1 ring-white/5 will-change-transform overflow-hidden pointer-events-none z-25 opacity-0 origin-bottom translate-y-85 motion-reduce:hidden!">
            <div class="size-full bg-linear-to-b from-slate-900/40 to-slate-950/80"></div>
          </div>
        </div>
      </div>
    </stat-highlights-stack>
  </div>

  <!-- Desktop & Tablet Mode: Responsive Multi-Column Grid -->
  <div class="hidden md:grid md:grid-cols-2 xl:grid-cols-3 gap-6 items-stretch">
    {stats.map((stat, index) => (
      <div
        class:list={[
          "flex size-full",
          { "sm:col-span-2 xl:col-span-1": index === stats.length - 1 && stats.length % 2 === 1 },
          DELAY_CLASSES[index] || "delay-0",
        ]}
        data-animate="fade-up"
      >
        <article
          class:list={[
            "group relative flex h-full w-full flex-col justify-between rounded-2xl border border-stone-200/90",
            cardBg,
            "p-6 sm:p-7 shadow-xs shadow-stone-900/5 transition-all duration-300 hover:-translate-y-1 hover:border-stone-300 hover:shadow-md",
          ]}
        >
          <div>
            <div class="mbe-5 flex items-center justify-between border-b border-stone-100 pb-3 text-[11px] font-mono uppercase tracking-wider text-stone-400">
              <span class="inline-flex items-center gap-2 font-semibold text-stone-500">
                <span class="size-2 rounded-full bg-orange-600" />
                Standard
              </span>
              <span class="text-stone-400">Verified</span>
            </div>
            <data
              value={stat.value}
              class="text-4xl font-bold tracking-tight text-orange-600 block"
            >
              {stat.value}
            </data>
            <h3 class="mbs-3 text-base sm:text-lg font-semibold tracking-tight text-stone-900">
              {stat.label}
            </h3>
            <p class="mbs-2 text-sm leading-relaxed text-stone-600 text-pretty">
              {stat.description}
            </p>
          </div>
        </article>
      </div>
    ))}
  </div>
</div>

<script src="./stat-highlights-stack.ts"></script>
