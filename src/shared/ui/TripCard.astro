---
import { ChevronRight } from "@lucide/astro";
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  readonly item: {
    readonly image: ImageMetadata | string;
    readonly route: string;
    readonly imageAlt?: string | undefined;
    readonly alt?: string | undefined;
  };
  readonly title: string;
  readonly description: string;
  readonly exploreLink?: string | undefined;
  readonly badge?: string | undefined;
  readonly priority?: boolean | undefined;
  readonly tagline?: string | undefined;
  readonly start?: string | undefined;
  readonly end?: string | undefined;
  readonly startLabel?: string | undefined;
  readonly endLabel?: string | undefined;
  readonly transitionName?: string | undefined;
}

const {
  item,
  title,
  description,
  exploreLink = "Explore",
  badge,
  priority = false,
  tagline,
  start,
  end,
  startLabel,
  endLabel,
  transitionName,
} = Astro.props;

const locale = Astro.currentLocale || "en";

const cardTransitionName =
  transitionName
  || (item.route.length > 0 ?
    `trip-image-${item.route.replace(/^\/+/, "").replaceAll(/[^a-zA-Z0-9_-]/g, "-")}`
  : undefined);
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-stone-200/90 bg-white p-4 shadow-xs transition duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] size-full dark:border-stone-800 dark:bg-stone-900/90 pointer-fine:hover:-translate-y-1 pointer-fine:hover:shadow-xl dark:pointer-fine:hover:shadow-black/40">
  <a
    class="absolute inset-0 z-20 rounded-2xl focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-stone-900"
    href={getRelativeLocaleUrl(locale, item.route)}
  >
    <span class="sr-only">
      {exploreLink} - {title}
    </span>
  </a>

  <div
    data-scroll-parallax
    class="relative aspect-4/3 shrink-0 overflow-hidden rounded-xl bg-stone-100 dark:bg-stone-800 inline-full"
  >
    <div class="parallax-media pointer-events-none absolute -inset-y-4 inset-x-0 h-[calc(100%+32px)] w-full">
      <Image
        alt={item.imageAlt || item.alt || title || "Morocco Trip"}
        class="size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105 motion-reduce:transform-none"
        height={480}
        loading={priority ? "eager" : "lazy"}
        sizes="(max-width: 480px) 320px, (max-width: 768px) 480px, 640px"
        src={item.image as ImageMetadata}
        {...(cardTransitionName ? { "transition:name": cardTransitionName } : {})}
        width={640}
        widths={[320, 480, 640]}
      />
    </div>
    <div class="absolute inset-0 bg-linear-to-t from-slate-950/70 via-transparent to-transparent opacity-60 transition-opacity duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:opacity-40"></div>

    {badge && (
      <div class="absolute inset-s-3 top-3 z-10">
        <span class="inline-flex items-center rounded-md border border-white/20 bg-slate-950/80 px-2 py-1 font-mono text-[11px] font-bold tracking-wider text-orange-300 uppercase shadow-xs backdrop-blur-xs">
          {badge}
        </span>
      </div>
    )}
  </div>

  <div class="flex flex-1 flex-col pbs-4 pbe-1">
    <hgroup class="mbe-2">
      {tagline && (
        <p class="mbe-1 font-mono text-xs font-semibold tracking-wider text-orange-600 dark:text-orange-400 uppercase">
          {tagline}
        </p>
      )}
      <h3 class="line-clamp-2 text-lg font-bold leading-snug tracking-tight text-stone-950 transition-colors duration-200 group-hover:text-orange-600 dark:text-stone-50 dark:group-hover:text-orange-400 sm:text-xl">
        {title}
      </h3>
    </hgroup>

    <p class="mbe-4 line-clamp-3 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
      {description}
    </p>

    {start && end && (
      <dl class="m-0 mbe-4 grid grid-cols-2 gap-3 rounded-xl border border-stone-200/80 bg-stone-50/80 px-3.5 py-2.5 text-xs font-mono dark:border-stone-800 dark:bg-stone-800/40">
        <div class="flex flex-col">
          <dt class="text-[10px] tracking-wider text-stone-400 uppercase dark:text-stone-500">
            {startLabel}
          </dt>
          <dd class="m-0 truncate font-semibold text-stone-900 dark:text-stone-100">{start}</dd>
        </div>
        <div class="flex flex-col border-s border-stone-200/80 ps-3 dark:border-stone-800">
          <dt class="text-[10px] tracking-wider text-stone-400 uppercase dark:text-stone-500">
            {endLabel}
          </dt>
          <dd class="m-0 truncate font-semibold text-stone-900 dark:text-stone-100">{end}</dd>
        </div>
      </dl>
    )}

    <div class="mbs-auto flex items-center justify-start pbs-3">
      <div class="inline-flex items-center gap-1.5 rounded-full bg-stone-100/70 px-4 py-2 text-xs font-semibold text-dark-grey select-none transition-colors duration-200 group-hover:bg-linear-to-br group-hover:from-amber-orange group-hover:to-orange group-hover:text-white group-hover:shadow-lg group-hover:shadow-orange/30 dark:bg-stone-800 dark:text-stone-200">
        <span class="transition-none">{exploreLink}</span>
        <ChevronRight
          aria-hidden="true"
          class="size-4 shrink-0 rtl:rotate-180"
        />
      </div>
    </div>
  </div>
</article>
