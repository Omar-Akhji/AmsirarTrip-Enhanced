---
import { ChevronRight } from "@lucide/astro";
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  readonly item: {
    readonly image: ImageMetadata | string;
    readonly route: string;
    readonly imageAlt?: string | undefined;
    readonly alt?: string | undefined;
  };
  readonly title: string;
  readonly description: string;
  readonly exploreLink?: string | undefined;
  readonly badge?: string | undefined;
  readonly priority?: boolean | undefined;
  readonly tagline?: string | undefined;
  readonly start?: string | undefined;
  readonly end?: string | undefined;
  readonly startLabel?: string | undefined;
  readonly endLabel?: string | undefined;
  readonly transitionName?: string | undefined;
}

const {
  item,
  title,
  description,
  exploreLink = "Explore",
  badge,
  priority = false,
  tagline,
  start,
  end,
  startLabel,
  endLabel,
  transitionName,
} = Astro.props;

const locale = Astro.currentLocale || "en";

const cardTransitionName =
  transitionName
  || (item.route.length > 0 ?
    `trip-image-${item.route.replace(/^\/+/, "").replaceAll(/[^a-zA-Z0-9_-]/g, "-")}`
  : undefined);
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-stone-200/90 bg-white p-3 shadow-xs transition duration-300 size-full pointer-fine:hover:-translate-y-1 pointer-fine:hover:border-stone-300 pointer-fine:hover:shadow-xl">
  <a
    class="absolute inset-0 z-20"
    href={getRelativeLocaleUrl(locale, item.route)}
  >
    <span class="sr-only">
      {exploreLink} - {title}
    </span>
  </a>

  <div
    data-scroll-parallax
    class="relative aspect-4/3 shrink-0 overflow-hidden rounded-xl bg-stone-100 inline-full"
  >
    <div class="parallax-media pointer-events-none absolute -inset-y-4 inset-x-0 h-[calc(100%+32px)] w-full">
      <Image
        alt={item.imageAlt || item.alt || title || "Morocco Trip"}
        class="size-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transform-none"
        height={480}
        loading={priority ? "eager" : "lazy"}
        sizes="(max-width: 480px) 320px, (max-width: 768px) 480px, 640px"
        src={item.image as ImageMetadata}
        {...(cardTransitionName ? { "transition:name": cardTransitionName } : {})}
        width={640}
        widths={[320, 480, 640]}
      />
    </div>
    <div class="absolute inset-0 bg-linear-to-t from-slate-950/70 via-transparent to-transparent opacity-60 transition-opacity duration-300 group-hover:opacity-40"></div>

    {badge && (
      <div class="absolute inset-s-3 top-3 z-10">
        <span class="inline-flex items-center rounded-md border border-white/20 bg-slate-950/80 px-2 py-1 font-mono text-[11px] font-bold tracking-wider text-orange-300 uppercase shadow-xs backdrop-blur-xs">
          {badge}
        </span>
      </div>
    )}
  </div>

  <div class="flex flex-1 flex-col px-3 pbs-5 pbe-2">
    <hgroup class="mbe-2">
      {tagline && (
        <p class="mbe-1 font-mono text-xs font-semibold tracking-wider text-orange-600 uppercase">
          {tagline}
        </p>
      )}
      <h3 class="line-clamp-2 text-lg font-bold leading-snug tracking-tight text-stone-950 transition-colors duration-200 group-hover:text-orange-600 sm:text-xl">
        {title}
      </h3>
    </hgroup>

    <p class="mbe-6 line-clamp-3 flex-1 text-sm leading-relaxed text-stone-600">{description}</p>

    {start && end && (
      <dl class="m-0 mbe-5 grid grid-cols-2 gap-3 border-y border-stone-100 p-0 py-3 text-xs font-mono">
        <div class="flex flex-col">
          <dt class="text-[10px] tracking-wider text-stone-400 uppercase">{startLabel}</dt>
          <dd class="m-0 truncate font-semibold text-stone-900">{start}</dd>
        </div>
        <div class="flex flex-col border-s border-stone-100 ps-3">
          <dt class="text-[10px] tracking-wider text-stone-400 uppercase">{endLabel}</dt>
          <dd class="m-0 truncate font-semibold text-stone-900">{end}</dd>
        </div>
      </dl>
    )}

    <div class="mbs-auto flex items-center justify-between border-t border-stone-100 pbs-3">
      <span class="text-xs font-bold tracking-wider text-orange-600 uppercase font-mono">
        {exploreLink}
      </span>
      <div class="flex size-8 items-center justify-center rounded-full border border-stone-200 bg-stone-50 text-stone-700 transition-all duration-200 group-hover:border-orange/50 group-hover:bg-linear-to-br group-hover:from-amber-orange group-hover:to-orange group-hover:text-white group-hover:shadow-md group-hover:shadow-orange/30">
        <ChevronRight
          aria-hidden="true"
          class="size-4 -rotate-90 transition-transform duration-200 ease-out group-hover:rotate-0"
        />
      </div>
    </div>
  </div>
</article>
