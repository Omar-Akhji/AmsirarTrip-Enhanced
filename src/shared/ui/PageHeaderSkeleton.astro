---
import { ChevronRight } from "@lucide/astro";
import AsciiSkeleton from "./AsciiSkeleton.astro";

interface Props {
  hasBreadcrumbs?: boolean | undefined;
  hasButtons?: boolean | undefined;
  hasUnderline?: boolean | undefined;
  crumbWidths?: string[] | undefined;
  titleWidth?: string | undefined;
  class?: string | undefined;
}

const {
  hasBreadcrumbs = true,
  hasButtons = false,
  hasUnderline = false,
  crumbWidths = ["w-12", "w-20"],
  titleWidth = "w-3/5 max-w-xs sm:w-1/2 sm:max-w-sm lg:w-1/3 lg:max-w-sm",
  class: className,
} = Astro.props;
---

<section
  aria-busy="true"
  aria-label="Loading page header"
  class:list={[
    "relative isolate flex flex-col justify-center overflow-hidden bg-zinc-950 pbs-24 pbe-12 sm:pbs-28 sm:pbe-16 lg:pbs-32 lg:pbe-20 text-center text-white shadow-xl inline-full min-h-[48dvh] sm:min-h-[52dvh] lg:min-h-[56dvh] max-h-150 print:hidden",
    className,
  ]}
>
  {/* Dark Hero Background with desert ASCII atmosphere spanning 100% edge-to-edge */}
  <div class="absolute inset-0 -z-30 size-full overflow-hidden bg-zinc-950">
    <AsciiSkeleton
      class="ars-image ars-hero-bg size-full text-stone-700/35"
      rows={32}
      variant="dither"
    />
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.06),transparent_65%)]"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-10 bg-linear-to-b from-zinc-950/80 via-zinc-950/55 to-zinc-950/90"
  ></div>

  <div class="relative z-20 mx-auto my-auto flex flex-col items-center justify-center px-4 text-center inline-full max-inline-7xl">
    <div class="w-full max-w-4xl space-y-6 text-center">
      {hasBreadcrumbs && (
        <nav
          aria-label="Loading breadcrumb"
          class="mbe-6 sm:mbe-8 flex items-center justify-center gap-3"
        >
          <div class="flex list-none flex-wrap items-center gap-2 rounded-full border border-white/20 bg-white/10 px-6 py-2 backdrop-blur-md min-h-9.5">
            {crumbWidths.map((width, index) => (
              <div class="flex h-5 items-center gap-2">
                <AsciiSkeleton
                  class:list={{
                    "text-stone-300": index === crumbWidths.length - 1,
                    "text-white/60": index !== crumbWidths.length - 1,
                  }}
                  lines={1}
                  variant="scan"
                  widths={[
                    width.includes("w-") ?
                      `${Math.trunc(Number(width.replace("w-", ""))) * 0.25}rem`
                    : "4rem",
                  ]}
                />
                {index < crumbWidths.length - 1 && (
                  <ChevronRight
                    aria-hidden="true"
                    class="size-3 text-white/40 shrink-0"
                  />
                )}
              </div>
            ))}
          </div>
        </nav>
      )}

      <hgroup class="space-y-4 sm:space-y-5">
        {!hasBreadcrumbs && (
          <div class="flex items-center justify-center gap-4">
            <span class="bg-white/20 block-px inline-8"></span>
            <AsciiSkeleton
              class="text-white/60"
              lines={1}
              variant="scan"
              widths={["8rem"]}
            />
            <span class="bg-white/20 block-px inline-8"></span>
          </div>
        )}

        {/* Title matching PageHeader text-3xl sm:text-4xl lg:text-5xl */}
        <div class:list={["mx-auto text-center", titleWidth]}>
          <AsciiSkeleton
            class="text-3xl sm:text-4xl lg:text-5xl text-white/90 font-bold text-center mx-auto"
            lines={1}
            variant="dither"
            widths={["100%"]}
          />
        </div>

        {hasUnderline && (
          <div class="mx-auto mt-3 block-1 inline-20 rounded-full bg-white/30"></div>
        )}

        {/* Subtitle matching PageHeader single max-w-[62ch] paragraph — centered broken line */}
        <div class="mx-auto max-w-[62ch] text-center">
          <AsciiSkeleton
            class="text-white/60 font-mono text-sm sm:text-base lg:text-lg text-center mx-auto"
            lines={2}
            variant="dither"
            widths={["100%", "72%"]}
          />
        </div>
      </hgroup>

      <div class="flex flex-wrap items-center justify-center gap-4 pbs-2">
        {hasButtons && (
          <>
            <div class="rounded-full border border-white/25 bg-white/10 px-6 py-2.5">
              <AsciiSkeleton
                class="text-white/75"
                lines={1}
                variant="scan"
                widths={["7rem"]}
              />
            </div>
            <div class="rounded-full border border-white/20 bg-white/10 px-6 py-2.5">
              <AsciiSkeleton
                class="text-white/75"
                lines={1}
                variant="scan"
                widths={["9rem"]}
              />
            </div>
          </>
        )}
      </div>
    </div>
  </div>
</section>
