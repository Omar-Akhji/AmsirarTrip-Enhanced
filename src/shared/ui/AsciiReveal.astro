---
import { cn } from "@/lib/utils";
import type { Duration, Origin, PresetName } from "ascii-reveal/core";

export interface Props {
  preset?: PresetName | undefined;
  duration?: Duration | undefined;
  speed?: number | undefined;
  origin?: Origin | undefined;
  as?: string | undefined;
  class?: string | undefined;
  lazy?: boolean | undefined;
  [key: string]: unknown;
}

const {
  preset = "dither",
  duration = "fast",
  speed = 1,
  origin = "center",
  as: Component = "div",
  class: className,
  lazy = true,
  ...rest
}: Props = Astro.props;

const originString = typeof origin === "string" ? origin : undefined;
---

<Component
  class:list={cn("relative", className)}
  data-ascii-reveal=""
  data-ascii-reveal-duration={duration}
  data-ascii-reveal-preset={preset}
  data-ascii-reveal-speed={speed}
  {...(originString ? { "data-ascii-reveal-origin": originString } : {})}
  {...(lazy ? { "data-ascii-reveal-lazy": "true" } : {})}
  {...rest}
>
  <slot />
</Component>
