---
import { BadgeCheck } from "@lucide/astro";

interface Props {
  readonly highlights: readonly string[];
  readonly highlightsTitle: string;
  readonly idPrefix?: string | undefined;
}

const { highlights, highlightsTitle, idPrefix = "trip" } = Astro.props;
---

<div
  class="delay-225"
  data-animate="fade-up"
>
  <section aria-labelledby={`${idPrefix}-highlights-title`}>
    <hgroup class="mbe-4">
      <p class="font-sans text-xs font-bold tracking-wider text-orange-700 uppercase">
        Key Experiences
      </p>
      <h3
        class="mbs-1 text-xl font-bold tracking-tight text-stone-900 sm:text-2xl md:text-3xl"
        id={`${idPrefix}-highlights-title`}
      >
        {highlightsTitle}
      </h3>
    </hgroup>
    <ul
      role="list"
      class="m-0 p-0 list-none grid gap-3 sm:grid-cols-2"
    >
      {highlights.map((highlight) => (
        <li class="flex items-start gap-3 rounded-2xl border border-stone-200/90 bg-white p-4 shadow-2xs">
          <BadgeCheck
            aria-hidden="true"
            class="mbs-0.5 size-5 shrink-0 text-orange-600"
          />
          <p class="text-sm leading-relaxed text-stone-700 sm:text-base font-normal">{highlight}</p>
        </li>
      ))}
    </ul>
  </section>
</div>
