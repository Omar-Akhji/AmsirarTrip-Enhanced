---
import { Image } from "astro:assets";
import { getLocalizedPath, useTranslations } from "@/i18n/utils";
import type { Locale } from "@/i18n/locales";
import { LANGUAGES } from "./constants";

interface Props {
  placement?: "left" | "right";
  size?: "sm" | "md";
  class?: string;
}

const { placement = "left", size = "md", class: className = "" } = Astro.props;

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const currentLanguage = LANGUAGES.find((l) => l.code === locale) || {
  code: "en",
  name: "English",
  shortName: "EN",
};

const getLocalizedHref = (code: string) => {
  return getLocalizedPath(Astro.url.pathname, code as Locale) + Astro.url.search;
};
---

<div class:list={["language-selector-root relative inline-block", className]}>
  <button
    aria-expanded="false"
    aria-haspopup="menu"
    aria-label={`${t("language") || "Language"} - ${currentLanguage.shortName}`}
    class="relative cursor-pointer"
    data-lang-trigger
    type="button"
  >
    <div
      class:list={[
        "flex items-center justify-center rounded-full border-2 transition-all duration-150 pointer-fine:hover:-translate-y-0.5 pointer-fine:hover:shadow-[0_8px_18px_rgba(0,0,0,0.28)]",
        "border-white/60 bg-white/10 text-white group-data-scrolled:border-0 group-data-scrolled:border-transparent group-data-scrolled:hover:border-0 group-data-scrolled:hover:border-transparent group-data-scrolled:bg-linear-to-br group-data-scrolled:from-amber-orange group-data-scrolled:to-orange group-data-scrolled:shadow-[0_10px_24px_oklch(56%_0.19_33deg/35%)]",
        {
          "size-11 sm:size-10 text-sm": size === "sm",
          "size-11 text-base font-semibold": size === "md",
        },
      ]}
    >
      <Image
        alt=""
        class:list={["object-contain", { "size-5": size === "sm", "size-6.25": size === "md" }]}
        decoding="async"
        height={25}
        loading="eager"
        src="/icons/translate-icon-com.svg"
        width={25}
      />
    </div>
    <span
      aria-hidden="true"
      class:list={[
        "absolute -inset-e-1.5 -bottom-1 font-bold tracking-[0.04em] text-white rounded-full border-2 border-white bg-linear-to-br from-amber-orange to-orange",
        {
          "px-1 py-px text-[0.6rem]": size === "sm",
          "px-1.5 py-0.5 text-[0.625rem]": size === "md",
        },
      ]}
    >
      {currentLanguage.shortName}
    </span>
  </button>

  <!-- Concentric radius formula: outer radius = inner radius + padding <=> inner radius = radius of list card - padding between them -->
  <div
    aria-orientation="vertical"
    style="

--card-radius: 12px; --card-padding: 6px; --inner-radius: calc(var(--card-radius) - var(--card-padding));

 border-radius: var(--card-radius); padding: var(--card-padding);"
    class:list={[
      "language-selector-menu pointer-events-none invisible scale-95 opacity-0 transition-all duration-200 ease-out",
      "data-[state=open]:pointer-events-auto data-[state=open]:visible data-[state=open]:scale-100 data-[state=open]:opacity-100",
      "absolute top-full z-50 mt-2 min-w-44 overflow-hidden rounded-xl border border-white/10 bg-slate-950/95 p-1.5 text-white shadow-2xl backdrop-blur-xl ring-1 ring-white/10",
      "group-data-scrolled:border-black/10 group-data-scrolled:bg-white group-data-scrolled:text-slate-800 group-data-scrolled:shadow-[0_12px_32px_rgba(0,0,0,0.15)]",
      { "inset-e-0": placement === "right", "inset-s-0": placement !== "right" },
    ]}
    data-lang-menu
    data-state="closed"
    role="menu"
  >
    <div class="flex flex-col gap-1">
      {LANGUAGES.map((lang) => {
        const isCurrent = lang.code === currentLanguage.code;
        return (
          <a
            aria-checked={isCurrent}
            aria-label={lang.name}
            style="border-radius: var(--inner-radius);"
            class:list={[
              "flex items-center justify-between whitespace-nowrap rounded-md px-3 py-2 text-sm font-medium transition-colors duration-150 inline-full",
              {
                "bg-white/15 text-white group-data-scrolled:bg-linear-to-br group-data-scrolled:from-amber-orange group-data-scrolled:to-orange group-data-scrolled:text-white":
                  isCurrent,
                "text-zinc-300 hover:bg-white/10 hover:text-white group-data-scrolled:text-zinc-600 group-data-scrolled:hover:bg-zinc-100 group-data-scrolled:hover:text-zinc-900":
                  !isCurrent,
              },
            ]}
            href={getLocalizedHref(lang.code)}
            role="menuitemradio"
          >
            <span class="flex items-center gap-2.5">
              <span>{lang.name}</span>
            </span>
            {isCurrent && (
              <span class="size-2 rounded-full bg-orange group-data-scrolled:bg-white" />
            )}
          </a>
        );
      })}
    </div>
  </div>
</div>

<script src="./scripts/language-selector.ts"></script>
