---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripLocaleFromPath, useTranslations } from "@/i18n/utils";
import { Compass, House, Mountain, User, Users } from "@lucide/astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const localize = (path: string): string => {
  const clean = path.replace(/^\/+/, "");
  return getRelativeLocaleUrl(locale, clean || undefined);
};

const normalizedPath = stripLocaleFromPath(Astro.url.pathname);

const isActive = (to: string): boolean =>
  normalizedPath === to || (to !== "/" && normalizedPath.startsWith(`${to}/`));

interface NavDockItem {
  readonly to: string;
  readonly labelKey: string;
  readonly defaultLabel: string;
  readonly icon: typeof House;
}

const NAV_ITEMS: readonly NavDockItem[] = [
  { to: "/", labelKey: "nav.home", defaultLabel: "Home", icon: House },
  { to: "/tours", labelKey: "nav.tours", defaultLabel: "Tours", icon: Compass },
  { to: "/excursions", labelKey: "nav.excursions", defaultLabel: "Excursions", icon: Mountain },
  { to: "/about", labelKey: "nav.about", defaultLabel: "About", icon: Users },
  { to: "/contact", labelKey: "nav.contact", defaultLabel: "Contact", icon: User },
] as const;
---

<nav
  aria-label={t("nav.mainAria", "Mobile Navigation")}
  class:list={[
    "group/dock fixed bottom-4 inset-x-0 mx-auto z-40 w-fit max-w-[calc(100vw-2rem)] mbe-[env(safe-area-inset-bottom,0)]",
    "flex items-center gap-1 p-1.5 rounded-full border-2 border-white/10 bg-white/10 text-white shadow-[0_10px_30px_rgba(3,7,18,0.12)] backdrop-blur-xl transition-all duration-200 md:hidden",
    "data-scrolled:border-stone-200/90 data-scrolled:bg-stone-100/90 data-scrolled:text-dark-grey data-scrolled:shadow-[0_12px_30px_oklch(0%_0_0deg/8%)]",
    className,
  ]}
  id="mobile-bottom-nav"
  transition:name="mobile-bottom-nav"
>
  <!-- Sliding indicator identical to desktop navbar indicator -->
  <div
    class="pointer-events-none absolute inset-y-1.5 left-0 z-0 rounded-full bg-linear-to-br from-amber-orange to-orange opacity-0 shadow-lg shadow-orange/30 will-change-transform motion-reduce:transition-none motion-reduce:transform-none"
    id="mobile-nav-indicator"
  ></div>

  {NAV_ITEMS.map((item) => {
    const active = isActive(item.to);
    const label = t(item.labelKey, item.defaultLabel);
    const IconComponent = item.icon;

    return (
      <a
        aria-current={active ? "page" : undefined}
        aria-label={label}
        class="group/link mobile-dock-link relative z-10 inline-flex min-h-11 h-11 items-center justify-center whitespace-nowrap shrink-0 rounded-full px-3 py-2 text-xs font-semibold select-none transition-colors duration-200 text-white/75 hover:text-white group-data-scrolled/dock:text-dark-grey group-data-scrolled/dock:hover:text-dark data-indicator:text-white group-data-scrolled/dock:data-indicator:text-white data-indicator:px-4"
        data-active={active ? "true" : undefined}
        data-indicator={active ? "true" : undefined}
        href={localize(item.to)}
        title={label}
      >
        <IconComponent class="pointer-events-none size-5 shrink-0 stroke-[2.2] transition-transform duration-200 group-hover/link:scale-110 motion-reduce:transform-none" />
        <span
          class="mobile-dock-label pointer-events-none inline-block overflow-hidden whitespace-nowrap text-xs font-semibold tracking-tight motion-reduce:transition-none"
          style={active ? "margin-left: 8px;" : "width: 0px; opacity: 0; margin-left: 0px;"}
        >
          {label}
        </span>
      </a>
    );
  })}
</nav>
