---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripLocaleFromPath, useTranslations } from "@/i18n/utils";
import { Compass, House, Mountain, User, Users } from "@lucide/astro";
import LanguageSelector from "./navbar/LanguageSelector.astro";
import MobileBottomNav from "./navbar/MobileBottomNav.astro";
import SocialLinks from "./navbar/SocialLinks.astro";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const localize = (path: string): string => {
  const clean = path.replace(/^\/+/, "");
  return getRelativeLocaleUrl(locale, clean || undefined);
};

const normalizedPath = stripLocaleFromPath(Astro.url.pathname);

const isActive = (to: string) =>
  normalizedPath === to || (to !== "/" && normalizedPath.startsWith(`${to}/`));

const NAV_ITEMS = [
  { to: "/", labelKey: "nav.home", defaultLabel: "Home", icon: House },
  { to: "/tours", labelKey: "nav.tours", defaultLabel: "Tours", icon: Compass },
  { to: "/excursions", labelKey: "nav.excursions", defaultLabel: "Excursions", icon: Mountain },
  { to: "/about", labelKey: "nav.about", defaultLabel: "About", icon: Users },
  { to: "/contact", labelKey: "nav.contact", defaultLabel: "Contact", icon: User },
] as const;
---

<!-- Skip to main content link for keyboard accessibility -->
<a
  class="sr-only focus:not-sr-only focus:fixed focus:inset-2 focus:z-9999 focus:rounded-lg focus:bg-orange focus:px-4 focus:py-2 focus:text-white focus:font-semibold focus:shadow-lg"
  href="#main-content"
>
  Skip to main content
</a>

<header>
  <div
    class="group fixed inset-s-1/2 top-2 z-50 translate-x-[-50%] rounded-2xl border border-white/10 bg-white/10 px-3 py-2 sm:px-4 text-white shadow-[0_10px_30px_rgba(3,7,18,0.12)] backdrop-blur-xl transition-all duration-200 will-change-auto inline-[min(1100px,calc(100%-2rem))]"
    id="main-navbar"
    transition:name="main-navbar"
  >
    <div class="relative flex items-center justify-between gap-2.5 px-1 py-0.5 lg:px-2 lg:py-1">
      <a
        aria-label="Amsirar Trip"
        class="brand-logo-link flex items-center whitespace-nowrap shrink-0 text-[1.3rem] sm:text-[1.4rem] lg:text-[1.5rem] font-semibold tracking-tight text-white transition-colors duration-200 group-data-scrolled:text-dark-grey"
        href={localize("/")}
      >
        Amsirar{" "}
        <span class="brand-logo-span font-brand font-light text-white transition-colors duration-200 group-data-scrolled:text-orange ms-1">
          Trip
        </span>
      </a>

      <nav
        aria-label={t("nav.mainAria", "Main Navigation")}
        class="absolute inset-s-1/2 z-10 hidden -translate-x-1/2 items-center gap-1 overflow-hidden rounded-full border-2 border-white/10 bg-white/5 p-1.5 shadow-[0_8px_32px_rgba(0,0,0,0.12)] transition-colors duration-200 group-data-scrolled:border-stone-200/90 group-data-scrolled:bg-stone-100/70 md:inline-flex lg:gap-1.5 max-w-fit"
        id="desktop-nav"
      >
        <div
          class="pointer-events-none absolute inset-y-1.5 left-0 z-0 rounded-full bg-linear-to-br from-amber-orange to-orange opacity-0 shadow-lg shadow-orange/30 will-change-transform"
          id="desktop-nav-indicator"
        ></div>

        {NAV_ITEMS.map((item) => {
          const active = isActive(item.to);
          const label = t(item.labelKey, item.defaultLabel);
          const IconComponent = item.icon;
          return (
            <a
              aria-current={active ? "page" : undefined}
              aria-label={label}
              title={label}
              class="group/link desktop-nav-link relative z-10 inline-flex items-center justify-center whitespace-nowrap shrink-0 rounded-full px-3 py-2 text-xs font-semibold select-none transition-colors duration-200 text-white/75 hover:text-white group-data-scrolled:text-dark-grey group-data-scrolled:hover:text-dark data-indicator:text-white group-data-scrolled:data-indicator:text-white lg:px-5 lg:py-2 lg:text-sm"
              data-active={active ? "true" : undefined}
              data-indicator={active ? "true" : undefined}
              href={localize(item.to)}
            >
              <IconComponent
                aria-hidden="true"
                class="size-5 shrink-0 stroke-[2.2] transition-transform duration-200 group-hover/link:scale-110 lg:hidden motion-reduce:transform-none"
              />
              <span
                class:list={[
                  "desktop-nav-label inline-block overflow-hidden whitespace-nowrap text-xs font-semibold tracking-tight motion-reduce:transition-none lg:text-sm lg:overflow-visible lg:w-auto! lg:opacity-100! lg:ml-0!",
                  { "ml-2": active, "w-0 opacity-0 ml-0": !active },
                ]}
                data-expanded={active ? "true" : undefined}
              >
                {label}
              </span>
            </a>
          );
        })}
      </nav>

      <div class="flex items-center gap-1.5 sm:gap-2">
        <SocialLinks compact={true} />
        <LanguageSelector
          placement="right"
          size="sm"
        />
      </div>
    </div>
  </div>
</header>

<MobileBottomNav />

<script src="../../scripts/navbar-scroll.ts"></script>
<script src="../../scripts/desktop-nav.ts"></script>
<script src="../../scripts/mobile-nav.ts"></script>
