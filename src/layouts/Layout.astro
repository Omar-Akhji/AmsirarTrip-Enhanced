---
import { createHash } from "node:crypto";
import { Font } from "astro:assets";
import "../styles/global.css";
import { generateOrganizationJsonLd, generateWebsiteJsonLd } from "../lib/structured-data";
import Footer from "./Footer.astro";
import Navbar from "./Navbar.astro";
import CookieConsent from "../shared/ui/widgets/CookieConsent.astro";
import ScrollProgressBar from "../shared/ui/feedback/ScrollProgressBar.astro";
import JsonLd from "../shared/ui/primitives/JsonLd.astro";
import { WHATSAPP_LINK } from "../lib/constants/contact";
import {
  DEFAULT_LOCALE,
  getLocaleDirection,
  isLocale,
  LOCALES,
  OG_LOCALE_MAP,
  type Locale,
} from "../i18n/locales";
import { getLocalizedPath, stripLocaleFromPath, useTranslations } from "../i18n/utils";
import WhatsappIcon from "../shared/ui/icons/WhatsappIcon.astro";

interface Props {
  description?: string | undefined;
  image?: string | undefined;
  imageAlt?: string | undefined;
  noindex?: boolean | undefined;
  preloadImage?: boolean | undefined;
  preloadImageSizes?: string | undefined;
  preloadImageSrcSet?: string | undefined;
  title?: string | undefined;
}

const {
  title: rawTitle,
  description: rawDescription,
  noindex = false,
  image = "/images/hero/marrakech-medina.webp",
  imageAlt,
  preloadImage,
  preloadImageSizes,
  preloadImageSrcSet,
} = Astro.props;

const locale: Locale =
  Astro.locals.locale
  ?? (Astro.currentLocale && isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE);
const dir = getLocaleDirection(locale);
const t = useTranslations(locale);
const title = rawTitle ?? t("home.meta.title");
const description = rawDescription ?? t("home.meta.description");
const pageTitle = title.includes("Amsirar Trip") ? title : `${title} | Amsirar Trip`;

const site = Astro.site ?? Astro.url;
const pathname = Astro.url.pathname;

const cleanPath = stripLocaleFromPath(pathname);
const defaultUrl = new URL(cleanPath, site).href;
const canonicalURL = new URL(getLocalizedPath(pathname, locale), site).href;
const preloadImageHref = image;
const shouldPreload = Boolean(preloadImage);
const defaultOgImage = new URL(preloadImageHref, site).href;
const resolvedImageAlt = imageAlt ?? pageTitle;
const currentOgLocale = OG_LOCALE_MAP[locale] ?? locale;

const THEME_INIT_SCRIPT = [
  "try {",
  '  const stored = localStorage.getItem("amsirar-theme");',
  "  const isDark =",
  '    stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;',
  '  document.documentElement.classList.toggle("dark", isDark);',
  '  document.documentElement.style.colorScheme = isDark ? "dark" : "light";',
  "} catch {",
  "  // localStorage unavailable",
  "}",
].join("\n");
const THEME_INIT_HASH: `sha256-${string}` = `sha256-${createHash("sha256")
  .update(THEME_INIT_SCRIPT)
  .digest("base64")}`;
Astro.csp?.insertScriptHash(THEME_INIT_HASH);

const SPECULATION_RULES_SCRIPT = JSON.stringify({
  prerender: [{ source: "document", where: { selector_matches: "a" }, eagerness: "moderate" }],
  prefetch: [{ source: "document", where: { selector_matches: "a" }, eagerness: "moderate" }],
});
if (import.meta.env.DEV) {
  const SPECULATION_RULES_HASH: `sha256-${string}` = `sha256-${createHash("sha256")
    .update(SPECULATION_RULES_SCRIPT)
    .digest("base64")}`;
  Astro.csp?.insertScriptHash(SPECULATION_RULES_HASH);
  Astro.csp?.insertScriptHash("sha256-IU3B3AEAItf6Fb2EWGXsdXMld1XIzaKnQSqlrM/orqM=");
  Astro.csp?.insertScriptHash("sha256-0O7iB6zr9x0r6X6eWYITC9V5q+yWCGAoFvcysBGbY9Q=");
  Astro.csp?.insertScriptHash("sha256-2mkrkPfKG5HdF6qWOVbV6XM8cT+fSqsoBXayDHqg3hg=");
  Astro.csp?.insertStyleResource({ resource: "'unsafe-inline'", kind: "element" });
}
---

<!doctype html>
<html
  class="inline-full min-block-full overflow-x-clip scrollbar-none [-ms-overflow-style:none] bg-(--pattern-bg-color) bg-(image:--pattern-bg-image) bg-repeat bg-size-(--pattern-bg-size) [&::-webkit-scrollbar]:hidden [&::-webkit-scrollbar]:size-0 [&::-webkit-scrollbar]:bg-transparent"
  dir={dir}
  itemscope
  itemtype="https://schema.org/WebPage"
  lang={locale}
>
  <head>
    <meta charset="utf-8" />
    {/* Inline render-blocking theme init to prevent dark-mode FOUC; Astro 7 hashes this via Astro.csp. */}
    {/* eslint-disable astro/no-set-html-directive, astro/no-unsafe-inline-scripts -- static compile-time theme & dev speculationrules scripts hashed above */}
    <script
      is:inline
      set:html={THEME_INIT_SCRIPT}
    />
    {import.meta.env.DEV && (
      <script
        is:inline
        set:html={SPECULATION_RULES_SCRIPT}
        type="speculationrules"
      />
    )}
    {/* eslint-enable astro/no-set-html-directive, astro/no-unsafe-inline-scripts */}
    <script src="../scripts/theme.ts"></script>

    <meta
      content={locale}
      name="app-locale"
    />
    <Font
      cssVariable="--font-montserrat"
      preload
    />
    <Font cssVariable="--font-jetbrains-mono" />
    <Font cssVariable="--font-yellowtail" />
    <meta
      content="width=device-width, initial-scale=1.0"
      name="viewport"
    />
    <meta
      content="light dark"
      name="color-scheme"
    />
    <meta
      content="#fafaf9"
      media="(prefers-color-scheme: light)"
      name="theme-color"
    />
    <meta
      content="#0d0e12"
      media="(prefers-color-scheme: dark)"
      name="theme-color"
    />
    <meta
      content={
        noindex ? "noindex, follow" : (
          "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        )
      }
      name="robots"
    />

    <title>{pageTitle}</title>
    <meta
      content={description}
      name="description"
    />

    <meta
      content={pageTitle}
      property="og:title"
    />
    <meta
      content={description}
      property="og:description"
    />
    <meta
      content={defaultOgImage}
      property="og:image"
    />
    <meta
      content="1200"
      property="og:image:width"
    />
    <meta
      content="630"
      property="og:image:height"
    />
    <meta
      content="image/webp"
      property="og:image:type"
    />
    <meta
      content={resolvedImageAlt}
      property="og:image:alt"
    />
    <meta
      content={canonicalURL}
      property="og:url"
    />
    <meta
      content="website"
      property="og:type"
    />
    <meta
      content="Amsirar Trip"
      property="og:site_name"
    />
    <meta
      content={currentOgLocale}
      property="og:locale"
    />
    {LOCALES.filter((l) => l !== locale).map((l) => (
      <meta
        content={OG_LOCALE_MAP[l] ?? l}
        property="og:locale:alternate"
      />
    ))}

    <meta
      content="summary_large_image"
      name="twitter:card"
    />
    <meta
      content={pageTitle}
      name="twitter:title"
    />
    <meta
      content={description}
      name="twitter:description"
    />
    <meta
      content={defaultOgImage}
      name="twitter:image"
    />
    <meta
      content={resolvedImageAlt}
      name="twitter:image:alt"
    />

    <link
      href={canonicalURL}
      rel="canonical"
    />

    {!noindex
      && LOCALES.map((l) => {
        const href = new URL(getLocalizedPath(pathname, l), site).href;
        return (
          <link
            href={href}
            hreflang={l}
            rel="alternate"
          />
        );
      })}
    {!noindex && (
      <link
        href={defaultUrl}
        hreflang="x-default"
        rel="alternate"
      />
    )}

    <link
      href="/sitemap-index.xml"
      rel="sitemap"
    />

    <meta
      content="Amsirar Trip"
      name="application-name"
    />
    <meta
      content="Amsirar Trip"
      name="apple-mobile-web-app-title"
    />
    <meta
      content="yes"
      name="mobile-web-app-capable"
    />
    <meta
      content="yes"
      name="apple-mobile-web-app-capable"
    />
    <meta
      content="default"
      name="apple-mobile-web-app-status-bar-style"
    />
    <meta
      content="MA-07"
      name="geo.region"
    />
    <meta
      content="Marrakech, Morocco"
      name="geo.placename"
    />
    <meta
      content="31.62950;-7.98110"
      name="geo.position"
    />
    <meta
      content="31.62950, -7.98110"
      name="ICBM"
    />

    <link
      href="/favicon.ico"
      rel="icon"
      sizes="32x32"
    />
    <link
      href="/favicon.svg"
      rel="icon"
      type="image/svg+xml"
    />
    <link
      href="/favicon-96x96.png"
      rel="icon"
      sizes="96x96"
      type="image/png"
    />
    <link
      href="/favicon.png"
      rel="icon"
      sizes="1024x1024"
      type="image/png"
    />
    <link
      href="/apple-touch-icon.png"
      rel="apple-touch-icon"
      sizes="180x180"
    />
    <link
      href="/icons/icon-512.png"
      rel="apple-touch-icon"
      sizes="512x512"
    />
    <link
      href="/site.webmanifest"
      rel="manifest"
    />

    {shouldPreload && (
      <link
        as="image"
        fetchpriority="high"
        href={preloadImageSrcSet ? undefined : preloadImageHref}
        imagesizes={preloadImageSizes}
        imagesrcset={preloadImageSrcSet}
        rel="preload"
        type="image/webp"
      />
    )}

    <JsonLd
      data={generateOrganizationJsonLd()}
      id="organization-jsonld"
    />
    <JsonLd
      data={generateWebsiteJsonLd()}
      id="website-jsonld"
    />
  </head>

  <body class="flex flex-col inline-full min-block-full overflow-x-clip font-sans text-base leading-[1.6] text-ink bg-(--pattern-bg-color) bg-(image:--pattern-bg-image) bg-repeat bg-size-(--pattern-bg-size) antialiased font-features-['kern'_1,'liga'_1] selection:bg-[color-mix(in_oklch,var(--color-orange)_20%,transparent)] selection:text-inherit [&::-webkit-scrollbar]:hidden [&::-webkit-scrollbar]:size-0 [&::-webkit-scrollbar]:bg-transparent">
    <script src="../scripts/scroll-animate.ts"></script>
    <script src="../scripts/webmcp-tools.ts"></script>
    <Navbar />
    <main
      class="relative isolate block flex-[1_0_auto] inline-full min-h-dvh overflow-x-clip focus:outline-hidden"
      id="main-content"
    >
      <div id="page-content">
        <slot />
      </div>
    </main>
    <Footer />
    <ScrollProgressBar />
    <CookieConsent />

    <!-- WhatsApp Side Tape (Right Edge) -->
    <a
      aria-label={t("nav.whatsappCta")}
      class="group fixed inset-e-0 inset-be-33 z-40 flex size-11 items-center justify-center overflow-hidden rounded-s-md border-[1.5px] border-e-0 border-emerald-500/50 bg-slate-950/95 text-emerald-400 shadow-xl backdrop-blur-md transition-[transform,background-color,border-color,color,box-shadow] duration-200 ease-out pointer-fine:hover:-translate-x-1.5 pointer-fine:hover:border-emerald-400 pointer-fine:hover:bg-slate-900 pointer-fine:hover:text-emerald-300 pointer-fine:hover:shadow-2xl pointer-fine:hover:shadow-emerald-950/40 active:-translate-x-1.5 active:border-emerald-400 active:bg-slate-900 active:text-emerald-300 active:shadow-2xl active:shadow-emerald-950/40 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 motion-reduce:transform-none print:hidden"
      href={WHATSAPP_LINK}
      rel="noopener noreferrer"
      target="_blank"
      title={t("nav.whatsappCta")}
    >
      <span class="relative flex size-6 shrink-0 items-center justify-center">
        <span
          aria-hidden="true"
          class="absolute inset-0 -z-10 animate-ping rounded-full bg-emerald-400 opacity-25 duration-1000 motion-reduce:hidden"
        ></span>
        <WhatsappIcon class="size-6 shrink-0 transition-transform duration-200 ease-out pointer-fine:group-hover:scale-110 group-active:scale-110 motion-reduce:transform-none" />
      </span>
    </a>
  </body>
</html>

<style>
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
  }
</style>
