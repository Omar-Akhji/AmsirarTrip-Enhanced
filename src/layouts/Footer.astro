---
import FooterBottomBar from "./footer/FooterBottomBar.astro";
import FooterBrand from "./footer/FooterBrand.astro";
import FooterContactInfo from "./footer/FooterContactInfo.astro";
import FooterNewsletter from "./footer/FooterNewsletter.vue";

const locale = Astro.currentLocale || "en";
---

<footer class="relative z-10 mbs-0 box-border border-t-4 border-orange bg-slate-950 pbs-6 text-start leading-[1.6] text-white shadow-[0_-8px_32px_rgba(0,0,0,0.5)] ring-1 ring-white/5 inline-full sm:pbs-8 print:hidden">
  <div class="relative z-10">
    <div class="mx-auto p-6 xs:p-8 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
      <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-2 lg:grid-cols-[1fr_auto_1fr_auto_1fr] lg:gap-6 xl:gap-8 2xl:gap-12">
        <FooterBrand />

        <div
          class="mx-auto w-48 border-b border-white/20 md:hidden lg:block lg:h-48 lg:w-0 lg:border-b-0 lg:border-r lg:self-center"
          aria-hidden="true"
        ></div>

        <FooterContactInfo />

        <div
          class="mx-auto w-48 border-b border-white/20 md:col-span-2 md:block md:w-3/4 lg:col-span-1 lg:h-48 lg:w-0 lg:border-b-0 lg:border-r lg:self-center"
          aria-hidden="true"
        ></div>

        <FooterNewsletter
          client:visible
          locale={locale}
        />
      </div>
    </div>

    <!-- Big Monumental Brand Sign-Off (Laravel & Google Antigravity style) -->
    <div
      class="relative flex w-full items-center justify-center overflow-hidden border-t border-white/5 py-8 select-none pointer-events-none sm:py-10 lg:py-12"
      aria-hidden="true"
    >
      <!-- Soft ambient Moroccan terracotta glow -->
      <div
        class="monumental-glow absolute inset-x-0 top-1/2 -translate-y-1/2 mx-auto h-28 w-4/5 max-w-4xl rounded-full bg-orange/15 blur-3xl"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 flex w-full items-center justify-center px-0">
        <span class="monumental-text inline-flex items-baseline justify-center text-center font-bold tracking-[-0.035em] text-[clamp(2.75rem,14.5vw,14.5rem)] leading-none whitespace-nowrap">
          <span class="inline-block drop-shadow-[0_10px_15px_rgba(0,0,0,0.8)]">
            <span class="bg-linear-to-b from-[#e2e8f0] via-[#94a3b8] to-[#475569] bg-clip-text text-transparent">
              Amsirar
            </span>
          </span>
          <span class="font-brand font-light text-[1.12em] tracking-normal text-orange text-shadow-lg text-shadow-black/70 drop-shadow-md ms-0.5 sm:ms-1 pe-[0.25em] pb-[0.05em]">
            Trip
          </span>
        </span>
      </div>
    </div>

    <FooterBottomBar />
  </div>
</footer>
