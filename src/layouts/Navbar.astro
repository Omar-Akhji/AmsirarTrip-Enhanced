---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripLocaleFromPath, useTranslations } from "@/i18n/utils";
import LanguageSelector from "./navbar/LanguageSelector.astro";
import MobileBottomNav from "./navbar/MobileBottomNav.astro";
import NavIcon, { type NavIconName } from "./navbar/NavIcon.astro";
import ThemeToggle from "./navbar/ThemeToggle.astro";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const localize = (path: string): string => {
  const clean = path.replace(/^\/+/, "");
  return getRelativeLocaleUrl(locale, clean || undefined);
};

const normalizedPath = stripLocaleFromPath(Astro.url.pathname);

const isActive = (to: string) =>
  normalizedPath === to || (to !== "/" && normalizedPath.startsWith(`${to}/`));

const NAV_ITEMS: readonly {
  to: string;
  labelKey: string;
  defaultLabel: string;
  icon: NavIconName;
}[] = [
  { to: "/", labelKey: "nav.home", defaultLabel: "Home", icon: "home" },
  { to: "/tours", labelKey: "nav.tours", defaultLabel: "Tours", icon: "tours" },
  { to: "/excursions", labelKey: "nav.excursions", defaultLabel: "Excursions", icon: "excursions" },
  { to: "/about", labelKey: "nav.about", defaultLabel: "About", icon: "about" },
  { to: "/contact", labelKey: "nav.contact", defaultLabel: "Contact", icon: "contact" },
] as const;
---

<!-- Skip to main content link for keyboard accessibility -->
<a
  class="sr-only focus:not-sr-only focus:fixed focus:inset-2 focus:z-9999 focus:rounded-lg focus:bg-orange focus:px-4 focus:py-2 focus:text-white focus:font-semibold focus:shadow-lg"
  href="#main-content"
>
  Skip to main content
</a>

<header
  class="print:hidden"
  data-ascii="skip"
>
  <div
    class="group fixed inset-s-1/2 top-2 z-50 translate-x-[-50%] rounded-2xl border border-white/10 bg-white/10 px-3 py-2 sm:px-4 text-white shadow-[0_10px_30px_rgba(3,7,18,0.12)] backdrop-blur-xl transition-all duration-200 will-change-auto inline-[min(1100px,calc(100%-2rem))] 2xl:inline-[min(1280px,calc(100%-3rem))] 3xl:inline-[min(1440px,calc(100%-4rem))] dark:border-white/10 dark:bg-white/5 dark:shadow-[0_8px_32px_rgba(0,0,0,0.4)] data-[scrolled]:bg-white/90 data-[scrolled]:text-stone-900 data-[scrolled]:border-stone-200/90 data-[scrolled]:shadow-[0_12px_30px_rgba(0,0,0,0.08)] dark:data-[scrolled]:bg-[#0d0e12] dark:data-[scrolled]:border-white/10 dark:data-[scrolled]:text-mist-100 dark:data-[scrolled]:shadow-[0_16px_40px_rgba(0,0,0,0.7)]"
    id="main-navbar"
    transition:name="main-navbar"
  >
    <div class="relative flex items-center justify-between gap-2.5 px-1 py-0.5 md:py-1 lg:px-2 lg:py-1">
      <a
        aria-label="Amsirar Trip"
        class="brand-logo-link flex items-center shrink-0 transition-transform duration-200 hover:opacity-95"
        href={localize("/")}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 894 377"
          width="100%"
          height="100%"
          class="h-7 xs:h-8 sm:h-9 md:h-10 2xl:h-11 w-auto"
          aria-hidden="true"
        >
          <defs>
            <!-- Deep Navy Gradient for Capital "A" and "msirar" -->
            <linearGradient
              id="navy-a"
              x1="0%"
              y1="0%"
              x2="100%"
              y2="100%"
            >
              <stop
                offset="0%"
                stop-color="#141f4b"
              />
              <stop
                offset="60%"
                stop-color="#0c1433"
              />
              <stop
                offset="100%"
                stop-color="#2b1738"
              />
            </linearGradient>

            <!-- Warm Gold-Amber Gradient for Middle Mane Swooshes -->
            <linearGradient
              id="mane-gold"
              x1="0%"
              y1="0%"
              x2="100%"
              y2="0%"
            >
              <stop
                offset="0%"
                stop-color="#e0944a"
              />
              <stop
                offset="50%"
                stop-color="#c66b27"
              />
              <stop
                offset="100%"
                stop-color="#9e4716"
              />
            </linearGradient>

            <!-- Deep Crimson Gradient for Horse & Outer Mane -->
            <linearGradient
              id="horse-crimson"
              x1="0%"
              y1="0%"
              x2="100%"
              y2="0%"
            >
              <stop
                offset="0%"
                stop-color="#8a1426"
              />
              <stop
                offset="55%"
                stop-color="#780d1f"
              />
              <stop
                offset="100%"
                stop-color="#5e0816"
              />
            </linearGradient>
          </defs>

          <!-- White State (Default / Unscrolled Navbar in light mode, ALWAYS in dark mode) -->
          <g class="transition-opacity duration-300 opacity-100 group-data-scrolled:opacity-0 group-data-scrolled:pointer-events-none group-data-scrolled:dark:opacity-100 group-data-scrolled:dark:pointer-events-auto">
            <g
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M 324 91 C 385 126, 442 110, 502 82 C 562 54, 628 32, 691 58 C 632 40, 568 62, 508 90 C 446 118, 384 133, 324 91 Z"
                fill="#ffffff"
              />
              <path
                d="M 282 103 C 348 156, 422 142, 488 104 C 534 78, 562 66, 589 63 C 556 73, 524 90, 484 114 C 416 153, 344 164, 282 103 Z"
                fill="#ffffff"
                opacity="0.8"
              />
              <path
                d="M 277 154 C 334 198, 405 194, 468 148 C 510 116, 538 89, 565 79 C 536 98, 506 127, 464 158 C 402 203, 332 205, 277 154 Z"
                fill="#ffffff"
                opacity="0.8"
              />
              <path
                d="M 457 240 C 488 172, 532 108, 594 75 C 630 56, 666 53, 693 60 C 662 59, 626 64, 592 83 C 534 116, 494 176, 457 240 Z"
                fill="#ffffff"
              />
              <path
                d="M 696 63 C 704 49, 718 41, 733 42 C 726 49, 720 57, 717 69 C 715 62, 717 53, 722 47 C 712 48, 703 55, 696 63 Z"
                fill="#ffffff"
              />
              <path
                d="M 724 77 C 742 89, 753 102, 751 113 C 760 132, 779 152, 804 170 C 811 176, 809 188, 798 194 C 804 186, 803 178, 796 173 C 770 154, 750 134, 742 114 C 744 103, 736 90, 724 77 Z"
                fill="#ffffff"
              />
              <path
                d="M 644 124 C 660 165, 694 184, 728 180 C 746 182, 768 196, 784 198 C 790 198, 795 196, 798 193 C 792 201, 782 204, 770 201 C 754 197, 740 188, 724 187 C 688 191, 654 168, 644 124 Z"
                fill="#ffffff"
              />
              <path
                d="M 634 127 C 608 168, 624 226, 676 242 C 714 253, 754 238, 788 232 C 806 229, 820 232, 830 237 C 816 234, 800 234, 782 238 C 748 246, 710 261, 670 249 C 614 232, 599 170, 634 127 Z"
                fill="#ffffff"
              />
            </g>
            <g>
              <path
                fill="#ffffff"
                fill-rule="evenodd"
                d="M 62 183 L 122 183 L 204 335 C 209 343, 215 347, 223 349 L 150 349 C 158 347, 160 342, 156 333 L 132 283 L 76 283 L 56 327 C 51 338, 56 346, 69 350 L 23 350 C 33 345, 41 336, 48 322 L 96 214 C 101 201, 90 188, 62 183 Z M 82 269 L 125 269 L 104 223 Z"
              />
              <path
                fill="rgba(0,0,0,0.3)"
                d="M 103 185 L 114 185 L 195 346 L 184 346 Z"
              />
              <line
                x1="108.5"
                y1="189"
                x2="189.5"
                y2="344"
                stroke="#ffffff"
                stroke-width="4.5"
                stroke-dasharray="7 7"
                stroke-linecap="butt"
              />
            </g>
            <text
              x="195"
              y="283"
              font-family="'Montserrat', system-ui, sans-serif"
              font-size="126"
              font-weight="700"
              letter-spacing="-0.02em"
              fill="#ffffff"
            >
              msirar
            </text>
            <text
              x="598.5"
              y="352"
              font-family="'Yellowtail', var(--font-brand), cursive"
              font-size="85"
              text-anchor="end"
              fill="#ffffff"
            >
              Trip
            </text>
          </g>

          <!-- Colored State (Active / Scrolled Navbar in Light mode only) -->
          <g class="transition-opacity duration-300 opacity-0 group-data-scrolled:opacity-100 pointer-events-none group-data-scrolled:pointer-events-auto group-data-scrolled:dark:opacity-0 group-data-scrolled:dark:pointer-events-none">
            <!-- ==================== HORSE & MANE ==================== -->
            <g
              id="horse-mark"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <!-- Top Crimson Mane Wave -->
              <path
                d="M 324 91 C 385 126, 442 110, 502 82 C 562 54, 628 32, 691 58 C 632 40, 568 62, 508 90 C 446 118, 384 133, 324 91 Z"
                fill="url(#horse-crimson)"
              />

              <!-- Upper Amber-Gold Mane Wave -->
              <path
                d="M 282 103 C 348 156, 422 142, 488 104 C 534 78, 562 66, 589 63 C 556 73, 524 90, 484 114 C 416 153, 344 164, 282 103 Z"
                fill="url(#mane-gold)"
              />

              <!-- Lower Amber-Gold Mane Wave (sweeping under 's' & 'i' dot) -->
              <path
                d="M 277 154 C 334 198, 405 194, 468 148 C 510 116, 538 89, 565 79 C 536 98, 506 127, 464 158 C 402 203, 332 205, 277 154 Z"
                fill="url(#mane-gold)"
              />

              <!-- Inner Crimson Mane & Neck Arch (sweeping down between 'r' and 'a') -->
              <path
                d="M 457 240 C 488 172, 532 108, 594 75 C 630 56, 666 53, 693 60 C 662 59, 626 64, 592 83 C 534 116, 494 176, 457 240 Z"
                fill="url(#horse-crimson)"
              />

              <!-- Horse Ears -->
              <path
                d="M 696 63 C 704 49, 718 41, 733 42 C 726 49, 720 57, 717 69 C 715 62, 717 53, 722 47 C 712 48, 703 55, 696 63 Z"
                fill="url(#horse-crimson)"
              />

              <!-- Horse Forehead, Nose Bridge & Muzzle -->
              <path
                d="M 724 77 C 742 89, 753 102, 751 113 C 760 132, 779 152, 804 170 C 811 176, 809 188, 798 194 C 804 186, 803 178, 796 173 C 770 154, 750 134, 742 114 C 744 103, 736 90, 724 77 Z"
                fill="url(#horse-crimson)"
              />

              <!-- Horse Jawline & Cheek -->
              <path
                d="M 644 124 C 660 165, 694 184, 728 180 C 746 182, 768 196, 784 198 C 790 198, 795 196, 798 193 C 792 201, 782 204, 770 201 C 754 197, 740 188, 724 187 C 688 191, 654 168, 644 124 Z"
                fill="url(#horse-crimson)"
              />

              <!-- Horse Lower Neck & Chest Wave -->
              <path
                d="M 634 127 C 608 168, 624 226, 676 242 C 714 253, 754 238, 788 232 C 806 229, 820 232, 830 237 C 816 234, 800 234, 782 238 C 748 246, 710 261, 670 249 C 614 232, 599 170, 634 127 Z"
                fill="url(#horse-crimson)"
              />
            </g>

            <!-- ==================== "Amsirar" WORDMARK ==================== -->
            <g id="amsirar-wordmark">
              <!-- Capital "A" with Road Motif -->
              <g id="letter-A">
                <!-- Main Navy Body of "A" -->
                <path
                  fill="url(#navy-a)"
                  fill-rule="evenodd"
                  d="M 62 183 L 122 183 L 204 335 C 209 343, 215 347, 223 349 L 150 349 C 158 347, 160 342, 156 333 L 132 283 L 76 283 L 56 327 C 51 338, 56 346, 69 350 L 23 350 C 33 345, 41 336, 48 322 L 96 214 C 101 201, 90 188, 62 183 Z
                         M 82 269 L 125 269 L 104 223 Z"
                />

                <!-- White Road Strip inside Right Stem of "A" -->
                <path
                  fill="#ffffff"
                  d="M 103 185 L 114 185 L 195 346 L 184 346 Z"
                />

                <!-- Crimson Edge Accents along the Road -->
                <path
                  stroke="#780d1f"
                  stroke-width="2.2"
                  fill="none"
                  d="M 101 185 L 183 347 M 116 185 L 197 347"
                />

                <!-- Crimson Dashed Center Line inside the Road -->
                <line
                  x1="108.5"
                  y1="189"
                  x2="189.5"
                  y2="344"
                  stroke="#780d1f"
                  stroke-width="4.5"
                  stroke-dasharray="7 7"
                  stroke-linecap="butt"
                />
              </g>

              <!-- Lowercase "msirar" in Montserrat with matching Navy-A gradient -->
              <text
                x="195"
                y="283"
                font-family="'Montserrat', system-ui, sans-serif"
                font-size="126"
                font-weight="700"
                letter-spacing="-0.02em"
                fill="url(#navy-a)"
              >
                msirar
              </text>
            </g>

            <!-- "Trip" in Yellowtail cursive (matching footer brand), positioned as subscript aligned to the end of 'r' in Amsirar -->
            <text
              x="598.5"
              y="352"
              font-family="'Yellowtail', var(--font-brand), cursive"
              font-size="85"
              text-anchor="end"
              fill="var(--color-orange, #f15d30)"
            >
              Trip
            </text>
          </g>
        </svg>
      </a>

      <nav
        aria-label={t("nav.mainAria")}
        class="absolute inset-s-1/2 z-10 hidden -translate-x-1/2 items-center gap-1 overflow-hidden rounded-full border-2 border-white/10 bg-white/5 p-1.5 shadow-[0_8px_32px_rgba(0,0,0,0.12)] transition-colors duration-200 group-data-scrolled:border-stone-200/90 group-data-scrolled:bg-stone-100/70 group-data-scrolled:dark:border-white/10 group-data-scrolled:dark:bg-[oklch(18%_0.012_245deg/75%)] md:inline-flex lg:gap-1.5 max-w-fit"
        id="desktop-nav"
      >
        <div
          class="pointer-events-none absolute inset-y-1.5 left-0 z-0 rounded-full bg-linear-to-br from-amber-orange to-orange opacity-0 shadow-lg shadow-orange/30 will-change-transform"
          id="desktop-nav-indicator"
        ></div>

        {NAV_ITEMS.map((item) => {
          const active = isActive(item.to);
          const label = t(item.labelKey, item.defaultLabel);
          return (
            <a
              aria-current={active ? "page" : undefined}
              aria-label={label}
              title={label}
              class="group/link desktop-nav-link relative z-10 inline-flex items-center justify-center whitespace-nowrap shrink-0 rounded-full px-3 py-2.5 text-xs font-semibold select-none transition-colors duration-200 text-white/75 hover:text-white group-data-scrolled:text-dark-grey group-data-scrolled:hover:text-dark group-data-scrolled:dark:text-stone-300 group-data-scrolled:dark:hover:text-white data-indicator:text-white group-data-scrolled:data-indicator:text-white lg:px-5 lg:py-2 lg:text-sm"
              data-active={active ? "true" : undefined}
              data-indicator={active ? "true" : undefined}
              href={localize(item.to)}
            >
              <NavIcon
                name={item.icon}
                class="size-5 shrink-0 transition-transform duration-200 group-hover/link:scale-110 lg:hidden motion-reduce:transform-none"
              />
              <span
                class:list={[
                  "desktop-nav-label inline-block overflow-hidden whitespace-nowrap text-xs font-semibold tracking-tight motion-reduce:transition-none lg:text-sm lg:overflow-visible lg:w-auto lg:opacity-100 lg:ml-0",
                  { "ml-2": active, "w-0 opacity-0 ml-0": !active },
                ]}
                data-expanded={active ? "true" : undefined}
              >
                {label}
              </span>
            </a>
          );
        })}
      </nav>

      <div class="flex items-center gap-1.5 sm:gap-2">
        <ThemeToggle id="desktop-theme-toggle" />
        <LanguageSelector
          placement="right"
          size="sm"
        />
      </div>
    </div>
  </div>
</header>

<MobileBottomNav />

<script src="../scripts/navbar-scroll.ts"></script>
<script src="../scripts/desktop-nav.ts"></script>
<script src="../scripts/mobile-nav.ts"></script>
