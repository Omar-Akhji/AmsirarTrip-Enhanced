        id="desktop-nav"
      >
        <div
          class="pointer-events-none absolute inset-y-1.5 left-0 z-0 rounded-full bg-linear-to-br from-amber-orange to-orange opacity-0 shadow-lg shadow-orange/30 will-change-transform"
          id="desktop-nav-indicator"
        ></div>

        {NAV_ITEMS.map((item) => {
          const active = isActive(item.to);
          const label = t(item.labelKey, item.defaultLabel);
          return (
            <a
              aria-current={active ? "page" : undefined}
              aria-label={label}
              title={label}
              class="group/link desktop-nav-link relative z-10 inline-flex items-center justify-center whitespace-nowrap shrink-0 rounded-full px-3 py-2.5 text-xs font-semibold select-none transition-colors duration-200 text-white/75 hover:text-white group-data-scrolled:text-dark-grey group-data-scrolled:hover:text-dark group-data-scrolled:dark:text-stone-300 group-data-scrolled:dark:hover:text-white data-indicator:text-white group-data-scrolled:data-indicator:text-white lg:px-5 lg:py-2 lg:text-sm"
              data-indicator={active ? "true" : undefined}
              href={localize(item.to)}
            >
              <NavIcon
                name={item.icon}
                class="size-5 shrink-0 transition-transform duration-200 group-hover/link:scale-110 lg:hidden motion-reduce:transform-none"
              />
              <span
                class:list={[
                  "desktop-nav-label inline-block overflow-hidden whitespace-nowrap text-xs font-semibold tracking-tight motion-reduce:transition-none lg:text-sm lg:overflow-visible lg:w-auto lg:opacity-100 lg:ml-0",
                  { "ml-2": active, "w-0 opacity-0 ml-0": !active },
                ]}
                data-expanded={active ? "true" : undefined}
              >
                {label}
              </span>
            </a>
          );
        })}
      </nav>

