---
import FeaturedToursSkeleton from "@/features/home/components/FeaturedToursSkeleton.astro";
import HomeStatsSkeleton from "@/features/home/components/HomeStatsSkeleton.astro";
import ServicesSectionSkeleton from "@/features/home/components/ServicesSectionSkeleton.astro";
import TestimonialsSectionSkeleton from "@/features/home/components/TestimonialsSectionSkeleton.astro";
import VideoSectionSkeleton from "@/features/home/components/VideoSectionSkeleton.astro";
import AboutSkeleton from "@/shared/ui/feedback/AboutSkeleton.astro";
import AsciiSkeleton from "@/shared/ui/feedback/AsciiSkeleton.astro";
import ContactSkeleton from "@/shared/ui/feedback/ContactSkeleton.astro";
import FaqSkeleton from "@/shared/ui/feedback/FaqSkeleton.astro";
import HomeHeroSkeleton from "@/shared/ui/feedback/HomeHeroSkeleton.astro";
import PageHeaderSkeleton from "@/shared/ui/feedback/PageHeaderSkeleton.astro";
import TourDetailSkeleton from "@/shared/ui/feedback/TourDetailSkeleton.astro";
import TripCardSkeleton from "@/shared/ui/feedback/TripCardSkeleton.astro";
---

{/* Skeleton container: hidden by default, shown as an overlay during page transitions */}
<div
  aria-hidden="true"
  class="pointer-events-none absolute inset-0 z-30 size-full overflow-hidden bg-white dark:bg-stone-950 transition-opacity duration-300 ease-out hidden"
  id="skeleton-container"
>
  {/* Home Page Skeleton */}
  <div
    class="hidden"
    data-skeleton="home"
  >
    <HomeHeroSkeleton />
    <div class="text-zinc-900">
      <HomeStatsSkeleton />
      <FeaturedToursSkeleton count={6} />
      <ServicesSectionSkeleton />
      <TestimonialsSectionSkeleton />
      <VideoSectionSkeleton />
    </div>
  </div>

  {/* Tours Listing Skeleton */}
  <div
    class="hidden"
    data-skeleton="tours"
  >
    <PageHeaderSkeleton
      crumbWidths={["w-12", "w-16"]}
      hasButtons={false}
      hasUnderline={true}
    />
    <div class="text-zinc-900">
      {/* EXPEDITION STANDARDS */}
      <section class="bg-white py-12 sm:py-16 lg:py-24">
        <div class="mx-auto px-4 max-inline-7xl">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
            {Array.from({ length: 3 }, (_, index) => (
              <div class:list={["flex size-full", { "md:col-span-2 lg:col-span-1": index === 2 }]}>
                <article class="group relative flex size-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/80 p-6 sm:p-7 shadow-xs">
                  <div>
                    <div class="mbe-5 flex items-center justify-between border-b border-stone-100 pb-3 text-[11px] font-mono uppercase tracking-wider text-stone-400">
                      <span class="inline-flex items-center gap-2 font-semibold text-stone-500">
                        <span class="size-2 rounded-full bg-stone-400" />
                        <AsciiSkeleton
                          class="font-mono text-[11px] uppercase text-stone-500"
                          lines={1}
                          variant="dither"
                          widths={["4.5rem"]}
                        />
                      </span>
                      <AsciiSkeleton
                        class="font-mono text-[11px] uppercase text-stone-400"
                        lines={1}
                        variant="dither"
                        widths={["3.5rem"]}
                      />
                    </div>
                    <AsciiSkeleton
                      class="text-4xl font-bold tracking-tight text-stone-800"
                      lines={1}
                      variant="dither"
                      widths={["4.5rem"]}
                    />
                    <div class="mbs-3">
                      <AsciiSkeleton
                        class="text-base sm:text-lg font-semibold tracking-tight text-stone-900"
                        lines={1}
                        variant="dither"
                        widths={["11rem"]}
                      />
                    </div>
                    <div class="mbs-2">
                      <AsciiSkeleton
                        class="text-sm leading-relaxed text-stone-600"
                        lines={2}
                        variant="dither"
                        widths={["100%", "75%"]}
                      />
                    </div>
                  </div>
                </article>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* CURATED ITINERARIES */}
      <section
        class="border-t border-zinc-200 bg-linear-to-b from-zinc-50 to-white py-12 sm:py-16 lg:py-24"
        id="tours-grid-skeleton"
      >
        <div class="mx-auto px-4 max-inline-7xl">
          <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8">
            <div class="max-w-2xl space-y-2">
              <AsciiSkeleton
                class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance"
                lines={1}
                variant="dither"
                widths={["18rem"]}
              />
              <div class="border-s-2 border-stone-300 ps-4 py-0.5 max-w-[62ch]">
                <AsciiSkeleton
                  class="text-stone-600 text-sm sm:text-base leading-relaxed"
                  lines={2}
                  variant="dither"
                  widths={["100%", "65%"]}
                />
              </div>
            </div>
          </div>
          <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
            {Array.from({ length: 6 }, () => (
              <TripCardSkeleton />
            ))}
          </div>
        </div>
      </section>

      {/* TOURS FAQ SKELETON */}
      <FaqSkeleton
        categoryWidth="6rem"
        count={4}
        hasSubtitle={true}
        headingWidth="18rem"
        isListing={true}
        questionWidths={["85%", "75%", "90%", "65%"]}
        subtitleWidth="22rem"
      />
    </div>
  </div>

  {/* Tour Detail Skeleton */}
  <div
    class="hidden"
    data-skeleton="tour-detail"
  >
    <TourDetailSkeleton crumbWidths={["w-12", "w-14", "w-52"]} />
  </div>

  {/* Excursions Listing Skeleton */}
  <div
    class="hidden"
    data-skeleton="excursions"
  >
    <PageHeaderSkeleton
      crumbWidths={["w-12", "w-20"]}
      hasButtons={false}
      hasUnderline={true}
    />
    <div class="text-zinc-900">
      {/* DAY-TRIP STANDARDS */}
      <section class="bg-white py-12 sm:py-16 lg:py-24">
        <div class="mx-auto px-4 max-inline-7xl">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
            {Array.from({ length: 3 }, (_, index) => (
              <div class:list={["flex size-full", { "md:col-span-2 lg:col-span-1": index === 2 }]}>
                <article class="group relative flex size-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/80 p-6 sm:p-7 shadow-xs">
                  <div>
                    <div class="mbe-5 flex items-center justify-between border-b border-stone-100 pb-3 text-[11px] font-mono uppercase tracking-wider text-stone-400">
                      <span class="inline-flex items-center gap-2 font-semibold text-stone-500">
                        <span class="size-2 rounded-full bg-stone-400" />
                        <AsciiSkeleton
                          class="font-mono text-[11px] uppercase text-stone-500"
                          lines={1}
                          variant="dither"
                          widths={["4.5rem"]}
                        />
                      </span>
                      <AsciiSkeleton
                        class="font-mono text-[11px] uppercase text-stone-400"
                        lines={1}
                        variant="dither"
                        widths={["3.5rem"]}
                      />
                    </div>
                    <AsciiSkeleton
                      class="text-4xl font-bold tracking-tight text-stone-800"
                      lines={1}
                      variant="dither"
                      widths={["4.5rem"]}
                    />
                    <div class="mbs-3">
                      <AsciiSkeleton
                        class="text-base sm:text-lg font-semibold tracking-tight text-stone-900"
                        lines={1}
                        variant="dither"
                        widths={["11rem"]}
                      />
                    </div>
                    <div class="mbs-2">
                      <AsciiSkeleton
                        class="text-sm leading-relaxed text-stone-600"
                        lines={2}
                        variant="dither"
                        widths={["100%", "75%"]}
                      />
                    </div>
                  </div>
                </article>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* CURATED DAY TRIPS */}
      <section
        class="border-t border-zinc-200 bg-linear-to-b from-zinc-50 to-white py-12 sm:py-16 lg:py-24"
        id="excursions-grid-skeleton"
      >
        <div class="mx-auto px-4 max-inline-7xl">
          <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8">
            <div class="max-w-2xl space-y-2">
              <AsciiSkeleton
                class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl text-balance"
                lines={1}
                variant="dither"
                widths={["18rem"]}
              />
              <div class="border-s-2 border-stone-300 ps-4 py-0.5 max-w-[62ch]">
                <AsciiSkeleton
                  class="text-stone-600 text-sm sm:text-base leading-relaxed"
                  lines={2}
                  variant="dither"
                  widths={["100%", "65%"]}
                />
              </div>
            </div>
          </div>
          <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
            {Array.from({ length: 6 }, () => (
              <TripCardSkeleton hasItinerary={false} />
            ))}
          </div>
        </div>
      </section>

      {/* EXCURSIONS FAQ SKELETON */}
      <FaqSkeleton
        categoryWidth="6rem"
        count={4}
        hasSubtitle={true}
        headingWidth="19rem"
        isListing={true}
        questionWidths={["75%", "68%", "62%", "78%"]}
        subtitleWidth="20rem"
      />
    </div>
  </div>

  {/* Excursion Detail Skeleton */}
  <div
    class="hidden"
    data-skeleton="excursion-detail"
  >
    <TourDetailSkeleton crumbWidths={["w-12", "w-20", "w-52"]} />
  </div>

  {/* Contact Page Skeleton */}
  <div
    class="hidden"
    data-skeleton="contact"
  >
    <ContactSkeleton />
  </div>

  {/* About Page Skeleton */}
  <div
    class="hidden"
    data-skeleton="about"
  >
    <AboutSkeleton />
  </div>

  {/* Legal (Privacy & Terms) Skeleton */}
  <div
    class="hidden"
    data-skeleton="legal"
  >
    <PageHeaderSkeleton
      crumbWidths={["w-12", "w-28"]}
      hasBreadcrumbs={true}
      hasButtons={false}
    />
    <section class="relative isolate overflow-hidden bg-neutral-50 py-16 text-neutral-900 sm:py-24">
      <div class="relative z-10 mx-auto px-4 max-inline-4xl space-y-8">
        <div class="mx-auto mbe-8 flex justify-center">
          <AsciiSkeleton
            class="text-stone-400 font-mono text-xs uppercase"
            lines={1}
            variant="dither"
            widths={["9rem"]}
          />
        </div>
        <div class="rounded-2xl border border-stone-200/90 bg-white p-8 shadow-xs sm:p-12 space-y-6">
          <AsciiSkeleton
            class="text-2xl font-bold text-stone-800"
            lines={1}
            variant="dither"
            widths={["16rem"]}
          />
          <div class="space-y-3 pt-2">
            <AsciiSkeleton
              class="text-stone-400"
              lines={3}
              variant="dither"
              widths={["100%", "95%", "80%"]}
            />
          </div>
          <div class="space-y-3 pt-4">
            <AsciiSkeleton
              class="text-xl font-bold text-stone-800"
              lines={1}
              variant="dither"
              widths={["12rem"]}
            />
            <AsciiSkeleton
              class="text-stone-400"
              lines={3}
              variant="dither"
              widths={["100%", "90%", "75%"]}
            />
          </div>
        </div>
      </div>
    </section>
  </div>

  {/* Default Fallback Skeleton */}
  <div
    class="hidden"
    data-skeleton="default"
  >
    <PageHeaderSkeleton
      crumbWidths={["w-12", "w-20"]}
      hasButtons={false}
      hasUnderline={true}
    />
    <section class="bg-neutral-50 py-16">
      <div class="mx-auto max-w-7xl px-4">
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {Array.from({ length: 3 }, () => (
            <TripCardSkeleton />
          ))}
        </div>
      </div>
    </section>
  </div>
</div>
