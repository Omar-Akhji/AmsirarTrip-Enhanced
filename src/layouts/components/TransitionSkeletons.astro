---
import { getExcursionsData } from "@/features/excursions/data/excursions-data";
import FeaturedToursSkeleton from "@/features/home/components/FeaturedToursSkeleton.astro";
import HomeStatsSkeleton from "@/features/home/components/HomeStatsSkeleton.astro";
import ServicesSectionSkeleton from "@/features/home/components/ServicesSectionSkeleton.astro";
import TestimonialsSectionSkeleton from "@/features/home/components/TestimonialsSectionSkeleton.astro";
import VideoSectionSkeleton from "@/features/home/components/VideoSectionSkeleton.astro";
import { getToursData } from "@/features/tours/data/tours-data";
import { Skeleton } from "@/components/ui/skeleton";
import AboutSkeleton from "@/shared/ui/feedback/AboutSkeleton.astro";
import ButtonSkeleton from "@/shared/ui/feedback/ButtonSkeleton.astro";
import ContactSkeleton from "@/shared/ui/feedback/ContactSkeleton.astro";
import FaqSkeleton from "@/shared/ui/feedback/FaqSkeleton.astro";
import HomeHeroSkeleton from "@/shared/ui/feedback/HomeHeroSkeleton.astro";
import PageHeaderSkeleton from "@/shared/ui/feedback/PageHeaderSkeleton.astro";
import TourDetailSkeleton from "@/shared/ui/feedback/TourDetailSkeleton.astro";
import TripCardSkeleton from "@/shared/ui/feedback/TripCardSkeleton.astro";

const toursData = await getToursData();
const excursionsData = await getExcursionsData();
const toursCount = toursData.length;
const excursionsCount = excursionsData.length;
---

{/* Skeleton container: hidden by default, shown as an overlay during page transitions */}
<div
  aria-hidden="true"
  class="pointer-events-none absolute inset-0 z-30 size-full overflow-hidden bg-white dark:bg-stone-950 transition-opacity duration-300 ease-out hidden"
  id="skeleton-container"
>
  {/* Home Page Skeleton */}
  <div
    class="hidden"
    data-skeleton="home"
  >
    <HomeHeroSkeleton />
    <div class="text-zinc-900">
      <HomeStatsSkeleton />
      <FeaturedToursSkeleton count={6} />
      <ServicesSectionSkeleton />
      <TestimonialsSectionSkeleton />
      <VideoSectionSkeleton />
    </div>
  </div>

  {/* Tours Listing Skeleton */}
  <div
    class="hidden"
    data-skeleton="tours"
  >
    <PageHeaderSkeleton
      crumbWidths={["w-12", "w-16"]}
      hasButtons={false}
      hasUnderline={true}
      subtitleLines={2}
    />
    <div class="text-zinc-900">
      {/* EXPEDITION STANDARDS matching StatHighlights folder runway on mobile */}
      <section class="bg-white py-12 sm:py-16 lg:py-24">
        <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
          <div class="block md:hidden w-full">
            <div class="relative w-full overflow-x-clip">
              <div class="relative w-full h-auto motion-safe:h-[220vh]">
                <div class="static h-auto motion-safe:sticky motion-safe:top-18 motion-safe:h-102.5 w-full mx-auto">
                  <div class="flex flex-col gap-5 w-full motion-safe:hidden">
                    {Array.from({ length: 3 }, () => (
                      <article class="stat-card relative flex h-55 w-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/95 p-5 shadow-xl shadow-stone-900/10">
                        <div>
                          <div class="mbe-3.5 flex items-center justify-between border-b border-stone-100 pb-2.5">
                            <Skeleton class="h-3.5 w-18" />
                            <Skeleton class="h-3.5 w-14" />
                          </div>
                          <Skeleton class="h-10 w-20" />
                          <div class="mbs-2.5">
                            <Skeleton class="h-5 w-40" />
                          </div>
                          <div class="mbs-1.5 space-y-1.5">
                            <Skeleton class="h-3.5 w-full" />
                            <Skeleton class="h-3.5 w-3/4" />
                          </div>
                        </div>
                      </article>
                    ))}
                  </div>
                  <div class="hidden motion-safe:block relative top-2 h-85 w-full">
                    <article class="stat-card relative flex h-55 w-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/95 p-5 shadow-xl shadow-stone-900/10">
                      <div>
                        <div class="mbe-3.5 flex items-center justify-between border-b border-stone-100 pb-2.5">
                          <Skeleton class="h-3.5 w-18" />
                          <Skeleton class="h-3.5 w-14" />
                        </div>
                        <Skeleton class="h-10 w-20" />
                        <div class="mbs-2.5">
                          <Skeleton class="h-5 w-40" />
                        </div>
                        <div class="mbs-1.5 space-y-1.5">
                          <Skeleton class="h-3.5 w-full" />
                          <Skeleton class="h-3.5 w-3/4" />
                        </div>
                      </div>
                    </article>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 2xl:gap-8 items-stretch">
            {Array.from({ length: 3 }, (_, index) => (
              <div class:list={["flex size-full", { "md:col-span-2 lg:col-span-1": index === 2 }]}>
                <article class="group relative flex size-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/80 p-6 sm:p-7 shadow-xs">
                  <div>
                    <div class="mbe-5 flex items-center justify-between border-b border-stone-100 pb-3">
                      <Skeleton class="h-3.5 w-18" />
                      <Skeleton class="h-3.5 w-14" />
                    </div>
                    <Skeleton class="h-10 w-20" />
                    <div class="mbs-3">
                      <Skeleton class="h-6 w-44" />
                    </div>
                    <div class="mbs-2 space-y-1.5">
                      <Skeleton class="h-4 w-full" />
                      <Skeleton class="h-4 w-3/4" />
                    </div>
                  </div>
                </article>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* CURATED ITINERARIES */}
      <section
        class="border-t border-zinc-200 bg-linear-to-b from-zinc-50 to-white py-12 sm:py-16 lg:py-24"
        id="tours-grid-skeleton"
      >
        <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
          <div class="mbe-8 sm:mbe-12 flex flex-col gap-6 border-b border-stone-200 pb-6 sm:pb-8">
            <hgroup class="max-w-2xl space-y-2">
              <div class="text-3xl/tight sm:text-4xl font-bold ">
                <Skeleton class="h-[1.15em] w-72 sm:w-96 max-w-full" />
              </div>
              <div class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm/relaxed sm:text-base space-y-1.5 max-w-[62ch]">
                <Skeleton class="h-4 sm:h-5 w-full" />
                <Skeleton class="h-4 sm:h-5 w-2/3" />
              </div>
            </hgroup>

            <nav
              aria-label="Filter tours by departure city"
              class="flex flex-wrap items-center gap-2 pt-1"
            >
              <span class="text-xs font-semibold uppercase tracking-wider text-stone-500 pe-1">
                Departure:
              </span>
              <span class="rounded-full px-3.5 py-1.5 text-xs font-medium bg-stone-900 text-white">
                All Cities
              </span>
              {Array.from({ length: 4 }, () => (
                <span class="rounded-full px-3.5 py-1.5 text-xs font-medium bg-stone-100">
                  <Skeleton class="h-3.5 w-16" />
                </span>
              ))}
            </nav>
          </div>
          <div class="grid grid-cols-1 gap-6 xs:gap-7 md:grid-cols-2 lg:grid-cols-3 lg:gap-8 2xl:gap-10">
            {Array.from({ length: toursCount }, () => (
              <div class="flex size-full">
                <TripCardSkeleton />
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* TOURS FAQ SKELETON */}
      <FaqSkeleton
        count={4}
        hasSubtitle={true}
        headingWidth="w-72"
        isListing={true}
        questionWidths={["w-11/12", "w-4/5", "w-5/6", "w-2/3"]}
        subtitleWidth="w-80"
      />
    </div>
  </div>

  {/* Tour Detail Skeleton */}
  <div
    class="hidden"
    data-skeleton="tour-detail"
  >
    <TourDetailSkeleton
      crumbWidths={["w-12", "w-14", "w-52"]}
      hasItinerary={true}
      hasRelated={true}
    />
  </div>

  {/* Excursions Listing Skeleton */}
  <div
    class="hidden"
    data-skeleton="excursions"
  >
    <PageHeaderSkeleton
      crumbWidths={["w-12", "w-20"]}
      hasButtons={false}
      hasUnderline={true}
      subtitleLines={2}
    />
    <div class="text-zinc-900">
      {/* DAY-TRIP STANDARDS matching StatHighlights folder runway on mobile */}
      <section class="bg-white py-12 sm:py-16 lg:py-24">
        <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
          <div class="block md:hidden w-full">
            <div class="relative w-full overflow-x-clip">
              <div class="relative w-full h-auto motion-safe:h-[220vh]">
                <div class="static h-auto motion-safe:sticky motion-safe:top-18 motion-safe:h-102.5 w-full mx-auto">
                  <div class="flex flex-col gap-5 w-full motion-safe:hidden">
                    {Array.from({ length: 3 }, () => (
                      <article class="stat-card relative flex h-55 w-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/95 p-5 shadow-xl shadow-stone-900/10">
                        <div>
                          <div class="mbe-3.5 flex items-center justify-between border-b border-stone-100 pb-2.5">
                            <Skeleton class="h-3.5 w-18" />
                            <Skeleton class="h-3.5 w-14" />
                          </div>
                          <Skeleton class="h-10 w-20" />
                          <div class="mbs-2.5">
                            <Skeleton class="h-5 w-40" />
                          </div>
                          <div class="mbs-1.5 space-y-1.5">
                            <Skeleton class="h-3.5 w-full" />
                            <Skeleton class="h-3.5 w-3/4" />
                          </div>
                        </div>
                      </article>
                    ))}
                  </div>
                  <div class="hidden motion-safe:block relative top-2 h-85 w-full">
                    <article class="stat-card relative flex h-55 w-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/95 p-5 shadow-xl shadow-stone-900/10">
                      <div>
                        <div class="mbe-3.5 flex items-center justify-between border-b border-stone-100 pb-2.5">
                          <Skeleton class="h-3.5 w-18" />
                          <Skeleton class="h-3.5 w-14" />
                        </div>
                        <Skeleton class="h-10 w-20" />
                        <div class="mbs-2.5">
                          <Skeleton class="h-5 w-40" />
                        </div>
                        <div class="mbs-1.5 space-y-1.5">
                          <Skeleton class="h-3.5 w-full" />
                          <Skeleton class="h-3.5 w-3/4" />
                        </div>
                      </div>
                    </article>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 2xl:gap-8 items-stretch">
            {Array.from({ length: 3 }, (_, index) => (
              <div class:list={["flex size-full", { "md:col-span-2 lg:col-span-1": index === 2 }]}>
                <article class="group relative flex size-full flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/80 p-6 sm:p-7 shadow-xs">
                  <div>
                    <div class="mbe-5 flex items-center justify-between border-b border-stone-100 pb-3">
                      <Skeleton class="h-3.5 w-18" />
                      <Skeleton class="h-3.5 w-14" />
                    </div>
                    <Skeleton class="h-10 w-20" />
                    <div class="mbs-3">
                      <Skeleton class="h-6 w-44" />
                    </div>
                    <div class="mbs-2 space-y-1.5">
                      <Skeleton class="h-4 w-full" />
                      <Skeleton class="h-4 w-3/4" />
                    </div>
                  </div>
                </article>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* CURATED DAY TRIPS */}
      <section
        class="border-t border-zinc-200 bg-linear-to-b from-zinc-50 to-white py-12 sm:py-16 lg:py-24"
        id="excursions-grid-skeleton"
      >
        <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
          <div class="mbe-8 sm:mbe-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-stone-200 pb-6 sm:pb-8">
            <hgroup class="max-w-2xl space-y-2">
              <div class="text-3xl/tight sm:text-4xl font-bold ">
                <Skeleton class="h-[1.15em] w-72 sm:w-96 max-w-full" />
              </div>
              <div class="border-s-2 border-orange-600 ps-4 py-0.5 text-sm/relaxed sm:text-base space-y-1.5 max-w-[62ch]">
                <Skeleton class="h-4 sm:h-5 w-full" />
                <Skeleton class="h-4 sm:h-5 w-2/3" />
              </div>
            </hgroup>
          </div>
          <div class="grid grid-cols-1 gap-6 xs:gap-7 md:grid-cols-2 lg:grid-cols-3 lg:gap-8 2xl:gap-10">
            {Array.from({ length: excursionsCount }, () => (
              <div class="flex size-full">
                <TripCardSkeleton hasItinerary={false} />
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* EXCURSIONS FAQ SKELETON */}
      <FaqSkeleton
        count={4}
        hasSubtitle={true}
        headingWidth="w-76"
        isListing={true}
        questionWidths={["w-3/4", "w-2/3", "w-3/5", "w-4/5"]}
        subtitleWidth="w-80"
      />
    </div>
  </div>

  {/* Excursion Detail Skeleton */}
  <div
    class="hidden"
    data-skeleton="excursion-detail"
  >
    <TourDetailSkeleton
      crumbWidths={["w-12", "w-20", "w-52"]}
      hasItinerary={false}
      hasRelated={false}
    />
  </div>

  {/* Contact Page Skeleton */}
  <div
    class="hidden"
    data-skeleton="contact"
  >
    <ContactSkeleton />
  </div>

  {/* About Page Skeleton */}
  <div
    class="hidden"
    data-skeleton="about"
  >
    <AboutSkeleton />
  </div>

  {/* Legal (Privacy & Terms) Skeleton */}
  <div
    class="hidden"
    data-skeleton="legal"
  >
    <PageHeaderSkeleton
      crumbWidths={["w-12", "w-28"]}
      hasBreadcrumbs={true}
      hasButtons={false}
      hasUnderline={true}
      subtitleLines={3}
    >
      <div class="flex flex-wrap items-center justify-center gap-2 pbs-2">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1 text-xs font-mono font-medium text-white backdrop-blur-md">
          <span class="size-2 rounded-full bg-emerald-400"></span>
          <Skeleton class="h-3 w-28 bg-white/20" />
        </div>
        <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1 text-xs font-mono font-medium text-white/90 backdrop-blur-md">
          <Skeleton class="h-3 w-30 bg-white/20" />
        </div>
        <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1 text-xs font-mono font-medium text-white/90 backdrop-blur-md">
          <Skeleton class="h-3 w-24 bg-white/20" />
        </div>
      </div>
    </PageHeaderSkeleton>

    <div class="relative bg-stone-50/70 text-slate-900">
      {/* Executive Summary Bento */}
      <section
        aria-label="Legal Summary"
        class="relative z-10 border-be border-stone-200/80 bg-white py-12 lg:py-16"
      >
        <div class="mx-auto max-w-7xl 2xl:max-w-360 3xl:max-w-420 px-4 sm:px-6 lg:px-8">
          <div class="max-w-2xl space-y-2">
            <Skeleton class="h-3.5 w-32" />
            <Skeleton class="h-8 w-56" />
            <Skeleton class="h-4 w-96 max-w-full" />
          </div>

          <div class="mbs-8 grid grid-cols-1 gap-4 xs:grid-cols-2 lg:grid-cols-4 2xl:gap-6">
            {Array.from({ length: 4 }, (_, idx) => (
              <div class="group relative flex flex-col justify-between rounded-2xl border border-stone-200/90 bg-stone-50/60 p-6">
                <div>
                  <span class="font-mono text-xs font-bold text-orange-600">0{idx + 1}</span>
                  <div class="mbs-3">
                    <Skeleton class="h-5 w-4/5" />
                  </div>
                  <div class="mbs-2 space-y-1.5">
                    <Skeleton class="h-3.5 w-full" />
                    <Skeleton class="h-3.5 w-11/12" />
                    <Skeleton class="h-3.5 w-2/3" />
                  </div>
                </div>
                <div class="mbs-4 pbs-3 border-bs border-stone-200/60 flex items-center gap-2 text-xs font-medium text-slate-500">
                  <span class="size-2 rounded-full bg-emerald-500"></span>
                  <Skeleton class="h-3 w-20" />
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Two-Column Swiss Editorial Layout matching PrivacyView */}
      <div class="relative z-10 mx-auto max-w-7xl 2xl:max-w-360 3xl:max-w-420 px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-golden-rev lg:gap-8 xl:gap-8">
          {/* STICKY SIDEBAR */}
          <aside>
            <div class="sticky top-24 space-y-4">
              <div class="rounded-2xl border border-stone-200/90 bg-white p-4 sm:p-5 shadow-sm">
                <div class="flex items-center justify-between border-be border-stone-200/80 pbe-3">
                  <Skeleton class="h-3.5 w-32" />
                  <span class="rounded-full bg-stone-100 px-2 py-1 font-mono text-[11px] font-semibold text-slate-600">
                    10
                  </span>
                </div>
                <div class="mbs-3 flex flex-col gap-2 text-xs sm:text-sm font-medium">
                  {Array.from({ length: 8 }, (_, idx) => (
                    <div class="flex items-center gap-2 rounded-full px-3 py-2 text-slate-600">
                      <span class="font-mono text-xs font-bold text-slate-400">0{idx + 1}</span>
                      <Skeleton class="h-3.5 flex-1" />
                    </div>
                  ))}
                </div>
                <div class="mbs-3 pbs-3 border-bs border-stone-200/80">
                  <ButtonSkeleton
                    class="w-full bg-stone-50 text-slate-700"
                    size="sm"
                    variant="outline"
                  />
                </div>
              </div>

              <div class="overflow-hidden rounded-2xl border border-white/10 bg-slate-950 p-5 text-white shadow-xl ring-1 ring-white/10 space-y-2">
                <Skeleton class="h-3.5 w-28 bg-white/20" />
                <div class="mbs-2">
                  <Skeleton class="h-6 w-48 bg-white/20" />
                </div>
                <div class="mbs-1">
                  <Skeleton class="h-3.5 w-40 bg-white/10" />
                </div>
                <div class="mbs-4 flex flex-col gap-2 border-bs border-white/10 pbs-3">
                  <Skeleton class="h-3 w-11/12 bg-white/10" />
                  <Skeleton class="h-3 w-2/3 bg-white/10" />
                  <Skeleton class="h-3 w-1/2 bg-white/10" />
                </div>
                <div class="mbs-4 pbs-2">
                  <ButtonSkeleton
                    class="w-full rounded-full"
                    size="md"
                    variant="primary"
                  />
                </div>
              </div>
            </div>
          </aside>

          {/* CONTENT SECTIONS matching PrivacyView 11 sections + Cookie Inventory Table */}
          <div class="space-y-6">
            {Array.from({ length: 11 }, (_, idx) => (
              <section class="relative rounded-2xl border border-stone-200/90 bg-white p-6 sm:p-8 shadow-sm">
                <div class="border-be border-stone-200/80 pbe-4 flex items-center gap-3">
                  <span class="flex shrink-0 items-center justify-center rounded-full bg-orange-500/10 px-2 py-1 font-mono text-xs font-bold text-orange-600">
                    {String(idx + 1).padStart(2, "0")}
                  </span>
                  <Skeleton class="h-7 w-56 flex-1" />
                </div>
                <div class="mbs-6 flex flex-col gap-4">
                  <div class="space-y-2">
                    <Skeleton class="h-4 w-full" />
                    <Skeleton class="h-4 w-11/12" />
                    <Skeleton class="h-4 w-4/5" />
                  </div>
                  <div class="space-y-2">
                    <Skeleton class="h-4 w-full" />
                    <Skeleton class="h-4 w-11/12" />
                    <Skeleton class="h-4 w-3/4" />
                  </div>
                  {idx === 3 && (
                    <div class="mbs-2 rounded-xl border border-stone-200 bg-stone-50/70 p-4 space-y-3">
                      <Skeleton class="h-5 w-48" />
                      {Array.from({ length: 5 }, () => (
                        <Skeleton class="h-10 w-full rounded-lg" />
                      ))}
                    </div>
                  )}
                </div>
              </section>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Default Fallback Skeleton */}
  <div
    class="hidden"
    data-skeleton="default"
  >
    <PageHeaderSkeleton
      crumbWidths={["w-12", "w-20"]}
      hasButtons={false}
      hasUnderline={true}
    />
    <section class="bg-neutral-50 py-16">
      <div class="mx-auto px-4 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
        <div class="grid grid-cols-1 gap-6 xs:gap-7 md:grid-cols-2 lg:grid-cols-3 lg:gap-8 2xl:gap-10">
          {Array.from({ length: 3 }, () => (
            <TripCardSkeleton />
          ))}
        </div>
      </div>
    </section>
  </div>
</div>
