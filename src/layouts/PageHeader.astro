---
import AltArrowRightIcon from "@/shared/ui/icons/AltArrowRightIcon.astro";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  title: string;
  subtitle?: string;
  smTitle?: string;
  headingId?: string;
  gradientPosition?: "top" | "top-right" | "center";
  bgImage?: string | ImageMetadata;
  breadcrumbs?: { label: string; href?: string }[];
  hasUnderline?: boolean;
}

const {
  title,
  subtitle,
  smTitle,
  headingId,
  gradientPosition = "top",
  bgImage,
  breadcrumbs,
  hasUnderline = true,
} = Astro.props;

const locale = Astro.currentLocale || "en";

let gradientValue =
  "bg-[radial-gradient(circle_at_top,color-mix(in_oklch,var(--color-orange)_15%,transparent),transparent_70%)]";
if (gradientPosition === "top-right") {
  gradientValue =
    "bg-[radial-gradient(circle_at_top_right,color-mix(in_oklch,var(--color-orange)_15%,transparent),transparent_70%)]";
} else if (gradientPosition === "center") {
  gradientValue =
    "bg-[radial-gradient(circle_at_center,color-mix(in_oklch,var(--color-orange)_15%,transparent),transparent_70%)]";
}
---

<section class="relative flex flex-col justify-center overflow-hidden bg-zinc-950 pbs-20 pbe-10 xs:pbs-24 xs:pbe-12 sm:pbs-28 sm:pbe-16 lg:pbs-32 lg:pbe-20 2xl:pbs-36 2xl:pbe-24 text-center text-white shadow-xl inline-full min-h-[48dvh] sm:min-h-[52dvh] lg:min-h-[56dvh] max-h-150 3xl:max-h-175 print:hidden">
  {bgImage ?
    typeof bgImage === "string" ?
      <Image
        alt=""
        class="absolute inset-0 size-full object-cover"
        decoding="async"
        fetchpriority="high"
        height={1280}
        loading="eager"
        src={bgImage}
        width={1920}
      />
    : <Image
        alt=""
        class="absolute inset-0 size-full object-cover"
        decoding="async"
        fetchpriority="high"
        loading="eager"
        src={bgImage}
      />

  : null}

  <div
    aria-hidden="true"
    class:list={["absolute inset-0", gradientValue]}
  ></div>
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-linear-to-b from-black/40 via-black/20 to-black/45"
  ></div>

  <div class="relative mx-auto my-auto flex flex-col items-center justify-center px-4 text-center inline-full max-inline-7xl">
    <div class="w-full max-w-4xl space-y-6 text-center">
      {breadcrumbs && breadcrumbs.length > 0 ?
        <nav
          aria-label="Breadcrumb"
          class="mbe-6 sm:mbe-8 flex items-center justify-center gap-3"
        >
          <ol
            role="list"
            class="flex list-none flex-wrap items-center gap-2 rounded-full border-[1.5px] border-white/10 bg-white/10 px-6 py-2 shadow-xs ring-1 ring-black/5 backdrop-blur-[20px]"
          >
            {breadcrumbs.map((crumb, index) => (
              <li class="flex items-center gap-2">
                {crumb.href ?
                  <a
                    class="text-sm font-medium text-white/80 transition-colors pointer-fine:hover:text-white"
                    href={getRelativeLocaleUrl(locale, crumb.href)}
                  >
                    {crumb.label}
                  </a>
                : <span
                    aria-current="page"
                    class="text-sm font-semibold text-yellow"
                  >
                    {crumb.label}
                  </span>
                }
                {index < breadcrumbs.length - 1 && (
                  <AltArrowRightIcon
                    aria-hidden="true"
                    class="size-3 text-white/40"
                  />
                )}
              </li>
            ))}
          </ol>
        </nav>
      : null}

      <hgroup class="space-y-4 sm:space-y-5">
        {smTitle && !breadcrumbs ?
          <div class="flex items-center justify-center gap-4">
            <span class="bg-orange-400/60 block-px inline-8" />
            <p class="font-mono text-xs font-semibold tracking-[0.16em] text-orange-300 uppercase">
              {smTitle}
            </p>
            <span class="bg-orange-400/60 block-px inline-8" />
          </div>
        : null}

        <h1
          class="text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl text-balance"
          id={headingId}
        >
          {title}
        </h1>

        {hasUnderline ?
          <div
            aria-hidden="true"
            class="mx-auto mt-3 block-1 inline-20 rounded-none bg-orange-500"
          />
        : null}

        {subtitle ?
          <p class="mx-auto max-w-[62ch] font-mono text-sm leading-relaxed text-zinc-200 sm:text-base lg:text-lg">
            {subtitle}
          </p>
        : null}
      </hgroup>
      {Astro.slots.has("default") && (
        <div class="flex flex-wrap items-center justify-center gap-4 pbs-2">
          <slot />
        </div>
      )}
    </div>
  </div>
</section>
