---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripLocaleFromPath, useTranslations } from "@/i18n/utils";
import NavIcon, { type NavIconName } from "./NavIcon.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const localize = (path: string): string => {
  const clean = path.replace(/^\/+/, "");
  return getRelativeLocaleUrl(locale, clean || undefined);
};

const normalizedPath = stripLocaleFromPath(Astro.url.pathname);

const isActive = (to: string): boolean =>
  normalizedPath === to || (to !== "/" && normalizedPath.startsWith(`${to}/`));

interface NavDockItem {
  readonly to: string;
  readonly labelKey: string;
  readonly defaultLabel: string;
  readonly icon: NavIconName;
}

const NAV_ITEMS: readonly NavDockItem[] = [
  { to: "/", labelKey: "nav.home", defaultLabel: "Home", icon: "home" },
  { to: "/tours", labelKey: "nav.tours", defaultLabel: "Tours", icon: "tours" },
  { to: "/excursions", labelKey: "nav.excursions", defaultLabel: "Excursions", icon: "excursions" },
  { to: "/about", labelKey: "nav.about", defaultLabel: "About", icon: "about" },
  { to: "/contact", labelKey: "nav.contact", defaultLabel: "Contact", icon: "contact" },
] as const;
---

<nav
  aria-label={t("nav.mainAria")}
  class:list={[
    "group/dock fixed bottom-4 inset-x-0 mx-auto z-40 w-fit max-w-[calc(100vw-1.5rem)] xs:max-w-[calc(100vw-2rem)] mbe-[env(safe-area-inset-bottom,0)]",
    "flex items-center gap-0.5 xs:gap-1 p-1 xs:p-1.5 overflow-hidden rounded-full border-2 border-stone-200/90 bg-white/95 text-dark-grey shadow-[0_12px_30px_oklch(0%_0_0deg/8%)] backdrop-blur-xl transition-colors duration-200 md:hidden print:hidden",
    "dark:border-white/12 dark:bg-[oklch(14.1%_0.01_240deg/90%)] dark:text-mist-100 dark:shadow-[0_16px_40px_rgba(0,0,0,0.65)]",
    className,
  ]}
  id="mobile-bottom-nav"
  transition:name="mobile-bottom-nav"
>
  {NAV_ITEMS.map((item) => {
    const active = isActive(item.to);
    const label = t(item.labelKey, item.defaultLabel);

    return (
      <a
        aria-current={active ? "page" : undefined}
        aria-label={label}
        class:list={[
          "group/link relative z-10 inline-flex h-11 min-h-11 shrink-0 items-center justify-center rounded-full px-3 py-2 text-xs font-semibold whitespace-nowrap transition-transform duration-150 select-none active:scale-95",
          {
            "text-white": active,
            "text-dark-grey hover:text-dark dark:text-stone-300 dark:hover:text-white": !active,
          },
        ]}
        href={localize(item.to)}
        title={label}
      >
        {active && (
          <span
            class="pointer-events-none absolute inset-0 z-0 rounded-full bg-linear-to-br from-amber-orange to-orange shadow-md shadow-orange/30 motion-reduce:transition-none"
            transition:name="mobile-nav-indicator"
          />
        )}
        <NavIcon
          name={item.icon}
          class="relative z-10 size-5 shrink-0 transition-transform duration-200 group-hover/link:scale-110 motion-reduce:transform-none"
        />
        {active && (
          <span class="relative z-10 ml-1.5 inline-block whitespace-nowrap text-xs font-semibold tracking-tight motion-reduce:transition-none">
            {label}
          </span>
        )}
      </a>
    );
  })}
</nav>
