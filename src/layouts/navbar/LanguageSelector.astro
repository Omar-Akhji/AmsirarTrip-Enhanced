---
import type { Locale } from "@/i18n/locales";
import { getLocalizedPath, useTranslations } from "@/i18n/utils";
import GlobalIcon from "@/shared/ui/icons/GlobalIcon.astro";
import { LANGUAGES } from "./constants";

interface Props {
  placement?: "left" | "right";
  size?: "sm" | "md";
  class?: string;
  id?: string;
}

const {
  placement = "left",
  size = "md",
  class: className = "",
  id = "lang-selector",
} = Astro.props;

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const currentLanguage = LANGUAGES.find((l) => l.code === locale) || {
  code: "en",
  name: "English",
  shortName: "EN",
};

const getLocalizedHref = (code: string) => {
  return getLocalizedPath(Astro.url.pathname, code as Locale) + Astro.url.search;
};

const menuId = `${id}-popover`;
---

<div class:list={["language-selector-root relative inline-block", className]}>
  <button
    popovertarget={menuId}
    aria-haspopup="menu"
    aria-label={`${t("language") || "Language"}: ${currentLanguage.name}`}
    style="anchor-name: --lang-selector-btn;"
    class:list={[
      "group/lang-btn relative inline-flex items-center rounded-full font-medium transition-all duration-200 cursor-pointer select-none active:scale-[0.98]",
      "border border-white/20 bg-black/30 backdrop-blur-md text-white shadow-xs hover:border-white/40 hover:bg-white/15 hover:shadow-md",
      "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange/80 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950",
      "group-data-scrolled:border-transparent group-data-scrolled:bg-orange group-data-scrolled:text-white group-data-scrolled:shadow-[0_4px_14px_rgba(241,93,48,0.35)] group-data-scrolled:hover:bg-orange-600",
      {
        "h-9.5 px-3.5 gap-2 text-xs sm:text-sm": size === "sm",
        "h-11 px-4 gap-2.5 text-sm": size === "md",
      },
    ]}
    type="button"
  >
    <GlobalIcon class="size-4 shrink-0 text-white/90 transition-colors group-hover/lang-btn:text-white group-data-scrolled:text-white" />
    <span class="font-mono font-semibold tracking-wider uppercase text-[11px] sm:text-xs">
      {currentLanguage.shortName}
    </span>
    <svg
      aria-hidden="true"
      class="lang-chevron size-3.5 shrink-0 text-white/70 transition-transform duration-250 ease-out group-hover/lang-btn:text-white group-data-scrolled:text-white/90"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <div
    id={menuId}
    popover="auto"
    aria-orientation="vertical"
    class:list={[
      "language-selector-popover min-w-50 sm:min-w-55 overflow-hidden border border-white/12 bg-slate-950/95 text-white shadow-[0_20px_45px_-12px_rgba(0,0,0,0.7),0_0_0_1px_rgba(255,255,255,0.06)] backdrop-blur-2xl ring-1 ring-white/10 rounded-2xl p-1.5",
      "group-data-scrolled:border-stone-200/90 group-data-scrolled:bg-white/98 group-data-scrolled:text-slate-800 group-data-scrolled:shadow-[0_20px_45px_-10px_rgba(0,0,0,0.18),0_0_0_1px_rgba(0,0,0,0.04)]",
      { "inset-inline-start-0": placement === "left", "inset-inline-end-0": placement === "right" },
    ]}
    role="menu"
  >
    {/* Subtle Header */}
    <div class="px-3 pt-2 pb-1.5 text-[10px] font-mono uppercase tracking-widest text-zinc-400 group-data-scrolled:text-stone-500 select-none font-semibold">
      {t("language") || "Language"}
    </div>

    <div
      class="my-1 mx-1.5 h-px bg-white/10 group-data-scrolled:bg-stone-200/70"
      role="separator"
    ></div>

    {/* Language List */}
    <div class="flex flex-col gap-0.5">
      {LANGUAGES.map((lang) => {
        const isCurrent = lang.code === currentLanguage.code;
        return (
          <a
            aria-checked={isCurrent}
            aria-label={lang.name}
            class:list={[
              "group/item relative flex items-center gap-2.5 px-2.5 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all duration-150 inline-full select-none cursor-pointer",
              "outline-none focus-visible:ring-2 focus-visible:ring-orange/80 focus-visible:ring-offset-1 focus-visible:ring-offset-slate-950",
              {
                "bg-white/15 text-white font-semibold group-data-scrolled:bg-orange/10 group-data-scrolled:text-orange-950 shadow-xs":
                  isCurrent,
                "text-zinc-300 hover:bg-white/10 hover:text-white group-data-scrolled:text-stone-600 group-data-scrolled:hover:bg-stone-100 group-data-scrolled:hover:text-stone-900":
                  !isCurrent,
              },
            ]}
            href={getLocalizedHref(lang.code)}
            role="menuitemradio"
          >
            <span
              class:list={[
                "flex h-5.5 w-7 items-center justify-center rounded-md font-mono text-[10px] font-bold tracking-wider uppercase transition-colors shrink-0",
                {
                  "bg-orange text-white shadow-xs": isCurrent,
                  "bg-white/10 text-zinc-300 group-hover/item:bg-white/20 group-hover/item:text-white group-data-scrolled:bg-stone-200/80 group-data-scrolled:text-stone-700 group-data-scrolled:group-hover/item:bg-stone-300/80":
                    !isCurrent,
                },
              ]}
            >
              {lang.shortName}
            </span>
            <span class="truncate text-[13px]">{lang.name}</span>
          </a>
        );
      })}
    </div>
  </div>
</div>
