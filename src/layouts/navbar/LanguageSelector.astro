---
import type { Locale } from "@/i18n/locales";
import { getLocalizedPath, useTranslations } from "@/i18n/utils";
import GlobalIcon from "@/shared/ui/icons/GlobalIcon.astro";
import { LANGUAGES } from "./constants";

interface Props {
  placement?: "left" | "right";
  size?: "sm" | "md";
  class?: string;
  id?: string;
}

const {
  placement = "left",
  size = "md",
  class: className = "",
  id = "lang-selector",
} = Astro.props;

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);

const currentLanguage = LANGUAGES.find((l) => l.code === locale) || {
  code: "en",
  name: "English",
  shortName: "EN",
};

const getLocalizedHref = (code: string) => {
  return getLocalizedPath(Astro.url.pathname, code as Locale) + Astro.url.search;
};

const menuId = `${id}-popover`;
---

<div class:list={["language-selector-root relative inline-block", className]}>
  <button
    popovertarget={menuId}
    aria-haspopup="menu"
    aria-label={`${t("language") || "Language"}: ${currentLanguage.name}`}
    style="anchor-name: --lang-selector-btn;"
    class:list={[
      "group/lang-btn relative inline-flex items-center rounded-full font-medium transition-all duration-200 cursor-pointer select-none active:scale-[0.98]",
      "border border-white/20 bg-black/25 backdrop-blur-md text-white shadow-xs hover:border-white/40 hover:bg-white/15 hover:shadow-md",
      "group-data-scrolled:border-transparent group-data-scrolled:bg-orange group-data-scrolled:text-white group-data-scrolled:shadow-[0_4px_14px_rgba(241,93,48,0.35)] group-data-scrolled:hover:bg-orange-600",
      {
        "h-9.5 px-3.5 gap-2 text-xs sm:text-sm": size === "sm",
        "h-11 px-4 gap-2.5 text-sm": size === "md",
      },
    ]}
    type="button"
  >
    <GlobalIcon class="size-4 shrink-0 text-white/90 group-hover/lang-btn:text-white group-data-scrolled:text-white transition-colors" />
    <span class="font-semibold tracking-wider uppercase">{currentLanguage.shortName}</span>
    <svg
      aria-hidden="true"
      class="size-3.5 shrink-0 text-white/70 transition-transform duration-200 group-hover/lang-btn:text-white group-data-scrolled:text-white/90"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <div
    id={menuId}
    popover="auto"
    aria-orientation="vertical"
    style="

--menu-outer-radius: 14px; --menu-padding: 5px;"
    class:list={[
      "language-selector-popover m-0 min-w-40 overflow-hidden border border-white/10 bg-slate-950/95 text-white shadow-2xl backdrop-blur-xl ring-1 ring-white/10",
      "rounded-(--menu-outer-radius) p-(--menu-padding)",
      "group-data-scrolled:border-black/10 group-data-scrolled:bg-white group-data-scrolled:text-slate-800 group-data-scrolled:shadow-[0_12px_32px_rgba(0,0,0,0.15)]",
      { "inset-inline-start-0": placement === "left", "inset-inline-end-0": placement === "right" },
    ]}
    role="menu"
  >
    <div class="flex flex-col gap-0.5">
      {LANGUAGES.map((lang) => {
        const isCurrent = lang.code === currentLanguage.code;
        return (
          <a
            aria-checked={isCurrent}
            aria-label={lang.name}
            class:list={[
              "flex items-center whitespace-nowrap px-3 py-1.5 text-xs sm:text-sm font-medium transition-colors duration-150 inline-full",
              "rounded-[calc(var(--menu-outer-radius)-var(--menu-padding))]",
              {
                "bg-white/15 text-white font-semibold group-data-scrolled:bg-orange group-data-scrolled:text-white":
                  isCurrent,
                "text-zinc-300 hover:bg-white/10 hover:text-white group-data-scrolled:text-zinc-600 group-data-scrolled:hover:bg-zinc-100 group-data-scrolled:hover:text-zinc-900":
                  !isCurrent,
              },
            ]}
            href={getLocalizedHref(lang.code)}
            role="menuitemradio"
          >
            <span>{lang.name}</span>
          </a>
        );
      })}
    </div>
  </div>
</div>
