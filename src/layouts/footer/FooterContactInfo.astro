---
import { useTranslations } from "@/i18n/utils";
import { FAX_DISPLAY, FAX_LINK, PHONE_DISPLAY, PHONE_LINK } from "@/lib/constants/contact";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);
---

<div
  class="lg:col-span-1 animate-delay-150"
  data-animate="pillar-rise"
>
  <div class="mbe-2 flex h-9 items-center">
    <h3 class="text-sm font-semibold tracking-wider text-white uppercase">{t("footer.office")}</h3>
  </div>
  <span
    class="mbe-6 block bg-orange block-1 inline-12"
    data-scroll-wipe
  ></span>
  <address class="not-italic">
    <ul
      role="list"
      class="space-y-4"
    >
      <li class="group grid grid-cols-[36px_1fr] items-start gap-x-3">
        <div class="flex size-9 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 text-orange-400 transition-colors duration-300 group-hover:bg-orange-500/10">
          <svg
            aria-hidden="true"
            class="size-4.5 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              d="M21 13.1623C21 12.1187 21 9.5969 20.7169 9.20407C20.4337 8.81124 19.9387 8.64624 18.9487 8.31623L18 8M21 16.829C21 18.1199 21 18.7653 20.6603 19.18C20.5449 19.3208 20.4048 19.4394 20.247 19.5301C19.7821 19.797 19.1455 19.6909 17.8721 19.4787C16.6157 19.2693 15.9875 19.1646 15.3648 19.2167C15.1463 19.235 14.9292 19.2676 14.715 19.3144C14.1046 19.4477 13.5299 19.735 12.3806 20.3097C10.8809 21.0596 10.131 21.4345 9.33284 21.5501C9.09242 21.5849 8.8498 21.6021 8.60688 21.6016C7.80035 21.6001 7.01186 21.3373 5.43488 20.8116L5.05132 20.6838C4.06129 20.3538 3.56627 20.1888 3.28314 19.7959C3 19.4031 3 18.8813 3 17.8377V17M3 12.908C3 11.2491 3 10.4197 3.48841 9.97358C3.57388 9.89552 3.66809 9.82762 3.76917 9.77122C4.28426 9.48384 4.96572 9.66128 6.22311 10.075"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.5"
            ></path>
            <path
              d="M17.25 11.2513C17.7356 10.0935 18 8.86093 18 7.70031C18 4.55211 15.3137 2 12 2C8.68629 2 6 4.55211 6 7.70031C6 10.8238 7.91499 14.4687 10.9028 15.7721C11.5993 16.076 12.4007 16.076 13.0972 15.7721C14.0514 15.3558 14.8963 14.7007 15.6042 13.9"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.5"
            ></path>
            <circle
              cx="12"
              cy="8"
              r="2"
              stroke="currentColor"
              stroke-width="1.5"
            ></circle>
          </svg>
        </div>
        <p class="text-sm leading-relaxed text-zinc-400">
          APT 5 RDC IMM J RES PERLE DE L'ATLAS QI MARRAKECH
        </p>
      </li>

      <li class="group grid grid-cols-[36px_1fr] items-center gap-x-3">
        <div class="flex size-9 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 text-orange-400 transition-colors duration-300 group-hover:bg-orange-500/10">
          <svg
            aria-hidden="true"
            class="size-4.5 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              d="M22 12C22 15.7712 22 17.6569 20.8284 18.8284C19.6569 20 17.7712 20 14 20H10C6.22876 20 4.34315 20 3.17157 18.8284C2 17.6569 2 15.7712 2 12C2 8.22876 2 6.34315 3.17157 5.17157C4.34315 4 6.22876 4 10 4H14C17.7712 4 19.6569 4 20.8284 5.17157C21.4816 5.82475 21.7706 6.69989 21.8985 8"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.5"
            ></path>
            <path
              d="M18 8L15.8411 9.79908C14.0045 11.3296 13.0861 12.0949 12 12.0949C11.3507 12.0949 10.7614 11.8214 10 11.2744M6 8L6.9 8.75L7.8 9.5"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.5"
            ></path>
          </svg>
        </div>
        <a
          class="wrap-anywhere text-sm text-zinc-400 transition-colors duration-300 pointer-fine:hover:text-orange-400"
          href="mailto:amsirare@gmail.com"
        >
          amsirare@gmail.com
        </a>
      </li>

      <li class="group grid grid-cols-[36px_1fr] items-center gap-x-3">
        <div class="flex size-9 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 text-orange-400 transition-colors duration-300 group-hover:bg-orange-500/10">
          <svg
            aria-hidden="true"
            class="size-4.5 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              d="M20 14C20 17.7712 20 19.6569 18.8284 20.8284C17.6569 22 15.7712 22 12 22C8.22876 22 6.34315 22 5.17157 20.8284C4 19.6569 4 17.7712 4 14V10C4 6.22876 4 4.34315 5.17157 3.17157C6.34315 2 8.22876 2 12 2C15.7712 2 17.6569 2 18.8284 3.17157C20 4.34315 20 6.22876 20 10"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.5"
            ></path>
            <path
              d="M15 19H9"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.5"
            ></path>
            <path
              d="M16.7481 2.37793L16.664 2.5041C15.908 3.63818 15.5299 4.20525 14.9778 4.54836C14.868 4.61658 14.7539 4.67764 14.6362 4.73115C14.0444 5.00025 13.3629 5.00025 11.9999 5.00025C10.6369 5.00025 9.95539 5.00025 9.36363 4.73115C9.24596 4.67764 9.13187 4.61658 9.02207 4.54836C8.46992 4.20524 8.09189 3.6382 7.33582 2.5041L7.25171 2.37793"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.5"
            ></path>
          </svg>
        </div>
        <a
          class="text-sm text-zinc-400 transition-colors duration-300 pointer-fine:hover:text-orange-400"
          href={PHONE_LINK}
        >
          {PHONE_DISPLAY}
        </a>
      </li>

      <li class="group grid grid-cols-[36px_1fr] items-center gap-x-3">
        <div class="flex size-9 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 text-orange-400 transition-colors duration-300 group-hover:bg-orange-500/10">
          <svg
            aria-hidden="true"
            class="size-4.5 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              d="M4.00655 7.93309C3.93421 9.84122 4.41713 13.0817 7.6677 16.3323C8.45191 17.1165 9.23553 17.7396 10 18.2327M5.53781 4.93723C6.93076 3.54428 9.15317 3.73144 10.0376 5.31617L10.6866 6.4791C11.2723 7.52858 11.0372 8.90532 10.1147 9.8278C10.1147 9.8278 10.1147 9.8278 10.1147 9.8278C10.1146 9.82792 8.99588 10.9468 11.0245 12.9755C13.0525 15.0035 14.1714 13.8861 14.1722 13.8853C14.1722 13.8853 14.1722 13.8853 14.1722 13.8853C15.0947 12.9628 16.4714 12.7277 17.5209 13.3134L18.6838 13.9624C20.2686 14.8468 20.4557 17.0692 19.0628 18.4622C18.2258 19.2992 17.2004 19.9505 16.0669 19.9934C15.2529 20.0243 14.1963 19.9541 13 19.6111"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.5"
            ></path>
          </svg>
        </div>
        <a
          class="text-sm text-zinc-400 transition-colors duration-300 pointer-fine:hover:text-orange-400"
          href={FAX_LINK}
        >
          {FAX_DISPLAY} (Fax)
        </a>
      </li>
    </ul>
  </address>
</div>
