---
import agencyProfile from "@/data/agency-profile.json";
import { useTranslations } from "@/i18n/utils";
import { FAX_DISPLAY, FAX_LINK, PHONE_DISPLAY, PHONE_LINK } from "@/lib/constants/contact";
import LetterIcon from "@/shared/ui/icons/LetterIcon.astro";
import PhoneCallIcon from "@/shared/ui/icons/PhoneCallIcon.astro";
import PointOnMapIcon from "@/shared/ui/icons/PointOnMapIcon.astro";

const locale = Astro.locals.locale;
const t = useTranslations(locale);
const primaryEmail = agencyProfile.contact.emails[0] ?? "amsirare@gmail.com";
---

<div
  class="lg:col-span-1 animate-delay-150"
  data-animate="pillar-rise"
>
  <div class="mbe-2 flex h-9 items-center">
    <h3 class="text-sm font-semibold tracking-wider text-white uppercase">{t("footer.office")}</h3>
  </div>
  <span
    class="mbe-6 block bg-orange block-1 inline-12"
    data-scroll-wipe
  ></span>
  <address class="not-italic">
    <ul class="space-y-4">
      <li class="group grid grid-cols-[36px_1fr] items-start gap-x-3">
        <div class="flex size-9 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 text-orange-400 transition-colors duration-300 group-hover:bg-orange-500/10 group-active:bg-orange-500/10">
          <PointOnMapIcon class="size-4.5 shrink-0" />
        </div>
        <p class="text-sm/relaxed text-zinc-400">{agencyProfile.address.fullAddress}</p>
      </li>

      <li class="group grid grid-cols-[36px_1fr] items-center gap-x-3">
        <div class="flex size-9 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 text-orange-400 transition-colors duration-300 group-hover:bg-orange-500/10 group-active:bg-orange-500/10">
          <LetterIcon
            aria-hidden="true"
            class="size-4.5 shrink-0"
          />
        </div>
        <a
          class="wrap-anywhere text-sm text-zinc-400 transition-colors duration-300 pointer-fine:hover:text-orange-400 active:text-orange-400"
          href={`mailto:${primaryEmail}`}
        >
          {primaryEmail}
        </a>
      </li>

      <li class="group grid grid-cols-[36px_1fr] items-center gap-x-3">
        <div class="flex size-9 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 text-orange-400 transition-colors duration-300 group-hover:bg-orange-500/10 group-active:bg-orange-500/10">
          <PhoneCallIcon
            aria-hidden="true"
            class="size-4.5 shrink-0"
          />
        </div>
        <a
          class="text-sm text-zinc-400 transition-colors duration-300 pointer-fine:hover:text-orange-400 active:text-orange-400"
          href={PHONE_LINK}
        >
          {PHONE_DISPLAY}
        </a>
      </li>

      <li class="group grid grid-cols-[36px_1fr] items-center gap-x-3">
        <div class="flex size-9 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 text-orange-400 transition-colors duration-300 group-hover:bg-orange-500/10 group-active:bg-orange-500/10">
          <PhoneCallIcon
            aria-hidden="true"
            class="size-4.5 shrink-0"
          />
        </div>
        <a
          class="text-sm text-zinc-400 transition-colors duration-300 pointer-fine:hover:text-orange-400 active:text-orange-400"
          href={FAX_LINK}
        >
          {FAX_DISPLAY} ({t("legal.ui.fax")})
        </a>
      </li>
    </ul>
  </address>
</div>
