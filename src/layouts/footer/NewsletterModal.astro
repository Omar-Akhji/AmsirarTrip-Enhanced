---
import { actions } from "astro:actions";
import type { NewsletterStatusKey } from "@/actions";
import { isLocale } from "@/i18n/locales";
import { useTranslations } from "@/i18n/utils";
import { hasCaptcha } from "@/lib/client-env";

interface Props {
  locale?: string;
}

const { locale: propLocale } = Astro.props;
const candidateLocale = propLocale ?? Astro.locals.locale;
const locale = isLocale(candidateLocale) ? candidateLocale : "en";
const t = useTranslations(locale);

const newsletterResult = Astro.getActionResult(actions.newsletter);
if (newsletterResult) {
  Astro.cache.set(false);
}

const ssrSuccess = Boolean(newsletterResult && !newsletterResult.error && newsletterResult.data.ok);
const ssrStatusKey: NewsletterStatusKey =
  newsletterResult && !newsletterResult.error ?
    newsletterResult.data.statusKey
  : "footer.newsletterFailure";
const ssrStatusMessage = newsletterResult ? t(ssrStatusKey) : "";
---

<dialog
  aria-labelledby="newsletter-dialog-title"
  class="fixed inset-0 z-50 m-auto overflow-hidden rounded-2xl border border-white/10 bg-slate-950 p-0 text-white shadow-2xl ring-1 ring-white/10 inline-[95vw] max-inline-md scheme-dark opacity-0 scale-95 transition-[opacity,transform,display,overlay] duration-250 ease-out-expo transition-discrete motion-reduce:duration-[1ms] open:flex open:flex-col open:opacity-100 open:scale-100 starting:open:opacity-0 starting:open:scale-95 backdrop:opacity-0 backdrop:bg-[oklch(0%_0_0deg/0.75)] backdrop:backdrop-blur-[2px] backdrop:transition-[opacity,display,overlay] backdrop:duration-250 backdrop:ease-out-expo backdrop:transition-discrete motion-reduce:backdrop:duration-[1ms] open:backdrop:opacity-100 starting:open:backdrop:opacity-0"
  closedby="any"
  id="newsletter-dialog"
  open={Boolean(newsletterResult)}
>
  <div class="flex flex-1 flex-col rounded-2xl bg-slate-950">
    <div class="p-6 sm:p-8">
      <div class="mbe-6 flex items-start justify-between">
        <div>
          <h2
            class="text-xl font-bold tracking-tight text-white sm:text-2xl"
            id="newsletter-dialog-title"
          >
            {t("footer.newsletter")}
          </h2>
          <p class="mbs-1.5 text-sm/relaxed text-slate-300">{t("footer.newsletterDescription")}</p>
        </div>

        <form
          class="m-0"
          method="dialog"
        >
          <button
            aria-label={t("footer.newsletterCloseAria")}
            class="-me-1 -mbs-1 flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full border border-white/10 bg-white/5 text-zinc-400 transition-colors focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:outline-hidden active:bg-white/10 active:text-white pointer-fine:hover:bg-white/10 pointer-fine:hover:text-white"
            type="submit"
            value="cancel"
          >
            <svg
              aria-hidden="true"
              class="size-5"
              fill="none"
              stroke-width="1.5"
              viewBox="0 0 24 24"
            >
              <path
                d="M19.0068 5L15.5068 8.5"
                stroke="currentColor"
                stroke-linecap="round"
              />
              <path
                d="M12.0068 12L5.00684 19"
                stroke="currentColor"
                stroke-linecap="round"
              />
              <path
                d="M19 19L5 5"
                stroke="currentColor"
                stroke-linecap="round"
              />
            </svg>
          </button>
        </form>
      </div>

      <form
        action={actions.newsletter}
        aria-label={t("footer.newsletterAria")}
        data-label-sending={t("contact.form.sending")}
        data-label-subscribe={t("footer.newsletterSubscribe")}
        data-msg-captcha={t("footer.newsletterCaptchaError")}
        data-msg-failure={t("footer.newsletterFailure")}
        data-msg-rate-limited={t("footer.newsletterRateLimited")}
        data-msg-success={t("footer.newsletterSuccess")}
        data-newsletter-form
        method="POST"
        tooldescription="Subscribes the user to the newsletter with their name and email address"
        toolname="subscribe_to_newsletter"
      >
        <div
          aria-hidden="true"
          class="hidden"
        >
          <input
            autocomplete="new-password"
            name="website"
            tabindex="-1"
            type="text"
          />
        </div>
        <input
          name="language"
          type="hidden"
          value={locale}
        />
        <fieldset class="m-0 space-y-4 border-0 p-0">
          <legend class="sr-only">{t("footer.newsletter")}</legend>

          <div>
            <label
              class="mbe-1.5 block font-mono text-xs font-medium text-slate-300"
              for="newsletter-name"
            >
              {t("footer.newsletterNameLabel")}
            </label>
            <div class="group relative">
              <svg
                aria-hidden="true"
                class="pointer-events-none absolute inset-s-3.5 top-1/2 size-4.5 -translate-y-1/2 text-zinc-400 transition-colors group-focus-within:text-orange-500"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle
                  cx="12"
                  cy="6"
                  r="4"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M19.9975 18C20 17.8358 20 17.669 20 17.5C20 15.0147 16.4183 13 12 13C7.58172 13 4 15.0147 4 17.5C4 19.9853 4 22 12 22C14.231 22 15.8398 21.8433 17 21.5634"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-width="1.5"
                />
              </svg>
              <input
                autocomplete="name"
                class="rounded-xl border border-white/10 bg-white/5 ps-10.5 pe-4 font-mono text-sm text-white transition-colors block-11 inline-full placeholder:text-zinc-500 user-invalid:border-red-400/80 focus:border-orange-500 focus:bg-white/10 focus:ring-2 focus:ring-orange-500/20 focus:outline-hidden user-invalid:focus:ring-red-400/20"
                id="newsletter-name"
                maxlength="100"
                minlength="2"
                name="name"
                placeholder={t("footer.newsletterNamePlaceholder")}
                required
                toolparamdescription="The full name of the user subscribing to the newsletter"
                type="text"
              />
            </div>
          </div>

          <div>
            <label
              class="mbe-1.5 block font-mono text-xs font-medium text-slate-300"
              for="newsletter-email"
            >
              {t("footer.newsletterInputAria")}
            </label>
            <div class="group relative">
              <svg
                aria-hidden="true"
                class="pointer-events-none absolute inset-s-3.5 top-1/2 size-4.5 -translate-y-1/2 text-zinc-400 transition-colors group-focus-within:text-orange-500"
                fill="none"
                viewBox="0 0 24 24"
              >
                <path
                  d="M22 12C22 15.7712 22 17.6569 20.8284 18.8284C19.6569 20 17.7712 20 14 20H10C6.22876 20 4.34315 20 3.17157 18.8284C2 17.6569 2 15.7712 2 12C2 8.22876 2 6.34315 3.17157 5.17157C4.34315 4 6.22876 4 10 4H14C17.7712 4 19.6569 4 20.8284 5.17157C21.4816 5.82475 21.7706 6.69989 21.8985 8"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-width="1.5"
                />
                <path
                  d="M18 8L15.8411 9.79908C14.0045 11.3296 13.0861 12.0949 12 12.0949C11.3507 12.0949 10.7614 11.8214 10 11.2744M6 8L6.9 8.75L7.8 9.5"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-width="1.5"
                />
              </svg>
              <input
                autocomplete="email"
                class="rounded-xl border border-white/10 bg-white/5 ps-10.5 pe-4 font-mono text-sm text-white transition-colors block-11 inline-full placeholder:text-zinc-500 user-invalid:border-red-400/80 focus:border-orange-500 focus:bg-white/10 focus:ring-2 focus:ring-orange-500/20 focus:outline-hidden user-invalid:focus:ring-red-400/20"
                id="newsletter-email"
                maxlength="254"
                name="email"
                placeholder={t("footer.newsletterPlaceholder")}
                required
                toolparamdescription="The email address of the user subscribing to the newsletter"
                type="email"
              />
            </div>
          </div>

          <div class="flex justify-center pbs-2">
            <div
              class="w-fit rounded-2xl border border-dashed border-white/15 bg-white/2 p-1.5 transition-all data-[captcha-error=true]:border-red-400 data-[captcha-error=true]:bg-red-950/20"
              data-captcha-error="false"
              data-newsletter-turnstile-wrap
            >
              {hasCaptcha ?
                <div class="m-0 flex flex-col items-center justify-center p-0 leading-none">
                  <div
                    class="min-h-16.25 min-w-75"
                    data-newsletter-turnstile-slot
                  />
                </div>
              : <div class="rounded-xl border border-white/10 bg-white/5 p-2 font-mono text-xs text-slate-400">
                  {t("footer.captchaNotConfigured")}
                </div>
              }
            </div>
          </div>
        </fieldset>

        <label
          class="sr-only"
          for="newsletter-status"
        >
          {t("footer.newsletterStatus")}
        </label>
        <output
          aria-live="polite"
          class:list={[
            "mbs-4 text-center font-mono text-xs font-medium",
            {
              "text-emerald-300": Boolean(newsletterResult && ssrSuccess),
              "text-red-400": !newsletterResult || !ssrSuccess,
              hidden: !newsletterResult,
            },
          ]}
          data-newsletter-status
          for="newsletter-name newsletter-email"
          id="newsletter-status"
        >
          {ssrStatusMessage}
        </output>

        <button
          aria-busy="false"
          class="group mbs-5 inline-flex min-h-12 cursor-pointer items-center rounded-full border border-stone-200/80 bg-white py-1.5 ps-4 pe-1.5 font-mono text-xs font-semibold tracking-wider text-dark-surface uppercase shadow-lg shadow-black/25 transition-colors duration-200 select-none inline-full hover:border-stone-300 hover:bg-white hover:shadow-xl focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 focus-visible:outline-hidden active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 data-[state=success]:border-emerald-500/40 data-[state=success]:bg-emerald-500/15 data-[state=success]:text-emerald-300 data-[state=success]:opacity-100"
          data-newsletter-submit
          data-state="idle"
          type="submit"
        >
          <span
            class="flex-1 truncate px-2 text-center group-data-[state=success]:leading-tight group-data-[state=success]:tracking-normal group-data-[state=success]:normal-case group-data-[state=success]:whitespace-normal"
            data-newsletter-submit-label
          >
            {t("footer.newsletterSubscribe")}
          </span>
          <span class="relative flex size-8 shrink-0 items-center justify-center overflow-hidden rounded-full bg-linear-to-br from-amber-orange to-orange text-white shadow-xs shadow-orange/40 transition-transform duration-300 ease-out group-hover:scale-105 group-active:scale-95 group-data-[state=success]:bg-emerald-500 group-data-[state=success]:bg-none group-data-[state=success]:shadow-emerald-500/40">
            <svg
              aria-hidden="true"
              class="hidden size-4.5 group-data-[state=success]:block"
              fill="none"
              height="24"
              stroke-width="1.5"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M14 12L9 17L5 13"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M16.5 9.5L19 7"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>

            <svg
              aria-hidden="true"
              class="hidden size-4.5 animate-spin group-data-[state=submitting]:block"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.8"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M3.67981 13L3.67981 11.3333C3.67981 6.73096 7.4402 3 12.0789 3C12.2201 3 12.3605 3.00346 12.5 3.01029M2 11.3333L3.67981 13L5.35962 11.3333M19.2545 7C18.567 5.88176 17.6215 4.9368 16.5 4.2466" />
              <path d="M20.3137 11V12.6667C20.3137 17.269 16.5389 21 11.8825 21C11.7543 21 11.6268 20.9972 11.5 20.9916M21.9999 12.6667L20.3137 11L18.6274 12.6667M4.67944 17C5.38086 18.1366 6.34989 19.0942 7.5 19.7872" />
            </svg>

            <span class="relative flex size-full items-center justify-center group-data-[state=submitting]:hidden group-data-[state=success]:hidden">
              <svg
                aria-hidden="true"
                class="absolute size-4.5 transition-all duration-300 ease-out group-hover:translate-x-3 group-hover:-translate-y-3 group-hover:opacity-0 rtl:-scale-x-100 rtl:group-hover:-translate-x-3"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M18 15V6H9M18 6L11.5 12.5M6 18L8.5 15.5" />
              </svg>

              <svg
                aria-hidden="true"
                class="absolute size-4.5 -translate-x-3 translate-y-2 opacity-0 transition-all duration-300 ease-out group-hover:translate-0 group-hover:opacity-100 rtl:translate-x-3 rtl:-scale-x-100 rtl:group-hover:translate-x-0"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M14 18L20 12L14 6M20 12H9.5M4 12H6.5" />
              </svg>
            </span>
          </span>
        </button>
      </form>
    </div>
  </div>
</dialog>

<script src="../../scripts/newsletter-modal.ts"></script>
