---
import agencyProfile from "@/data/agency-profile.json";
import { useTranslations } from "@/i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.locals.locale;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();
---

<div
  class="border-bs border-white/5 bg-black/20 animate-delay-450"
  data-animate="curtain-up"
>
  <div class="mx-auto px-4 pbs-6 pbe-24 sm:px-6 lg:py-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420">
    <div class="flex flex-col items-center justify-between gap-4 md:flex-row md:gap-6">
      <div class="text-center md:text-start">
        <p class="flex flex-wrap items-center justify-center gap-x-1.5 gap-y-1 text-sm font-medium text-zinc-400 md:justify-start">
          <span class="whitespace-nowrap">
            &copy; <time datetime={currentYear.toString()}>{currentYear}</time>
          </span>
          <span
            aria-hidden="true"
            class="opacity-20"
          >
            &bull;
          </span>
          <span class="whitespace-nowrap text-zinc-300">{agencyProfile.legalName}</span>
          <span
            aria-hidden="true"
            class="opacity-20"
          >
            &bull;
          </span>
          <span class="whitespace-nowrap">{t("footer.copyright")}</span>
        </p>
      </div>

      <nav
        aria-label="Privacy and Terms"
        class="shrink-0"
      >
        <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 sm:gap-x-6">
          <li>
            <a
              class="whitespace-nowrap text-sm font-medium text-zinc-400 transition-colors duration-200 pointer-fine:hover:text-white active:text-white"
              href={getRelativeLocaleUrl(locale, "/privacy-policy")}
            >
              {t("legal.footer.privacyPolicy")}
            </a>
          </li>
          <li
            aria-hidden="true"
            class="hidden bg-white/10 block-3 inline-px sm:block"
          ></li>
          <li>
            <a
              class="whitespace-nowrap text-sm font-medium text-zinc-400 transition-colors duration-200 pointer-fine:hover:text-white active:text-white"
              href={getRelativeLocaleUrl(locale, "/terms-of-service")}
            >
              {t("legal.footer.termsOfService")}
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</div>
