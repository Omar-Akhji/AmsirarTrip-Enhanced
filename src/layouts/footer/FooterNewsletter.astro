---
import { useTranslations } from "@/i18n/utils";
import NewsletterModal from "./NewsletterModal.vue";

interface Props {
  locale?: string;
}

const { locale = Astro.currentLocale || "en" } = Astro.props;
const t = useTranslations(locale);
---

<div class="inline-full">
  <div class="mbe-2 flex h-9 items-center">
    <h3 class="text-sm font-semibold tracking-wider text-white uppercase">
      {t("footer.newsletter")}
    </h3>
  </div>
  <span class="mbe-6 block bg-orange-600 block-1 inline-12"></span>
  <div class="rounded-2xl border border-white/10 bg-linear-to-br from-white/5 to-white/2 p-4 backdrop-blur-sm">
    <p class="mbe-4 text-sm leading-relaxed text-zinc-400">{t("footer.newsletterDescription")}</p>
    <button
      aria-label={t("footer.newsletterButtonAria")}
      class="group inline-flex min-h-12 cursor-pointer items-center rounded-full border border-stone-200/80 bg-white py-1.5 ps-4 pe-1.5 font-mono text-xs font-semibold tracking-wider text-dark-surface uppercase shadow-lg shadow-black/25 transition-colors duration-200 select-none inline-full hover:border-stone-300 hover:bg-white hover:shadow-xl focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 focus-visible:outline-hidden active:scale-[0.98]"
      command="show-modal"
      commandfor="newsletter-dialog"
      data-newsletter-open
      type="button"
    >
      <span class="flex-1 text-center truncate px-2">{t("footer.newsletterSubscribe")}</span>
      <span class="relative flex size-8 shrink-0 items-center justify-center overflow-hidden rounded-full bg-linear-to-br from-amber-orange to-orange text-white shadow-xs shadow-orange/40 transition-transform duration-300 ease-out group-hover:scale-105 group-active:scale-95">
        <div class="relative flex size-full items-center justify-center">
          <!-- Default state: Solar Arrow Right-Up Broken (slides up-right & fades out on hover) -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="absolute size-4.5 transition-all duration-300 ease-out group-hover:translate-x-3 group-hover:-translate-y-3 group-hover:opacity-0 rtl:-scale-x-100 rtl:group-hover:-translate-x-3"
            aria-hidden="true"
          >
            <path d="M18 15V6H9M18 6L11.5 12.5M6 18L8.5 15.5" />
          </svg>

          <!-- Hover state: Solar Arrow Right Broken (slides in from left & settles centered) -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="absolute size-4.5 -translate-x-3 translate-y-2 opacity-0 transition-all duration-300 ease-out group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100 rtl:translate-x-3 rtl:-scale-x-100 rtl:group-hover:translate-x-0"
            aria-hidden="true"
          >
            <path d="M14 18L20 12L14 6M20 12H9.5M4 12H6.5" />
          </svg>
        </div>
      </span>
    </button>

    <!-- FooterSocialLinks -->
    <nav
      aria-label={t("footer.socialAria")}
      class="mbs-6"
    >
      <ul class="m-0 flex list-none flex-wrap items-center justify-center gap-3 p-0">
        <li
          class="after:font-inherit relative isolate size-11 shrink-0 [--bg:#1877f2] after:pointer-events-none after:invisible after:absolute after:inset-s-1/2 after:top-[-45%] after:z-0 after:-translate-x-1/2 after:rounded-full after:border after:border-white/15 after:px-3 after:py-1 after:text-xs after:leading-tight after:font-semibold after:whitespace-nowrap after:text-white after:opacity-0 after:shadow-[0_4px_12px_rgb(0_0_0/0.4)] after:transition-[inset,visibility,opacity] after:duration-300 after:content-[attr(data-tooltip)] after:[background:var(--bg,#070707)] has-[a:focus-visible]:z-20 has-[a:focus-visible]:after:visible has-[a:focus-visible]:after:top-[-70%] has-[a:focus-visible]:after:opacity-100 has-[a:hover]:z-20 has-[a:hover]:after:visible has-[a:hover]:after:top-[-70%] has-[a:hover]:after:opacity-100 motion-reduce:after:transition-none sm:size-12"
          data-tooltip={t("footer.social.facebook")}
        >
          <a
            aria-label={t("footer.social.facebook")}
            class="group/social-link relative z-1 flex aspect-square size-full items-center justify-center overflow-hidden rounded-full border-[1.5px] border-white/15 bg-white/4 text-slate-300 no-underline transition-[color,border-color,box-shadow] duration-300 outline-none after:pointer-events-none after:absolute after:inset-x-0 after:top-full after:bottom-0 after:transition-[inset] after:duration-300 after:ease-out after:content-[''] after:[background:var(--bg,#070707)] hover:border-white/30 hover:text-white hover:shadow-[0_4px_16px_rgb(0_0_0/0.4)] hover:after:top-0 focus-visible:border-white/30 focus-visible:text-white focus-visible:shadow-[0_4px_16px_rgb(0_0_0/0.4)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-orange,#f70) focus-visible:after:top-0 motion-reduce:transition-none motion-reduce:after:transition-none"
            href="https://www.facebook.com/profile.php?id=61571322141368"
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg
              aria-hidden="true"
              class="relative z-1 size-5 shrink-0 fill-current transition-transform duration-300 group-hover/social-link:scale-110 group-focus-visible/social-link:scale-110 motion-reduce:transition-none"
              viewBox="0 0 20 20"
            >
              <path d="M8.46 18h2.93v-7.3h2.45l.37-2.84h-2.82V6.04c0-.82.23-1.38 1.41-1.38h1.51V2.11c-.26-.03-1.15-.11-2.19-.11-2.18 0-3.66 1.33-3.66 3.76v2.1H6v2.84h2.46V18z"></path>
            </svg>
