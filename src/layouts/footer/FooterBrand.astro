---
import { useTranslations } from "@/i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);
---

<div
  class="lg:col-span-1"
  data-animate="fade-up"
>
  <div class="mbe-2 flex h-9 items-center">
    <a
      class="group inline-flex items-center gap-1"
      href={getRelativeLocaleUrl(locale, "/")}
    >
      <span class="text-3xl font-bold tracking-tight text-white transition-transform duration-300 group-hover:scale-105">
        Amsirar
      </span>
      <span class="font-brand text-3xl text-orange transition-transform duration-300 group-hover:scale-105">
        Trip
      </span>
    </a>
  </div>
  <span class="mbe-6 block bg-orange block-1 inline-12"></span>
  <p class="font-mono text-sm leading-relaxed text-stone-300 lg:max-inline-sm">
    {t("footer.description")}
  </p>
</div>
