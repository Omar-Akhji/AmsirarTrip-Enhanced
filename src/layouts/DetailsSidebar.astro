---
import type { RouteMapData } from "@/features/maps/types";
import RouteMapCard from "@/shared/ui/widgets/RouteMapCard.astro";

interface Props {
  sidebarTitle: string;
  mainBrand: string;
  intro: string;
  details: string;
  sidebarItems: readonly string[];
  conclusion: string;
  ctaTitle: string;
  ctaDescription: string;
  ctaPoints?: readonly string[] | undefined;
  ctaPoint01?: string | undefined;
  ctaPoint02?: string | undefined;
  ctaPoint03?: string | undefined;
  routeMap?: RouteMapData | undefined;
}

const {
  sidebarTitle,
  mainBrand,
  intro,
  details,
  sidebarItems,
  conclusion,
  ctaTitle,
  ctaDescription,
  ctaPoints,
  ctaPoint01,
  ctaPoint02,
  ctaPoint03,
  routeMap,
} = Astro.props;

const points =
  ctaPoints && ctaPoints.length > 0 ?
    ctaPoints
  : [ctaPoint01, ctaPoint02, ctaPoint03].filter(
      (p): p is string => typeof p === "string" && p.length > 0,
    );
---

<aside
  aria-label={sidebarTitle}
  class="space-y-6 self-start lg:sticky lg:top-24"
>
  {routeMap && (
    <div
      class="inline-full"
      data-animate="creative-slide-left"
      data-delay="75"
    >
      <RouteMapCard routeMap={routeMap} />
    </div>
  )}

  <div
    class="inline-full"
    data-animate="creative-slide-left"
    data-delay="150"
  >
    <div
      class="overflow-hidden rounded-2xl bg-slate-950 text-white shadow-xl"
      data-ascii="surface"
      style="

--ascii-glyph: #cbd5e1; --ascii-surface: #020617;"
    >
      <div class="p-6 sm:p-8">
        <hgroup class="text-center">
          <p class="font-mono text-xs font-semibold tracking-[0.16em] text-orange-400 uppercase">
            {sidebarTitle}
          </p>
          <h3 class="mbs-2 text-xl sm:text-2xl font-bold tracking-tight text-white">{mainBrand}</h3>
        </hgroup>
        <div
          aria-hidden="true"
          class="my-4 border-t border-slate-800"
        ></div>
        <p class="mbs-2 font-mono text-xs sm:text-sm leading-relaxed text-slate-300">{intro}</p>
        <p class="mbs-4 font-mono text-xs sm:text-sm leading-relaxed text-slate-300">{details}</p>
        <ul
          role="list"
          class="mbs-4 grid gap-3"
        >
          {sidebarItems.map((item, index) => (
            <li class="flex items-start gap-3">
              <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-orange-500/20 text-orange-400 font-mono text-xs font-bold">
                {index + 1}
              </span>
              <p class="font-mono text-xs sm:text-sm leading-relaxed text-slate-200">{item}</p>
            </li>
          ))}
        </ul>
        <p class="mbs-4 font-mono text-xs text-slate-400 leading-relaxed">{conclusion}</p>
      </div>
    </div>
  </div>

  <div
    class="inline-full"
    data-animate="creative-slide-left"
    data-delay="300"
  >
    <div
      class="rounded-2xl border border-dashed border-stone-200 bg-white p-6 shadow-2xs"
      data-ascii="surface"
    >
      <h3 class="text-base font-bold text-stone-900 tracking-tight">{ctaTitle}</h3>
      <p class="mbs-2 font-mono text-xs text-stone-600 leading-relaxed">{ctaDescription}</p>
      <ul
        role="list"
        class="m-0 mbs-4 grid list-none gap-3 p-0 font-mono text-xs text-stone-700"
      >
        {points.map((point) => (
          <li class="flex items-start gap-3">
            <span class="mbs-1 size-2 shrink-0 rounded-full bg-orange-600"></span>
            <p>{point}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</aside>
