---
import bgImage from "@/assets/images/Header/header-1.webp";
import DetailsSidebar from "@/layouts/DetailsSidebar.astro";
import PageHeader from "@/layouts/PageHeader.astro";
import { Image } from "astro:assets";

const {
  title,
  pageTitle,
  pageSubtitle,
  hasUnderline = true,
  lead,
  smTitle,
  breadcrumbs,
  imageSrc,
  imageAlt = title || "Morocco Trip",
  sectionId,
  headingId,
  sidebar,
  transitionName,
  routeMap,
} = Astro.props;
const sl = Astro.slots.has("default");
---

<PageHeader
  bgImage={bgImage}
  breadcrumbs={breadcrumbs}
  hasUnderline={hasUnderline}
  smTitle={smTitle}
  subtitle={pageSubtitle}
  title={pageTitle}
/>

<div class="trip-content">
  <section
    aria-labelledby={headingId}
    class="py-12 sm:py-16 lg:py-24"
    id={sectionId}
  >
    <div class="mx-auto grid gap-4 px-4 max-inline-7xl lg:grid-cols-[minmax(0,1fr)_403px]">
      <article
        class="rounded-2xl bg-white p-4 pbe-8 shadow-xs ring-1 ring-zinc-100 sm:p-6 sm:pbe-12"
        data-ascii="surface"
      >
        <div data-animate="zoom-in">
          <figure class="relative mbe-8 aspect-4/3 overflow-hidden rounded-xl border border-zinc-100 shadow-md inline-full bg-stone-100 dark:bg-stone-800">
            <Image
              alt={imageAlt}
              class="absolute inset-0 size-full object-cover"
              height={600}
              loading="eager"
              sizes="(max-width: 600px) 400px, (max-width: 900px) 600px, 800px"
              src={imageSrc}
              transition:name={transitionName}
              width={800}
              widths={[400, 600, 800]}
            />
          </figure>
        </div>

        <div
          class="delay-150"
          data-animate="fade-up"
        >
          <hgroup class="mbe-8 sm:mbe-12 block border-b border-stone-200 pb-6 sm:pb-8 text-start">
            <h2
              class="text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl md:text-4xl text-balance"
              id={headingId}
            >
              {title}
            </h2>
            {lead ?
              <p class="mbs-3 sm:mbs-4 border-s-2 border-orange-600 ps-4 py-0.5 text-sm sm:text-base leading-relaxed text-stone-600 text-pretty">
                {lead}
              </p>
            : null}
          </hgroup>
        </div>

        <div class="space-y-8">
          <slot name="content" />
        </div>
      </article>

      <DetailsSidebar
        conclusion={sidebar.conclusion}
        ctaDescription={sidebar.ctaDescription}
        ctaPoint01={sidebar.ctaPoint01}
        ctaPoint02={sidebar.ctaPoint02}
        ctaPoint03={sidebar.ctaPoint03}
        ctaPoints={sidebar.ctaPoints}
        ctaTitle={sidebar.ctaTitle}
        details={sidebar.details}
        intro={sidebar.intro}
        mainBrand={sidebar.mainBrand}
        routeMap={routeMap}
        sidebarItems={sidebar.sidebarItems}
        sidebarTitle={sidebar.sidebarTitle}
      />
    </div>
  </section>
  {sl && <slot />}
</div>
