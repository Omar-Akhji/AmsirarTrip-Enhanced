---
import bgImage from "@/assets/images/Header/header-1.webp";
import DetailsSidebar from "@/layouts/DetailsSidebar.astro";
import PageHeader from "@/layouts/PageHeader.astro";
import { Image } from "astro:assets";

const {
  title,
  pageTitle,
  pageSubtitle,
  hasUnderline = true,
  smTitle,
  breadcrumbs,
  imageSrc,
  imageAlt = title || "Morocco Trip",
  sectionId,
  headingId,
  sidebar,
  transitionName,
  routeMap,
} = Astro.props;
const sl = Astro.slots.has("default");
---

<PageHeader
  bgImage={bgImage}
  breadcrumbs={breadcrumbs}
  hasUnderline={hasUnderline}
  smTitle={smTitle}
  subtitle={pageSubtitle}
  title={pageTitle}
/>

<div class="trip-content">
  <section
    aria-labelledby={headingId}
    class="py-12 sm:py-16 lg:py-24"
    id={sectionId}
  >
    <div class="mx-auto grid gap-4 sm:gap-6 lg:gap-8 px-2 sm:px-6 lg:px-8 max-inline-7xl 2xl:max-inline-360 3xl:max-inline-420 lg:grid-cols-golden">
      <article
        class="rounded-2xl bg-white p-4 pbe-8 shadow-xs ring-1 ring-zinc-100 xs:p-5 sm:p-6 sm:pbe-12 2xl:p-8 dark:border-2 dark:border-white/10 dark:bg-surface-card/85 dark:ring-0 dark:shadow-[0_4px_20px_-2px_rgba(0,0,0,0.4)]"
        data-ascii="surface"
      >
        <div data-animate="zoom-in">
          <figure class="relative mbe-8 aspect-golden overflow-hidden rounded-xl border border-zinc-100 shadow-md inline-full bg-stone-100 dark:border-white/10 dark:bg-surface-card">
            <Image
              alt={imageAlt}
              class="absolute inset-0 size-full object-cover"
              height={600}
              loading="eager"
              sizes="(max-width: 480px) 400px, (max-width: 768px) 600px, 800px"
              src={imageSrc}
              transition:name={transitionName}
              width={800}
              widths={[400, 600, 800]}
            />
          </figure>
        </div>

        <div
          class="delay-150"
          data-animate="fade-up"
        >
          <hgroup class="mbe-8 sm:mbe-12 block border-b border-stone-200 pb-6 sm:pb-8 text-start dark:border-white/10">
            <h2
              class="text-2xl sm:text-3xl lg:text-4xl 2xl:text-[2.625rem] font-bold tracking-tight text-stone-900 leading-[1.15] text-balance dark:text-mist-100"
              id={headingId}
            >
              {title}
            </h2>
          </hgroup>
        </div>

        <div class="space-y-8">
          <slot name="content" />
        </div>
      </article>

      <DetailsSidebar
        conclusion={sidebar.conclusion}
        ctaDescription={sidebar.ctaDescription}
        ctaPoint01={sidebar.ctaPoint01}
        ctaPoint02={sidebar.ctaPoint02}
        ctaPoint03={sidebar.ctaPoint03}
        ctaPoints={sidebar.ctaPoints}
        ctaTitle={sidebar.ctaTitle}
        details={sidebar.details}
        intro={sidebar.intro}
        mainBrand={sidebar.mainBrand}
        routeMap={routeMap}
        sidebarItems={sidebar.sidebarItems}
        sidebarTitle={sidebar.sidebarTitle}
      />
    </div>
  </section>
  {sl && <slot />}
</div>
