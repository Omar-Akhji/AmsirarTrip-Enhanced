---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  class?: string | undefined;
}

const { class: className, ...props } = Astro.props;
const hasCustomRadius = typeof className === "string" && /\brounded-/.test(className);
---

<div
  aria-hidden="true"
  class:list={[
    "animate-pulse bg-stone-200/80 dark:bg-stone-800/80 motion-reduce:animate-none",
    !hasCustomRadius && "rounded-md",
    className,
  ]}
  {...props}
/>
