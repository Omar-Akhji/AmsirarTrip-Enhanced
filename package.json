{
  "name": "amsirartrip",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "build:timings": "astro build --timings",
    "check": "astro check && tsc --noEmit",
    "dev": "astro dev",
    "format": "bun run format:tailwind && prettier --write .",
    "format:check": "bun run format:tailwind:check && prettier --check .",
    "format:tailwind": "tailwind-suggest-canonical-classes \"src/**/*.{astro,vue,ts,js,css,md,mdx}\" --css src/styles/global.css",
    "format:tailwind:check": "tailwind-suggest-canonical-classes \"src/**/*.{astro,vue,ts,js,css,md,mdx}\" --css src/styles/global.css --check",
    "lint": "eslint . && bun run lint:style",
    "lint:style": "stylelint \"src/**/*.{css,astro,vue}\"",
    "lint:style:fix": "stylelint \"src/**/*.{css,astro,vue}\" --fix",
    "prepare": "git update-index --assume-unchanged .husky/pre-commit 2>/dev/null || true",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "test:e2e": "playwright test",
    "test:lighthouse": "bun run build && bun scripts/lighthouse-test.ts",
    "type-check": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.astro": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "baseline-browser-mapping": ">=2.11.26",
    "brace-expansion": ">=5.0.9",
    "browserslist": ">=4.29.1",
    "deepmerge-ts": "^8.0.2",
    "devalue": "^5.9.1",
    "fast-uri": "^3.1.6",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.19",
    "postcss": "^8.5.28",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/node": "^11.1.9",
    "@astrojs/vue": "^7.1.2",
    "@lucide/astro": "^1.67.0",
    "@lucide/vue": "^1.67.0",
    "ascii-reveal": "^0.3.0",
    "astro": "^7.4.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-vue-next": "^1.0.0",
    "nodemailer": "10.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/ts-plugin": "^1.10.12",
    "@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@laststance/tailwind-suggest-canonical-classes": "^0.1.2",
    "@playform/compress": "^0.2.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "astro-eslint-parser": "^3.2.0",
    "astro-html-validate": "^1.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.14.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-astro-organize-imports": "^0.4.14",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.17.0"
  }
}
