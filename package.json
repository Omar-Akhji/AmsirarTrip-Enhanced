{
  "name": "amsirartrip",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "build:timings": "astro build --timings",
    "check": "bun scripts/i18n-check.ts && astro check && tsc --noEmit",
    "dev": "astro dev",
    "format": "bun run format:tailwind && prettier --write .",
    "format:check": "bun run format:tailwind:check && prettier --check .",
    "format:tailwind": "tailwind-suggest-canonical-classes \"src/**/*.{astro,vue,ts,js,css,md,mdx}\" --css src/styles/global.css",
    "format:tailwind:check": "tailwind-suggest-canonical-classes \"src/**/*.{astro,vue,ts,js,css,md,mdx}\" --css src/styles/global.css --check",
    "lint": "eslint . && bun run lint:style",
    "lint:style": "stylelint \"src/**/*.{css,astro,vue}\"",
    "lint:style:fix": "stylelint \"src/**/*.{css,astro,vue}\" --fix",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "test:e2e": "playwright test",
    "test:lighthouse": "bun run build && bun scripts/lighthouse-test.ts",
    "type-check": "tsc --noEmit"
  },
  "overrides": {
    "baseline-browser-mapping": ">=2.11.26",
    "brace-expansion": ">=5.0.9",
    "browserslist": ">=4.29.1",
    "deepmerge-ts": "^8.0.2",
    "devalue": "^5.9.1",
    "fast-uri": "^3.1.6",
    "glob": ">=14.0.2",
    "js-yaml": "^4.3.2",
    "minimatch": ">=11.0.1",
    "nanoid": "^3.3.19",
    "postcss": "^8.5.28",
    "postcss-selector-parser": ">=7.1.1",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.12",
    "@astrojs/vercel": "^11.0.21",
    "@astrojs/vue": "^7.1.4",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.10",
    "cap-widget": "^0.1.62",
    "capjs-core": "0.1.15",
    "lenis": "^1.3.27",
    "nodemailer": "10.5.0",
    "sharp": "^0.35.5",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/ts-plugin": "^1.11.0",
    "@dreamsicle.io/stylelint-config-tailwindcss": "^1.3.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@laststance/tailwind-suggest-canonical-classes": "^0.1.2",
    "@playform/compress": "^0.2.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "astro-html-validate": "^1.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-astro-organize-imports": "^0.4.14",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^18.0.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^41.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vue-eslint-parser": "^10.4.2"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": "24.x"
  }
}
